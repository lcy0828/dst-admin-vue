{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { roomApi } from '../../api/index';\nexport default {\n  name: 'RoomList',\n  data() {\n    return {\n      loading: false,\n      searchQuery: '',\n      rooms: []\n    };\n  },\n  computed: {\n    filteredRooms() {\n      let result = this.rooms;\n\n      // 按搜索查询筛选\n      if (this.searchQuery) {\n        const query = this.searchQuery.toLowerCase();\n        result = result.filter(room => room.name.toLowerCase().includes(query) || room.savepath && room.savepath.toLowerCase().includes(query));\n      }\n      return result;\n    }\n  },\n  methods: {\n    refreshRooms() {\n      this.loading = true;\n      roomApi.getRoomList().then(response => {\n        if (response && response.status === 200 && response.data && Array.isArray(response.data.data)) {\n          // 直接使用API返回的数据\n          this.rooms = response.data.data.map(item => ({\n            id: item.name,\n            // 使用房间名称作为ID\n            ...item // 保留API返回的所有其他字段\n          }));\n          this.$message({\n            message: '房间列表已刷新',\n            type: 'success'\n          });\n        } else {\n          this.$message.error('获取房间列表失败，返回数据格式不正确');\n          console.error('返回数据:', response);\n        }\n      }).catch(error => {\n        this.$message.error('获取房间列表失败: ' + error.message);\n      }).finally(() => {\n        this.loading = false;\n      });\n    },\n    createRoom() {\n      this.$router.push('/rooms/settings');\n    },\n    editRoom(room) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: {\n          id: room.id\n        }\n      });\n    },\n    startRoom(room) {\n      this.$confirm(`确定要开启房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.startRoom(room.id).then(() => {\n          this.$message({\n            message: `房间 ${room.name} 已开启`,\n            type: 'success'\n          });\n        }).catch(error => {\n          this.$message.error(`开启房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleRowClick(row) {\n      // 点击行跳转到详情页\n      this.$router.push({\n        path: '/rooms/settings',\n        query: {\n          id: row.id\n        }\n      });\n    },\n    handleMoreCommands(command, room) {\n      switch (command) {\n        case 'duplicate':\n          this.duplicateRoom(room);\n          break;\n        case 'backup':\n          this.backupRoom(room);\n          break;\n        case 'delete':\n          this.deleteRoom(room);\n          break;\n      }\n    },\n    duplicateRoom(room) {\n      this.$prompt('请输入新房间名称', '复制房间', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        inputPattern: /^[a-zA-Z0-9_\\.]+$/,\n        inputErrorMessage: '房间名称只能包含字母、数字、下划线和点'\n      }).then(({\n        value\n      }) => {\n        this.loading = true;\n        roomApi.duplicateRoom(room.id, {\n          name: value\n        }).then(() => {\n          this.$message({\n            type: 'success',\n            message: `已复制房间 ${room.name} 到 ${value}`\n          });\n          this.refreshRooms(); // 刷新列表以显示新房间\n        }).catch(error => {\n          this.$message.error(`复制房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    backupRoom(room) {\n      this.$confirm(`确定要备份房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'info'\n      }).then(() => {\n        this.loading = true;\n        roomApi.backupRoom(room.id).then(() => {\n          this.$message({\n            type: 'success',\n            message: `房间 ${room.name} 备份已创建`\n          });\n        }).catch(error => {\n          this.$message.error(`备份房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    deleteRoom(room) {\n      this.$confirm(`确定要删除房间 \"${room.name}\" 吗？此操作不可恢复!`, '警告', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.deleteRoom(room.id).then(() => {\n          // 从本地列表中移除\n          this.rooms = this.rooms.filter(r => r.id !== room.id);\n          this.$message({\n            type: 'success',\n            message: `房间 ${room.name} 已删除`\n          });\n        }).catch(error => {\n          this.$message.error(`删除房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    }\n  },\n  mounted() {\n    this.refreshRooms();\n  }\n};","map":{"version":3,"names":["roomApi","name","data","loading","searchQuery","rooms","computed","filteredRooms","result","query","toLowerCase","filter","room","includes","savepath","methods","refreshRooms","getRoomList","then","response","status","Array","isArray","map","item","id","$message","message","type","error","console","catch","finally","createRoom","$router","push","editRoom","path","startRoom","$confirm","confirmButtonText","cancelButtonText","handleRowClick","row","handleMoreCommands","command","duplicateRoom","backupRoom","deleteRoom","$prompt","inputPattern","inputErrorMessage","value","r","mounted"],"sources":["src/views/rooms/RoomList.vue"],"sourcesContent":["<template>\n  <div class=\"room-list-page\">\n    <div class=\"page-header\">\n      <h2>房间列表</h2>\n      <div class=\"header-actions\">\n        <el-input\n          placeholder=\"搜索房间\"\n          v-model=\"searchQuery\"\n          class=\"search-input\"\n          prefix-icon=\"el-icon-search\"\n          clearable>\n        </el-input>\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"createRoom\">创建房间</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"room-list-card\">\n      <div slot=\"header\" class=\"card-header\">\n        <span>所有房间</span>\n        <div>\n          <el-button style=\"margin-left: 10px;\" size=\"small\" icon=\"el-icon-refresh\" @click=\"refreshRooms\">刷新</el-button>\n        </div>\n      </div>\n      \n      <el-table\n        :data=\"filteredRooms\"\n        style=\"width: 100%\"\n        v-loading=\"loading\"\n        @row-click=\"handleRowClick\">\n        <el-table-column prop=\"name\" label=\"房间名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"savepath\" label=\"保存路径\" min-width=\"300\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"220\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button \n              type=\"success\" \n              size=\"mini\" \n              @click.stop=\"startRoom(scope.row)\">开启</el-button>\n            <el-button \n              type=\"primary\" \n              size=\"mini\" \n              @click.stop=\"editRoom(scope.row)\">编辑</el-button>\n            <el-dropdown trigger=\"click\" @command=\"handleMoreCommands($event, scope.row)\" @click.stop>\n              <el-button size=\"mini\">\n                更多<i class=\"el-icon-arrow-down el-icon--right\"></i>\n              </el-button>\n              <el-dropdown-menu slot=\"dropdown\">\n                <el-dropdown-item command=\"duplicate\">复制房间</el-dropdown-item>\n                <el-dropdown-item command=\"backup\">备份房间</el-dropdown-item>\n                <el-dropdown-item command=\"delete\" divided>\n                  <span style=\"color: #F56C6C;\">删除房间</span>\n                </el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { roomApi } from '../../api/index';\n\nexport default {\n  name: 'RoomList',\n  data() {\n    return {\n      loading: false,\n      searchQuery: '',\n      rooms: []\n    }\n  },\n  computed: {\n    filteredRooms() {\n      let result = this.rooms;\n      \n      // 按搜索查询筛选\n      if (this.searchQuery) {\n        const query = this.searchQuery.toLowerCase();\n        result = result.filter(room => \n          room.name.toLowerCase().includes(query) || \n          (room.savepath && room.savepath.toLowerCase().includes(query))\n        );\n      }\n      \n      return result;\n    }\n  },\n  methods: {\n    refreshRooms() {\n      this.loading = true;\n      roomApi.getRoomList()\n        .then(response => {\n          if (response && response.status === 200 && response.data && Array.isArray(response.data.data)) {\n            // 直接使用API返回的数据\n            this.rooms = response.data.data.map(item => ({\n              id: item.name, // 使用房间名称作为ID\n              ...item // 保留API返回的所有其他字段\n            }));\n            \n            this.$message({\n              message: '房间列表已刷新',\n              type: 'success'\n            });\n          } else {\n            this.$message.error('获取房间列表失败，返回数据格式不正确');\n            console.error('返回数据:', response);\n          }\n        })\n        .catch(error => {\n          this.$message.error('获取房间列表失败: ' + error.message);\n        })\n        .finally(() => {\n          this.loading = false;\n        });\n    },\n    createRoom() {\n      this.$router.push('/rooms/settings');\n    },\n    editRoom(room) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: { id: room.id }\n      });\n    },\n    startRoom(room) {\n      this.$confirm(`确定要开启房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.startRoom(room.id)\n          .then(() => {\n            this.$message({\n              message: `房间 ${room.name} 已开启`,\n              type: 'success'\n            });\n          })\n          .catch(error => {\n            this.$message.error(`开启房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleRowClick(row) {\n      // 点击行跳转到详情页\n      this.$router.push({\n        path: '/rooms/settings',\n        query: { id: row.id }\n      });\n    },\n    handleMoreCommands(command, room) {\n      switch (command) {\n        case 'duplicate':\n          this.duplicateRoom(room);\n          break;\n        case 'backup':\n          this.backupRoom(room);\n          break;\n        case 'delete':\n          this.deleteRoom(room);\n          break;\n      }\n    },\n    duplicateRoom(room) {\n      this.$prompt('请输入新房间名称', '复制房间', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        inputPattern: /^[a-zA-Z0-9_\\.]+$/,\n        inputErrorMessage: '房间名称只能包含字母、数字、下划线和点'\n      }).then(({ value }) => {\n        this.loading = true;\n        roomApi.duplicateRoom(room.id, { name: value })\n          .then(() => {\n            this.$message({\n              type: 'success',\n              message: `已复制房间 ${room.name} 到 ${value}`,\n            });\n            this.refreshRooms(); // 刷新列表以显示新房间\n          })\n          .catch(error => {\n            this.$message.error(`复制房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    backupRoom(room) {\n      this.$confirm(`确定要备份房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'info'\n      }).then(() => {\n        this.loading = true;\n        roomApi.backupRoom(room.id)\n          .then(() => {\n            this.$message({\n              type: 'success',\n              message: `房间 ${room.name} 备份已创建`\n            });\n          })\n          .catch(error => {\n            this.$message.error(`备份房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    deleteRoom(room) {\n      this.$confirm(`确定要删除房间 \"${room.name}\" 吗？此操作不可恢复!`, '警告', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.deleteRoom(room.id)\n          .then(() => {\n            // 从本地列表中移除\n            this.rooms = this.rooms.filter(r => r.id !== room.id);\n            this.$message({\n              type: 'success',\n              message: `房间 ${room.name} 已删除`\n            });\n          })\n          .catch(error => {\n            this.$message.error(`删除房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    }\n  },\n  mounted() {\n    this.refreshRooms();\n  }\n}\n</script>\n\n<style scoped>\n.room-list-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-con