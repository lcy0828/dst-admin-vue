{"ast":null,"code":"export default {\n  name: 'ModList',\n  data() {\n    return {\n      loading: false,\n      // 搜索表单\n      searchForm: {\n        name: '',\n        author: '',\n        status: ''\n      },\n      // 模组列表\n      modsList: [],\n      // 选中的模组\n      selectedMods: [],\n      // 分页\n      pagination: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      // 添加/编辑模组对话框\n      dialogVisible: false,\n      dialogType: 'add',\n      // 'add' 或 'edit'\n      modForm: {\n        id: null,\n        name: '',\n        author: '',\n        version: '',\n        description: '',\n        category: '',\n        status: 'enabled',\n        iconUrl: '',\n        fileList: []\n      },\n      modRules: {\n        name: [{\n          required: true,\n          message: '请输入模组名称',\n          trigger: 'blur'\n        }, {\n          min: 1,\n          max: 50,\n          message: '长度在 1 到 50 个字符',\n          trigger: 'blur'\n        }],\n        author: [{\n          required: true,\n          message: '请输入作者名称',\n          trigger: 'blur'\n        }],\n        version: [{\n          required: true,\n          message: '请输入版本号',\n          trigger: 'blur'\n        }],\n        category: [{\n          required: true,\n          message: '请选择分类',\n          trigger: 'change'\n        }]\n      },\n      // 创意工坊对话框\n      workshopDialogVisible: false,\n      workshopLoading: false,\n      workshopForm: {\n        workshopId: ''\n      },\n      workshopSearchResult: null\n    };\n  },\n  computed: {\n    hasSelection() {\n      return this.selectedMods.length > 0;\n    }\n  },\n  created() {\n    this.fetchModsList();\n  },\n  methods: {\n    fetchModsList() {\n      // 实现获取模组列表的逻辑\n    },\n    handleSearch() {\n      // 实现搜索逻辑\n    },\n    resetSearch() {\n      // 实现重置搜索逻辑\n    },\n    handleAdd() {\n      // 实现添加模组逻辑\n    },\n    handleEdit(mod) {\n      // 实现编辑模组逻辑\n    },\n    handleConfig(mod) {\n      // 实现配置模组逻辑\n    },\n    handleDelete(mod) {\n      // 实现删除模组逻辑\n    },\n    handleSelectionChange(selected) {\n      // 实现选择模组逻辑\n    },\n    handleEnable() {\n      // 实现启用所选模组逻辑\n    },\n    handleDisable() {\n      // 实现禁用所选模组逻辑\n    },\n    handleBatchDelete() {\n      // 实现批量删除模组逻辑\n    },\n    handleWorkshopImport() {\n      // 实现从创意工坊导入模组逻辑\n    },\n    handleSizeChange(newSize) {\n      // 实现改变页面大小逻辑\n    },\n    handleCurrentChange(newPage) {\n      // 实现改变当前页面逻辑\n    },\n    customUpload(event) {\n      // 实现自定义上传逻辑\n    },\n    handleExceed(files, fileList) {\n      // 实现超过上传限制逻辑\n    },\n    uploadIcon(event) {\n      // 实现上传图标逻辑\n    },\n    beforeIconUpload(file) {\n      // 实现上传图标前的验证逻辑\n    },\n    submitModForm() {\n      // 实现提交模组表单逻辑\n    },\n    searchWorkshop() {\n      // 实现搜索创意工坊模组逻辑\n    },\n    importFromWorkshop() {\n      // 实现从创意工坊导入模组逻辑\n    },\n    handleStatusChange(mod, val) {\n      // 实现改变模组状态逻辑\n    }\n  }\n};","map":{"version":3,"names":["name","data","loading","searchForm","author","status","modsList","selectedMods","pagination","currentPage","pageSize","total","dialogVisible","dialogType","modForm","id","version","description","category","iconUrl","fileList","modRules","required","message","trigger","min","max","workshopDialogVisible","workshopLoading","workshopForm","workshopId","workshopSearchResult","computed","hasSelection","length","created","fetchModsList","methods","handleSearch","resetSearch","handleAdd","handleEdit","mod","handleConfig","handleDelete","handleSelectionChange","selected","handleEnable","handleDisable","handleBatchDelete","handleWorkshopImport","handleSizeChange","newSize","handleCurrentChange","newPage","customUpload","event","handleExceed","files","uploadIcon","beforeIconUpload","file","submitModForm","searchWorkshop","importFromWorkshop","handleStatusChange","val"],"sources":["src/views/mods/ModList.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card class=\"main-card\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>模组管理</span>\n        <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"refreshData\">刷新</el-button>\n      </div>\n\n      <!-- 搜索区域 -->\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"search-form\" size=\"small\">\n        <el-form-item label=\"模组名称\">\n          <el-input v-model=\"searchForm.name\" placeholder=\"请输入模组名称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"作者\">\n          <el-input v-model=\"searchForm.author\" placeholder=\"请输入作者\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"状态\">\n          <el-select v-model=\"searchForm.status\" placeholder=\"请选择状态\" clearable>\n            <el-option label=\"启用\" value=\"enabled\"></el-option>\n            <el-option label=\"禁用\" value=\"disabled\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">搜索</el-button>\n          <el-button icon=\"el-icon-refresh\" @click=\"resetSearch\">重置</el-button>\n        </el-form-item>\n      </el-form>\n\n      <!-- 工具栏 -->\n      <div class=\"tool-bar\">\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"handleAdd\">添加模组</el-button>\n        <el-button type=\"success\" icon=\"el-icon-check\" :disabled=\"!hasSelection\" @click=\"handleEnable\">启用所选</el-button>\n        <el-button type=\"info\" icon=\"el-icon-close\" :disabled=\"!hasSelection\" @click=\"handleDisable\">禁用所选</el-button>\n        <el-button type=\"danger\" icon=\"el-icon-delete\" :disabled=\"!hasSelection\" @click=\"handleBatchDelete\">删除所选</el-button>\n        <el-button type=\"warning\" icon=\"el-icon-download\" @click=\"handleWorkshopImport\">从创意工坊导入</el-button>\n      </div>\n\n      <!-- 模组列表 -->\n      <div v-loading=\"loading\">\n        <el-table\n          :data=\"modsList\"\n          border\n          stripe\n          @selection-change=\"handleSelectionChange\"\n          style=\"width: 100%\">\n          <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n          <el-table-column label=\"状态\" width=\"80\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-switch\n                v-model=\"scope.row.status === 'enabled'\"\n                @change=\"(val) => handleStatusChange(scope.row, val)\"\n                active-color=\"#13ce66\"\n                inactive-color=\"#ff4949\">\n              </el-switch>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"name\" label=\"模组名称\" min-width=\"180\">\n            <template slot-scope=\"scope\">\n              <div class=\"mod-info\">\n                <el-avatar :size=\"40\" :src=\"scope.row.iconUrl\" class=\"mod-icon\"></el-avatar>\n                <div class=\"mod-detail\">\n                  <div class=\"mod-name\">{{ scope.row.name }}</div>\n                  <div class=\"mod-version\">v{{ scope.row.version }}</div>\n                </div>\n              </div>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"author\" label=\"作者\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"description\" label=\"描述\" min-width=\"200\" show-overflow-tooltip></el-table-column>\n          <el-table-column prop=\"category\" label=\"分类\" width=\"120\">\n            <template slot-scope=\"scope\">\n              <el-tag>{{ scope.row.category }}</el-tag>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"size\" label=\"大小\" width=\"90\" align=\"center\"></el-table-column>\n          <el-table-column prop=\"updatedAt\" label=\"更新时间\" width=\"180\" align=\"center\"></el-table-column>\n          <el-table-column label=\"操作\" width=\"240\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-button \n                size=\"mini\" \n                type=\"primary\" \n                icon=\"el-icon-edit\" \n                @click=\"handleEdit(scope.row)\">\n                编辑\n              </el-button>\n              <el-button \n                size=\"mini\" \n                type=\"success\" \n                icon=\"el-icon-setting\" \n                @click=\"handleConfig(scope.row)\">\n                配置\n              </el-button>\n              <el-button \n                size=\"mini\" \n                type=\"danger\" \n                icon=\"el-icon-delete\" \n                @click=\"handleDelete(scope.row)\">\n                删除\n              </el-button>\n            </template>\n          </el-table-column>\n        </el-table>\n\n        <!-- 分页 -->\n        <div class=\"pagination-container\">\n          <el-pagination\n            @size-change=\"handleSizeChange\"\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pagination.currentPage\"\n            :page-sizes=\"[10, 20, 50, 100]\"\n            :page-size=\"pagination.pageSize\"\n            layout=\"total, sizes, prev, pager, next, jumper\"\n            :total=\"pagination.total\">\n          </el-pagination>\n        </div>\n      </div>\n    </el-card>\n\n    <!-- 添加/编辑模组对话框 -->\n    <el-dialog :title=\"dialogType === 'add' ? '添加模组' : '编辑模组'\" :visible.sync=\"dialogVisible\" width=\"600px\">\n      <el-form :model=\"modForm\" :rules=\"modRules\" ref=\"modForm\" label-width=\"100px\">\n        <el-form-item label=\"模组名称\" prop=\"name\">\n          <el-input v-model=\"modForm.name\" placeholder=\"请输入模组名称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"作者\" prop=\"author\">\n          <el-input v-model=\"modForm.author\" placeholder=\"请输入作者名称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"版本\" prop=\"version\">\n          <el-input v-model=\"modForm.version\" placeholder=\"请输入版本号\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"分类\" prop=\"category\">\n          <el-select v-model=\"modForm.category\" placeholder=\"请选择分类\">\n            <el-option label=\"游戏玩法\" value=\"gameplay\"></el-option>\n            <el-option label=\"物品\" value=\"item\"></el-option>\n            <el-option label=\"生物\" value=\"creature\"></el-option>\n            <el-option label=\"辅助工具\" value=\"utility\"></el-option>\n            <el-option label=\"界面\" value=\"interface\"></el-option>\n            <el-option label=\"世界生成\" value=\"worldgen\"></el-option>\n            <el-option label=\"其他\" value=\"other\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"描述\" prop=\"description\">\n          <el-input type=\"textarea\" v-model=\"modForm.description\" rows=\"4\" placeholder=\"请输入模组描述\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"模组文件\" prop=\"file\" v-if=\"dialogType === 'add'\">\n          <el-upload\n            class=\"upload-demo\"\n            action=\"#\"\n            :http-request=\"customUpload\"\n            :limit=\"1\"\n            :on-exceed=\"handleExceed\"\n            :file-list=\"modForm.fileList\">\n            <el-button size=\"small\" type=\"primary\">点击上传</el-button>\n            <div slot=\"tip\" class=\"el-upload__tip\">只能上传zip文件，且不超过50MB</div>\n          </el-upload>\n        </el-form-item>\n        <el-form-item label=\"图标\" prop=\"iconUrl\">\n          <el-upload\n            class=\"avatar-uploader\"\n            action=\"#\"\n            :show-file-list=\"false\"\n            :http-request=\"uploadIcon\"\n            :before-upload=\"beforeIconUpload\">\n            <img v-if=\"modForm.iconUrl\" :src=\"modForm.iconUrl\" class=\"avatar\">\n            <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\n          </el-upload>\n        </el-form-item>\n        <el-form-item label=\"状态\" prop=\"status\">\n          <el-switch\n            v-model=\"modForm.status\"\n            active-text=\"启用\"\n            inactive-text=\"禁用\"\n            active-value=\"enabled\"\n            inactive-value=\"disabled\">\n          </el-switch>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitModForm\">确定</el-button>\n      </span>\n    </el-dialog>\n\n    <!-- 导入创意工坊模组对话框 -->\n    <el-dialog title=\"从创意工坊导入模组\" :visible.sync=\"workshopDialogVisible\" width=\"600px\">\n      <el-form :model=\"workshopForm\" ref=\"workshopForm\" label-width=\"120px\">\n        <el-form-item label=\"创意工坊ID\" prop=\"workshopId\">\n          <el-input v-model=\"workshopForm.workshopId\" placeholder=\"请输入Steam创意工坊ID\"></el-input>\n        </el-form-item>\n        <div class=\"workshop-search-result\" v-if=\"workshopSearchResult\">\n          <div class=\"workshop-mod-info\">\n            <img :src=\"workshopSearchResult.iconUrl\" class=\"workshop-mod-image\">\n            <div class=\"workshop-mod-details\">\n              <h3>{{ workshopSearchResult.name }}</h3>\n              <p>作者: {{ workshopSearchResult.author }}</p>\n              <p>更新时间: {{ workshopSearchResult.updatedAt }}</p>\n              <p class=\"workshop-mod-description\">{{ workshopSearchResult.description }}</p>\n            </div>\n          </div>\n        </div>\n        <div class=\"workshop-loading\" v-else-if=\"workshopLoading\">\n          <el-skeleton style=\"width: 100%\" animated>\n            <template slot=\"template\">\n              <el-skeleton-item variant=\"image\" style=\"width: 100%; height: 120px\" />\n              <div style=\"padding: 14px;\">\n                <el-skeleton-item variant=\"h3\" style=\"width: 50%\" />\n                <div style=\"display: flex; align-items: center; justify-content: space-between; margin-top: 14px;\">\n                  <el-skeleton-item variant=\"text\" style=\"margin-right: 16px;\" />\n                  <el-skeleton-item variant=\"text\" style=\"width: 30%;\" />\n                </div>\n              </div>\n            </template>\n          </el-skeleton>\n        </div>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"workshopDialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"searchWorkshop\" v-if=\"!workshopSearchResult\">搜索</el-button>\n        <el-button type=\"success\" @click=\"importFromWorkshop\" v-else>导入模组</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'ModList',\n  data() {\n    return {\n      loading: false,\n      // 搜索表单\n      searchForm: {\n        name: '',\n        author: '',\n        status: ''\n      },\n      // 模组列表\n      modsList: [],\n      // 选中的模组\n      selectedMods: [],\n      // 分页\n      pagination: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      \n      // 添加/编辑模组对话框\n      dialogVisible: false,\n      dialogType: 'add', // 'add' 或 'edit'\n      modForm: {\n        id: null,\n        name: '',\n        author: '',\n        version: '',\n        description: '',\n        category: '',\n        status: 'enabled',\n        iconUrl: '',\n        fileList: []\n      },\n      modRules: {\n        name: [\n          { required: true, message: '请输入模组名称', trigger: 'blur' },\n          { min: 1, max: 50, message: '长度在 1 到 50 个字符', trigger: 'blur' }\n        ],\n        author: [\n          { required: true, message: '请输入作者名称', trigger: 'blur' }\n        ],\n        version: [\n          { required: true, message: '请输入版本号', trigger: 'blur' }\n        ],\n        category: [\n          { required: true, message: '请选择分类', trigger: 'change' }\n        ]\n      },\n      \n      // 创意工坊对话框\n      workshopDialogVisible: false,\n      workshopLoading: false,\n      workshopForm: {\n        workshopId: ''\n      },\n      workshopSearchResult: null\n    };\n  },\n  computed: {\n    hasSelection() {\n      return this.selec