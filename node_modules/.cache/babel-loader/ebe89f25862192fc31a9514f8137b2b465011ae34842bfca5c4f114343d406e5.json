{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { serverApi } from '@/api/index';\nexport default {\n  name: 'SpecialLists',\n  data() {\n    return {\n      // 存档相关\n      saveList: [{\n        label: '存档1',\n        value: 'save1'\n      }, {\n        label: '存档2',\n        value: 'save2'\n      }, {\n        label: '存档3',\n        value: 'save3'\n      }],\n      currentSave: '',\n      // 标签页\n      activeTab: 'admin',\n      // 数据\n      adminList: [],\n      blockList: [],\n      whiteList: [],\n      // 加载状态\n      loading: {\n        admin: false,\n        block: false,\n        white: false\n      },\n      // 对话框\n      dialogVisible: false,\n      dialogType: 'admin',\n      // admin, block, white\n      dialogTitle: '添加管理员',\n      userForm: {\n        name: '',\n        id: ''\n      },\n      userRules: {\n        name: [{\n          required: true,\n          message: '请输入玩家名称',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 20,\n          message: '长度在 2 到 20 个字符',\n          trigger: 'blur'\n        }],\n        id: [{\n          required: true,\n          message: '请输入KU ID',\n          trigger: 'blur'\n        }]\n      },\n      submitting: false\n    };\n  },\n  methods: {\n    // 切换存档\n    changeSave() {\n      this.fetchAllLists();\n    },\n    // 切换标签页\n    handleTabClick(tab) {\n      // 可根据需要添加逻辑\n    },\n    // 获取所有列表数据\n    fetchAllLists() {\n      if (!this.currentSave) return;\n      this.fetchAdminList();\n      this.fetchBlockList();\n      this.fetchWhiteList();\n    },\n    // 获取管理员列表\n    fetchAdminList() {\n      this.loading.admin = true;\n      serverApi.getAdminList(this.currentSave).then(res => {\n        this.adminList = Array.isArray(res) ? res : [];\n        console.log('获取管理员列表成功:', this.adminList);\n      }).catch(err => {\n        console.error('获取管理员列表失败:', err);\n        this.$message.error('获取管理员列表失败');\n      }).finally(() => {\n        this.loading.admin = false;\n      });\n    },\n    // 获取黑名单\n    fetchBlockList() {\n      this.loading.block = true;\n      serverApi.getBlockList(this.currentSave).then(res => {\n        this.blockList = Array.isArray(res) ? res : [];\n        console.log('获取黑名单成功:', this.blockList);\n      }).catch(err => {\n        console.error('获取黑名单失败:', err);\n        this.$message.error('获取黑名单失败');\n      }).finally(() => {\n        this.loading.block = false;\n      });\n    },\n    // 获取白名单\n    fetchWhiteList() {\n      this.loading.white = true;\n      serverApi.getWhiteList(this.currentSave).then(res => {\n        this.whiteList = Array.isArray(res) ? res : [];\n        console.log('获取白名单成功:', this.whiteList);\n      }).catch(err => {\n        console.error('获取白名单失败:', err);\n        this.$message.error('获取白名单失败');\n      }).finally(() => {\n        this.loading.white = false;\n      });\n    },\n    // 打开添加用户对话框\n    addUser(type) {\n      this.dialogType = type;\n      this.userForm = {\n        name: '',\n        id: ''\n      };\n\n      // 设置对话框标题\n      switch (type) {\n        case 'admin':\n          this.dialogTitle = '添加管理员';\n          break;\n        case 'block':\n          this.dialogTitle = '添加黑名单';\n          break;\n        case 'white':\n          this.dialogTitle = '添加白名单';\n          break;\n      }\n      this.dialogVisible = true;\n    },\n    // 提交用户表单\n    submitUserForm() {\n      this.$refs.userForm.validate(valid => {\n        if (!valid) return;\n        this.submitting = true;\n\n        // 根据类型调用不同的API\n        const newList = [...this.getTargetList()];\n        newList.push(this.userForm);\n        this.updateList(newList).then(() => {\n          this.dialogVisible = false;\n          this.$message.success('添加成功');\n\n          // 刷新列表\n          this.refreshList();\n        }).catch(err => {\n          console.error('添加失败:', err);\n          this.$message.error('添加失败');\n        }).finally(() => {\n          this.submitting = false;\n        });\n      });\n    },\n    // 获取当前编辑的目标列表\n    getTargetList() {\n      switch (this.dialogType) {\n        case 'admin':\n          return this.adminList;\n        case 'block':\n          return this.blockList;\n        case 'white':\n          return this.whiteList;\n      }\n      return [];\n    },\n    // 更新列表\n    updateList(list) {\n      switch (this.dialogType) {\n        case 'admin':\n          return serverApi.updateAdminList(this.currentSave, list);\n        case 'block':\n          return serverApi.updateBlockList(this.currentSave, list);\n        case 'white':\n          return serverApi.updateWhiteList(this.currentSave, list);\n      }\n      return Promise.reject('未知类型');\n    },\n    // 刷新当前列表\n    refreshList() {\n      switch (this.dialogType) {\n        case 'admin':\n          this.fetchAdminList();\n          break;\n        case 'block':\n          this.fetchBlockList();\n          break;\n        case 'white':\n          this.fetchWhiteList();\n          break;\n      }\n    },\n    // 移除用户\n    removeUser(type, index, row) {\n      this.$confirm(`确定要从${this.getListTypeText(type)}中移除 ${row.name} 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 保存当前类型，后续操作中使用\n        this.dialogType = type;\n\n        // 获取相应的列表并移除用户\n        const list = [...this.getTargetList()];\n        list.splice(index, 1);\n\n        // 调用API更新列表\n        this.updateList(list).then(() => {\n          this.$message.success('移除成功');\n          // 刷新列表\n          this.refreshList();\n        }).catch(err => {\n          console.error('移除失败:', err);\n          this.$message.error('移除失败');\n        });\n      }).catch(() => {\n        // 用户取消操作\n      });\n    },\n    // 获取列表类型文本\n    getListTypeText(type) {\n      switch (type) {\n        case 'admin':\n          return '管理员列表';\n        case 'block':\n          return '黑名单';\n        case 'white':\n          return '白名单';\n      }\n      return '';\n    }\n  },\n  mounted() {\n    // 获取所有存档列表\n    // 实际项目中应该从API获取存档列表\n    this.saveList = [{\n      label: '测试存档',\n      value: 'test'\n    }, {\n      label: '生存模式',\n      value: 'survival'\n    }, {\n      label: '无尽模式',\n      value: 'endless'\n    }];\n\n    // 默认选择第一个存档\n    if (this.saveList.length > 0) {\n      this.currentSave = this.saveList[0].value;\n      this.fetchAllLists();\n    }\n  }\n};","map":{"version":3,"names":["serverApi","name","data","saveList","label","value","currentSave","activeTab","adminList","blockList","whiteList","loading","admin","block","white","dialogVisible","dialogType","dialogTitle","userForm","id","userRules","required","message","trigger","min","max","submitting","methods","changeSave","fetchAllLists","handleTabClick","tab","fetchAdminList","fetchBlockList","fetchWhiteList","getAdminList","then","res","Array","isArray","console","log","catch","err","error","$message","finally","getBlockList","getWhiteList","addUser","type","submitUserForm","$refs","validate","valid","newList","getTargetList","push","updateList","success","refreshList","list","updateAdminList","updateBlockList","updateWhiteList","Promise","reject","removeUser","index","row","$confirm","getListTypeText","confirmButtonText","cancelButtonText","splice","mounted","length"],"sources":["src/views/rooms/SpecialLists.vue"],"sourcesContent":["<template>\n  <div class=\"special-lists-page\">\n    <div class=\"page-header\">\n      <h2>特殊名单管理</h2>\n    </div>\n    \n    <el-card class=\"save-selector\">\n      <div slot=\"header\">\n        <span>选择存档</span>\n      </div>\n      <el-select v-model=\"currentSave\" placeholder=\"请选择存档\" @change=\"changeSave\" style=\"width: 100%;\">\n        <el-option\n          v-for=\"item in saveList\"\n          :key=\"item.value\"\n          :label=\"item.label\"\n          :value=\"item.value\">\n        </el-option>\n      </el-select>\n    </el-card>\n    \n    <el-tabs v-model=\"activeTab\" type=\"card\" @tab-click=\"handleTabClick\">\n      <el-tab-pane label=\"管理员名单\" name=\"admin\">\n        <el-card shadow=\"hover\" v-loading=\"loading.admin\">\n          <div slot=\"header\" class=\"list-header\">\n            <span>管理员列表</span>\n            <div>\n              <el-button size=\"small\" type=\"primary\" @click=\"addUser('admin')\" :disabled=\"!currentSave\">添加管理员</el-button>\n            </div>\n          </div>\n          \n          <div v-if=\"adminList.length > 0\">\n            <el-table :data=\"adminList\" style=\"width: 100%\">\n              <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n              <el-table-column prop=\"id\" label=\"KU ID\"></el-table-column>\n              <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\n                <template slot-scope=\"scope\">\n                  <el-button\n                    @click.native.prevent=\"removeUser('admin', scope.$index, scope.row)\"\n                    type=\"danger\"\n                    size=\"small\">\n                    移除\n                  </el-button>\n                </template>\n              </el-table-column>\n            </el-table>\n          </div>\n          <div v-else class=\"empty-list\">\n            <i class=\"el-icon-info\"></i>\n            <p>暂无管理员</p>\n          </div>\n        </el-card>\n      </el-tab-pane>\n      \n      <el-tab-pane label=\"黑名单\" name=\"block\">\n        <el-card shadow=\"hover\" v-loading=\"loading.block\">\n          <div slot=\"header\" class=\"list-header\">\n            <span>黑名单列表</span>\n            <div>\n              <el-button size=\"small\" type=\"primary\" @click=\"addUser('block')\" :disabled=\"!currentSave\">添加黑名单</el-button>\n            </div>\n          </div>\n          \n          <div v-if=\"blockList.length > 0\">\n            <el-table :data=\"blockList\" style=\"width: 100%\">\n              <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n              <el-table-column prop=\"id\" label=\"KU ID\"></el-table-column>\n              <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\n                <template slot-scope=\"scope\">\n                  <el-button\n                    @click.native.prevent=\"removeUser('block', scope.$index, scope.row)\"\n                    type=\"danger\"\n                    size=\"small\">\n                    移除\n                  </el-button>\n                </template>\n              </el-table-column>\n            </el-table>\n          </div>\n          <div v-else class=\"empty-list\">\n            <i class=\"el-icon-info\"></i>\n            <p>暂无黑名单用户</p>\n          </div>\n        </el-card>\n      </el-tab-pane>\n      \n      <el-tab-pane label=\"白名单\" name=\"white\">\n        <el-card shadow=\"hover\" v-loading=\"loading.white\">\n          <div slot=\"header\" class=\"list-header\">\n            <span>白名单列表</span>\n            <div>\n              <el-button size=\"small\" type=\"primary\" @click=\"addUser('white')\" :disabled=\"!currentSave\">添加白名单</el-button>\n            </div>\n          </div>\n          \n          <div v-if=\"whiteList.length > 0\">\n            <el-table :data=\"whiteList\" style=\"width: 100%\">\n              <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n              <el-table-column prop=\"id\" label=\"KU ID\"></el-table-column>\n              <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\n                <template slot-scope=\"scope\">\n                  <el-button\n                    @click.native.prevent=\"removeUser('white', scope.$index, scope.row)\"\n                    type=\"danger\"\n                    size=\"small\">\n                    移除\n                  </el-button>\n                </template>\n              </el-table-column>\n            </el-table>\n          </div>\n          <div v-else class=\"empty-list\">\n            <i class=\"el-icon-info\"></i>\n            <p>暂无白名单用户</p>\n          </div>\n        </el-card>\n      </el-tab-pane>\n    </el-tabs>\n    \n    <!-- 添加用户对话框 -->\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"30%\">\n      <el-form :model=\"userForm\" ref=\"userForm\" :rules=\"userRules\" label-width=\"100px\">\n        <el-form-item label=\"玩家名称\" prop=\"name\">\n          <el-input v-model=\"userForm.name\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"KU ID\" prop=\"id\">\n          <el-input v-model=\"userForm.id\"></el-input>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitUserForm\" :loading=\"submitting\">确定</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { serverApi } from '@/api/index';\n\nexport default {\n  name: 'SpecialLists',\n  data() {\n    return {\n      // 存档相关\n      saveList: [\n        { label: '存档1', value: 'save1' },\n        { label: '存档2', value: 'save2' },\n        { label: '存档3', value: 'save3' }\n      ],\n      currentSave: '',\n      \n      // 标签页\n      activeTab: 'admin',\n      \n      // 数据\n      adminList: [],\n      blockList: [],\n      whiteList: [],\n      \n      // 加载状态\n      loading: {\n        admin: false,\n        block: false,\n        white: false\n      },\n      \n      // 对话框\n      dialogVisible: false,\n      dialogType: 'admin', // admin, block, white\n      dialogTitle: '添加管理员',\n      userForm: {\n        name: '',\n        id: ''\n      },\n      userRules: {\n        name: [\n          { required: true, message: '请输入玩家名称', trigger: 'blur' },\n          { min: 2, max: 20, message: '长度在 2 到 20 个字符', trigger: 'blur' }\n        ],\n        id: [\n          { required: true, message: '请输入KU ID', trigger: 'blur' }\n        ]\n      },\n      submitting: false\n    }\n  },\n  methods: {\n    // 切换存档\n    changeSave() {\n      this.fetchAllLists();\n    },\n    \n    // 切换标签页\n    handleTabClick(tab) {\n      // 可根据需要添加逻辑\n    },\n    \n    // 获取所有列表数据\n    fetchAllLists() {\n      if (!this.currentSave) return;\n      \n      this.fetchAdminList();\n      this.fetchBlockList();\n      this.fetchWhiteList();\n    },\n    \n    // 获取管理员列表\n    fetchAdminList() {\n      this.loading.admin = true;\n      serverApi.getAdminList(this.currentSave)\n        .then(res => {\n          this.adminList = Array.isArray(res) ? res : [];\n          console.log('获取管理员列表成功:', this.adminList);\n        })\n        .catch(err => {\n          console.error('获取管理员列表失败:', err);\n          this.$message.error('获取管理员列表失败');\n        })\n        .finally(() => {\n          this.loading.admin = false;\n        });\n    },\n    \n    // 获取黑名单\n    fetchBlockList() {\n      this.loading.block = true;\n      serverApi.getBlockList(this.currentSave)\n        .then(res => {\n          this.blockList = Array.isArray(res) ? res : [];\n          console.log('获取黑名单成功:', this.blockList);\n        })\n        .catch(err => {\n          console.error('获取黑名单失败:', err);\n          this.$message.error('获取黑名单失败');\n        })\n        .finally(() => {\n          this.loading.block = false;\n        });\n    },\n    \n    // 获取白名单\n    fetchWhiteList() {\n      this.loading.white = true;\n      serverApi.getWhiteList(this.currentSave)\n        .then(res => {\n          this.whiteList = Array.isArray(res) ? res : [];\n          console.log('获取白名单成功:', this.whiteList);\n        })\n        .catch(err => {\n          console.error('获取白名单失败:', err);\n          this.$message.error('获取白名单失败');\n        })\n        .finally(() => {\n          this.loading.white = false;\n        });\n    },\n    \n    // 打开添加用户对话框\n    addUser(type) {\n      this.dialogType = type;\n      this.userForm = { name: '', id: '' };\n      \n      // 设置对话框标题\n      switch (type) {\n        case 'admin':\n          this.dialogTitle = '添加管理员';\n          break;\n        case 'block':\n          this.dialogTitle = '添加黑名单';\n          break;\n        case 'white':\n          this.dialogTitle = '添加白名单';\n          break;\n      }\n      \n      this.dialogVisible = true;\n    },\n    \n    // 提交用户表单\n    submitUserForm() {\n      this.$refs.userForm.validate(valid => {\n        if (!valid) return;\n        \n        this.submitting = true;\n        \n        // 根据类型调用不同的API\n        const newList = [...this.getTargetList()];\n        newList.push(this.userForm);\n        \n        this.updateList(newList)\n          .then(() => {\n            this.dialogVisible = false;\n            this.$message.success('添加成功');\n            \n            // 刷新列表\n            this.refreshList();\n          })\n          .catch(err => {\n            console.error('添加失败:', err);\n            this.$message.error('添加失败');\n          })\n          .finally(() => {\n            this.submitting = false;\n          });\n      });\n    },\n    \n    // 获取当前编辑的目标列表\n    getTargetList() {\n      switch (this.dialogType) {\n        case 'admin':\n          return this.adminList;\n        case 'block':\n          return this.blockList;\n        case 'white':\n          return this.whiteList;\n      }\n      return [];\n    },\n    \n    // 更新列表\n    updateList(list) {\n      switch (this.dialogType) {\n        case 'admin':\n          return serverApi.updateAdminList(this.currentSave, list);\n        case 'block':\n          return serverApi.updateBlockList(this.currentSave, list);\n        case 'white':\n          return serverApi.updateWhiteList(this.currentSave, list);\n      }\n      return Promise.reject('未知类型');\n    },\n    \n    // 刷新当前列表\n    refreshList() {\n      switch (this.dialogType) {\n        case 'admin':\n          this.fetchAdminList();\n          break;\n        case 'block':\n          this.fetchBlockList();\n          break;\n        case 'white':\n          this.fetchWhiteList();\n          break;\n      }\n    },\n    \n    // 移除用户\n    removeUser(type, index, row) {\n      this.$confirm(`确定要从${this.getListTypeText(type)}中移除 ${row.name} 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 保存当前类型，后续操作中使用\n        this.dialogType = type;\n        \n        // 获取相应的列表并移除用户\n        const list = [...this.getTargetList()];\n        list.splice(index, 1);\n        \n        // 调用API更新列表\n        this.updateList(list)\n          .then(() => {\n            this.$message.success('移除成功');\n            // 刷新列表\n            this.refreshList();\n          })\n          .catch(err => {\n            console.error('移除失败:', err);\n            this.$message.error('移除失败');\n          });\n      }).catch(() => {\n        // 用户取消操作\n      });\n    },\n    \n    // 获取列表类型文本\n    getListTypeText(type) {\n      switch (type) {\n        case 'admin':\n          return '管理员列表';\n        case 'block':\n          return '黑名单';\n        case 'white':\n          return '白名单';\n      }\n      return '';\n    }\n  },\n  mounted() {\n    // 获取所有存档列表\n    // 实际项目中应该从API获取存档列表\n    this.saveList = [\n      { label: '测试存档', value: 'test' },\n      { label: '生存模式', value: 'survival' },\n      { label: '无尽模式', value: 'endless' }\n    ];\n    \n    // 默认选择第一个存档\n    if (this.saveList.length > 0) {\n      this.currentSave = this.saveList[0].value;\n      this.fetchAllLists();\n    }\n  }\n}\n</script>\n\n<style scoped>\n.special-lists-page {\n  padding: 20px;\n}\n\n.page-header {\n  margin-bottom: 20px;\n}\n\n.save-selector {\n  margin-bottom: 20px;\n}\n\n.list-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.empty-list {\n  text-align: center;\n  padding: 30px 0;\n  color: #909399;\n}\n\n.empty-list i {\n  font-size: 40px;\n  margin-bottom: 10px;\n}\n\n.el-tabs {\n  margin-bottom: 20px;\n}\n</style> "],"mappings":";AAyIA,SAAAA,SAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACA;MACAC,QAAA,GACA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,