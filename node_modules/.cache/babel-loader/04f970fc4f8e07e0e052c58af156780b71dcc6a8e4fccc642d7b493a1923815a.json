{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport { Terminal } from 'xterm';\nimport { FitAddon } from 'xterm-addon-fit';\nimport 'xterm/css/xterm.css';\nexport default {\n  name: 'WorldLog',\n  props: {\n    title: {\n      type: String,\n      default: '世界日志'\n    },\n    serverId: {\n      type: [String, Number],\n      default: null\n    }\n  },\n  data() {\n    return {\n      terminal: null,\n      fitAddon: null,\n      selectedServer: null,\n      loading: false,\n      servers: [{\n        id: 1,\n        name: '主世界服务器'\n      }, {\n        id: 2,\n        name: '洞穴服务器'\n      }, {\n        id: 3,\n        name: 'MOD测试服务器'\n      }, {\n        id: 4,\n        name: '活动服务器'\n      }, {\n        id: 5,\n        name: '开发测试服务器'\n      }],\n      logContent: ''\n    };\n  },\n  mounted() {\n    this.initTerminal();\n    if (this.serverId) {\n      this.selectedServer = this.serverId;\n      this.loadLog();\n    }\n\n    // 监听窗口大小变化，调整终端大小\n    window.addEventListener('resize', this.onResize);\n  },\n  beforeDestroy() {\n    // 清理事件监听\n    window.removeEventListener('resize', this.onResize);\n    // 销毁终端\n    if (this.terminal) {\n      this.terminal.dispose();\n    }\n  },\n  methods: {\n    initTerminal() {\n      // 创建终端实例\n      this.terminal = new Terminal({\n        cursorBlink: false,\n        disableStdin: true,\n        // 禁用输入\n        fontSize: 14,\n        fontFamily: 'Menlo, Monaco, \"Courier New\", monospace',\n        theme: {\n          background: '#1e1e1e',\n          foreground: '#f0f0f0',\n          cursor: 'transparent'\n        },\n        rendererType: 'canvas',\n        scrollback: 5000\n      });\n\n      // 创建自适应插件\n      this.fitAddon = new FitAddon();\n      this.terminal.loadAddon(this.fitAddon);\n\n      // 挂载终端\n      this.terminal.open(this.$refs.terminal);\n\n      // 调整大小\n      this.$nextTick(() => {\n        this.fitAddon.fit();\n      });\n\n      // 写入欢迎信息\n      this.terminal.writeln('\\x1B[1;3;36m欢迎使用饥荒联机版服务器日志查看器\\x1B[0m');\n      this.terminal.writeln('\\x1B[90m请选择一个服务器以查看其日志记录...\\x1B[0m');\n      this.terminal.writeln('');\n    },\n    handleServerChange() {\n      this.loadLog();\n    },\n    onResize() {\n      if (this.fitAddon) {\n        this.fitAddon.fit();\n      }\n    },\n    refreshLog() {\n      if (this.selectedServer) {\n        this.loadLog();\n      } else {\n        this.$message.warning('请先选择一个服务器');\n      }\n    },\n    loadLog() {\n      if (!this.selectedServer) return;\n      this.loading = true;\n\n      // 清空终端内容\n      this.terminal.clear();\n\n      // 模拟API调用获取日志\n      setTimeout(() => {\n        // 获取所选服务器的信息\n        const server = this.servers.find(s => s.id === this.selectedServer);\n\n        // 写入日志标题\n        this.terminal.writeln(`\\x1B[1;32m=== ${server.name} 日志记录 ===\\x1B[0m`);\n        this.terminal.writeln('');\n\n        // 模拟日志内容\n        const logs = this.generateSampleLogs(server.name);\n\n        // 逐行写入日志\n        logs.forEach(log => {\n          this.terminal.writeln(log);\n        });\n        this.loading = false;\n      }, 800);\n    },\n    generateSampleLogs(serverName) {\n      // 模拟日志内容\n      const currentDate = new Date();\n      const logs = [];\n\n      // 生成20条模拟日志\n      for (let i = 20; i >= 0; i--) {\n        const time = new Date(currentDate - i * 60000);\n        const timeStr = `[${time.getHours().toString().padStart(2, '0')}:${time.getMinutes().toString().padStart(2, '0')}:${time.getSeconds().toString().padStart(2, '0')}]`;\n        let logLine;\n        const logType = Math.floor(Math.random() * 5);\n        switch (logType) {\n          case 0:\n            logLine = `${timeStr} \\x1B[32m[INFO]\\x1B[0m 玩家 \"Player${Math.floor(Math.random() * 100)}\" 加入了游戏`;\n            break;\n          case 1:\n            logLine = `${timeStr} \\x1B[32m[INFO]\\x1B[0m 玩家 \"Player${Math.floor(Math.random() * 100)}\" 离开了游戏`;\n            break;\n          case 2:\n            logLine = `${timeStr} \\x1B[33m[WARN]\\x1B[0m 世界进入第 ${Math.floor(Math.random() * 365) + 1} 天`;\n            break;\n          case 3:\n            logLine = `${timeStr} \\x1B[36m[SYSTEM]\\x1B[0m 世界状态已保存`;\n            break;\n          case 4:\n            logLine = `${timeStr} \\x1B[35m[EVENT]\\x1B[0m 季节变更为 ${['春季', '夏季', '秋季', '冬季'][Math.floor(Math.random() * 4)]}`;\n            break;\n        }\n        logs.push(logLine);\n      }\n      return logs;\n    }\n  }\n};","map":{"version":3,"names":["Terminal","FitAddon","name","props","title","type","String","default","serverId","Number","data","terminal","fitAddon","selectedServer","loading","servers","id","logContent","mounted","initTerminal","loadLog","window","addEventListener","onResize","beforeDestroy","removeEventListener","dispose","methods","cursorBlink","disableStdin","fontSize","fontFamily","theme","background","foreground","cursor","rendererType","scrollback","loadAddon","open","$refs","$nextTick","fit","writeln","handleServerChange","refreshLog","$message","warning","clear","setTimeout","server","find","s","logs","generateSampleLogs","forEach","log","serverName","currentDate","Date","i","time","timeStr","getHours","toString","padStart","getMinutes","getSeconds","logLine","logType","Math","floor","random","push"],"sources":["src/components/WorldLog.vue"],"sourcesContent":["<template>\n  <div class=\"world-log-container\">\n    <div class=\"log-header\">\n      <div class=\"log-title\">\n        <i class=\"el-icon-document\"></i>\n        <span>{{ title || '世界日志' }}</span>\n      </div>\n      <div class=\"log-actions\">\n        <el-select \n          v-model=\"selectedServer\" \n          placeholder=\"选择服务器\" \n          size=\"small\"\n          @change=\"handleServerChange\">\n          <el-option\n            v-for=\"server in servers\"\n            :key=\"server.id\"\n            :label=\"server.name\"\n            :value=\"server.id\">\n          </el-option>\n        </el-select>\n        <el-button \n          size=\"small\" \n          type=\"primary\" \n          icon=\"el-icon-refresh\" \n          @click=\"refreshLog\"\n          :loading=\"loading\">\n          刷新\n        </el-button>\n      </div>\n    </div>\n    <div class=\"log-content\">\n      <div ref=\"terminal\" class=\"terminal-container\"></div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Terminal } from 'xterm';\nimport { FitAddon } from 'xterm-addon-fit';\nimport 'xterm/css/xterm.css';\n\nexport default {\n  name: 'WorldLog',\n  props: {\n    title: {\n      type: String,\n      default: '世界日志'\n    },\n    serverId: {\n      type: [String, Number],\n      default: null\n    }\n  },\n  data() {\n    return {\n      terminal: null,\n      fitAddon: null,\n      selectedServer: null,\n      loading: false,\n      servers: [\n        { id: 1, name: '主世界服务器' },\n        { id: 2, name: '洞穴服务器' },\n        { id: 3, name: 'MOD测试服务器' },\n        { id: 4, name: '活动服务器' },\n        { id: 5, name: '开发测试服务器' }\n      ],\n      logContent: ''\n    };\n  },\n  mounted() {\n    this.initTerminal();\n    if (this.serverId) {\n      this.selectedServer = this.serverId;\n      this.loadLog();\n    }\n    \n    // 监听窗口大小变化，调整终端大小\n    window.addEventListener('resize', this.onResize);\n  },\n  beforeDestroy() {\n    // 清理事件监听\n    window.removeEventListener('resize', this.onResize);\n    // 销毁终端\n    if (this.terminal) {\n      this.terminal.dispose();\n    }\n  },\n  methods: {\n    initTerminal() {\n      // 创建终端实例\n      this.terminal = new Terminal({\n        cursorBlink: false,\n        disableStdin: true, // 禁用输入\n        fontSize: 14,\n        fontFamily: 'Menlo, Monaco, \"Courier New\", monospace',\n        theme: {\n          background: '#1e1e1e',\n          foreground: '#f0f0f0',\n          cursor: 'transparent'\n        },\n        rendererType: 'canvas',\n        scrollback: 5000\n      });\n      \n      // 创建自适应插件\n      this.fitAddon = new FitAddon();\n      this.terminal.loadAddon(this.fitAddon);\n      \n      // 挂载终端\n      this.terminal.open(this.$refs.terminal);\n      \n      // 调整大小\n      this.$nextTick(() => {\n        this.fitAddon.fit();\n      });\n      \n      // 写入欢迎信息\n      this.terminal.writeln('\\x1B[1;3;36m欢迎使用饥荒联机版服务器日志查看器\\x1B[0m');\n      this.terminal.writeln('\\x1B[90m请选择一个服务器以查看其日志记录...\\x1B[0m');\n      this.terminal.writeln('');\n    },\n    \n    handleServerChange() {\n      this.loadLog();\n    },\n    \n    onResize() {\n      if (this.fitAddon) {\n        this.fitAddon.fit();\n      }\n    },\n    \n    refreshLog() {\n      if (this.selectedServer) {\n        this.loadLog();\n      } else {\n        this.$message.warning('请先选择一个服务器');\n      }\n    },\n    \n    loadLog() {\n      if (!this.selectedServer) return;\n      \n      this.loading = true;\n      \n      // 清空终端内容\n      this.terminal.clear();\n      \n      // 模拟API调用获取日志\n      setTimeout(() => {\n        // 获取所选服务器的信息\n        const server = this.servers.find(s => s.id === this.selectedServer);\n        \n        // 写入日志标题\n        this.terminal.writeln(`\\x1B[1;32m=== ${server.name} 日志记录 ===\\x1B[0m`);\n        this.terminal.writeln('');\n        \n        // 模拟日志内容\n        const logs = this.generateSampleLogs(server.name);\n        \n        // 逐行写入日志\n        logs.forEach(log => {\n          this.terminal.writeln(log);\n        });\n        \n        this.loading = false;\n      }, 800);\n    },\n    \n    generateSampleLogs(serverName) {\n      // 模拟日志内容\n      const currentDate = new Date();\n      const logs = [];\n      \n      // 生成20条模拟日志\n      for (let i = 20; i >= 0; i--) {\n        const time = new Date(currentDate - i * 60000);\n        const timeStr = `[${time.getHours().toString().padStart(2, '0')}:${time.getMinutes().toString().padStart(2, '0')}:${time.getSeconds().toString().padStart(2, '0')}]`;\n        \n        let logLine;\n        const logType = Math.floor(Math.random() * 5);\n        \n        switch (logType) {\n          case 0:\n            logLine = `${timeStr} \\x1B[32m[INFO]\\x1B[0m 玩家 \"Player${Math.floor(Math.random() * 100)}\" 加入了游戏`;\n            break;\n          case 1:\n            logLine = `${timeStr} \\x1B[32m[INFO]\\x1B[0m 玩家 \"Player${Math.floor(Math.random() * 100)}\" 离开了游戏`;\n            break;\n          case 2:\n            logLine = `${timeStr} \\x1B[33m[WARN]\\x1B[0m 世界进入第 ${Math.floor(Math.random() * 365) + 1} 天`;\n            break;\n          case 3:\n            logLine = `${timeStr} \\x1B[36m[SYSTEM]\\x1B[0m 世界状态已保存`;\n            break;\n          case 4:\n            logLine = `${timeStr} \\x1B[35m[EVENT]\\x1B[0m 季节变更为 ${['春季', '夏季', '秋季', '冬季'][Math.floor(Math.random() * 4)]}`;\n            break;\n        }\n        \n        logs.push(logLine);\n      }\n      \n      return logs;\n    }\n  }\n};\n</script>\n\n<style scoped>\n.world-log-container {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  border-radius: 4px;\n  overflow: hidden;\n  background: #f5f7fa;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n}\n\n.log-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 15px;\n  background: #ffffff;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.log-title {\n  display: flex;\n  align-items: center;\n  font-size: 16px;\n  font-weight: bold;\n  color: #303133;\n}\n\n.log-title i {\n  margin-right: 8px;\n  color: #409EFF;\n}\n\n.log-actions {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.log-content {\n  flex: 1;\n  overflow: hidden;\n  padding: 10px;\n  background: #1e1e1e;\n}\n\n.terminal-container {\n  width: 100%;\n  height: 100%;\n  background: #1e1e1e;\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n/* 自定义下拉选择器样式 */\n:deep(.el-select) {\n  width: 150px;\n}\n\n/* 自定义按钮样式 */\n:deep(.el-button) {\n  padding: 8px 15px;\n}\n\n/* 显示滚动条的自定义样式 */\n:deep(.xterm-viewport::-webkit-scrollbar) {\n  width: 6px;\n  height: 6px;\n}\n\n:deep(.xterm-viewport::-webkit-scrollbar-thumb) {\n  background: rgba(144, 147, 153, 0.3);\n  border-radius: 3px;\n}\n\n:deep(.xterm-viewport::-webkit-scrollbar-track) {\n  background: transparent;\n}\n\n:deep(.xterm-viewport:hover::-webkit-scrollbar-thumb) {\n  background: rgba(144, 147, 153, 0.5);\n}\n</style> "],"mappings":";;;;AAqCA,SAAAA,QAAA;AACA,SAAAC,QAAA;AACA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,KAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,QAAA;MACAH,IAAA,GAAAC,MAAA,EAAAG,MAAA;MACAF,OAAA;IACA;EACA;EACAG,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;MACAC,cAAA;MACAC,OAAA;MACAC,OAAA,GACA;QAAAC,EAAA;QAAAd,IAAA;MAAA,GACA;QAAAc,EAAA;QAAAd,IAAA;MAAA,GACA;QAAAc,EAAA;QAAAd,IAAA;MAAA,GACA;QAAAc,EAAA;QAAAd,IAAA;MAAA,GACA;QAAAc,EAAA;QAAAd,IAAA;MAAA,EACA;MACAe,UAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,YAAA;IACA,SAAAX,QAAA;MACA,KAAAK,cAAA,QAAAL,QAAA;MACA,KAAAY,OAAA;IACA;;IAEA;IACAC,MAAA,CAAAC,gBAAA,gBAAAC,QAAA;EACA;EACAC,cAAA;IACA;IACAH,MAAA,CAAAI,mBAAA,gBAAAF,QAAA;IACA;IACA,SAAAZ,QAAA;MACA,KAAAA,QAAA,CAAAe,OAAA;IACA;EACA;EACAC,OAAA;IACAR,aAAA;MACA;MACA,KAAAR,QAAA,OAAAX,QAAA;QACA4B,WAAA;QACAC,YAAA;QAAA;QACAC,QAAA;QACAC,UAAA;QACAC,KAAA;UACAC,UAAA;UACAC,UAAA;UACAC,MAAA;QACA;QACAC,YAAA;QACAC,UAAA;MACA;;MAEA;MACA,KAAAzB,QAAA,OAAAX,QAAA;MACA,KAAAU,QAAA,CAAA2B,SAAA,MAAA1B,QAAA;;MAEA;MACA,KAAAD,QAAA,CAAA4B,IAAA,MAAAC,KAAA,CAAA7B,QAAA;;MAEA;MACA,KAAA8B,SAAA;QACA,KAAA7B,QAAA,CAAA8B,GAAA;MACA;;MAEA;MACA,KAAA/B,QAAA,CAAAgC,OAAA;MACA,KAAAhC,QAAA,CAAAgC,OAAA;MACA,KAAAhC,QAAA,CAAAgC,OAAA;IACA;IAEAC,mBAAA;MACA,KAAAxB,OAAA;IACA;IAEAG,SAAA;MACA,SAAAX,QAAA;QACA,KAAAA,QAAA,CAAA8B,GAAA;MACA;IACA;IAEAG,WAAA;MACA,SAAAhC,cAAA;QACA,KAAAO,OAAA;MACA;QACA,KAAA0B,QAAA,CAAAC,OAAA;MACA;IACA;IAEA3B,QAAA;MACA,UAAAP,cAAA;MAEA,KAAAC,OAAA;;MAEA;MACA,KAAAH,QAAA,CAAAqC,KAAA;;MAEA;MACAC,UAAA;QACA;QACA,MAAAC,MAAA,QAAAnC,OAAA,CAAAoC,IAAA,CAAAC,CAAA,IAAAA,CAAA,CAAApC,EAAA,UAAAH,cAAA;;QAEA;QACA,KAAAF,QAAA,CAAAgC,OAAA,kBAAAO,MAAA,CAAAhD,IAAA;QACA,