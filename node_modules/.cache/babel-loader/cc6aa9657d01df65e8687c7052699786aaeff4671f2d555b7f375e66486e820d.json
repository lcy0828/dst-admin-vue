{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'ServerList',\n  data() {\n    return {\n      loading: false,\n      serverList: [{\n        id: 1,\n        name: '主世界服务器',\n        address: '192.168.1.100:10999',\n        type: '主世界服务器',\n        version: 'v0.525842',\n        status: 'online',\n        uptime: '5天12小时',\n        memory: 45,\n        cpu: 28,\n        season: '夏',\n        autoStart: true,\n        players: [{\n          id: 1,\n          name: '猪王爱烤肉',\n          role: '薇诺娜',\n          time: '3小时25分'\n        }, {\n          id: 2,\n          name: '沃利大厨',\n          role: '沃利',\n          time: '2小时10分'\n        }]\n      }, {\n        id: 2,\n        name: '洞穴服务器',\n        address: '192.168.1.100:11000',\n        type: '洞穴服务器',\n        version: 'v0.525842',\n        status: 'online',\n        uptime: '5天12小时',\n        memory: 38,\n        cpu: 22,\n        season: '',\n        autoStart: true,\n        players: [{\n          id: 3,\n          name: '麦斯威尔',\n          role: '麦斯威尔',\n          time: '1小时40分'\n        }]\n      }, {\n        id: 3,\n        name: '模组服务器',\n        address: '192.168.1.100:11001',\n        type: '模组服务器',\n        version: 'v0.525842',\n        status: 'restarting',\n        uptime: '0分钟',\n        memory: 15,\n        cpu: 85,\n        season: '秋',\n        autoStart: true,\n        players: []\n      }, {\n        id: 4,\n        name: 'PVP服务器',\n        address: '192.168.1.100:11002',\n        type: 'PVP服务器',\n        version: 'v0.525842',\n        status: 'offline',\n        uptime: '0分钟',\n        memory: 0,\n        cpu: 0,\n        season: '冬',\n        autoStart: false,\n        players: []\n      }],\n      selectedServers: [],\n      dialogVisible: false,\n      dialogTitle: '添加服务器',\n      serverForm: {\n        id: null,\n        name: '',\n        address: '',\n        type: '主世界服务器',\n        version: 'v0.525842',\n        status: 'offline',\n        uptime: '0分钟',\n        memory: 0,\n        cpu: 0,\n        season: '',\n        autoStart: true,\n        players: []\n      },\n      serverRules: {\n        name: [{\n          required: true,\n          message: '请输入服务器名称',\n          trigger: 'blur'\n        }],\n        address: [{\n          required: true,\n          message: '请输入服务器地址',\n          trigger: 'blur'\n        }],\n        type: [{\n          required: true,\n          message: '请选择服务器类型',\n          trigger: 'change'\n        }],\n        version: [{\n          required: true,\n          message: '请输入游戏版本',\n          trigger: 'blur'\n        }]\n      },\n      playersVisible: false,\n      currentServer: null\n    };\n  },\n  computed: {\n    hasSelection() {\n      return this.selectedServers.length > 0;\n    }\n  },\n  mounted() {\n    this.loading = true;\n    setTimeout(() => {\n      this.loading = false;\n    }, 800);\n  },\n  methods: {\n    refreshData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.$message({\n          message: '服务器数据已刷新',\n          type: 'success'\n        });\n        this.loading = false;\n      }, 800);\n    },\n    handleSelectionChange(val) {\n      this.selectedServers = val;\n    },\n    getStatusType(status) {\n      const statusMap = {\n        'online': 'success',\n        'offline': 'info',\n        'restarting': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    getStatusText(status) {\n      const statusMap = {\n        'online': '在线',\n        'offline': '离线',\n        'restarting': '重启中'\n      };\n      return statusMap[status] || status;\n    },\n    getServerTypeTag(type) {\n      const typeMap = {\n        '主世界服务器': 'primary',\n        '洞穴服务器': 'success',\n        '模组服务器': 'warning',\n        'PVP服务器': 'danger'\n      };\n      return typeMap[type] || '';\n    },\n    tableRowClassName({\n      row\n    }) {\n      if (row.status === 'offline') {\n        return 'server-row-offline';\n      } else if (row.status === 'restarting') {\n        return 'server-row-restarting';\n      }\n      return '';\n    },\n    getMemoryStatus(value) {\n      if (value > 80) return 'exception';\n      if (value > 60) return 'warning';\n      return 'success';\n    },\n    getCpuStatus(value) {\n      if (value > 80) return 'exception';\n      if (value > 60) return 'warning';\n      return 'success';\n    },\n    canRestart(row) {\n      return row.status !== 'restarting';\n    },\n    handleEdit(row) {\n      this.dialogTitle = '编辑服务器';\n      this.serverForm = {\n        ...row\n      };\n      this.dialogVisible = true;\n    },\n    handleRestart(row) {\n      this.$confirm(`确定要重启服务器 \"${row.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        // 模拟重启操作\n        const index = this.serverList.findIndex(s => s.id === row.id);\n        if (index !== -1) {\n          this.serverList[index].status = 'restarting';\n          setTimeout(() => {\n            this.serverList[index].status = 'online';\n            this.serverList[index].uptime = '0分钟';\n            this.loading = false;\n            this.$message({\n              type: 'success',\n              message: `服务器 ${row.name} 已重启成功！`\n            });\n          }, 3000);\n        }\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消重启'\n        });\n      });\n    },\n    handleStop(row) {\n      this.$confirm(`确定要停止服务器 \"${row.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        // 模拟停止操作\n        const index = this.serverList.findIndex(s => s.id === row.id);\n        if (index !== -1) {\n          setTimeout(() => {\n            this.serverList[index].status = 'offline';\n            this.serverList[index].uptime = '0分钟';\n            this.serverList[index].memory = 0;\n            this.serverList[index].cpu = 0;\n            this.serverList[index].players = [];\n            this.loading = false;\n            this.$message({\n              type: 'success',\n              message: `服务器 ${row.name} 已停止！`\n            });\n          }, 1500);\n        }\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消停止'\n        });\n      });\n    },\n    handleDelete(row) {\n      this.$confirm(`确定要删除服务器 \"${row.name}\" 吗? 此操作将无法恢复!`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟删除操作\n        this.loading = true;\n        setTimeout(() => {\n          this.serverList = this.serverList.filter(s => s.id !== row.id);\n          this.loading = false;\n          this.$message({\n            type: 'success',\n            message: `服务器 ${row.name} 已删除！`\n          });\n        }, 800);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消删除'\n        });\n      });\n    },\n    handleBatchRestart() {\n      if (this.selectedServers.length === 0) return;\n      const names = this.selectedServers.map(s => s.name).join('、');\n      this.$confirm(`确定要重启所选的 ${this.selectedServers.length} 台服务器吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        // 模拟批量重启\n        setTimeout(() => {\n          this.selectedServers.forEach(selected => {\n            const index = this.serverList.findIndex(s => s.id === selected.id);\n            if (index !== -1 && this.serverList[index].status !== 'offline') {\n              this.serverList[index].status = 'restarting';\n              setTimeout(() => {\n                this.serverList[index].status = 'online';\n                this.serverList[index].uptime = '0分钟';\n              }, 2000 + Math.random() * 3000);\n            }\n          });\n          this.loading = false;\n          this.$message({\n            type: 'success',\n            message: `已开始重启所选服务器！`\n          });\n        }, 1000);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleBatchStop() {\n      if (this.selectedServers.length === 0) return;\n      const names = this.selectedServers.map(s => s.name).join('、');\n      this.$confirm(`确定要停止所选的 ${this.selectedServers.length} 台服务器吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        // 模拟批量停止\n        setTimeout(() => {\n          this.selectedServers.forEach(selected => {\n            const index = this.serverList.findIndex(s => s.id === selected.id);\n            if (index !== -1 && this.serverList[index].status !== 'offline') {\n              this.serverList[index].status = 'offline';\n              this.serverList[index].uptime = '0分钟';\n              this.serverList[index].memory = 0;\n              this.serverList[index].cpu = 0;\n              this.serverList[index].players = [];\n            }\n          });\n          this.loading = false;\n          this.$message({\n            type: 'success',\n            message: `已停止所选服务器！`\n          });\n        }, 1000);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    copyAddress(address) {\n      // 模拟复制到剪贴板\n      this.$message({\n        message: `已复制地址: ${address}`,\n        type: 'success'\n      });\n    },\n    showPlayers(row) {\n      this.currentServer = row;\n      this.playersVisible = true;\n    },\n    handleMessage(player) {\n      this.$prompt(`发送消息给玩家 ${player.name}`, '私信', {\n        confirmButtonText: '发送',\n        cancelButtonText: '取消',\n        inputPlaceholder: '请输入消息内容'\n      }).then(({\n        value\n      }) => {\n        this.$message({\n          type: 'success',\n          message: `消息已发送给 ${player.name}！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消发送'\n        });\n      });\n    },\n    handleKick(player) {\n      this.$confirm(`确定要将玩家 \"${player.name}\" 踢出服务器吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 从当前服务器玩家列表中移除该玩家\n        if (this.currentServer) {\n          this.currentServer.players = this.currentServer.players.filter(p => p.id !== player.id);\n\n          // 更新原服务器列表中的数据\n          const index = this.serverList.findIndex(s => s.id === this.currentServer.id);\n          if (index !== -1) {\n            this.serverList[index].players = [...this.currentServer.players];\n          }\n          this.$message({\n            type: 'success',\n            message: `已将玩家 ${player.name} 踢出服务器！`\n          });\n        }\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleCommand(command, row) {\n      switch (command) {\n        case 'console':\n          this.$message({\n            message: `正在打开 ${row.name} 的控制台`,\n            type: 'info'\n          });\n          break;\n        case 'backup':\n          this.$message({\n            message: `正在备份 ${row.name} 的存档`,\n            type: 'info'\n          });\n          break;\n        case 'mods':\n          this.$router.push('/mods/list');\n          break;\n        case 'settings':\n          this.$router.push('/servers/settings');\n          break;\n        case 'logs':\n          this.$message({\n            message: `正在查看 ${row.name} 的日志`,\n            type: 'info'\n          });\n          break;\n      }\n    },\n    submitServerForm() {\n      this.$refs.serverForm.validate(valid => {\n        if (valid) {\n          this.loading = true;\n          setTimeout(() => {\n            if (this.serverForm.id) {\n              // 编辑现有服务器\n              const index = this.serverList.findIndex(s => s.id === this.serverForm.id);\n              if (index !== -1) {\n                this.serverList[index] = {\n                  ...this.serverForm\n                };\n                this.$message({\n                  message: `服务器 ${this.serverForm.name} 信息已更新`,\n                  type: 'success'\n                });\n              }\n            } else {\n              // 添加新服务器\n              const newServer = {\n                ...this.serverForm,\n                id: this.serverList.length + 1,\n                status: 'offline',\n                uptime: '0分钟',\n                memory: 0,\n                cpu: 0,\n                players: []\n              };\n              this.serverList.push(newServer);\n              this.$message({\n                message: `服务器 ${newServer.name} 已添加`,\n                type: 'success'\n              });\n            }\n            this.dialogVisible = false;\n            this.loading = false;\n          }, 800);\n        } else {\n          return false;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","loading","serverList","id","address","type","version","status","uptime","memory","cpu","season","autoStart","players","role","time","selectedServers","dialogVisible","dialogTitle","serverForm","serverRules","required","message","trigger","playersVisible","currentServer","computed","hasSelection","length","mounted","setTimeout","methods","refreshData","$message","handleSelectionChange","val","getStatusType","statusMap","getStatusText","getServerTypeTag","typeMap","tableRowClassName","row","getMemoryStatus","value","getCpuStatus","canRestart","handleEdit","handleRestart","$confirm","confirmButtonText","cancelButtonText","then","index","findIndex","s","catch","handleStop","handleDelete","filter","handleBatchRestart","names","map","join","forEach","selected","Math","random","handleBatchStop","copyAddress","showPlayers","handleMessage","player","$prompt","inputPlaceholder","handleKick","p","handleCommand","command","$router","push","submitServerForm","$refs","validate","valid","newServer"],"sources":["src/views/servers/ServerList.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card class=\"main-card\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>服务器管理</span>\n        <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"refreshData\">刷新</el-button>\n      </div>\n\n      <!-- 工具栏 -->\n      <div class=\"tool-bar\">\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"dialogVisible = true\">添加服务器</el-button>\n        <el-button type=\"success\" icon=\"el-icon-refresh\" @click=\"handleBatchRestart\" :disabled=\"!hasSelection\">批量重启</el-button>\n        <el-button type=\"warning\" icon=\"el-icon-turn-off\" @click=\"handleBatchStop\" :disabled=\"!hasSelection\">批量关闭</el-button>\n      </div>\n\n      <!-- 服务器表格 -->\n      <el-table\n        :data=\"serverList\"\n        v-loading=\"loading\"\n        style=\"width: 100%\"\n        border\n        @selection-change=\"handleSelectionChange\"\n        :row-class-name=\"tableRowClassName\"\n        highlight-current-row>\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n        <el-table-column label=\"服务器\" min-width=\"240\">\n          <template slot-scope=\"scope\">\n            <div class=\"server-name\">\n              <el-tag size=\"small\" :type=\"getStatusType(scope.row.status)\" class=\"status-tag\">\n                {{ getStatusText(scope.row.status) }}\n              </el-tag>\n              <span class=\"server-title\">{{ scope.row.name }}</span>\n              <el-tag size=\"small\" type=\"warning\" v-if=\"scope.row.season\" class=\"season-tag\">{{ scope.row.season }}</el-tag>\n            </div>\n            <div class=\"server-address\">\n              <i class=\"el-icon-position\"></i>\n              <span>{{ scope.row.address }}</span>\n              <el-button size=\"mini\" type=\"text\" @click=\"copyAddress(scope.row.address)\">复制</el-button>\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"type\" label=\"类型\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-tag size=\"medium\" :type=\"getServerTypeTag(scope.row.type)\">{{ scope.row.type }}</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"version\" label=\"版本\" width=\"100\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"players\" label=\"在线玩家\" width=\"100\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-badge :value=\"scope.row.players.length\" :max=\"99\" class=\"player-badge\">\n              <el-button size=\"small\" icon=\"el-icon-user\" circle @click=\"showPlayers(scope.row)\"></el-button>\n            </el-badge>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"uptime\" label=\"运行时间\" width=\"120\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"memory\" label=\"内存使用\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-progress :percentage=\"scope.row.memory\" :format=\"format => `${format}%`\" :status=\"getMemoryStatus(scope.row.memory)\"></el-progress>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"cpu\" label=\"CPU使用\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-progress :percentage=\"scope.row.cpu\" :format=\"format => `${format}%`\" :status=\"getCpuStatus(scope.row.cpu)\"></el-progress>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"280\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" icon=\"el-icon-edit\" @click=\"handleEdit(scope.row)\"></el-button>\n            <el-button size=\"mini\" type=\"success\" icon=\"el-icon-refresh\" @click=\"handleRestart(scope.row)\" :disabled=\"!canRestart(scope.row)\"></el-button>\n            <el-button size=\"mini\" type=\"warning\" icon=\"el-icon-video-pause\" @click=\"handleStop(scope.row)\" :disabled=\"scope.row.status === 'offline'\"></el-button>\n            <el-button size=\"mini\" type=\"danger\" icon=\"el-icon-delete\" @click=\"handleDelete(scope.row)\"></el-button>\n            <el-dropdown trigger=\"click\" @command=\"handleCommand($event, scope.row)\">\n              <el-button size=\"mini\" type=\"info\">\n                更多<i class=\"el-icon-arrow-down el-icon--right\"></i>\n              </el-button>\n              <el-dropdown-menu slot=\"dropdown\">\n                <el-dropdown-item command=\"console\">控制台</el-dropdown-item>\n                <el-dropdown-item command=\"backup\" :disabled=\"scope.row.status === 'offline'\">备份存档</el-dropdown-item>\n                <el-dropdown-item command=\"mods\">模组管理</el-dropdown-item>\n                <el-dropdown-item command=\"settings\">服务器设置</el-dropdown-item>\n                <el-dropdown-item command=\"logs\" divided>查看日志</el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n\n    <!-- 添加/编辑服务器对话框 -->\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"600px\">\n      <el-form :model=\"serverForm\" :rules=\"serverRules\" ref=\"serverForm\" label-width=\"100px\">\n        <el-form-item label=\"服务器名称\" prop=\"name\">\n          <el-input v-model=\"serverForm.name\" placeholder=\"请输入服务器名称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"服务器地址\" prop=\"address\">\n          <el-input v-model=\"serverForm.address\" placeholder=\"请输入服务器地址\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"服务器类型\" prop=\"type\">\n          <el-select v-model=\"serverForm.type\" placeholder=\"请选择服务器类型\" style=\"width: 100%\">\n            <el-option label=\"主世界服务器\" value=\"主世界服务器\"></el-option>\n            <el-option label=\"洞穴服务器\" value=\"洞穴服务器\"></el-option>\n            <el-option label=\"模组服务器\" value=\"模组服务器\"></el-option>\n            <el-option label=\"PVP服务器\" value=\"PVP服务器\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"游戏版本\" prop=\"version\">\n          <el-input v-model=\"serverForm.version\" placeholder=\"请输入游戏版本\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"当前季节\" prop=\"season\">\n          <el-select v-model=\"serverForm.season\" placeholder=\"请选择当前季节\" style=\"width: 100%\">\n            <el-option label=\"春\" value=\"春\"></el-option>\n            <el-option label=\"夏\" value=\"夏\"></el-option>\n            <el-option label=\"秋\" value=\"秋\"></el-option>\n            <el-option label=\"冬\" value=\"冬\"></el-option>\n            <el-option label=\"无\" value=\"\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"自动启动\">\n          <el-switch v-model=\"serverForm.autoStart\"></el-switch>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitServerForm\">确认</el-button>\n      </span>\n    </el-dialog>\n\n    <!-- 在线玩家对话框 -->\n    <el-dialog title=\"在线玩家\" :visible.sync=\"playersVisible\" width=\"500px\">\n      <div v-if=\"currentServer && currentServer.players.length === 0\" class=\"empty-players\">\n        <i class=\"el-icon-warning-outline\"></i>\n        <p>当前服务器没有在线玩家</p>\n      </div>\n      <el-table v-else :data=\"currentServer ? currentServer.players : []\" style=\"width: 100%\">\n        <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n        <el-table-column prop=\"role\" label=\"角色\"></el-table-column>\n        <el-table-column prop=\"time\" label=\"在线时长\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"150\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button size=\"mini\" type=\"success\" @click=\"handleMessage(scope.row)\">私信</el-button>\n            <el-button size=\"mini\" type=\"warning\" @click=\"handleKick(scope.row)\">踢出</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"playersVisible = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'ServerList',\n  data() {\n    return {\n      loading: false,\n      serverList: [\n        {\n          id: 1,\n          name: '主世界服务器',\n          address: '192.168.1.100:10999',\n          type: '主世界服务器',\n          version: 'v0.525842',\n          status: 'online',\n          uptime: '5天12小时',\n          memory: 45,\n          cpu: 28,\n          season: '夏',\n          autoStart: true,\n          players: [\n            { id: 1, name: '猪王爱烤肉', role: '薇诺娜', time: '3小时25分' },\n            { id: 2, name: '沃利大厨', role: '沃利', time: '2小时10分' }\n          ]\n        },\n        {\n          id: 2,\n          name: '洞穴服务器',\n          address: '192.168.1.100:11000',\n          type: '洞穴服务器',\n          version: 'v0.525842',\n          status: 'online',\n          uptime: '5天12小时',\n          memory: 38,\n          cpu: 22,\n          season: '',\n          autoStart: true,\n          players: [\n            { id: 3, name: '麦斯威尔', role: '麦斯威尔', time: '1小时40分' }\n          ]\n        },\n        {\n          id: 3,\n   