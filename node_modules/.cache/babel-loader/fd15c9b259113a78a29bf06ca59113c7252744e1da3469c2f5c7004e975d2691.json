{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { roomApi } from '../../api/index';\nexport default {\n  name: 'RoomList',\n  data() {\n    return {\n      loading: false,\n      searchQuery: '',\n      statusFilter: 'all',\n      rooms: []\n    };\n  },\n  computed: {\n    filteredRooms() {\n      let result = this.rooms;\n\n      // 按状态筛选\n      if (this.statusFilter !== 'all') {\n        const status = this.statusFilter === 'open' ? '开放' : '关闭';\n        result = result.filter(room => room.status === status);\n      }\n\n      // 按搜索查询筛选\n      if (this.searchQuery) {\n        const query = this.searchQuery.toLowerCase();\n        result = result.filter(room => room.name.toLowerCase().includes(query));\n      }\n      return result;\n    }\n  },\n  methods: {\n    getStyleColor(style) {\n      const colors = {\n        default: '#f9f9f9',\n        dark: '#333333',\n        forest: '#2c7744',\n        desert: '#e8c07d',\n        winter: '#a8d8ff',\n        cave: '#514b4a'\n      };\n      return colors[style] || colors.default;\n    },\n    refreshRooms() {\n      this.loading = true;\n      roomApi.getRoomList().then(response => {\n        if (response.status === 200 && Array.isArray(response.data)) {\n          // 将API返回的数据转换为组件需要的格式\n          this.rooms = response.data.map(item => ({\n            id: item.name,\n            // 使用房间名称作为ID\n            name: item.name,\n            savepath: item.savepath,\n            players: '0/0',\n            // 默认值，后续可能需要从其他API获取\n            mode: '生存模式',\n            // 默认值\n            style: 'default',\n            // 默认风格\n            styleName: '默认风格',\n            status: '关闭',\n            // 默认状态，后续可能需要从其他API获取\n            description: `房间保存路径: ${item.savepath}`\n          }));\n          this.$message({\n            message: '房间列表已刷新',\n            type: 'success'\n          });\n        } else {\n          this.$message.error('获取房间列表失败，返回数据格式不正确');\n        }\n      }).catch(error => {\n        this.$message.error('获取房间列表失败: ' + error.message);\n      }).finally(() => {\n        this.loading = false;\n      });\n    },\n    createRoom() {\n      this.$router.push('/rooms/settings');\n    },\n    editRoom(room) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: {\n          id: room.id\n        }\n      });\n    },\n    shutdownRoom(room) {\n      this.$confirm(`确定要关闭房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.stopRoom(room.id).then(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms[index].status = '关闭';\n          }\n          this.$message({\n            message: `房间 ${room.name} 已关闭`,\n            type: 'success'\n          });\n        }).catch(error => {\n          this.$message.error(`关闭房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    startRoom(room) {\n      this.$confirm(`确定要开启房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.startRoom(room.id).then(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms[index].status = '开放';\n          }\n          this.$message({\n            message: `房间 ${room.name} 已开启`,\n            type: 'success'\n          });\n        }).catch(error => {\n          this.$message.error(`开启房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleRowClick(row) {\n      // 点击行跳转到详情页\n      this.$router.push({\n        path: '/rooms/settings',\n        query: {\n          id: row.id\n        }\n      });\n    },\n    handleMoreCommands(command, room) {\n      switch (command) {\n        case 'duplicate':\n          this.duplicateRoom(room);\n          break;\n        case 'backup':\n          this.backupRoom(room);\n          break;\n        case 'delete':\n          this.deleteRoom(room);\n          break;\n      }\n    },\n    duplicateRoom(room) {\n      this.$prompt('请输入新房间名称', '复制房间', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        inputPattern: /^[a-zA-Z0-9_]+$/,\n        inputErrorMessage: '房间名称只能包含字母、数字和下划线'\n      }).then(({\n        value\n      }) => {\n        this.loading = true;\n        roomApi.duplicateRoom(room.id, {\n          name: value\n        }).then(() => {\n          this.$message({\n            type: 'success',\n            message: `已复制房间 ${room.name} 到 ${value}`\n          });\n          this.refreshRooms(); // 刷新列表以显示新房间\n        }).catch(error => {\n          this.$message.error(`复制房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    backupRoom(room) {\n      this.$confirm(`确定要备份房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'info'\n      }).then(() => {\n        this.loading = true;\n        roomApi.backupRoom(room.id).then(() => {\n          this.$message({\n            type: 'success',\n            message: `房间 ${room.name} 备份已创建`\n          });\n        }).catch(error => {\n          this.$message.error(`备份房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    deleteRoom(room) {\n      this.$confirm(`确定要删除房间 \"${room.name}\" 吗？此操作不可恢复!`, '警告', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.deleteRoom(room.id).then(() => {\n          // 从本地列表中移除\n          this.rooms = this.rooms.filter(r => r.id !== room.id);\n          this.$message({\n            type: 'success',\n            message: `房间 ${room.name} 已删除`\n          });\n        }).catch(error => {\n          this.$message.error(`删除房间失败: ${error.message}`);\n        }).finally(() => {\n          this.loading = false;\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    }\n  },\n  mounted() {\n    this.refreshRooms();\n  }\n};","map":{"version":3,"names":["roomApi","name","data","loading","searchQuery","statusFilter","rooms","computed","filteredRooms","result","status","filter","room","query","toLowerCase","includes","methods","getStyleColor","style","colors","default","dark","forest","desert","winter","cave","refreshRooms","getRoomList","then","response","Array","isArray","map","item","id","savepath","players","mode","styleName","description","$message","message","type","error","catch","finally","createRoom","$router","push","editRoom","path","shutdownRoom","$confirm","confirmButtonText","cancelButtonText","stopRoom","index","findIndex","r","startRoom","handleRowClick","row","handleMoreCommands","command","duplicateRoom","backupRoom","deleteRoom","$prompt","inputPattern","inputErrorMessage","value","mounted"],"sources":["src/views/rooms/RoomList.vue"],"sourcesContent":["<template>\n  <div class=\"room-list-page\">\n    <div class=\"page-header\">\n      <h2>房间列表</h2>\n      <div class=\"header-actions\">\n        <el-input\n          placeholder=\"搜索房间\"\n          v-model=\"searchQuery\"\n          class=\"search-input\"\n          prefix-icon=\"el-icon-search\"\n          clearable>\n        </el-input>\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"createRoom\">创建房间</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"room-list-card\">\n      <div slot=\"header\" class=\"card-header\">\n        <span>所有房间</span>\n        <div>\n          <el-radio-group v-model=\"statusFilter\" size=\"small\">\n            <el-radio-button label=\"all\">全部</el-radio-button>\n            <el-radio-button label=\"open\">开放</el-radio-button>\n            <el-radio-button label=\"closed\">关闭</el-radio-button>\n          </el-radio-group>\n          <el-button style=\"margin-left: 10px;\" size=\"small\" icon=\"el-icon-refresh\" @click=\"refreshRooms\">刷新</el-button>\n        </div>\n      </div>\n      \n      <el-table\n        :data=\"filteredRooms\"\n        style=\"width: 100%\"\n        v-loading=\"loading\"\n        @row-click=\"handleRowClick\">\n        <el-table-column prop=\"name\" label=\"房间名称\">\n          <template slot-scope=\"scope\">\n            <div class=\"room-name\">\n              <div class=\"style-dot\" :style=\"{ backgroundColor: getStyleColor(scope.row.style) }\"></div>\n              {{ scope.row.name }}\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"players\" label=\"玩家数\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"mode\" label=\"游戏模式\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"style\" label=\"风格\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <div class=\"style-tag\" :class=\"'style-' + scope.row.style\">{{ scope.row.styleName }}</div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === '开放' ? 'success' : 'info'\" size=\"mini\">{{ scope.row.status }}</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\">\n          <template slot-scope=\"scope\">\n            <el-button \n              v-if=\"scope.row.status === '开放'\"\n              type=\"danger\" \n              size=\"mini\" \n              @click.stop=\"shutdownRoom(scope.row)\">关闭</el-button>\n            <el-button \n              v-else\n              type=\"success\" \n              size=\"mini\" \n              @click.stop=\"startRoom(scope.row)\">开启</el-button>\n            <el-button \n              type=\"primary\" \n              size=\"mini\" \n              @click.stop=\"editRoom(scope.row)\">编辑</el-button>\n            <el-dropdown trigger=\"click\" @command=\"handleMoreCommands($event, scope.row)\" @click.stop>\n              <el-button size=\"mini\">\n                更多<i class=\"el-icon-arrow-down el-icon--right\"></i>\n              </el-button>\n              <el-dropdown-menu slot=\"dropdown\">\n                <el-dropdown-item command=\"duplicate\">复制房间</el-dropdown-item>\n                <el-dropdown-item command=\"backup\">备份房间</el-dropdown-item>\n                <el-dropdown-item command=\"delete\" divided>\n                  <span style=\"color: #F56C6C;\">删除房间</span>\n                </el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { roomApi } from '../../api/index';\n\nexport default {\n  name: 'RoomList',\n  data() {\n    return {\n      loading: false,\n      searchQuery: '',\n      statusFilter: 'all',\n      rooms: []\n    }\n  },\n  computed: {\n    filteredRooms() {\n      let result = this.rooms;\n      \n      // 按状态筛选\n      if (this.statusFilter !== 'all') {\n        const status = this.statusFilter === 'open' ? '开放' : '关闭';\n        result = result.filter(room => room.status === status);\n      }\n      \n      // 按搜索查询筛选\n      if (this.searchQuery) {\n        const query = this.searchQuery.toLowerCase();\n        result = result.filter(room => \n          room.name.toLowerCase().includes(query)\n        );\n      }\n      \n      return result;\n    }\n  },\n  methods: {\n    getStyleColor(style) {\n      const colors = {\n        default: '#f9f9f9',\n        dark: '#333333',\n        forest: '#2c7744',\n        desert: '#e8c07d',\n        winter: '#a8d8ff',\n        cave: '#514b4a'\n      };\n      return colors[style] || colors.default;\n    },\n    refreshRooms() {\n      this.loading = true;\n      roomApi.getRoomList()\n        .then(response => {\n          if (response.status === 200 && Array.isArray(response.data)) {\n            // 将API返回的数据转换为组件需要的格式\n            this.rooms = response.data.map(item => ({\n              id: item.name, // 使用房间名称作为ID\n              name: item.name,\n              savepath: item.savepath,\n              players: '0/0', // 默认值，后续可能需要从其他API获取\n              mode: '生存模式', // 默认值\n              style: 'default', // 默认风格\n              styleName: '默认风格',\n              status: '关闭', // 默认状态，后续可能需要从其他API获取\n              description: `房间保存路径: ${item.savepath}`\n            }));\n            \n            this.$message({\n              message: '房间列表已刷新',\n              type: 'success'\n            });\n          } else {\n            this.$message.error('获取房间列表失败，返回数据格式不正确');\n          }\n        })\n        .catch(error => {\n          this.$message.error('获取房间列表失败: ' + error.message);\n        })\n        .finally(() => {\n          this.loading = false;\n        });\n    },\n    createRoom() {\n      this.$router.push('/rooms/settings');\n    },\n    editRoom(room) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: { id: room.id }\n      });\n    },\n    shutdownRoom(room) {\n      this.$confirm(`确定要关闭房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.stopRoom(room.id)\n          .then(() => {\n            // 更新本地数据\n            const index = this.rooms.findIndex(r => r.id === room.id);\n            if (index > -1) {\n              this.rooms[index].status = '关闭';\n            }\n            \n            this.$message({\n              message: `房间 ${room.name} 已关闭`,\n              type: 'success'\n            });\n          })\n          .catch(error => {\n            this.$message.error(`关闭房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    startRoom(room) {\n      this.$confirm(`确定要开启房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.startRoom(room.id)\n          .then(() => {\n            // 更新本地数据\n            const index = this.rooms.findIndex(r => r.id === room.id);\n            if (index > -1) {\n              this.rooms[index].status = '开放';\n            }\n            \n            this.$message({\n              message: `房间 ${room.name} 已开启`,\n              type: 'success'\n            });\n          })\n          .catch(error => {\n            this.$message.error(`开启房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleRowClick(row) {\n      // 点击行跳转到详情页\n      this.$router.push({\n        path: '/rooms/settings',\n        query: { id: row.id }\n      });\n    },\n    handleMoreCommands(command, room) {\n      switch (command) {\n        case 'duplicate':\n          this.duplicateRoom(room);\n          break;\n        case 'backup':\n          this.backupRoom(room);\n          break;\n        case 'delete':\n          this.deleteRoom(room);\n          break;\n      }\n    },\n    duplicateRoom(room) {\n      this.$prompt('请输入新房间名称', '复制房间', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        inputPattern: /^[a-zA-Z0-9_]+$/,\n        inputErrorMessage: '房间名称只能包含字母、数字和下划线'\n      }).then(({ value }) => {\n        this.loading = true;\n        roomApi.duplicateRoom(room.id, { name: value })\n          .then(() => {\n            this.$message({\n              type: 'success',\n              message: `已复制房间 ${room.name} 到 ${value}`,\n            });\n            this.refreshRooms(); // 刷新列表以显示新房间\n          })\n          .catch(error => {\n            this.$message.error(`复制房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    backupRoom(room) {\n      this.$confirm(`确定要备份房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'info'\n      }).then(() => {\n        this.loading = true;\n        roomApi.backupRoom(room.id)\n          .then(() => {\n            this.$message({\n              type: 'success',\n              message: `房间 ${room.name} 备份已创建`\n            });\n          })\n          .catch(error => {\n            this.$message.error(`备份房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    deleteRoom(room) {\n      this.$confirm(`确定要删除房间 \"${room.name}\" 吗？此操作不可恢复!`, '警告', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.loading = true;\n        roomApi.deleteRoom(room.id)\n          .then(() => {\n            // 从本地列表中移除\n            this.rooms = this.rooms.filter(r => r.id !== room.id);\n            this.$message({\n              type: 'success',\n              message: `房间 ${room.name} 已删除`\n            });\n          })\n          .catch(error => {\n            this.$message.error(`删除房间失败: ${error.message}`);\n          })\n          .finally(() => {\n            this.loading = false;\n          });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    }\n  },\n  mounted() {\n    this.refreshRooms();\n  }\n}\n</script>\n\n<style scoped>\n.room-list-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n}\n\n.search-input {\n  width: 250px;\n  margin-right: 15px;\n}\n\n.room-list-card {\n  margin-bottom: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.room-name {\n  display: flex;\n  align-items: center;\n}\n\n.style-dot {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  margin-right: 10px;\n  border: 1px solid #DCDFE6;\n}\n\n.style-tag {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-size: 12px;\n}\n\n.style-default {\n  background-color: #f9f9f9;\n  color: #333333;\n  border: 1px solid #dcdfe6;\n}\n\n.style-dark {\n  background-color: #333333;\n  color: #ffffff;\n}\n\n.style-forest {\n  backgro