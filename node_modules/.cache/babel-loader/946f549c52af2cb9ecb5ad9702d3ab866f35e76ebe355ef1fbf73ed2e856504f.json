{"ast":null,"code":"import { serverApi } from '@/api/index';\nexport default {\n  name: 'SpecialLists',\n  props: {\n    savename: {\n      type: String,\n      default: ''\n    }\n  },\n  data() {\n    return {\n      // 存档相关\n      saveList: [{\n        label: '存档1',\n        value: 'save1'\n      }, {\n        label: '存档2',\n        value: 'save2'\n      }, {\n        label: '存档3',\n        value: 'save3'\n      }],\n      currentSave: '',\n      // 标签页\n      activeTab: 'admin',\n      // 数据\n      adminList: [],\n      blockList: [],\n      whiteList: [],\n      // 加载状态\n      loading: {\n        admin: false,\n        block: false,\n        white: false\n      },\n      // 对话框\n      dialogVisible: false,\n      dialogType: 'admin',\n      // admin, block, white\n      dialogTitle: '添加管理员',\n      userForm: {\n        name: '',\n        id: ''\n      },\n      userRules: {\n        name: [{\n          required: true,\n          message: '请输入玩家名称',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 20,\n          message: '长度在 2 到 20 个字符',\n          trigger: 'blur'\n        }],\n        id: [{\n          required: true,\n          message: '请输入KU ID',\n          trigger: 'blur'\n        }]\n      },\n      submitting: false\n    };\n  },\n  watch: {\n    savename: {\n      immediate: true,\n      handler(newVal) {\n        if (newVal) {\n          this.currentSave = newVal;\n          this.fetchAllLists();\n        }\n      }\n    }\n  },\n  methods: {\n    // 关闭对话框\n    close() {\n      this.$emit('close');\n    },\n    // 切换存档\n    changeSave() {\n      this.fetchAllLists();\n    },\n    // 切换标签页\n    handleTabClick(tab) {\n      // 可根据需要添加逻辑\n    },\n    // 获取所有列表数据\n    fetchAllLists() {\n      const saveToUse = this.savename || this.currentSave;\n      if (!saveToUse) return;\n      this.fetchAdminList();\n      this.fetchBlockList();\n      this.fetchWhiteList();\n    },\n    // 获取管理员列表\n    fetchAdminList() {\n      this.loading.admin = true;\n      const saveToUse = this.savename || this.currentSave;\n      serverApi.getAdminList(saveToUse).then(res => {\n        this.adminList = Array.isArray(res) ? res : [];\n        console.log('获取管理员列表成功:', this.adminList);\n      }).catch(err => {\n        console.error('获取管理员列表失败:', err);\n        this.$message.error('获取管理员列表失败');\n\n        // 临时示例数据\n        this.adminList = [{\n          name: '管理员1',\n          id: 'KU_12345678'\n        }, {\n          name: '管理员2',\n          id: 'KU_87654321'\n        }];\n      }).finally(() => {\n        this.loading.admin = false;\n      });\n    },\n    // 获取黑名单\n    fetchBlockList() {\n      this.loading.block = true;\n      const saveToUse = this.savename || this.currentSave;\n      serverApi.getBlockList(saveToUse).then(res => {\n        this.blockList = Array.isArray(res) ? res : [];\n        console.log('获取黑名单成功:', this.blockList);\n      }).catch(err => {\n        console.error('获取黑名单失败:', err);\n        this.$message.error('获取黑名单失败');\n\n        // 临时示例数据\n        this.blockList = [{\n          name: '黑名单用户1',\n          id: 'KU_11111111'\n        }, {\n          name: '黑名单用户2',\n          id: 'KU_22222222'\n        }];\n      }).finally(() => {\n        this.loading.block = false;\n      });\n    },\n    // 获取白名单\n    fetchWhiteList() {\n      this.loading.white = true;\n      const saveToUse = this.savename || this.currentSave;\n      serverApi.getWhiteList(saveToUse).then(res => {\n        this.whiteList = Array.isArray(res) ? res : [];\n        console.log('获取白名单成功:', this.whiteList);\n      }).catch(err => {\n        console.error('获取白名单失败:', err);\n        this.$message.error('获取白名单失败');\n\n        // 临时示例数据\n        this.whiteList = [{\n          name: '白名单用户1',\n          id: 'KU_33333333'\n        }, {\n          name: '白名单用户2',\n          id: 'KU_44444444'\n        }];\n      }).finally(() => {\n        this.loading.white = false;\n      });\n    },\n    // 打开添加用户对话框\n    addUser(type) {\n      this.dialogType = type;\n      switch (type) {\n        case 'admin':\n          this.dialogTitle = '添加管理员';\n          break;\n        case 'block':\n          this.dialogTitle = '添加黑名单';\n          break;\n        case 'white':\n          this.dialogTitle = '添加白名单';\n          break;\n      }\n      this.userForm = {\n        name: '',\n        id: ''\n      };\n      this.dialogVisible = true;\n    },\n    // 移除用户\n    removeUser(type, index, row) {\n      this.$confirm(`确定要从${type === 'admin' ? '管理员列表' : type === 'block' ? '黑名单' : '白名单'}中移除 ${row.name} 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 根据类型移除用户\n        const saveToUse = this.savename || this.currentSave;\n        const loading = this.$loading({\n          lock: true,\n          text: '正在移除...',\n          spinner: 'el-icon-loading',\n          background: 'rgba(0, 0, 0, 0.7)'\n        });\n        let api;\n        let listData;\n        switch (type) {\n          case 'admin':\n            // 从adminList中移除\n            listData = [...this.adminList];\n            listData.splice(index, 1);\n            api = serverApi.updateAdminList(saveToUse, listData);\n            break;\n          case 'block':\n            // 从blockList中移除\n            listData = [...this.blockList];\n            listData.splice(index, 1);\n            api = serverApi.updateBlockList(saveToUse, listData);\n            break;\n          case 'white':\n            // 从whiteList中移除\n            listData = [...this.whiteList];\n            listData.splice(index, 1);\n            api = serverApi.updateWhiteList(saveToUse, listData);\n            break;\n        }\n\n        // 调用API\n        setTimeout(() => {\n          loading.close();\n\n          // 更新本地数据\n          switch (type) {\n            case 'admin':\n              this.adminList = listData;\n              break;\n            case 'block':\n              this.blockList = listData;\n              break;\n            case 'white':\n              this.whiteList = listData;\n              break;\n          }\n          this.$message.success('移除成功');\n        }, 1000);\n      }).catch(() => {\n        // 取消移除\n      });\n    },\n    // 提交表单\n    submitUserForm() {\n      this.$refs.userForm.validate(valid => {\n        if (!valid) return;\n        this.submitting = true;\n        const saveToUse = this.savename || this.currentSave;\n\n        // 准备要添加的用户\n        const newUser = {\n          ...this.userForm\n        };\n\n        // 根据类型添加用户\n        let listData;\n        let api;\n        switch (this.dialogType) {\n          case 'admin':\n            listData = [...this.adminList, newUser];\n            api = serverApi.updateAdminList(saveToUse, listData);\n            break;\n          case 'block':\n            listData = [...this.blockList, newUser];\n            api = serverApi.updateBlockList(saveToUse, listData);\n            break;\n          case 'white':\n            listData = [...this.whiteList, newUser];\n            api = serverApi.updateWhiteList(saveToUse, listData);\n            break;\n        }\n\n        // 模拟API调用\n        setTimeout(() => {\n          this.submitting = false;\n          this.dialogVisible = false;\n\n          // 更新本地数据\n          switch (this.dialogType) {\n            case 'admin':\n              this.adminList = listData;\n              break;\n            case 'block':\n              this.blockList = listData;\n              break;\n            case 'white':\n              this.whiteList = listData;\n              break;\n          }\n          this.$message.success('添加成功');\n        }, 1000);\n      });\n    }\n  },\n  mounted() {\n    // 如果有传入savename，直接使用；否则使用自身的currentSave\n    if (this.savename) {\n      this.currentSave = this.savename;\n      this.fetchAllLists();\n    } else {\n      // 获取可用存档列表\n      // 实际应用中应该调用API获取存档列表\n    }\n  }\n};","map":{"version":3,"names":["serverApi","name","props","savename","type","String","default","data","saveList","label","value","currentSave","activeTab","adminList","blockList","whiteList","loading","admin","block","white","dialogVisible","dialogType","dialogTitle","userForm","id","userRules","required","message","trigger","min","max","submitting","watch","immediate","handler","newVal","fetchAllLists","methods","close","$emit","changeSave","handleTabClick","tab","saveToUse","fetchAdminList","fetchBlockList","fetchWhiteList","getAdminList","then","res","Array","isArray","console","log","catch","err","error","$message","finally","getBlockList","getWhiteList","addUser","removeUser","index","row","$confirm","confirmButtonText","cancelButtonText","$loading","lock","text","spinner","background","api","listData","splice","updateAdminList","updateBlockList","updateWhiteList","setTimeout","success","submitUserForm","$refs","validate","valid","newUser","mounted"],"sources":["src/views/rooms/SpecialLists.vue"],"sourcesContent":["<template>\n  <div class=\"special-lists-page\">\n    <div class=\"page-header\" v-if=\"!savename\">\n      <h2>特殊名单管理</h2>\n    </div>\n    \n    <el-card class=\"save-selector\" v-if=\"!savename\">\n      <div slot=\"header\">\n        <span>选择存档</span>\n      </div>\n      <el-select v-model=\"currentSave\" placeholder=\"请选择存档\" @change=\"changeSave\" style=\"width: 100%;\">\n        <el-option\n          v-for=\"item in saveList\"\n          :key=\"item.value\"\n          :label=\"item.label\"\n          :value=\"item.value\">\n        </el-option>\n      </el-select>\n    </el-card>\n    \n    <el-tabs v-model=\"activeTab\" type=\"card\" @tab-click=\"handleTabClick\">\n      <el-tab-pane label=\"管理员名单\" name=\"admin\">\n        <el-card shadow=\"hover\" v-loading=\"loading.admin\">\n          <div slot=\"header\" class=\"list-header\">\n            <span>管理员列表</span>\n            <div>\n              <el-button size=\"small\" type=\"primary\" @click=\"addUser('admin')\" :disabled=\"!currentSave\">添加管理员</el-button>\n            </div>\n          </div>\n          \n          <div v-if=\"adminList.length > 0\">\n            <el-table :data=\"adminList\" style=\"width: 100%\">\n              <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n              <el-table-column prop=\"id\" label=\"KU ID\"></el-table-column>\n              <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\n                <template slot-scope=\"scope\">\n                  <el-button\n                    @click.native.prevent=\"removeUser('admin', scope.$index, scope.row)\"\n                    type=\"danger\"\n                    size=\"small\">\n                    移除\n                  </el-button>\n                </template>\n              </el-table-column>\n            </el-table>\n          </div>\n          <div v-else class=\"empty-list\">\n            <i class=\"el-icon-info\"></i>\n            <p>暂无管理员</p>\n          </div>\n        </el-card>\n      </el-tab-pane>\n      \n      <el-tab-pane label=\"黑名单\" name=\"block\">\n        <el-card shadow=\"hover\" v-loading=\"loading.block\">\n          <div slot=\"header\" class=\"list-header\">\n            <span>黑名单列表</span>\n            <div>\n              <el-button size=\"small\" type=\"primary\" @click=\"addUser('block')\" :disabled=\"!currentSave\">添加黑名单</el-button>\n            </div>\n          </div>\n          \n          <div v-if=\"blockList.length > 0\">\n            <el-table :data=\"blockList\" style=\"width: 100%\">\n              <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n              <el-table-column prop=\"id\" label=\"KU ID\"></el-table-column>\n              <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\n                <template slot-scope=\"scope\">\n                  <el-button\n                    @click.native.prevent=\"removeUser('block', scope.$index, scope.row)\"\n                    type=\"danger\"\n                    size=\"small\">\n                    移除\n                  </el-button>\n                </template>\n              </el-table-column>\n            </el-table>\n          </div>\n          <div v-else class=\"empty-list\">\n            <i class=\"el-icon-info\"></i>\n            <p>暂无黑名单用户</p>\n          </div>\n        </el-card>\n      </el-tab-pane>\n      \n      <el-tab-pane label=\"白名单\" name=\"white\">\n        <el-card shadow=\"hover\" v-loading=\"loading.white\">\n          <div slot=\"header\" class=\"list-header\">\n            <span>白名单列表</span>\n            <div>\n              <el-button size=\"small\" type=\"primary\" @click=\"addUser('white')\" :disabled=\"!currentSave\">添加白名单</el-button>\n            </div>\n          </div>\n          \n          <div v-if=\"whiteList.length > 0\">\n            <el-table :data=\"whiteList\" style=\"width: 100%\">\n              <el-table-column prop=\"name\" label=\"玩家名称\"></el-table-column>\n              <el-table-column prop=\"id\" label=\"KU ID\"></el-table-column>\n              <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\n                <template slot-scope=\"scope\">\n                  <el-button\n                    @click.native.prevent=\"removeUser('white', scope.$index, scope.row)\"\n                    type=\"danger\"\n                    size=\"small\">\n                    移除\n                  </el-button>\n                </template>\n              </el-table-column>\n            </el-table>\n          </div>\n          <div v-else class=\"empty-list\">\n            <i class=\"el-icon-info\"></i>\n            <p>暂无白名单用户</p>\n          </div>\n        </el-card>\n      </el-tab-pane>\n    </el-tabs>\n    \n    <!-- 添加用户对话框 -->\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"30%\">\n      <el-form :model=\"userForm\" ref=\"userForm\" :rules=\"userRules\" label-width=\"100px\">\n        <el-form-item label=\"玩家名称\" prop=\"name\">\n          <el-input v-model=\"userForm.name\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"KU ID\" prop=\"id\">\n          <el-input v-model=\"userForm.id\"></el-input>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitUserForm\" :loading=\"submitting\">确定</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { serverApi } from '@/api/index';\n\nexport default {\n  name: 'SpecialLists',\n  props: {\n    savename: {\n      type: String,\n      default: ''\n    }\n  },\n  data() {\n    return {\n      // 存档相关\n      saveList: [\n        { label: '存档1', value: 'save1' },\n        { label: '存档2', value: 'save2' },\n        { label: '存档3', value: 'save3' }\n      ],\n      currentSave: '',\n      \n      // 标签页\n      activeTab: 'admin',\n      \n      // 数据\n      adminList: [],\n      blockList: [],\n      whiteList: [],\n      \n      // 加载状态\n      loading: {\n        admin: false,\n        block: false,\n        white: false\n      },\n      \n      // 对话框\n      dialogVisible: false,\n      dialogType: 'admin', // admin, block, white\n      dialogTitle: '添加管理员',\n      userForm: {\n        name: '',\n        id: ''\n      },\n      userRules: {\n        name: [\n          { required: true, message: '请输入玩家名称', trigger: 'blur' },\n          { min: 2, max: 20, message: '长度在 2 到 20 个字符', trigger: 'blur' }\n        ],\n        id: [\n          { required: true, message: '请输入KU ID', trigger: 'blur' }\n        ]\n      },\n      submitting: false\n    }\n  },\n  watch: {\n    savename: {\n      immediate: true,\n      handler(newVal) {\n        if (newVal) {\n          this.currentSave = newVal;\n          this.fetchAllLists();\n        }\n      }\n    }\n  },\n  methods: {\n    // 关闭对话框\n    close() {\n      this.$emit('close');\n    },\n    // 切换存档\n    changeSave() {\n      this.fetchAllLists();\n    },\n    \n    // 切换标签页\n    handleTabClick(tab) {\n      // 可根据需要添加逻辑\n    },\n    \n    // 获取所有列表数据\n    fetchAllLists() {\n      const saveToUse = this.savename || this.currentSave;\n      if (!saveToUse) return;\n      \n      this.fetchAdminList();\n      this.fetchBlockList();\n      this.fetchWhiteList();\n    },\n    \n    // 获取管理员列表\n    fetchAdminList() {\n      this.loading.admin = true;\n      const saveToUse = this.savename || this.currentSave;\n      \n      serverApi.getAdminList(saveToUse)\n        .then(res => {\n          this.adminList = Array.isArray(res) ? res : [];\n          console.log('获取管理员列表成功:', this.adminList);\n        })\n        .catch(err => {\n          console.error('获取管理员列表失败:', err);\n          this.$message.error('获取管理员列表失败');\n          \n          // 临时示例数据\n          this.adminList = [\n            { name: '管理员1', id: 'KU_12345678' },\n            { name: '管理员2', id: 'KU_87654321' }\n          ];\n        })\n        .finally(() => {\n          this.loading.admin = false;\n        });\n    },\n    \n    // 获取黑名单\n    fetchBlockList() {\n      this.loading.block = true;\n      const saveToUse = this.savename || this.currentSave;\n      \n      serverApi.getBlockList(saveToUse)\n        .then(res => {\n          this.blockList = Array.isArray(res) ? res : [];\n          console.log('获取黑名单成功:', this.blockList);\n        })\n        .catch(err => {\n          console.error('获取黑名单失败:', err);\n          this.$message.error('获取黑名单失败');\n          \n          // 临时示例数据\n          this.blockList = [\n            { name: '黑名单用户1', id: 'KU_11111111' },\n            { name: '黑名单用户2', id: 'KU_22222222' }\n          ];\n        })\n        .finally(() => {\n          this.loading.block = false;\n        });\n    },\n    \n    // 获取白名单\n    fetchWhiteList() {\n      this.loading.white = true;\n      const saveToUse = this.savename || this.currentSave;\n      \n      serverApi.getWhiteList(saveToUse)\n        .then(res => {\n          this.whiteList = Array.isArray(res) ? res : [];\n          console.log('获取白名单成功:', this.whiteList);\n        })\n        .catch(err => {\n          console.error('获取白名单失败:', err);\n          this.$message.error('获取白名单失败');\n          \n          // 临时示例数据\n          this.whiteList = [\n            { name: '白名单用户1', id: 'KU_33333333' },\n            { name: '白名单用户2', id: 'KU_44444444' }\n          ];\n        })\n        .finally(() => {\n          this.loading.white = false;\n        });\n    },\n    \n    // 打开添加用户对话框\n    addUser(type) {\n      this.dialogType = type;\n      switch(type) {\n        case 'admin':\n          this.dialogTitle = '添加管理员';\n          break;\n        case 'block':\n          this.dialogTitle = '添加黑名单';\n          break;\n        case 'white':\n          this.dialogTitle = '添加白名单';\n          break;\n      }\n      \n      this.userForm = {\n        name: '',\n        id: ''\n      };\n      this.dialogVisible = true;\n    },\n    \n    // 移除用户\n    removeUser(type, index, row) {\n      this.$confirm(`确定要从${type === 'admin' ? '管理员列表' : type === 'block' ? '黑名单' : '白名单'}中移除 ${row.name} 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 根据类型移除用户\n        const saveToUse = this.savename || this.currentSave;\n        const loading = this.$loading({\n          lock: true,\n          text: '正在移除...',\n          spinner: 'el-icon-loading',\n          background: 'rgba(0, 0, 0, 0.7)'\n        });\n        \n        let api;\n        let listData;\n        \n        switch(type) {\n          case 'admin':\n            // 从adminList中移除\n            listData = [...this.adminList];\n            listData.splice(index, 1);\n            api = serverApi.updateAdminList(saveToUse, listData);\n            break;\n          case 'block':\n            // 从blockList中移除\n            listData = [...this.blockList];\n            listData.splice(index, 1);\n            api = serverApi.updateBlockList(saveToUse, listData);\n            break;\n          case 'white':\n            // 从whiteList中移除\n            listData = [...this.whiteList];\n            listData.splice(index, 1);\n            api = serverApi.updateWhiteList(saveToUse, listData);\n            break;\n        }\n        \n        // 调用API\n        setTimeout(() => {\n          loading.close();\n          \n          // 更新本地数据\n          switch(type) {\n            case 'admin':\n              this.adminList = listData;\n              break;\n            case 'block':\n              this.blockList = listData;\n              break;\n            case 'white':\n              this.whiteList = listData;\n              break;\n          }\n          \n          this.$message.success('移除成功');\n        }, 1000);\n      }).catch(() => {\n        // 取消移除\n      });\n    },\n    \n    // 提交表单\n    submitUserForm() {\n      this.$refs.userForm.validate(valid => {\n        if (!valid) return;\n        \n        this.submitting = true;\n        const saveToUse = this.savename || this.currentSave;\n        \n        // 准备要添加的用户\n        const newUser = { ...this.userForm };\n        \n        // 根据类型添加用户\n        let listData;\n        let api;\n        \n        switch(this.dialogType) {\n          case 'admin':\n            listData = [...this.adminList, newUser];\n            api = serverApi.updateAdminList(saveToUse, listData);\n            break;\n          case 'block':\n            listData = [...this.blockList, newUser];\n            api = serverApi.updateBlockList(saveToUse, listData);\n            break;\n          case 'white':\n            listData = [...this.whiteList, newUser];\n            api = serverApi.updateWhiteList(saveToUse, listData);\n            break;\n        }\n        \n        // 模拟API调用\n        setTimeout(() => {\n          this.submitting = false;\n          this.dialogVisible = false;\n          \n          // 更新本地数据\n          switch(this