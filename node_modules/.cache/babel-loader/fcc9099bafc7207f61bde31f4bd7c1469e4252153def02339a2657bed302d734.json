{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\n// 导入世界设置JSON数据\nimport worldSettingsData from '../../../dist/misc/dst_world_setting.json';\n// 导入世界配置工具函数\nimport { initWorldCategorySettings, getWorldCategories, getSortedCategoryKeys, getSortedItemKeys, createWorldConfig, getItemImageStyle } from '../../utils/worldConfigUtils';\nexport default {\n  name: 'WorldSettings',\n  data() {\n    return {\n      loading: false,\n      isEdit: false,\n      saveId: null,\n      // 存档基本信息\n      saveForm: {\n        name: '',\n        description: ''\n      },\n      // 验证规则\n      saveRules: {\n        name: [{\n          required: true,\n          message: '请输入存档名称',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 30,\n          message: '长度在 2 到 30 个字符',\n          trigger: 'blur'\n        }]\n      },\n      // 世界列表\n      worlds: [],\n      // 世界设置数据\n      worldSettingsData: worldSettingsData\n    };\n  },\n  computed: {\n    // 是否已有森林世界\n    hasForestWorld() {\n      return this.worlds.some(world => world.type === 'master');\n    },\n    // 是否已有洞穴世界\n    hasCaveWorld() {\n      return this.worlds.some(world => world.type === 'cave');\n    }\n  },\n  methods: {\n    // 返回列表页\n    goBack() {\n      this.$router.push('/worlds/list');\n    },\n    // 保存设置\n    saveSettings() {\n      this.$refs.saveForm.validate(valid => {\n        if (valid) {\n          if (this.worlds.length === 0) {\n            this.$message.error('请至少添加一个世界');\n            return;\n          }\n          this.loading = true;\n\n          // 准备保存的数据\n          const saveData = {\n            ...this.saveForm,\n            worlds: this.worlds.map(world => {\n              // 仅保存必要的数据，不包括UI状态等\n              return {\n                name: world.name,\n                type: world.type,\n                worldgen: world.worldgen,\n                worldsettings: world.worldsettings,\n                mods: world.mods,\n                others: world.others\n              };\n            })\n          };\n          console.log('保存的数据:', saveData);\n\n          // 模拟API调用\n          setTimeout(() => {\n            this.loading = false;\n            this.$message({\n              message: this.isEdit ? '存档设置已更新' : '存档创建成功',\n              type: 'success'\n            });\n            this.goBack();\n          }, 1000);\n        } else {\n          this.$message.error('请正确填写表单信息');\n          return false;\n        }\n      });\n    },\n    // 添加世界\n    addWorld(type) {\n      // 使用工具函数创建新世界的初始数据结构\n      const newWorld = createWorldConfig(type, type === 'master' ? '森林世界' : '洞穴世界', this.worldSettingsData);\n      this.worlds.push(newWorld);\n    },\n    // 删除世界\n    removeWorld(index) {\n      this.$confirm('确定要删除此世界吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.worlds.splice(index, 1);\n        this.$message({\n          type: 'success',\n          message: '删除成功!'\n        });\n      }).catch(() => {});\n    },\n    // 获取世界生成分类\n    getWorldgenCategories(worldType) {\n      const mappedType = worldType === 'master' ? 'forest' : 'cave';\n      return getWorldCategories(this.worldSettingsData, mappedType, 'WORLDGEN_GROUP');\n    },\n    // 获取世界设置分类\n    getWorldsettingsCategories(worldType) {\n      const mappedType = worldType === 'master' ? 'forest' : 'cave';\n      return getWorldCategories(this.worldSettingsData, mappedType, 'WORLDSETTINGS_GROUP');\n    },\n    // 获取排序后的分类键数组\n    getSortedCategoryKeys(categories) {\n      return getSortedCategoryKeys(categories);\n    },\n    // 获取排序后的项目键数组\n    getSortedItemKeys(items) {\n      return getSortedItemKeys(items);\n    },\n    // 获取配置项的图片样式\n    getItemImageStyle(item, isWorldgen = true) {\n      const atlasPath = isWorldgen ? '/dist/misc/worldgen_customization.webp' : '/dist/misc/worldsettings_customization.webp';\n      return getItemImageStyle(item, atlasPath);\n    },\n    // 加载存档数据\n    loadSaveData() {\n      if (!this.saveId) return;\n      this.loading = true;\n\n      // 模拟API调用\n      setTimeout(() => {\n        // 模拟从API获取的数据\n        const saveData = {\n          id: 1,\n          name: '测试存档',\n          description: '这是一个测试存档',\n          worlds: [{\n            name: '森林世界',\n            type: 'master'\n            // 其他数据...\n          }, {\n            name: '洞穴世界',\n            type: 'cave'\n            // 其他数据...\n          }]\n        };\n\n        // 设置表单数据\n        this.saveForm.name = saveData.name;\n        this.saveForm.description = saveData.description;\n\n        // 设置世界数据\n        this.worlds = saveData.worlds.map(world => {\n          // 使用映射类型\n          const mappedType = world.type === 'master' ? 'forest' : 'cave';\n          return {\n            ...world,\n            activeTab: 'basic',\n            worldgen: world.worldgen || initWorldCategorySettings(this.worldSettingsData, mappedType, 'WORLDGEN_GROUP'),\n            worldsettings: world.worldsettings || initWorldCategorySettings(this.worldSettingsData, mappedType, 'WORLDSETTINGS_GROUP'),\n            mods: world.mods || {},\n            others: world.others || {}\n          };\n        });\n        this.loading = false;\n      }, 1000);\n    }\n  },\n  created() {\n    // 判断是否为编辑模式\n    const {\n      id\n    } = this.$route.query;\n    if (id) {\n      this.isEdit = true;\n      this.saveId = parseInt(id);\n      this.loadSaveData();\n    } else {\n      // 默认添加一个森林世界\n      this.addWorld('master');\n    }\n  }\n};","map":{"version":3,"names":["worldSettingsData","initWorldCategorySettings","getWorldCategories","getSortedCategoryKeys","getSortedItemKeys","createWorldConfig","getItemImageStyle","name","data","loading","isEdit","saveId","saveForm","description","saveRules","required","message","trigger","min","max","worlds","computed","hasForestWorld","some","world","type","hasCaveWorld","methods","goBack","$router","push","saveSettings","$refs","validate","valid","length","$message","error","saveData","map","worldgen","worldsettings","mods","others","console","log","setTimeout","addWorld","newWorld","removeWorld","index","$confirm","confirmButtonText","cancelButtonText","then","splice","catch","getWorldgenCategories","worldType","mappedType","getWorldsettingsCategories","categories","items","item","isWorldgen","atlasPath","loadSaveData","id","activeTab","created","$route","query","parseInt"],"sources":["src/views/worlds/WorldSettings.vue"],"sourcesContent":["<template>\n  <div class=\"world-settings-page\">\n    <div class=\"page-header\">\n      <h2>{{ isEdit ? '编辑存档' : '创建存档' }}</h2>\n      <div class=\"header-actions\">\n        <el-button @click=\"goBack\">返回列表</el-button>\n        <el-button type=\"primary\" @click=\"saveSettings\" :loading=\"loading\">保存设置</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"settings-card\">\n      <el-form ref=\"saveForm\" :model=\"saveForm\" :rules=\"saveRules\" label-width=\"120px\">\n        <el-form-item label=\"存档名称\" prop=\"name\">\n          <el-input v-model=\"saveForm.name\" placeholder=\"请输入存档名称\"></el-input>\n        </el-form-item>\n        \n        <el-form-item label=\"存档描述\">\n          <el-input type=\"textarea\" v-model=\"saveForm.description\" rows=\"3\" placeholder=\"请输入存档描述\"></el-input>\n        </el-form-item>\n      </el-form>\n    </el-card>\n    \n    <!-- 世界列表 -->\n    <div class=\"worlds-container\">\n      <h3 class=\"section-title\">世界列表</h3>\n      \n      <div class=\"worlds-list\">\n        <el-card \n          v-for=\"(world, index) in worlds\" \n          :key=\"index\" \n          shadow=\"hover\" \n          class=\"world-card\"\n        >\n          <div class=\"world-card-header\">\n            <div class=\"world-info\">\n              <h4>{{ world.name }} ({{ world.type === 'master' ? '森林' : '洞穴' }})</h4>\n            </div>\n            <div class=\"world-actions\">\n              <el-button size=\"small\" type=\"danger\" @click=\"removeWorld(index)\">删除</el-button>\n            </div>\n          </div>\n          \n          <el-tabs v-model=\"world.activeTab\">\n            <el-tab-pane label=\"基本设置\" name=\"basic\">\n              <el-form :model=\"world\" label-width=\"120px\">\n                <el-form-item label=\"世界名称\" prop=\"name\">\n                  <el-input v-model=\"world.name\" placeholder=\"请输入世界名称\"></el-input>\n                </el-form-item>\n                \n                <el-form-item label=\"世界类型\" prop=\"type\">\n                  <el-radio-group v-model=\"world.type\" disabled>\n                    <el-radio label=\"master\">森林</el-radio>\n                    <el-radio label=\"cave\">洞穴</el-radio>\n                  </el-radio-group>\n                </el-form-item>\n              </el-form>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"世界生成\" name=\"generation\">\n              <div class=\"world-config-container\">\n                <!-- 世界生成配置 -->\n                <div \n                  v-for=\"categoryKey in getSortedCategoryKeys(getWorldgenCategories(world.type))\" \n                  :key=\"categoryKey\" \n                  class=\"config-category\"\n                >\n                  <div class=\"category-header\">\n                    <h3>{{ getWorldgenCategories(world.type)[categoryKey].text }}</h3>\n                    <span v-if=\"getWorldgenCategories(world.type)[categoryKey].desc\" class=\"category-desc\">\n                      {{ getWorldgenCategories(world.type)[categoryKey].desc }}\n                    </span>\n                  </div>\n                  \n                  <div class=\"category-items\">\n                    <div \n                      v-for=\"itemKey in getSortedItemKeys(getWorldgenCategories(world.type)[categoryKey].items)\" \n                      :key=\"itemKey\" \n                      class=\"config-item\"\n                    >\n                      <div class=\"item-header\">\n                        <div class=\"item-icon\" v-if=\"getWorldgenCategories(world.type)[categoryKey].items[itemKey].image\">\n                          <div \n                            class=\"item-image\" \n                            :style=\"getItemImageStyle(getWorldgenCategories(world.type)[categoryKey].items[itemKey], true)\"\n                          ></div>\n                        </div>\n                        <div class=\"item-info\">\n                          <span class=\"item-title\">{{ getWorldgenCategories(world.type)[categoryKey].items[itemKey].text }}</span>\n                        </div>\n                      </div>\n\n                      <div class=\"item-control\">\n                        <el-select \n                          v-model=\"world.worldgen[categoryKey][itemKey]\" \n                          placeholder=\"请选择\">\n                          <el-option \n                            v-for=\"(label, value) in getWorldgenCategories(world.type)[categoryKey].items[itemKey].desc\" \n                            :key=\"value\" \n                            :label=\"label\" \n                            :value=\"value\">\n                          </el-option>\n                        </el-select>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"世界设置\" name=\"settings\">\n              <div class=\"world-config-container\">\n                <!-- 世界设置配置 -->\n                <div \n                  v-for=\"categoryKey in getSortedCategoryKeys(getWorldsettingsCategories(world.type))\" \n                  :key=\"categoryKey\" \n                  class=\"config-category\"\n                >\n                  <div class=\"category-header\">\n                    <h3>{{ getWorldsettingsCategories(world.type)[categoryKey].text }}</h3>\n                    <span v-if=\"getWorldsettingsCategories(world.type)[categoryKey].desc\" class=\"category-desc\">\n                      {{ getWorldsettingsCategories(world.type)[categoryKey].desc }}\n                    </span>\n                  </div>\n                  \n                  <div class=\"category-items\">\n                    <div \n                      v-for=\"itemKey in getSortedItemKeys(getWorldsettingsCategories(world.type)[categoryKey].items)\" \n                      :key=\"itemKey\" \n                      class=\"config-item\"\n                    >\n                      <div class=\"item-header\">\n                        <div class=\"item-icon\" v-if=\"getWorldsettingsCategories(world.type)[categoryKey].items[itemKey].image\">\n                          <div \n                            class=\"item-image\" \n                            :style=\"getItemImageStyle(getWorldsettingsCategories(world.type)[categoryKey].items[itemKey], false)\"\n                          ></div>\n                        </div>\n                        <div class=\"item-info\">\n                          <span class=\"item-title\">{{ getWorldsettingsCategories(world.type)[categoryKey].items[itemKey].text }}</span>\n                        </div>\n                      </div>\n\n                      <div class=\"item-control\">\n                        <el-select \n                          v-model=\"world.worldsettings[categoryKey][itemKey]\" \n                          placeholder=\"请选择\">\n                          <el-option \n                            v-for=\"(label, value) in getWorldsettingsCategories(world.type)[categoryKey].items[itemKey].desc\" \n                            :key=\"value\" \n                            :label=\"label\" \n                            :value=\"value\">\n                          </el-option>\n                        </el-select>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"模组配置\" name=\"mods\">\n              <p>模组配置功能待开发</p>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"其他配置\" name=\"others\">\n              <p>其他配置功能待开发</p>\n            </el-tab-pane>\n          </el-tabs>\n        </el-card>\n      </div>\n      \n      <div class=\"add-world-actions\">\n        <el-button type=\"primary\" @click=\"addWorld('master')\" :disabled=\"hasForestWorld\">添加森林世界</el-button>\n        <el-button type=\"primary\" @click=\"addWorld('cave')\" :disabled=\"hasCaveWorld\">添加洞穴世界</el-button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\n// 导入世界设置JSON数据\nimport worldSettingsData from '../../../dist/misc/dst_world_setting.json'\n// 导入世界配置工具函数\nimport { \n  initWorldCategorySettings, \n  getWorldCategories, \n  getSortedCategoryKeys, \n  getSortedItemKeys, \n  createWorldConfig, \n  getItemImageStyle \n} from '../../utils/worldConfigUtils';\n\nexport default {\n  name: 'WorldSettings',\n  data() {\n    return {\n      loading: false,\n      isEdit: false,\n      saveId: null,\n      \n      // 存档基本信息\n      saveForm: {\n        name: '',\n        description: ''\n      },\n      \n      // 验证规则\n      saveRules: {\n        name: [\n          { required: true, message: '请输入存档名称', trigger: 'blur' },\n          { min: 2, max: 30, message: '长度在 2 到 30 个字符', trigger: 'blur' }\n        ]\n      },\n      \n      // 世界列表\n      worlds: [],\n      \n      // 世界设置数据\n      worldSettingsData: worldSettingsData\n    }\n  },\n  computed: {\n    // 是否已有森林世界\n    hasForestWorld() {\n      return this.worlds.some(world => world.type === 'master');\n    },\n    \n    // 是否已有洞穴世界\n    hasCaveWorld() {\n      return this.worlds.some(world => world.type === 'cave');\n    }\n  },\n  methods: {\n    // 返回列表页\n    goBack() {\n      this.$router.push('/worlds/list');\n    },\n    \n    // 保存设置\n    saveSettings() {\n      this.$refs.saveForm.validate(valid => {\n        if (valid) {\n          if (this.worlds.length === 0) {\n            this.$message.error('请至少添加一个世界');\n            return;\n          }\n          \n          this.loading = true;\n          \n          // 准备保存的数据\n          const saveData = {\n            ...this.saveForm,\n            worlds: this.worlds.map(world => {\n              // 仅保存必要的数据，不包括UI状态等\n              return {\n                name: world.name,\n                type: world.type,\n                worldgen: world.worldgen,\n                worldsettings: world.worldsettings,\n                mods: world.mods,\n                others: world.others\n              };\n            })\n          };\n          \n          console.log('保存的数据:', saveData);\n          \n          // 模拟API调用\n          setTimeout(() => {\n            this.loading = false;\n            this.$message({\n              message: this.isEdit ? '存档设置已更新' : '存档创建成功',\n              type: 'success'\n            });\n            this.goBack();\n          }, 1000);\n        } else {\n          this.$message.error('请正确填写表单信息');\n          return false;\n        }\n      });\n    },\n    \n    // 添加世界\n    addWorld(type) {\n      // 使用工具函数创建新世界的初始数据结构\n      const newWorld = createWorldConfig(type, type === 'master' ? '森林世界' : '洞穴世界', this.worldSettingsData);\n      this.worlds.push(newWorld);\n    },\n    \n    // 删除世界\n    removeWorld(index) {\n      this.$confirm('确定要删除此世界吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.worlds.splice(index, 1);\n        this.$message({\n          type: 'success',\n          message: '删除成功!'\n        });\n      }).catch(() => {});\n    },\n    \n    // 获取世界生成分类\n    getWorldgenCategories(worldType) {\n      const mappedType = worldType === 'master' ? 'forest' : 'cave';\n      return getWorldCategories(this.worldSettingsData, mappedType, 'WORLDGEN_GROUP');\n    },\n    \n    // 获取世界设置分类\n    getWorldsettingsCategories(worldType) {\n      const mappedType = worldType === 'master' ? 'forest' : 'cave';\n      return getWorldCategories(this.worldSettingsData, mappedType, 'WORLDSETTINGS_GROUP');\n    },\n    \n    // 获取排序后的分类键数组\n    getSortedCategoryKeys(categories) {\n      return getSortedCategoryKeys(categories);\n    },\n    \n    // 获取排序后的项目键数组\n    getSortedItemKeys(items) {\n      return getSortedItemKeys(items);\n    },\n    \n    // 获取配置项的图片样式\n    getItemImageStyle(item, isWorldgen = true) {\n      const atlasPath = isWorldgen \n        ? '/dist/misc/worldgen_customization.webp' \n        : '/dist/misc/worldsettings_customization.webp';\n      return getItemImageStyle(item, atlasPath);\n    },\n    \n    // 加载存档数据\n    loadSaveData() {\n      if (!this.saveId) return;\n      \n      this.loading = true;\n      \n      // 模拟API调用\n      setTimeout(() => {\n        // 模拟从API获取的数据\n        const saveData = {\n          id: 1,\n          name: '测试存档',\n          description: '这是一个测试存档',\n          worlds: [\n            {\n              name: '森林世界',\n              type: 'master',\n              // 其他数据...\n            },\n            {\n              name: '洞穴世界',\n              type: 'cave',\n              // 其他数据...\n            }\n          ]\n        };\n        \n        // 设置表单数据\n        this.saveForm.name = saveData.name;\n        this.saveForm.description = saveData.description;\n        \n        // 设置世界数据\n        this.worlds = saveData.worlds.map(world => {\n          // 使用映射类型\n          const mappedType = world.type === 'master' ? 'forest' : 'cave';\n          \n          return {\n            ...world,\n            activeTab: 'basic',\n            worldgen: world.worldgen || initWorldCategorySettings(this.worldSettingsData, mappedType, 'WORLDGEN_GROUP'),\n            worldsettings: world.worldsettings || initWorldCategorySettings(this.worldSettingsData, mappedType, 'WORLDSETTINGS_GROUP'),\n            mods: world.mods || {},\n            others: world.others || {}\n          };\n        });\n        \n        this.loading = false;\n      }, 1000);\n    }\n  },\n  created() {\n    // 判断是否为编辑模式\n    const { id } = this.$route.query;\n    if (id) {\n      this.isEdit = true;\n      this.saveId = parseInt(id);\n      this.loadSaveData();\n    } else {\n      // 默认添加一个森林世界\n      this.addWorld('master');\n    }\n  }\n}\n</script>\n\n<style scoped>\n.world-settings-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.settings-card {\n  margin-bottom: 20px;\n}\n\n.section-title {\n  margin-top: 20px;\n  margin-bottom: 15px;\n  font-size: 18px;\n  font-weight: 500;\n}\n\n.worlds-container {\n  margin-top: 20px;\n}\n\n.worlds-list {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.world-card {\n  width: 100%;\n}\n\n.world-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 15px;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 10px;\n}\n\n.world-info h4 {\n  margin: 0;\n  color: #409EFF;\n}\n\n.add-world-actions {\n  display: flex;\n  gap: 10px;\n  margin-top: 15px;\n}\n\n.config-category {\n  margin-bottom: 30px;\n}\n\n.category-header {\n  margin-bottom: 15px;\n}\n\n.category-header h3 {\n  margin: 0 0 5px 0;\n  font-size: 16px;\n  font-weight: 500;\n}\n\n.category-desc {\n  font-size: 14px;\n  color: #909399;\n}\n\n.category-items {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 15px;\n}\n\n.config-item {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  background-color: #f5f7fa;\n  border-radius: 4px;\n  padding: 10px;\n}\n\n.item-header {\n