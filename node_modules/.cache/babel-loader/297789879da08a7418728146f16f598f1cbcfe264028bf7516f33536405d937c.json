{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport WorldLog from '@/components/WorldLog.vue';\nexport default {\n  name: 'Dashboard',\n  components: {\n    WorldLog\n  },\n  data() {\n    return {\n      loading: false,\n      serverList: [{\n        name: '主世界服务器',\n        players: '12/20',\n        day: 128,\n        season: '秋季',\n        uptime: '3天12小时',\n        status: '在线'\n      }, {\n        name: '洞穴服务器',\n        players: '8/12',\n        day: 128,\n        season: '无',\n        uptime: '3天11小时',\n        status: '在线'\n      }, {\n        name: 'MOD测试服务器',\n        players: '7/15',\n        day: 45,\n        season: '夏季',\n        uptime: '1天8小时',\n        status: '在线'\n      }, {\n        name: '活动服务器',\n        players: '0/20',\n        day: 1,\n        season: '春季',\n        uptime: '0小时',\n        status: '离线'\n      }, {\n        name: '开发测试服务器',\n        players: '0/10',\n        day: 215,\n        season: '冬季',\n        uptime: '0小时',\n        status: '重启中'\n      }],\n      customColors: [{\n        color: '#67C23A',\n        percentage: 40\n      }, {\n        color: '#E6A23C',\n        percentage: 70\n      }, {\n        color: '#F56C6C',\n        percentage: 90\n      }],\n      timeRange: 'week',\n      announcements: [{\n        title: '服务器维护通知',\n        content: '我们将于本周六凌晨2点进行服务器维护，预计需要2小时，请各位玩家合理安排游戏时间。',\n        time: '1小时前',\n        type: '通知'\n      }, {\n        title: '新版本更新内容',\n        content: '新版本已发布，更新了大量内容，包括新的生物、武器和建筑，欢迎体验。',\n        time: '1天前',\n        type: '更新'\n      }, {\n        title: '周末活动预告',\n        content: '本周末将举办首届饥荒生存挑战赛，优胜者将获得丰厚奖励。',\n        time: '2天前',\n        type: '活动'\n      }],\n      systemLoading: false,\n      systemStatus: {}\n    };\n  },\n  created() {\n    this.refreshData();\n  },\n  methods: {\n    refreshData() {\n      this.loading = true;\n\n      // 模拟数据加载\n      setTimeout(() => {\n        this.loading = false;\n      }, 800);\n    },\n    tableRowClassName({\n      row\n    }) {\n      if (row.status === '离线') {\n        return 'server-offline';\n      } else if (row.status === '重启中') {\n        return 'server-restarting';\n      }\n      return '';\n    },\n    getSeasonClass(season) {\n      switch (season) {\n        case '春季':\n          return 'season-spring';\n        case '夏季':\n          return 'season-summer';\n        case '秋季':\n          return 'season-autumn';\n        case '冬季':\n          return 'season-winter';\n        default:\n          return '';\n      }\n    },\n    handleServerAction(server) {\n      if (server.status === '在线') {\n        this.$confirm(`确定要停止 \"${server.name}\" 吗？当前有 ${server.players.split('/')[0]} 名玩家在线。`, '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          server.status = '离线';\n          server.uptime = '0小时';\n          server.players = `0/${server.players.split('/')[1]}`;\n          this.$message({\n            type: 'success',\n            message: `${server.name} 已停止`\n          });\n        }).catch(() => {});\n      } else {\n        server.status = '在线';\n        server.uptime = '刚刚启动';\n        this.$message({\n          type: 'success',\n          message: `${server.name} 已启动`\n        });\n      }\n    },\n    handleRestart(server) {\n      this.$confirm(`确定要重启 \"${server.name}\" 吗？重启过程大约需要2分钟。`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        server.status = '重启中';\n        setTimeout(() => {\n          server.status = '在线';\n          server.uptime = '刚刚启动';\n          this.$message({\n            type: 'success',\n            message: `${server.name} 已重启完成`\n          });\n        }, 5000);\n      }).catch(() => {});\n    },\n    handleConfigure(server) {\n      this.$router.push('/servers/settings');\n    },\n    getAnnouncementTagType(type) {\n      switch (type) {\n        case '通知':\n          return 'info';\n        case '更新':\n          return 'success';\n        case '活动':\n          return 'warning';\n        default:\n          return '';\n      }\n    },\n    editAnnouncement(announcement) {\n      // 编辑公告逻辑\n    },\n    publishAnnouncement(announcement) {\n      this.$message({\n        type: 'success',\n        message: `公告\"${announcement.title}\"已发布到所有服务器`\n      });\n    },\n    gotoAnnouncement() {\n      this.$router.push('/announcements');\n    },\n    refreshSystemStatus() {\n      this.systemLoading = true;\n\n      // 模拟系统状态获取\n      setTimeout(() => {\n        this.systemLoading = false;\n        this.systemStatus = {\n          cpu_usage: 45,\n          cpu_model: 'Intel Core i7-9700K',\n          cpu_cores: 8,\n          cpu_threads: 16,\n          memory_usage: 68,\n          total_memory: '16GB',\n          used_memory: '10.5GB',\n          free_memory: '5.5GB',\n          disk_usage: 32,\n          total_disk: '1TB',\n          used_disk: '750GB',\n          free_disk: '250GB',\n          cpu_load1: 0.5,\n          cpu_load5: 0.7,\n          cpu_load15: 0.9,\n          os_info: 'Windows 10',\n          uptime_formatted: '3天12小时',\n          current_time: '10:30'\n        };\n      }, 800);\n    },\n    formatMemory(memory) {\n      if (typeof memory === 'string') {\n        return memory;\n      } else if (typeof memory === 'number') {\n        return memory.toFixed(2) + 'GB';\n      }\n      return '未知';\n    }\n  }\n};","map":{"version":3,"names":["WorldLog","name","components","data","loading","serverList","players","day","season","uptime","status","customColors","color","percentage","timeRange","announcements","title","content","time","type","systemLoading","systemStatus","created","refreshData","methods","setTimeout","tableRowClassName","row","getSeasonClass","handleServerAction","server","$confirm","split","confirmButtonText","cancelButtonText","then","$message","message","catch","handleRestart","handleConfigure","$router","push","getAnnouncementTagType","editAnnouncement","announcement","publishAnnouncement","gotoAnnouncement","refreshSystemStatus","cpu_usage","cpu_model","cpu_cores","cpu_threads","memory_usage","total_memory","used_memory","free_memory","disk_usage","total_disk","used_disk","free_disk","cpu_load1","cpu_load5","cpu_load15","os_info","uptime_formatted","current_time","formatMemory","memory","toFixed"],"sources":["src/views/Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"dashboard-content\" v-loading=\"loading\" element-loading-text=\"加载中...\" element-loading-spinner=\"el-icon-loading\">\n    <!-- 统计卡片 -->\n    <el-row :gutter=\"20\" class=\"stat-cards\">\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-content\">\n            <div class=\"stat-icon-container server-icon\">\n              <i class=\"el-icon-monitor\"></i>\n            </div>\n            <div class=\"stat-info\">\n              <div class=\"stat-title\">在线服务器</div>\n              <div class=\"stat-value\">3/5</div>\n              <div class=\"stat-detail\">正常运行中</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-content\">\n            <div class=\"stat-icon-container player-icon\">\n              <i class=\"el-icon-user\"></i>\n            </div>\n            <div class=\"stat-info\">\n              <div class=\"stat-title\">在线玩家</div>\n              <div class=\"stat-value\">27</div>\n              <div class=\"stat-detail\">峰值: 42</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-content\">\n            <div class=\"stat-icon-container mod-icon\">\n              <i class=\"el-icon-s-grid\"></i>\n            </div>\n            <div class=\"stat-info\">\n              <div class=\"stat-title\">已安装模组</div>\n              <div class=\"stat-value\">24</div>\n              <div class=\"stat-detail\">可用: 22</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-content\">\n            <div class=\"stat-icon-container backup-icon\">\n              <i class=\"el-icon-document\"></i>\n            </div>\n            <div class=\"stat-info\">\n              <div class=\"stat-title\">存档备份</div>\n              <div class=\"stat-value\">12</div>\n              <div class=\"stat-detail\">最近备份: 1小时前</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n    \n    <!-- 标题分割线 -->\n    <div class=\"section-divider\">\n      <div class=\"section-title\">\n        <i class=\"el-icon-data-analysis\"></i>\n        <span>服务器状态监控</span>\n      </div>\n      <div class=\"refresh-btn\">\n        <el-button size=\"small\" type=\"primary\" icon=\"el-icon-refresh\" circle @click=\"refreshData\"></el-button>\n      </div>\n    </div>\n    \n    <!-- 服务器监控 -->\n    <el-row :gutter=\"20\" class=\"monitor-section\">\n      <el-col :span=\"16\">\n        <el-card shadow=\"hover\" class=\"server-monitor\">\n          <el-table \n            :data=\"serverList\" \n            style=\"width: 100%\" \n            size=\"medium\"\n            :row-class-name=\"tableRowClassName\"\n            highlight-current-row>\n            <el-table-column prop=\"name\" label=\"服务器名称\">\n              <template slot-scope=\"scope\">\n                <div class=\"server-name\">\n                  <el-tag\n                    :type=\"scope.row.status === '在线' ? 'success' : scope.row.status === '重启中' ? 'warning' : 'danger'\"\n                    size=\"mini\"\n                    effect=\"dark\">\n                    {{ scope.row.status }}\n                  </el-tag>\n                  <span class=\"server-title\">{{ scope.row.name }}</span>\n                </div>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"players\" label=\"玩家\" width=\"100\" align=\"center\"></el-table-column>\n            <el-table-column prop=\"day\" label=\"天数\" width=\"80\" align=\"center\"></el-table-column>\n            <el-table-column prop=\"season\" label=\"季节\" width=\"100\" align=\"center\">\n              <template slot-scope=\"scope\">\n                <div class=\"season-badge\">\n                  <span :class=\"getSeasonClass(scope.row.season)\">{{ scope.row.season }}</span>\n                </div>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"uptime\" label=\"运行时间\" width=\"120\" align=\"center\"></el-table-column>\n            <el-table-column label=\"操作\" width=\"230\" align=\"center\">\n              <template slot-scope=\"scope\">\n                <el-button\n                  size=\"mini\"\n                  :type=\"scope.row.status === '在线' ? 'danger' : 'success'\"\n                  :disabled=\"scope.row.status === '重启中'\"\n                  @click=\"handleServerAction(scope.row)\">\n                  {{ scope.row.status === '在线' ? '停止' : '启动' }}\n                </el-button>\n                <el-button\n                  size=\"mini\"\n                  type=\"warning\"\n                  :disabled=\"scope.row.status !== '在线'\"\n                  @click=\"handleRestart(scope.row)\">\n                  重启\n                </el-button>\n                <el-button\n                  size=\"mini\"\n                  type=\"info\"\n                  @click=\"handleConfigure(scope.row)\">\n                  配置\n                </el-button>\n              </template>\n            </el-table-column>\n          </el-table>\n        </el-card>\n      </el-col>\n      \n      <el-col :span=\"8\">\n        <el-card shadow=\"hover\" class=\"system-info\">\n          <div slot=\"header\" class=\"clearfix\">\n            <span>系统资源</span>\n            <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"refreshSystemStatus\">刷新</el-button>\n          </div>\n          <div v-loading=\"systemLoading\" class=\"resource-usage\">\n            <div class=\"resource-item\">\n              <div class=\"resource-label\">\n                <span>CPU使用率</span>\n                <span class=\"resource-value\">{{ systemStatus.cpu_usage ? systemStatus.cpu_usage.toFixed(2) + '%' : '0%' }}</span>\n              </div>\n              <el-progress :percentage=\"parseFloat(systemStatus.cpu_usage) || 0\" :color=\"customColors\"></el-progress>\n              <div class=\"resource-detail\">\n                <span>{{ systemStatus.cpu_model || '未知CPU' }}</span>\n                <span>{{ systemStatus.cpu_cores || 0 }}核心 / {{ systemStatus.cpu_threads || 0 }}线程</span>\n              </div>\n            </div>\n            <div class=\"resource-item\">\n              <div class=\"resource-label\">\n                <span>内存使用率</span>\n                <span class=\"resource-value\">{{ systemStatus.memory_usage ? systemStatus.memory_usage.toFixed(2) + '%' : '0%' }}</span>\n              </div>\n              <el-progress :percentage=\"parseFloat(systemStatus.memory_usage) || 0\" :color=\"customColors\"></el-progress>\n              <div class=\"resource-detail\">\n                <span>总内存: {{ formatMemory(systemStatus.total_memory) }}</span>\n                <span>已用: {{ formatMemory(systemStatus.used_memory) }}</span>\n                <span>空闲: {{ formatMemory(systemStatus.free_memory) }}</span>\n              </div>\n            </div>\n            <div class=\"resource-item\">\n              <div class=\"resource-label\">\n                <span>磁盘使用率</span>\n                <span class=\"resource-value\">{{ systemStatus.disk_usage ? systemStatus.disk_usage.toFixed(2) + '%' : '0%' }}</span>\n              </div>\n              <el-progress :percentage=\"parseFloat(systemStatus.disk_usage) || 0\" :color=\"customColors\"></el-progress>\n              <div class=\"resource-detail\">\n                <span>总容量: {{ systemStatus.total_disk || 0 }}GB</span>\n                <span>已用: {{ systemStatus.used_disk || 0 }}GB</span>\n                <span>空闲: {{ systemStatus.free_disk || 0 }}GB</span>\n              </div>\n            </div>\n            <div class=\"resource-item\">\n              <div class=\"resource-label\">\n                <span>系统负载</span>\n                <span class=\"resource-value\">{{ systemStatus.cpu_load1 || 0 }}</span>\n              </div>\n              <el-progress :percentage=\"Math.min((systemStatus.cpu_load1 || 0) * 20, 100)\" :color=\"customColors\"></el-progress>\n              <div class=\"resource-detail\">\n                <span>1分钟: {{ systemStatus.cpu_load1 || 0 }}</span>\n                <span>5分钟: {{ systemStatus.cpu_load5 || 0 }}</span>\n                <span>15分钟: {{ systemStatus.cpu_load15 || 0 }}</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"system-info-footer\">\n            <div class=\"system-info-item\">\n              <i class=\"el-icon-monitor\"></i>\n              <span>{{ systemStatus.os_info || '未知系统' }}</span>\n            </div>\n            <div class=\"system-info-item\">\n              <i class=\"el-icon-time\"></i>\n              <span>运行时间: {{ systemStatus.uptime_formatted || '未知' }}</span>\n            </div>\n            <div class=\"system-info-item\">\n              <i class=\"el-icon-refresh\"></i>\n              <span>更新时间: {{ systemStatus.current_time || '未知' }}</span>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n    \n    <!-- 第二个分割线 -->\n    <div class=\"section-divider\">\n      <div class=\"section-title\">\n        <i class=\"el-icon-document\"></i>\n        <span>世界日志</span>\n      </div>\n    </div>\n    \n    <!-- 世界日志 -->\n    <el-row :gutter=\"20\" class=\"log-section\">\n      <el-col :span=\"24\">\n        <div class=\"world-log-wrapper\">\n          <world-log ref=\"worldLog\" style=\"height: 400px;\"></world-log>\n        </div>\n      </el-col>\n    </el-row>\n    \n    <!-- 第三个分割线 -->\n    <div class=\"section-divider\">\n      <div class=\"section-title\">\n        <i class=\"el-icon-s-data\"></i>\n        <span>最近游戏数据</span>\n      </div>\n    </div>\n    \n    <!-- 游戏数据和公告 -->\n    <el-row :gutter=\"20\" class=\"data-section\">\n      <el-col :span=\"12\">\n        <el-card shadow=\"hover\" class=\"player-stats\">\n          <div slot=\"header\" class=\"clearfix\">\n            <span>玩家数据统计</span>\n            <el-radio-group v-model=\"timeRange\" size=\"mini\" style=\"float: right;\">\n              <el-radio-button label=\"week\">周</el-radio-button>\n              <el-radio-button label=\"month\">月</el-radio-button>\n              <el-radio-button label=\"year\">年</el-radio-button>\n            </el-radio-group>\n          </div>\n          <div class=\"chart-container\">\n            <!-- 这里假设使用了一个自定义的图表组件 -->\n            <div class=\"placeholder-chart\">\n              <div class=\"chart-title\">玩家活跃度</div>\n              <!-- 图表占位符 -->\n              <div class=\"chart-placeholder\"></div>\n            </div>\n          </div>\n          <div class=\"player-stats-details\">\n            <div class=\"stats-item\">\n              <div class=\"stats-label\">新增玩家</div>\n              <div class=\"stats-value\">42</div>\n            </div>\n            <div class=\"stats-item\">\n              <div class=\"stats-label\">活跃玩家</div>\n              <div class=\"stats-value\">157</div>\n            </div>\n            <div class=\"stats-item\">\n              <div class=\"stats-label\">平均游戏时长</div>\n              <div class=\"stats-value\">2.4小时</div>\n            </div>\n            <div class=\"stats-item\">\n              <div class=\"stats-label\">总游戏时长</div>\n              <div class=\"stats-value\">489小时</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      \n      <el-col :span=\"12\">\n        <el-card shadow=\"hover\" class=\"announcement-card\">\n          <div slot=\"header\" class=\"clearfix\">\n            <span>公告管理</span>\n            <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"gotoAnnouncement\">更多</el-button>\n          </div>\n          <div class=\"announcement-list\">\n            <div class=\"announcement-item\" v-for=\"(item, index) in announcements\" :key=\"index\">\n              <div class=\"announcement-title\">\n                <el-tag size=\"mini\" :type=\"getAnnouncementTagType(item.type)\">{{ item.type }}</el-tag>\n                <span>{{ item.title }}</span>\n              </div>\n              <div class=\"announcement-body\">{{ item.content }}</div>\n              <div class=\"announcement-footer\">\n                <span class=\"announcement-time\">{{ item.time }}</span>\n                <div class=\"announcement-actions\">\n                  <el-button type=\"text\" size=\"mini\" @click=\"editAnnouncement(item)\">编辑</el-button>\n                  <el-button type=\"text\" size=\"mini\" @click=\"publishAnnouncement(item)\">发布</el-button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport WorldLog from '@/components/WorldLog.vue';\n\nexport default {\n  name: 'Dashboard',\n  components: {\n    WorldLog\n  },\n  data() {\n    return {\n      loading: false,\n      serverList: [\n        {\n          name: '主世界服务器',\n          players: '12/20',\n          day: 128,\n          season: '秋季',\n          uptime: '3天12小时',\n          status: '在线'\n        },\n        {\n          name: '洞穴服务器',\n          players: '8/12',\n          day: 128,\n          season: '无',\n          uptime: '3天11小时',\n          status: '在线'\n        },\n        {\n          name: 'MOD测试服务器',\n          players: '7/15',\n          day: 45,\n          season: '夏季',\n          uptime: '1天8小时',\n          status: '在线'\n        },\n        {\n          name: '活动服务器',\n          players: '0/20',\n          day: 1,\n          season: '春季',\n          uptime: '0小时',\n          status: '离线'\n        },\n        {\n          name: '开发测试服务器',\n          players: '0/10',\n          day: 215,\n          season: '冬季',\n          uptime: '0小时',\n          status: '重启中'\n        }\n      ],\n      customColors: [\n        {color: '#67C23A', percentage: 40},\n        {color: '#E6A23C', percentage: 70},\n        {color: '#F56C6C', percentage: 90}\n      ],\n      timeRange: 'week',\n      announcements: [\n        {\n          title: '服务器维护通知',\n          content: '我们将于本周六凌晨2点进行服务器维护，预计需要2小时，请各位玩家合理安排游戏时间。',\n          time: '1小时前',\n          type: '通知'\n        },\n        {\n          title: '新版本更新内容',\n          content: '新版本已发布，更新了大量内容，包括新的生物、武器和建筑，欢迎体验。',\n          time: '1天前',\n          type: '更新'\n        },\n        {\n          title: '周末活动预告',\n          content: '本周末将举办首届饥荒生存挑战赛，优胜者将获得丰厚奖励。',\n          time: '2天前',\n          type: '活动'\n        }\n      ],\n      systemLoading: false,\n      systemStatus: {}\n    }\n  },\n  created() {\n    this.refreshData();\n  },\n  methods: {\n    refreshData() {\n      this.loading = true;\n      \n      // 模拟数据加载\n      setTimeout(() => {\n        this.loading = false;\n      }, 800);\n    },\n    \n    tableRowClassName({row}) {\n      if (row.status === '离线') {\n        return 'server-offline';\n      } else if (row.status === '重启中') {\n        return 'server-restarting';\n      }\n      return '';\n    },\n    \n    getSeasonClass(season) {\n      switch (season) {\n        case '春季': return 'season-spring';\n        case '夏季': return 'season-summer';\n        case '秋季': return 'season-autumn';\n        case '冬季': return 'season-winter';\n        default: return '';\n      }\n