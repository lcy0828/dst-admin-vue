{"ast":null,"code":"export default {\n  name: 'ServerSettings',\n  data() {\n    return {\n      loading: false,\n      selectedServer: null,\n      activeTab: 'basic',\n      serverList: [{\n        id: 1,\n        name: '主世界服务器',\n        status: 'online'\n      }, {\n        id: 2,\n        name: '洞穴服务器',\n        status: 'online'\n      }, {\n        id: 3,\n        name: '模组服务器',\n        status: 'restarting'\n      }, {\n        id: 4,\n        name: 'PVP服务器',\n        status: 'offline'\n      }],\n      basicSettings: {\n        worldName: '',\n        gameMode: 'survival',\n        season: 'autumn',\n        maxPlayers: 16,\n        pvp: false,\n        pauseWhenEmpty: true,\n        whitelist: false,\n        autoBackupInterval: '180',\n        consoleCommands: ''\n      },\n      worldSettings: {\n        worldSize: 'medium',\n        branchingPathLength: 5,\n        loopPercent: 25,\n        berryBushes: 'default',\n        carrots: 'default',\n        rocks: 'default',\n        trees: 'default',\n        bees: 'default',\n        rabbits: 'default',\n        pigs: 'default',\n        hounds: 'default'\n      },\n      advancedSettings: {\n        cmdLineArgs: '-console -bind_ip 0.0.0.0',\n        clusterId: 'cluster_1',\n        clusterKey: 'random_key_12345',\n        serverPort: 10999,\n        maxSnapshots: 10,\n        perfTracking: false,\n        logLevel: 'info'\n      },\n      originalSettings: {\n        basic: {},\n        world: {},\n        advanced: {}\n      }\n    };\n  },\n  methods: {\n    getStatusType(status) {\n      const statusMap = {\n        'online': 'success',\n        'offline': 'info',\n        'restarting': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    getStatusText(status) {\n      const statusMap = {\n        'online': '在线',\n        'offline': '离线',\n        'restarting': '重启中'\n      };\n      return statusMap[status] || status;\n    },\n    refreshData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.$message({\n          message: '服务器设置已刷新',\n          type: 'success'\n        });\n        this.loading = false;\n      }, 800);\n    },\n    loadServerSettings(serverId) {\n      this.loading = true;\n\n      // 模拟加载所选服务器的设置数据\n      setTimeout(() => {\n        // 根据选中的服务器 ID 设置不同的值\n        if (serverId === 1) {\n          // 主世界服务器\n          this.basicSettings = {\n            worldName: '生存世界',\n            gameMode: 'survival',\n            season: 'autumn',\n            maxPlayers: 16,\n            pvp: false,\n            pauseWhenEmpty: true,\n            whitelist: false,\n            autoBackupInterval: '180',\n            consoleCommands: 'c_announce(\"欢迎来到主世界服务器!\")'\n          };\n          this.worldSettings = {\n            worldSize: 'large',\n            branchingPathLength: 6,\n            loopPercent: 30,\n            berryBushes: 'more',\n            carrots: 'more',\n            rocks: 'default',\n            trees: 'more',\n            bees: 'more',\n            rabbits: 'default',\n            pigs: 'more',\n            hounds: 'default'\n          };\n          this.advancedSettings = {\n            cmdLineArgs: '-console -bind_ip 0.0.0.0',\n            clusterId: 'cluster_1',\n            clusterKey: 'main_world_key_123',\n            serverPort: 10999,\n            maxSnapshots: 15,\n            perfTracking: false,\n            logLevel: 'info'\n          };\n        } else if (serverId === 2) {\n          // 洞穴服务器\n          this.basicSettings = {\n            worldName: '洞穴世界',\n            gameMode: 'survival',\n            season: 'autumn',\n            maxPlayers: 16,\n            pvp: false,\n            pauseWhenEmpty: true,\n            whitelist: false,\n            autoBackupInterval: '180',\n            consoleCommands: 'c_announce(\"欢迎来到洞穴服务器!\")'\n          };\n          this.worldSettings = {\n            worldSize: 'medium',\n            branchingPathLength: 5,\n            loopPercent: 25,\n            berryBushes: 'rare',\n            carrots: 'none',\n            rocks: 'more',\n            trees: 'rare',\n            bees: 'none',\n            rabbits: 'none',\n            pigs: 'rare',\n            hounds: 'rare'\n          };\n          this.advancedSettings = {\n            cmdLineArgs: '-console -bind_ip 0.0.0.0 -cave',\n            clusterId: 'cluster_1',\n            clusterKey: 'main_world_key_123',\n            serverPort: 11000,\n            maxSnapshots: 15,\n            perfTracking: false,\n            logLevel: 'info'\n          };\n        } else if (serverId === 3) {\n          // 模组服务器\n          this.basicSettings = {\n            worldName: '模组世界',\n            gameMode: 'endless',\n            season: 'spring',\n            maxPlayers: 20,\n            pvp: false,\n            pauseWhenEmpty: true,\n            whitelist: true,\n            autoBackupInterval: '60',\n            consoleCommands: 'c_announce(\"欢迎来到模组服务器!\")'\n          };\n          this.worldSettings = {\n            worldSize: 'huge',\n            branchingPathLength: 8,\n            loopPercent: 35,\n            berryBushes: 'lots',\n            carrots: 'lots',\n            rocks: 'lots',\n            trees: 'lots',\n            bees: 'lots',\n            rabbits: 'lots',\n            pigs: 'lots',\n            hounds: 'rare'\n          };\n          this.advancedSettings = {\n            cmdLineArgs: '-console -bind_ip 0.0.0.0 -mods workshop-12345,workshop-67890',\n            clusterId: 'modded_cluster',\n            clusterKey: 'modded_key_456',\n            serverPort: 11001,\n            maxSnapshots: 20,\n            perfTracking: true,\n            logLevel: 'debug'\n          };\n        } else if (serverId === 4) {\n          // PVP服务器\n          this.basicSettings = {\n            worldName: 'PVP竞技场',\n            gameMode: 'wilderness',\n            season: 'winter',\n            maxPlayers: 32,\n            pvp: true,\n            pauseWhenEmpty: false,\n            whitelist: false,\n            autoBackupInterval: '360',\n            consoleCommands: 'c_announce(\"欢迎来到PVP服务器!\")'\n          };\n          this.worldSettings = {\n            worldSize: 'medium',\n            branchingPathLength: 4,\n            loopPercent: 60,\n            berryBushes: 'default',\n            carrots: 'default',\n            rocks: 'more',\n            trees: 'default',\n            bees: 'default',\n            rabbits: 'default',\n            pigs: 'default',\n            hounds: 'more'\n          };\n          this.advancedSettings = {\n            cmdLineArgs: '-console -bind_ip 0.0.0.0 -pvp',\n            clusterId: 'pvp_cluster',\n            clusterKey: 'pvp_key_789',\n            serverPort: 11002,\n            maxSnapshots: 5,\n            perfTracking: true,\n            logLevel: 'warning'\n          };\n        }\n\n        // 保存原始设置以便重置\n        this.originalSettings = {\n          basic: JSON.parse(JSON.stringify(this.basicSettings)),\n          world: JSON.parse(JSON.stringify(this.worldSettings)),\n          advanced: JSON.parse(JSON.stringify(this.advancedSettings))\n        };\n        this.loading = false;\n      }, 800);\n    },\n    resetSettings() {\n      this.$confirm('确定要重置所有设置到最后保存的状态吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.basicSettings = JSON.parse(JSON.stringify(this.originalSettings.basic));\n        this.worldSettings = JSON.parse(JSON.stringify(this.originalSettings.world));\n        this.advancedSettings = JSON.parse(JSON.stringify(this.originalSettings.advanced));\n        this.$message({\n          type: 'success',\n          message: '已重置设置'\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消重置'\n        });\n      });\n    },\n    saveSettings() {\n      this.loading = true;\n      setTimeout(() => {\n        this.originalSettings = {\n          basic: JSON.parse(JSON.stringify(this.basicSettings)),\n          world: JSON.parse(JSON.stringify(this.worldSettings)),\n          advanced: JSON.parse(JSON.stringify(this.advancedSettings))\n        };\n        this.loading = false;\n        this.$message({\n          message: '服务器设置已保存',\n          type: 'success'\n        });\n      }, 1000);\n    }\n  }\n};","map":{"version":3,"names":["name","data","loading","selectedServer","activeTab","serverList","id","status","basicSettings","worldName","gameMode","season","maxPlayers","pvp","pauseWhenEmpty","whitelist","autoBackupInterval","consoleCommands","worldSettings","worldSize","branchingPathLength","loopPercent","berryBushes","carrots","rocks","trees","bees","rabbits","pigs","hounds","advancedSettings","cmdLineArgs","clusterId","clusterKey","serverPort","maxSnapshots","perfTracking","logLevel","originalSettings","basic","world","advanced","methods","getStatusType","statusMap","getStatusText","refreshData","setTimeout","$message","message","type","loadServerSettings","serverId","JSON","parse","stringify","resetSettings","$confirm","confirmButtonText","cancelButtonText","then","catch","saveSettings"],"sources":["src/views/servers/ServerSettings.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card class=\"main-card\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>服务器设置</span>\n        <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"refreshData\">刷新</el-button>\n      </div>\n\n      <!-- 服务器选择 -->\n      <div class=\"server-select-wrapper\">\n        <el-select v-model=\"selectedServer\" placeholder=\"请选择服务器\" @change=\"loadServerSettings\" style=\"width: 300px;\">\n          <el-option\n            v-for=\"server in serverList\"\n            :key=\"server.id\"\n            :label=\"server.name\"\n            :value=\"server.id\">\n            <template>\n              <el-tag size=\"mini\" :type=\"getStatusType(server.status)\" class=\"status-tag\">\n                {{ getStatusText(server.status) }}\n              </el-tag>\n              <span style=\"margin-left: 8px\">{{ server.name }}</span>\n            </template>\n          </el-option>\n        </el-select>\n      </div>\n\n      <!-- 设置表单 -->\n      <div v-loading=\"loading\">\n        <div v-if=\"!selectedServer\" class=\"empty-settings\">\n          <i class=\"el-icon-setting\"></i>\n          <p>请选择一个服务器来查看设置</p>\n        </div>\n        <div v-else>\n          <el-tabs v-model=\"activeTab\" type=\"border-card\">\n            <el-tab-pane label=\"基本设置\" name=\"basic\">\n              <el-form :model=\"basicSettings\" label-width=\"150px\" size=\"medium\">\n                <el-form-item label=\"世界名称\">\n                  <el-input v-model=\"basicSettings.worldName\" placeholder=\"世界名称\"></el-input>\n                </el-form-item>\n                <el-form-item label=\"游戏模式\">\n                  <el-select v-model=\"basicSettings.gameMode\" placeholder=\"请选择游戏模式\" style=\"width: 100%\">\n                    <el-option label=\"生存\" value=\"survival\"></el-option>\n                    <el-option label=\"荒野\" value=\"wilderness\"></el-option>\n                    <el-option label=\"无尽\" value=\"endless\"></el-option>\n                    <el-option label=\"创造\" value=\"creative\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"初始季节\">\n                  <el-select v-model=\"basicSettings.season\" placeholder=\"请选择初始季节\" style=\"width: 100%\">\n                    <el-option label=\"春\" value=\"spring\"></el-option>\n                    <el-option label=\"夏\" value=\"summer\"></el-option>\n                    <el-option label=\"秋\" value=\"autumn\"></el-option>\n                    <el-option label=\"冬\" value=\"winter\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"最大玩家数\">\n                  <el-input-number v-model=\"basicSettings.maxPlayers\" :min=\"1\" :max=\"64\"></el-input-number>\n                </el-form-item>\n                <el-form-item label=\"PVP\">\n                  <el-switch v-model=\"basicSettings.pvp\"></el-switch>\n                </el-form-item>\n                <el-form-item label=\"暂停当空闲\">\n                  <el-switch v-model=\"basicSettings.pauseWhenEmpty\"></el-switch>\n                </el-form-item>\n                <el-form-item label=\"仅白名单\">\n                  <el-switch v-model=\"basicSettings.whitelist\"></el-switch>\n                </el-form-item>\n                <el-form-item label=\"自动备份间隔\">\n                  <el-select v-model=\"basicSettings.autoBackupInterval\" placeholder=\"请选择备份间隔\" style=\"width: 100%\">\n                    <el-option label=\"关闭\" value=\"0\"></el-option>\n                    <el-option label=\"30分钟\" value=\"30\"></el-option>\n                    <el-option label=\"1小时\" value=\"60\"></el-option>\n                    <el-option label=\"3小时\" value=\"180\"></el-option>\n                    <el-option label=\"6小时\" value=\"360\"></el-option>\n                    <el-option label=\"12小时\" value=\"720\"></el-option>\n                    <el-option label=\"24小时\" value=\"1440\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"控制台命令\">\n                  <el-input\n                    type=\"textarea\"\n                    v-model=\"basicSettings.consoleCommands\"\n                    placeholder=\"每行一个命令，在服务器启动时执行\"\n                    :rows=\"4\">\n                  </el-input>\n                </el-form-item>\n              </el-form>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"世界生成\" name=\"world\">\n              <el-form :model=\"worldSettings\" label-width=\"150px\" size=\"medium\">\n                <el-divider content-position=\"left\">地图设置</el-divider>\n                <el-form-item label=\"世界大小\">\n                  <el-select v-model=\"worldSettings.worldSize\" placeholder=\"请选择世界大小\" style=\"width: 100%\">\n                    <el-option label=\"小\" value=\"small\"></el-option>\n                    <el-option label=\"中\" value=\"medium\"></el-option>\n                    <el-option label=\"大\" value=\"large\"></el-option>\n                    <el-option label=\"巨大\" value=\"huge\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"分支路径长度\">\n                  <el-slider v-model=\"worldSettings.branchingPathLength\" :min=\"1\" :max=\"10\" :step=\"1\" show-stops></el-slider>\n                </el-form-item>\n                <el-form-item label=\"循环率\">\n                  <el-slider v-model=\"worldSettings.loopPercent\" :min=\"0\" :max=\"100\" :step=\"5\" show-stops></el-slider>\n                </el-form-item>\n                \n                <el-divider content-position=\"left\">资源设置</el-divider>\n                <el-form-item label=\"浆果丛\">\n                  <el-select v-model=\"worldSettings.berryBushes\" placeholder=\"请选择浆果丛数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"胡萝卜\">\n                  <el-select v-model=\"worldSettings.carrots\" placeholder=\"请选择胡萝卜数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"石头\">\n                  <el-select v-model=\"worldSettings.rocks\" placeholder=\"请选择石头数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"树林\">\n                  <el-select v-model=\"worldSettings.trees\" placeholder=\"请选择树林数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                \n                <el-divider content-position=\"left\">生物设置</el-divider>\n                <el-form-item label=\"蜜蜂\">\n                  <el-select v-model=\"worldSettings.bees\" placeholder=\"请选择蜜蜂数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"兔子\">\n                  <el-select v-model=\"worldSettings.rabbits\" placeholder=\"请选择兔子数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"野猪\">\n                  <el-select v-model=\"worldSettings.pigs\" placeholder=\"请选择野猪数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n                <el-form-item label=\"猎犬\">\n                  <el-select v-model=\"worldSettings.hounds\" placeholder=\"请选择猎犬数量\" style=\"width: 100%\">\n                    <el-option label=\"无\" value=\"none\"></el-option>\n                    <el-option label=\"很少\" value=\"rare\"></el-option>\n                    <el-option label=\"默认\" value=\"default\"></el-option>\n                    <el-option label=\"较多\" value=\"more\"></el-option>\n                    <el-option label=\"很多\" value=\"lots\"></el-option>\n                  </el-select>\n                </el-form-item>\n              </el-form>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"高级设置\" name=\"advanced\">\n              <el-form :model=\"advancedSettings\" label-width=\"150px\" size=\"medium\">\n                <el-form-item label=\"命令行参数\">\n                  <el-input\n                    type=\"textarea\"\n                    v-model=\"advancedSettings.cmdLineArgs\"\n                    placeholder=\"服务器启动的命令行参数\"\n                    :rows=\"3\">\n                  </el-input>\n                </el-form-item>\n                <el-form-item label=\"集群ID\">\n                  <el-input v-model=\"advancedSettings.clusterId\" placeholder=\"集群ID\"></el-input>\n                </el-form-item>\n                <el-form-item label=\"集群密钥\">\n                  <el-input v-model=\"advancedSettings.clusterKey\" placeholder=\"集群密钥\" show-password></el-input>\n                </el-form-item>\n                <el-form-item label=\"服务器端口\">\n                  <el-input-number v-model=\"advancedSettings.serverPort\" :min=\"1000\" :max=\"65535\"></el-input-number>\n                </el-form-item>\n                <el-form-item label=\"最大快照数\">\n                  <el-input-number v-model=\"advancedSettings.maxSnapshots\" :min=\"1\" :max=\"100\"></el-input-number>\n                </el-form-item>\n                <el-form-item label=\"性能跟踪\">\n                  <el-switch v-model=\"advancedSettings.perfTracking\"></el-switch>\n                </el-form-item>\n                <el-form-item label=\"日志级别\">\n                  <el-select v-model=\"advancedSettings.logLevel\" placeholder=\"请选择日志级别\" style=\"width: 100%\">\n                    <el-option label=\"错误\" value=\"error\"></el-option>\n                    <el-option label=\"警告\" value=\"warning\"></el-option>\n                    <el-option label=\"信息\" value=\"info\"></el-option>\n                    <el-option label=\"调试\" value=\"debug\"></el-option>\n                  </el-select>\n                </el-form-item>\n              </el-form>\n            </el-tab-pane>\n          </el-tabs>\n\n          <!-- 操作按钮 -->\n          <div class=\"action-buttons\">\n            <el-button type=\"warning\" @click=\"resetSettings\">重置</el-button>\n            <el-button type=\"primary\" @click=\"saveSettings\">保存设置</el-button>\n          </div>\n        </div>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'ServerSettings',\n  data() {\n    return {\n      loading: false,\n      selectedServer: null,\n      activeTab: 'basic',\n      serverList: [\n        {\n          id: 1,\n          name: '主世界服务器',\n          status: 'online'\n        },\n        {\n          id: 2,\n          name: '洞穴服务器',\n          status: 'online'\n        },\n        {\n          id: 3,\n          name: '模组服务器',\n          status: 'restarting'\n        },\n        {\n          id: 4,\n          name: 'PVP服务器',\n          status: 'offline'\n        }\n      ],\n      basicSettings: {\n        worldName: '',\n        gameMode: 'survival',\n        season: 'autumn',\n        maxPlayers: 16,\n        pvp: false,\n        pauseWhenEmpty: true,\n        whitelist: false,\n        autoBackupInterval: '180',\n        consoleCommands: ''\n      },\n      worldSettings: {\n        worldSize: 'medium',\n        branchingPathLength: 5,\n        loopPercent: 25,\n        berryBushes: 'default',\n        carrots: 'default',\n        rocks: 'default',\n        trees: 'default',\n        bees: 'default',\n        rabbits: 'default',\n        pigs: 'default',\n        hounds: 'default'\n      },\n      advancedSettings: {\n        cmdLineArgs: '-console -bind_ip 0.0.0.0',\n        clusterId: 'cluster_1',\n        clusterKey: 'random_key_12345',\n        serverPort: 10999,\n        maxSnapshots: 10,\n        perfTracking: false,\n        logLevel: 'info'\n      },\n      originalSettings: {\n        basic: {},\n        world: {},\n        advanced: {}\n      }\n    };\n  },\n  methods: {\n    getStatusType(status) {\n      const statusMap = {\n        'online': 'success',\n        'offline': 'info',\n        'restarting': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    getStatusText(status) {\n      const statusMap = {\n        'online': '在线',\n        'offline': '离线',\n        'restarting': '重启中'\n      };\n      return statusMap[status] || status;\n    },\n    refreshData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.$message({\n          message: '服务器设置已刷新',\n          type: 'success'\n        });\n        this.loading = false;\n      }, 800);\n    },\n    loadServerSettings(serverId) {\n      this.loading = true;\n      \n      // 模拟加载所选服务器的设置数据\n      setTimeout(() => {\n        // 根据选中的服务器 ID 设置不同的值\n        if (serverId === 1) { // 主世界服务器\n          this.basicSettings = {\n            worldName: '生存世界',\n            gameMode: 'survival',\n            season: 'autumn',\n            maxPlayers: 16,\n            pvp: false,\n            pauseWhenEmpty: true,\n            whitelist: false,\n            autoBackupInterval: '180',\n            consoleCommands: 'c_announce(\"欢迎来到主世界服务器!\")'\n          };\n          this.worldSettings = {\n            worldSize: 'large',\n            branchingPathLength: 6,\n            loopPercent: 30,\n            berryBushes: 'more',\n            carrots: 'more',\n            rocks: 'default',\n            trees: 'more',\n            bees: 'more',\n            rabbits: 'default',\n            pigs: 'more',\n            hounds: 'default'\n          };\n          this.advancedSettings = {\n            cmdLineArgs: '-console -bind_ip 0.0.0.0',\n            clusterId: 'cluster_1',\n            clusterKey: 'main_world_key_123',\n            serverPort: 10999,\n            maxSnapshots: 15,\n            perfTracking: false,\n            logLevel: 'info'\n          };\n        } else if (serverId === 2) { // 洞穴服务器\n          this.basicSettings = {\n            worldName: '洞穴世界',\n            gameMode: 'survival',\n            season: 'autumn',\n            maxPlayers: 16,\n            pvp: false,\n            pauseWhenEmpty: true,\n            whi