{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { agentApi } from '@/api/index';\nexport default {\n  name: 'AgentCommand',\n  data() {\n    return {\n      loading: false,\n      commandLoading: false,\n      historyLoading: false,\n      agentListLoading: false,\n      dialogVisible: false,\n      showKey: false,\n      currentPage: 1,\n      pageSize: 10,\n      total: 0,\n      agentList: [],\n      commandHistory: [],\n      selectedCommand: null,\n      commandForm: {\n        agent_id: '',\n        type: 'shell',\n        content: '',\n        timeout: 30\n      },\n      commandRules: {\n        agent_id: [{\n          required: true,\n          message: '请选择Agent',\n          trigger: 'change'\n        }],\n        type: [{\n          required: true,\n          message: '请选择命令类型',\n          trigger: 'change'\n        }],\n        content: [{\n          required: true,\n          message: '请输入命令内容',\n          trigger: 'blur'\n        }],\n        timeout: [{\n          required: true,\n          message: '请设置超时时间',\n          trigger: 'change'\n        }]\n      },\n      historyFilter: {\n        agent_id: '',\n        status: ''\n      }\n    };\n  },\n  created() {\n    this.fetchAgentList();\n    this.fetchCommandHistory();\n  },\n  methods: {\n    // Agent列表相关方法\n    async fetchAgentList() {\n      this.agentListLoading = true;\n      try {\n        const response = await agentApi.getAgentList();\n        if (response && response.code === 200) {\n          // 处理返回的数据结构，将每个agent对象转换为列表项\n          const agentData = response.data || {};\n          this.agentList = Object.entries(agentData).map(([key, agent]) => ({\n            id: agent.agent_uuid,\n            // 使用agent_uuid作为id\n            hostname: agent.hostname,\n            // 使用hostname作为显示名称\n            ip: agent.ip_addresses ? agent.ip_addresses[0] : '',\n            // 使用第一个IP地址\n            os: agent.os,\n            // 操作系统信息\n            status: agent.connected ? 'online' : 'offline' // 连接状态\n          }));\n        }\n      } catch (error) {\n        this.$message.error('获取Agent列表失败：' + error.message);\n      } finally {\n        this.agentListLoading = false;\n      }\n    },\n    handleAgentSelectVisibleChange(visible) {\n      if (visible) {\n        this.fetchAgentList();\n      }\n    },\n    getOsIcon(os) {\n      if (!os) return 'el-icon-monitor';\n      const osLower = os.toLowerCase();\n      if (osLower.includes('windows')) return 'el-icon-platform-eleme';\n      if (osLower.includes('linux')) return 'el-icon-platform-eleme';\n      if (osLower.includes('darwin')) return 'el-icon-apple';\n      return 'el-icon-monitor';\n    },\n    // 命令执行相关方法\n    async executeCommand() {\n      try {\n        await this.$refs.commandForm.validate();\n        this.commandLoading = true;\n\n        // 确保所有必要的字段都有值\n        const commandData = {\n          agent_id: this.commandForm.agent_id,\n          type: this.commandForm.type,\n          content: this.commandForm.content,\n          timeout: this.commandForm.timeout\n        };\n        const response = await agentApi.executeCommand(commandData);\n        if (response && response.code === 200) {\n          this.$message.success('命令已发送');\n\n          // 获取命令ID\n          const commandId = response.data.command_id;\n          if (commandId) {\n            // 立即获取并显示命令详情\n            this.pollCommandResult(commandId);\n          }\n\n          // 更新命令历史\n          setTimeout(() => {\n            this.fetchCommandHistory();\n          }, 1000); // 稍微延迟更新历史，确保后端已处理\n\n          // 重置表单\n          this.resetCommand();\n        } else {\n          this.$message.error(response.msg || '命令执行失败');\n        }\n      } catch (error) {\n        this.$message.error('命令执行失败：' + (error.message || '未知错误'));\n      } finally {\n        this.commandLoading = false;\n      }\n    },\n    // 轮询命令结果\n    async pollCommandResult(commandId, attempts = 0) {\n      if (attempts > 20) {\n        // 最多尝试20次，约1分钟\n        this.$message.warning('命令执行时间较长，请在历史记录中查看结果');\n        return;\n      }\n      try {\n        const response = await agentApi.getCommandResult(commandId);\n        if (response && response.code === 200) {\n          const result = response.data;\n\n          // 如果命令已完成或出错，显示详情\n          if (result.status === 'completed' || result.status === 'failed' || result.status === 'timeout') {\n            this.selectedCommand = result;\n            this.dialogVisible = true;\n\n            // 根据结果显示不同的消息\n            if (result.success) {\n              this.$message.success('命令执行成功');\n            } else {\n              this.$message.warning('命令执行失败: ' + (result.error_msg || '未知错误'));\n            }\n            return;\n          }\n\n          // 如果命令仍在执行，继续轮询\n          setTimeout(() => {\n            this.pollCommandResult(commandId, attempts + 1);\n          }, 3000); // 每3秒查询一次\n        } else {\n          // 查询失败，但仍继续尝试\n          setTimeout(() => {\n            this.pollCommandResult(commandId, attempts + 1);\n          }, 3000);\n        }\n      } catch (error) {\n        console.error('获取命令结果失败:', error);\n        // 出错后仍继续尝试\n        setTimeout(() => {\n          this.pollCommandResult(commandId, attempts + 1);\n        }, 3000);\n      }\n    },\n    resetCommand() {\n      this.$refs.commandForm.resetFields();\n    },\n    // 命令历史相关方法\n    async fetchCommandHistory() {\n      this.historyLoading = true;\n      try {\n        const params = {\n          page: this.currentPage,\n          page_size: this.pageSize\n        };\n\n        // 添加 Agent ID 过滤\n        if (this.historyFilter.agent_id) {\n          params.agent_id = this.historyFilter.agent_id;\n        }\n\n        // 添加状态过滤\n        if (this.historyFilter.status) {\n          params.status = this.historyFilter.status;\n        }\n        console.log('获取命令历史参数:', params);\n        const response = await agentApi.getCommandHistory(params);\n        if (response && response.code === 200) {\n          // 处理不同的返回数据结构\n          if (Array.isArray(response.data)) {\n            this.commandHistory = response.data;\n            this.total = response.data.length;\n          } else if (response.data && typeof response.data === 'object') {\n            if (Array.isArray(response.data.items)) {\n              this.commandHistory = response.data.items;\n              this.total = response.data.total || response.data.items.length;\n            } else {\n              // 如果是对象格式，转换为数组\n              const commands = Object.values(response.data);\n              this.commandHistory = commands;\n              this.total = commands.length;\n            }\n          } else {\n            this.commandHistory = [];\n            this.total = 0;\n          }\n          console.log('命令历史数据:', this.commandHistory);\n        } else {\n          this.$message.error(response.msg || '获取命令历史失败');\n          this.commandHistory = [];\n          this.total = 0;\n        }\n      } catch (error) {\n        console.error('获取命令历史失败:', error);\n        this.$message.error('获取命令历史失败：' + (error.message || '未知错误'));\n        this.commandHistory = [];\n        this.total = 0;\n      } finally {\n        this.historyLoading = false;\n      }\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n      this.fetchCommandHistory();\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n      this.fetchCommandHistory();\n    },\n    getStatusType(status) {\n      const statusMap = {\n        'pending': 'info',\n        'running': 'warning',\n        'completed': 'success',\n        'failed': 'danger',\n        'timeout': 'danger'\n      };\n      return statusMap[status] || 'info';\n    },\n    viewCommandDetail(command) {\n      this.selectedCommand = command;\n      this.dialogVisible = true;\n    },\n    formatTime(timestamp) {\n      if (!timestamp) return 'N/A';\n      return new Date(timestamp).toLocaleString();\n    },\n    onAgentFilterChange() {\n      this.fetchCommandHistory();\n    },\n    onStatusFilterChange() {\n      this.fetchCommandHistory();\n    },\n    refreshHistory() {\n      this.fetchCommandHistory();\n    }\n  }\n};","map":{"version":3,"names":["agentApi","name","data","loading","commandLoading","historyLoading","agentListLoading","dialogVisible","showKey","currentPage","pageSize","total","agentList","commandHistory","selectedCommand","commandForm","agent_id","type","content","timeout","commandRules","required","message","trigger","historyFilter","status","created","fetchAgentList","fetchCommandHistory","methods","response","getAgentList","code","agentData","Object","entries","map","key","agent","id","agent_uuid","hostname","ip","ip_addresses","os","connected","error","$message","handleAgentSelectVisibleChange","visible","getOsIcon","osLower","toLowerCase","includes","executeCommand","$refs","validate","commandData","success","commandId","command_id","pollCommandResult","setTimeout","resetCommand","msg","attempts","warning","getCommandResult","result","error_msg","console","resetFields","params","page","page_size","log","getCommandHistory","Array","isArray","length","items","commands","values","handleSizeChange","val","handleCurrentChange","getStatusType","statusMap","viewCommandDetail","command","formatTime","timestamp","Date","toLocaleString","onAgentFilterChange","onStatusFilterChange","refreshHistory"],"sources":["src/views/agents/AgentCommand.vue"],"sourcesContent":["<template>\n  <div class=\"agent-command-container\">\n    <el-card class=\"main-card\" shadow=\"hover\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span class=\"card-title\">\n          <i class=\"el-icon-terminal\"></i> Agent命令管理\n        </span>\n      </div>\n      \n      <div v-loading=\"loading\" class=\"command-content\">\n        <!-- 命令执行表单 -->\n        <div class=\"section\">\n          <div class=\"section-title\">\n            <i class=\"el-icon-edit\"></i> 命令执行\n          </div>\n          \n          <el-form label-position=\"top\" :model=\"commandForm\" ref=\"commandForm\" :rules=\"commandRules\">\n            <el-form-item label=\"Agent ID\" prop=\"agent_id\">\n              <el-select \n                v-model=\"commandForm.agent_id\" \n                filterable \n                placeholder=\"请选择Agent\" \n                style=\"width: 100%\"\n                @visible-change=\"handleAgentSelectVisibleChange\"\n                :loading=\"agentListLoading\">\n                <div slot=\"empty\" v-if=\"agentListLoading\" class=\"agent-loading\">\n                  <i class=\"el-icon-loading\"></i> 加载中...\n                </div>\n                <div slot=\"empty\" v-else class=\"agent-empty\">\n                  没有已连接的Agent\n                </div>\n                <el-option \n                  v-for=\"agent in agentList\" \n                  :key=\"agent.id\"\n                  :label=\"`${agent.hostname || '未知'} (${agent.id || '未知'})`\"\n                  :value=\"agent.id\">\n                  <div class=\"agent-option\">\n                    <i :class=\"getOsIcon(agent.os)\" class=\"agent-os-icon\"></i>\n                    <div class=\"agent-option-content\">\n                      <div class=\"agent-hostname\">{{ agent.hostname || 'Unknown' }}</div>\n                      <div class=\"agent-details\">\n                        ID: {{ agent.id }} | IP: {{ agent.ip || 'Unknown' }}\n                      </div>\n                    </div>\n                    <el-tag size=\"mini\" :type=\"agent.status === 'online' ? 'success' : 'danger'\">\n                      {{ agent.status || 'unknown' }}\n                    </el-tag>\n                  </div>\n                </el-option>\n              </el-select>\n            </el-form-item>\n            \n            <el-form-item label=\"命令类型\" prop=\"type\">\n              <el-select v-model=\"commandForm.type\" placeholder=\"请选择命令类型\" style=\"width: 100%\">\n                <el-option label=\"Shell命令\" value=\"shell\"></el-option>\n                <el-option label=\"PowerShell命令\" value=\"powershell\"></el-option>\n              </el-select>\n            </el-form-item>\n            \n            <el-form-item label=\"命令内容\" prop=\"content\">\n              <el-input \n                type=\"textarea\" \n                v-model=\"commandForm.content\" \n                :rows=\"4\"\n                placeholder=\"请输入要执行的命令内容\"></el-input>\n            </el-form-item>\n            \n            <el-form-item label=\"超时时间 (秒)\" prop=\"timeout\">\n              <el-input-number v-model=\"commandForm.timeout\" :min=\"1\" :max=\"600\" :step=\"5\"></el-input-number>\n            </el-form-item>\n            \n            <el-form-item>\n              <el-button type=\"primary\" @click=\"executeCommand\" :loading=\"commandLoading\">执行命令</el-button>\n              <el-button @click=\"resetCommand\">重置</el-button>\n            </el-form-item>\n          </el-form>\n        </div>\n\n        <!-- 命令历史记录 -->\n        <div class=\"section\">\n          <div class=\"section-title\">\n            <i class=\"el-icon-time\"></i> 命令历史\n            <div class=\"history-filter\">\n              <el-select\n                v-model=\"historyFilter.agent_id\"\n                placeholder=\"选择Agent\"\n                clearable\n                @change=\"onAgentFilterChange\"\n                style=\"width: 240px; margin-left: 15px;\">\n                <el-option \n                  v-for=\"agent in agentList\" \n                  :key=\"agent.id\"\n                  :label=\"`${agent.hostname || '未知'} (${agent.id || '未知'})`\"\n                  :value=\"agent.id\">\n                </el-option>\n              </el-select>\n              <el-select\n                v-model=\"historyFilter.status\"\n                placeholder=\"命令状态\"\n                clearable\n                @change=\"onStatusFilterChange\"\n                style=\"width: 120px; margin-left: 10px;\">\n                <el-option value=\"pending\" label=\"待执行\"></el-option>\n                <el-option value=\"running\" label=\"执行中\"></el-option>\n                <el-option value=\"completed\" label=\"已完成\"></el-option>\n                <el-option value=\"failed\" label=\"失败\"></el-option>\n                <el-option value=\"timeout\" label=\"超时\"></el-option>\n              </el-select>\n              <el-button type=\"primary\" plain size=\"small\" icon=\"el-icon-refresh\" @click=\"refreshHistory\" style=\"margin-left: 10px;\">刷新</el-button>\n            </div>\n          </div>\n          \n          <el-table\n            :data=\"commandHistory\"\n            style=\"width: 100%\"\n            v-loading=\"historyLoading\">\n            <el-table-column prop=\"command_id\" label=\"命令ID\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"agent_id\" label=\"Agent ID\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"type\" label=\"类型\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <el-tag size=\"mini\" :type=\"scope.row.type === 'shell' ? 'primary' : 'success'\">\n                  {{ scope.row.type }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"content\" label=\"命令内容\" show-overflow-tooltip></el-table-column>\n            <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <el-tag size=\"mini\" :type=\"getStatusType(scope.row.status)\">\n                  {{ scope.row.status }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"created_at\" label=\"创建时间\" width=\"180\">\n              <template slot-scope=\"scope\">\n                {{ formatTime(scope.row.created_at) }}\n              </template>\n            </el-table-column>\n            <el-table-column label=\"操作\" width=\"120\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" size=\"mini\" @click=\"viewCommandDetail(scope.row)\">\n                  查看详情\n                </el-button>\n              </template>\n            </el-table-column>\n          </el-table>\n\n          <div class=\"pagination-container\">\n            <el-pagination\n              @size-change=\"handleSizeChange\"\n              @current-change=\"handleCurrentChange\"\n              :current-page=\"currentPage\"\n              :page-sizes=\"[10, 20, 50, 100]\"\n              :page-size=\"pageSize\"\n              layout=\"total, sizes, prev, pager, next, jumper\"\n              :total=\"total\">\n            </el-pagination>\n          </div>\n        </div>\n\n        <!-- 命令详情对话框 -->\n        <el-dialog\n          title=\"命令详情\"\n          :visible.sync=\"dialogVisible\"\n          width=\"70%\"\n          class=\"command-detail-dialog\">\n          <div v-if=\"selectedCommand\" class=\"command-detail\">\n            <el-descriptions :column=\"2\" border>\n              <el-descriptions-item label=\"命令ID\">{{ selectedCommand.command_id }}</el-descriptions-item>\n              <el-descriptions-item label=\"Agent ID\">{{ selectedCommand.agent_id }}</el-descriptions-item>\n              <el-descriptions-item label=\"命令类型\">{{ selectedCommand.type }}</el-descriptions-item>\n              <el-descriptions-item label=\"退出码\">{{ selectedCommand.exit_code }}</el-descriptions-item>\n              <el-descriptions-item label=\"开始时间\">{{ formatTime(selectedCommand.start_time) }}</el-descriptions-item>\n              <el-descriptions-item label=\"结束时间\">{{ formatTime(selectedCommand.end_time) }}</el-descriptions-item>\n              <el-descriptions-item label=\"命令内容\" :span=\"2\">\n                <pre class=\"command-content\">{{ selectedCommand.content }}</pre>\n              </el-descriptions-item>\n              <el-descriptions-item label=\"命令输出\" :span=\"2\">\n                <el-tabs type=\"border-card\">\n                  <el-tab-pane label=\"输出\">\n                    <pre class=\"command-output\" v-if=\"selectedCommand.output\">{{ selectedCommand.output }}</pre>\n                    <div class=\"no-output\" v-else>无输出内容</div>\n                  </el-tab-pane>\n                  <el-tab-pane label=\"错误\" v-if=\"selectedCommand.error_msg\">\n                    <pre class=\"command-error\">{{ selectedCommand.error_msg }}</pre>\n                  </el-tab-pane>\n                </el-tabs>\n              </el-descriptions-item>\n            </el-descriptions>\n          </div>\n        </el-dialog>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { agentApi } from '@/api/index';\n\nexport default {\n  name: 'AgentCommand',\n  data() {\n    return {\n      loading: false,\n      commandLoading: false,\n      historyLoading: false,\n      agentListLoading: false,\n      dialogVisible: false,\n      showKey: false,\n      currentPage: 1,\n      pageSize: 10,\n      total: 0,\n      agentList: [],\n      commandHistory: [],\n      selectedCommand: null,\n      commandForm: {\n        agent_id: '',\n        type: 'shell',\n        content: '',\n        timeout: 30\n      },\n      commandRules: {\n        agent_id: [{ required: true, message: '请选择Agent', trigger: 'change' }],\n        type: [{ required: true, message: '请选择命令类型', trigger: 'change' }],\n        content: [{ required: true, message: '请输入命令内容', trigger: 'blur' }],\n        timeout: [{ required: true, message: '请设置超时时间', trigger: 'change' }]\n      },\n      historyFilter: {\n        agent_id: '',\n        status: ''\n      }\n    };\n  },\n  created() {\n    this.fetchAgentList();\n    this.fetchCommandHistory();\n  },\n  methods: {\n    // Agent列表相关方法\n    async fetchAgentList() {\n      this.agentListLoading = true;\n      try {\n        const response = await agentApi.getAgentList();\n        if (response && response.code === 200) {\n          // 处理返回的数据结构，将每个agent对象转换为列表项\n          const agentData = response.data || {};\n          this.agentList = Object.entries(agentData).map(([key, agent]) => ({\n            id: agent.agent_uuid,  // 使用agent_uuid作为id\n            hostname: agent.hostname,  // 使用hostname作为显示名称\n            ip: agent.ip_addresses ? agent.ip_addresses[0] : '',  // 使用第一个IP地址\n            os: agent.os,  // 操作系统信息\n            status: agent.connected ? 'online' : 'offline'  // 连接状态\n          }));\n        }\n      } catch (error) {\n        this.$message.error('获取Agent列表失败：' + error.message);\n      } finally {\n        this.agentListLoading = false;\n      }\n    },\n    handleAgentSelectVisibleChange(visible) {\n      if (visible) {\n        this.fetchAgentList();\n      }\n    },\n    getOsIcon(os) {\n      if (!os) return 'el-icon-monitor';\n      const osLower = os.toLowerCase();\n      if (osLower.includes('windows')) return 'el-icon-platform-eleme';\n      if (osLower.includes('linux')) return 'el-icon-platform-eleme';\n      if (osLower.includes('darwin')) return 'el-icon-apple';\n      return 'el-icon-monitor';\n    },\n\n    // 命令执行相关方法\n    async executeCommand() {\n      try {\n        await this.$refs.commandForm.validate();\n        this.commandLoading = true;\n        \n        // 确保所有必要的字段都有值\n        const commandData = {\n          agent_id: this.commandForm.agent_id,\n          type: this.commandForm.type,\n          content: this.commandForm.content,\n          timeout: this.commandForm.timeout\n        };\n        \n        const response = await agentApi.executeCommand(commandData);\n        if (response && response.code === 200) {\n          this.$message.success('命令已发送');\n          \n          // 获取命令ID\n          const commandId = response.data.command_id;\n          if (commandId) {\n            // 立即获取并显示命令详情\n            this.pollCommandResult(commandId);\n          }\n          \n          // 更新命令历史\n          setTimeout(() => {\n            this.fetchCommandHistory();\n          }, 1000); // 稍微延迟更新历史，确保后端已处理\n          \n          // 重置表单\n          this.resetCommand();\n        } else {\n          this.$message.error(response.msg || '命令执行失败');\n        }\n      } catch (error) {\n        this.$message.error('命令执行失败：' + (error.message || '未知错误'));\n      } finally {\n        this.commandLoading = false;\n      }\n    },\n    \n    // 轮询命令结果\n    async pollCommandResult(commandId, attempts = 0) {\n      if (attempts > 20) { // 最多尝试20次，约1分钟\n        this.$message.warning('命令执行时间较长，请在历史记录中查看结果');\n        return;\n      }\n      \n      try {\n        const response = await agentApi.getCommandResult(commandId);\n        \n        if (response && response.code === 200) {\n          const result = response.data;\n          \n          // 如果命令已完成或出错，显示详情\n          if (result.status === 'completed' || result.status === 'failed' || result.status === 'timeout') {\n            this.selectedCommand = result;\n            this.dialogVisible = true;\n            \n            // 根据结果显示不同的消息\n            if (result.success) {\n              this.$message.success('命令执行成功');\n            } else {\n              this.$message.warning('命令执行失败: ' + (result.error_msg || '未知错误'));\n            }\n            \n            return;\n          }\n          \n          // 如果命令仍在执行，继续轮询\n          setTimeout(() => {\n            this.pollCommandResult(commandId, attempts + 1);\n          }, 3000); // 每3秒查询一次\n        } else {\n          // 查询失败，但仍继续尝试\n          setTimeout(() => {\n            this.pollCommandResult(commandId, attempts + 1);\n          }, 3000);\n        }\n      } catch (error) {\n        console.error('获取命令结果失败:', error);\n        // 出错后仍继续尝试\n        setTimeout(() => {\n          this.pollCommandResult(commandId, attempts + 1);\n        }, 3000);\n      }\n    },\n    resetCommand() {\n      this.$refs.commandForm.resetFields();\n    },\n\n    // 命令历史相关方法\n    async fet