{"ast":null,"code":"export default {\n  name: 'App'\n};","map":{"version":3,"names":["name"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <router-view/>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App'\n}\n</script>\n\n<style>\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml, body {\n  font-family: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  height: 100%;\n  font-size: 14px;\n  color: #333;\n}\n\n#app {\n  height: 100%;\n}\n\n/* 全局禁用Element UI的遮罩层 */\n.v-modal {\n  display: none !important;\n  opacity: 0 !important;\n  visibility: hidden !important;\n  pointer-events: none !important;\n  z-index: -1 !important;\n}\n\n/* 提高对话框层级，禁用背景遮罩层 */\n.el-dialog__wrapper {\n  background-color: transparent !important;\n  position: fixed !important;\n  top: 0 !important;\n  right: 0 !important;\n  bottom: 0 !important;\n  left: 0 !important;\n  overflow: auto !important;\n  z-index: 2001 !important;\n  pointer-events: auto !important;\n}\n\n.el-dialog {\n  pointer-events: auto !important;\n  margin: 0 auto !important;\n  position: relative !important;\n  top: 10vh !important;\n  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;\n  z-index: 2002 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  max-height: 85vh !important;\n}\n\n.el-dialog__body {\n  overflow-y: auto !important;\n  padding: 15px 20px !important;\n  max-height: calc(85vh - 108px) !important; /* 减去头部和底部的高度 */\n  margin: 0 !important;\n}\n\n.el-dialog__header {\n  padding: 15px 20px !important;\n  margin: 0 !important;\n}\n\n.el-dialog__footer {\n  padding: 10px 20px 15px !important;\n  margin: 0 !important;\n}\n\n/* 禁用相关的loading遮罩 */\n/* .el-loading-mask {\n  background-color: rgba(255, 255, 255, 0.5) !important;\n  pointer-events: none !important;\n  position: absolute !important;\n  z-index: 10 !important;\n} */\n\n/* 公共样式 */\n.text-center {\n  text-align: center;\n}\n\n.text-right {\n  text-align: right;\n}\n\n.mb-20 {\n  margin-bottom: 20px;\n}\n\n.mt-20 {\n  margin-top: 20px;\n}\n\n.tag-success {\n  color: #67C23A;\n  background-color: #F0F9EB;\n  border: 1px solid #E1F3D8;\n  padding: 2px 6px;\n  border-radius: 2px;\n}\n\n.tag-warning {\n  color: #E6A23C;\n  background-color: #FDF6EC;\n  border: 1px solid #FAECD8;\n  padding: 2px 6px;\n  border-radius: 2px;\n}\n\n.tag-error {\n  color: #F56C6C;\n  background-color: #FEF0F0;\n  border: 1px solid #FDE2E2;\n  padding: 2px 6px;\n  border-radius: 2px;\n}\n\n/* 修改Element UI样式 */\n.el-table th {\n  background-color: #F5F7FA !important;\n}\n\n.el-card__header {\n  font-size: 16px;\n  font-weight: bold;\n}\n</style> "],"mappings":"AAOA;EACAA,IAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}