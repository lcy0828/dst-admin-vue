);\n  }\n}\n</script>\n\n<style scoped>\n.world-list-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n}\n\n.search-input {\n  width: 250px;\n  margin-right: 15px;\n}\n\n.world-list-card {\n  margin-bottom: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n/* 表格行悬停样式 */\n.el-table >>> .el-table__row {\n  cursor: pointer;\n}\n\n.el-table >>> .el-table__row:hover {\n  background-color: #f5f7fa;\n}\n</style> "],"mappings":";;;AA8EA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,WAAA;MACAC,MAAA,GACA;QACAC,EAAA;QACAL,IAAA;QACAM,IAAA;QACAC,MAAA;QACAC,GAAA;QACAC,MAAA;QACAC,WAAA;MACA,GACA;QACAL,EAAA;QACAL,IAAA;QACAM,IAAA;QACAC,MAAA;QACAC,GAAA;QACAC,MAAA;QACAC,WAAA;MACA,GACA;QACAL,EAAA;QACAL,IAAA;QACAM,IAAA;QACAC,MAAA;QACAC,GAAA;QACAC,MAAA;QACAC,WAAA;MACA;IAEA;EACA;EACAC,QAAA;IACAC,eAAA;MACA,IAAAC,MAAA,QAAAT,MAAA;;MAEA;MACA,SAAAD,WAAA;QACA,MAAAW,KAAA,QAAAX,WAAA,CAAAY,WAAA;QACAF,MAAA,GAAAA,MAAA,CAAAG,MAAA,CAAAC,KAAA,IACAA,KAAA,CAAAjB,IAAA,CAAAe,WAAA,GAAAG,QAAA,CAAAJ,KAAA,KACAG,KAAA,CAAAP,WAAA,CAAAK,WAAA,GAAAG,QAAA,CAAAJ,KAAA,CACA;MACA;MAEA,OAAAD,MAAA;IACA;EACA;EACAM,OAAA;IACAC,cAAA;MACA,KAAAlB,OAAA;MACAmB,OAAA,CAAAC,GAAA;;MAEA;MACAC,UAAA;QACA,KAAArB,OAAA;QACA,KAAAsB,QAAA;UACAC,OAAA;UACAnB,IAAA;QACA;MACA;IACA;IACAoB,YAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,UAAAZ,KAAA;MACA,KAAAU,OAAA,CAAAC,IAAA;QACAE,IAAA;QACAhB,KAAA;UAAAT,EAAA,EAAAY,KAAA,CAAAZ;QAAA;MACA;IACA;IACA0B,kBAAAd,KAAA;MACA,MAAAe,MAAA,GAAAf,KAAA,CAAAR,MAAA;MACA,KAAAwB,QAAA,OAAAD,MAAA,OAAAf,KAAA,CAAAjB,IAAA;QACAkC,iBAAA;QACAC,gBAAA;QACA7B,IAAA;MACA,GAAA8B,IAAA;QACA,KAAAlC,OAAA;;QAEA;QACAqB,UAAA;UACA;UACA,MAAAc,KAAA,QAAAjC,MAAA,CAAAkC,SAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAlC,EAAA,KAAAY,KAAA,CAAAZ,EAAA;UACA,IAAAgC,KAAA;YACA,KAAAjC,MAAA,CAAAiC,KAAA,EAAA5B,MAAA,GAAAQ,KAAA,CAAAR,MAAA;UACA;UAEA,KAAAP,OAAA;UACA,KAA