{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nexport default {\n  name: 'ModConfigDialog',\n  props: {\n    visible: {\n      type: Boolean,\n      default: false\n    },\n    modId: {\n      type: String,\n      default: null\n    },\n    modInfo: {\n      type: Object,\n      default: null\n    },\n    isNewMod: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      // 弹窗可见状态\n      dialogVisible: false,\n      // 加载状态\n      loading: false,\n      saving: false,\n      // 配置表单\n      configForm: {},\n      // 原始配置，用于重置\n      originalConfig: {},\n      // 默认图标\n      defaultIcon: 'https://placehold.co/200x200/409EFF/white?text=MOD'\n    };\n  },\n  computed: {\n    // 是否有配置选项\n    hasOptions() {\n      return this.modInfo && this.modInfo.configuration_options && this.modInfo.configuration_options.length > 0;\n    },\n    // 按分类整理的配置选项\n    categorizedOptions() {\n      if (!this.hasOptions) return [];\n      const result = [];\n      let currentCategory = {\n        name: '',\n        options: []\n      };\n      this.modInfo.configuration_options.forEach(option => {\n        // 判断是否是分类标题\n        if (option.name === 'null' && option.options && option.options.length > 0) {\n          // 将之前的分类添加到结果中\n          if (currentCategory.options.length > 0) {\n            result.push({\n              ...currentCategory\n            });\n          }\n          // 创建新分类\n          currentCategory = {\n            name: option.label,\n            options: []\n          };\n        }\n        // 普通配置选项\n        else if (option.name !== 'null') {\n          currentCategory.options.push(option);\n        }\n      });\n\n      // 添加最后一个分类\n      if (currentCategory.options.length > 0) {\n        result.push(currentCategory);\n      }\n      return result;\n    }\n  },\n  watch: {\n    visible(newVal) {\n      this.dialogVisible = newVal;\n      if (newVal) {\n        this.initializeConfig();\n      }\n    },\n    dialogVisible(newVal) {\n      if (!newVal) {\n        this.$emit('update:visible', false);\n      }\n    }\n  },\n  methods: {\n    // 初始化配置\n    initializeConfig() {\n      this.loading = true;\n\n      // 清空配置表单\n      this.configForm = {};\n      this.originalConfig = {};\n      if (this.modInfo && this.modInfo.configuration_options) {\n        // 初始化配置表单\n        this.modInfo.configuration_options.forEach(option => {\n          if (option.name !== 'null') {\n            this.configForm[option.name] = option.default;\n            this.originalConfig[option.name] = option.default;\n          }\n        });\n      }\n\n      // 如果不是新模组，可以从API获取保存的配置\n      if (!this.isNewMod && this.modId) {\n        this.fetchSavedConfig();\n      } else {\n        this.loading = false;\n      }\n    },\n    // 获取保存的配置\n    fetchSavedConfig() {\n      // 模拟API获取保存的配置\n      setTimeout(() => {\n        // 这里可以添加已保存的配置数据\n        const savedConfig = {\n          language: true,\n          damage: 7,\n          planardamage: 2,\n          durability: 500,\n          chop: true,\n          hammer: false,\n          mine: true,\n          dig: false\n        };\n\n        // 更新配置表单\n        for (const key in savedConfig) {\n          if (key in this.configForm) {\n            this.configForm[key] = savedConfig[key];\n            this.originalConfig[key] = savedConfig[key];\n          }\n        }\n        this.loading = false;\n      }, 600);\n    },\n    // 判断是否是布尔选项（开关类型）\n    isBooleanOption(option) {\n      return option.options && option.options.length === 2 && typeof option.options[0].data === 'boolean' && typeof option.options[1].data === 'boolean';\n    },\n    // 判断是否是单选选项（选项较少时适合）\n    isRadioOption(option) {\n      return option.options && option.options.length > 0 && option.options.length <= 5;\n    },\n    // 获取开关选项的显示文本\n    getOptionLabel(option, isActive) {\n      if (!option.options || option.options.length < 2) return '';\n      const activeOpt = option.options.find(opt => opt.data === true);\n      const inactiveOpt = option.options.find(opt => opt.data === false);\n      return isActive ? activeOpt ? activeOpt.description : '是' : inactiveOpt ? inactiveOpt.description : '否';\n    },\n    // 保存配置\n    saveConfig() {\n      this.saving = true;\n\n      // 模拟API保存配置\n      setTimeout(() => {\n        this.saving = false;\n\n        // 通知父组件配置已更新\n        this.$emit('config-updated', {\n          modId: this.modId,\n          configData: this.configForm\n        });\n\n        // 关闭对话框\n        this.dialogVisible = false;\n\n        // 显示成功提示\n        this.$message({\n          type: 'success',\n          message: '配置已保存'\n        });\n      }, 800);\n    },\n    // 关闭对话框\n    handleClose() {\n      // 检查是否有未保存的更改\n      let hasChanges = false;\n      for (const key in this.configForm) {\n        if (this.configForm[key] !== this.originalConfig[key]) {\n          hasChanges = true;\n          break;\n        }\n      }\n      if (hasChanges) {\n        this.$confirm('您有未保存的配置更改，确定要关闭吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.dialogVisible = false;\n        }).catch(() => {\n          // 用户取消关闭\n        });\n      } else {\n        this.dialogVisible = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","visible","type","Boolean","default","modId","String","modInfo","Object","isNewMod","data","dialogVisible","loading","saving","configForm","originalConfig","defaultIcon","computed","hasOptions","configuration_options","length","categorizedOptions","result","currentCategory","options","forEach","option","push","label","watch","newVal","initializeConfig","$emit","methods","fetchSavedConfig","setTimeout","savedConfig","language","damage","planardamage","durability","chop","hammer","mine","dig","key","isBooleanOption","isRadioOption","getOptionLabel","isActive","activeOpt","find","opt","inactiveOpt","description","saveConfig","configData","$message","message","handleClose","hasChanges","$confirm","confirmButtonText","cancelButtonText","then","catch"],"sources":["src/views/mods/ModConfigDialog.vue"],"sourcesContent":["<template>\n  <el-dialog\n    title=\"模组配置\"\n    :visible.sync=\"dialogVisible\"\n    width=\"800px\"\n    class=\"mod-config-dialog\"\n    :before-close=\"handleClose\">\n    \n    <!-- 加载状态 -->\n    <div v-loading=\"loading\" class=\"config-container\">\n      <!-- 模组基本信息 -->\n      <div v-if=\"modInfo\" class=\"mod-info-section\">\n        <div class=\"mod-info-header\">\n          <el-image \n            :src=\"modInfo.iconUrl || defaultIcon\" \n            fit=\"cover\"\n            class=\"mod-icon\">\n            <div slot=\"error\" class=\"image-slot\">\n              <i class=\"el-icon-picture-outline\"></i>\n            </div>\n          </el-image>\n          \n          <div class=\"mod-info-details\">\n            <h2 class=\"mod-name\">{{ modInfo.name }}</h2>\n            <div class=\"mod-meta\">\n              <span class=\"mod-author\">\n                <i class=\"el-icon-user\"></i> {{ modInfo.author }}\n              </span>\n              <span class=\"mod-version\">\n                <i class=\"el-icon-info\"></i> v{{ modInfo.version }}\n              </span>\n            </div>\n            <div class=\"mod-description\">\n              {{ modInfo.description || '暂无描述' }}\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <!-- 配置选项 -->\n      <div v-if=\"!loading && hasOptions\" class=\"config-options-section\">\n        <h3 class=\"section-title\">配置选项</h3>\n        \n        <!-- 分类配置选项 -->\n        <div v-for=\"(category, categoryIndex) in categorizedOptions\" :key=\"categoryIndex\" class=\"option-category\">\n          <div v-if=\"category.name\" class=\"category-header\">\n            <h4 class=\"category-title\">{{ category.name }}</h4>\n          </div>\n          \n          <div class=\"category-options\">\n            <el-form :model=\"configForm\" label-position=\"top\">\n              <el-form-item \n                v-for=\"option in category.options\" \n                :key=\"option.name\" \n                :label=\"option.label\"\n                class=\"config-form-item\">\n                \n                <!-- 开关类型 -->\n                <template v-if=\"isBooleanOption(option)\">\n                  <el-switch\n                    v-model=\"configForm[option.name]\"\n                    :active-text=\"getOptionLabel(option, true)\"\n                    :inactive-text=\"getOptionLabel(option, false)\">\n                  </el-switch>\n                </template>\n                \n                <!-- 单选类型 -->\n                <template v-else-if=\"isRadioOption(option)\">\n                  <el-radio-group v-model=\"configForm[option.name]\" class=\"radio-options\">\n                    <el-radio \n                      v-for=\"(opt, idx) in option.options\" \n                      :key=\"idx\" \n                      :label=\"opt.data\">\n                      {{ opt.description }}\n                    </el-radio>\n                  </el-radio-group>\n                </template>\n                \n                <!-- 下拉选择类型 -->\n                <template v-else>\n                  <el-select v-model=\"configForm[option.name]\" style=\"width: 100%\">\n                    <el-option\n                      v-for=\"(opt, idx) in option.options\"\n                      :key=\"idx\"\n                      :label=\"opt.description\"\n                      :value=\"opt.data\">\n                    </el-option>\n                  </el-select>\n                </template>\n                \n                <!-- 配置说明 -->\n                <div v-if=\"option.hover\" class=\"option-description\">\n                  <i class=\"el-icon-info\"></i> {{ option.hover }}\n                </div>\n              </el-form-item>\n            </el-form>\n          </div>\n        </div>\n        \n        <!-- 无配置选项提示 -->\n        <div v-if=\"!hasOptions\" class=\"no-options\">\n          <el-empty description=\"该模组没有配置选项\" :image-size=\"150\"></el-empty>\n        </div>\n      </div>\n    </div>\n    \n    <span slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"handleClose\">取消</el-button>\n      <el-button type=\"primary\" @click=\"saveConfig\" :loading=\"saving\">保存配置</el-button>\n    </span>\n  </el-dialog>\n</template>\n\n<script>\nexport default {\n  name: 'ModConfigDialog',\n  props: {\n    visible: {\n      type: Boolean,\n      default: false\n    },\n    modId: {\n      type: String,\n      default: null\n    },\n    modInfo: {\n      type: Object,\n      default: null\n    },\n    isNewMod: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      // 弹窗可见状态\n      dialogVisible: false,\n      // 加载状态\n      loading: false,\n      saving: false,\n      // 配置表单\n      configForm: {},\n      // 原始配置，用于重置\n      originalConfig: {},\n      // 默认图标\n      defaultIcon: 'https://placehold.co/200x200/409EFF/white?text=MOD'\n    };\n  },\n  computed: {\n    // 是否有配置选项\n    hasOptions() {\n      return this.modInfo && \n        this.modInfo.configuration_options && \n        this.modInfo.configuration_options.length > 0;\n    },\n    \n    // 按分类整理的配置选项\n    categorizedOptions() {\n      if (!this.hasOptions) return [];\n      \n      const result = [];\n      let currentCategory = { name: '', options: [] };\n      \n      this.modInfo.configuration_options.forEach(option => {\n        // 判断是否是分类标题\n        if (option.name === 'null' && option.options && option.options.length > 0) {\n          // 将之前的分类添加到结果中\n          if (currentCategory.options.length > 0) {\n            result.push({...currentCategory});\n          }\n          // 创建新分类\n          currentCategory = {\n            name: option.label,\n            options: []\n          };\n        } \n        // 普通配置选项\n        else if (option.name !== 'null') {\n          currentCategory.options.push(option);\n        }\n      });\n      \n      // 添加最后一个分类\n      if (currentCategory.options.length > 0) {\n        result.push(currentCategory);\n      }\n      \n      return result;\n    }\n  },\n  watch: {\n    visible(newVal) {\n      this.dialogVisible = newVal;\n      if (newVal) {\n        this.initializeConfig();\n      }\n    },\n    dialogVisible(newVal) {\n      if (!newVal) {\n        this.$emit('update:visible', false);\n      }\n    }\n  },\n  methods: {\n    // 初始化配置\n    initializeConfig() {\n      this.loading = true;\n      \n      // 清空配置表单\n      this.configForm = {};\n      this.originalConfig = {};\n      \n      if (this.modInfo && this.modInfo.configuration_options) {\n        // 初始化配置表单\n        this.modInfo.configuration_options.forEach(option => {\n          if (option.name !== 'null') {\n            this.configForm[option.name] = option.default;\n            this.originalConfig[option.name] = option.default;\n          }\n        });\n      }\n      \n      // 如果不是新模组，可以从API获取保存的配置\n      if (!this.isNewMod && this.modId) {\n        this.fetchSavedConfig();\n      } else {\n        this.loading = false;\n      }\n    },\n    \n    // 获取保存的配置\n    fetchSavedConfig() {\n      // 模拟API获取保存的配置\n      setTimeout(() => {\n        // 这里可以添加已保存的配置数据\n        const savedConfig = {\n          language: true,\n          damage: 7,\n          planardamage: 2,\n          durability: 500,\n          chop: true,\n          hammer: false,\n          mine: true,\n          dig: false\n        };\n        \n        // 更新配置表单\n        for (const key in savedConfig) {\n          if (key in this.configForm) {\n            this.configForm[key] = savedConfig[key];\n            this.originalConfig[key] = savedConfig[key];\n          }\n        }\n        \n        this.loading = false;\n      }, 600);\n    },\n    \n    // 判断是否是布尔选项（开关类型）\n    isBooleanOption(option) {\n      return option.options && \n        option.options.length === 2 && \n        typeof option.options[0].data === 'boolean' && \n        typeof option.options[1].data === 'boolean';\n    },\n    \n    // 判断是否是单选选项（选项较少时适合）\n    isRadioOption(option) {\n      return option.options && \n        option.options.length > 0 && \n        option.options.length <= 5;\n    },\n    \n    // 获取开关选项的显示文本\n    getOptionLabel(option, isActive) {\n      if (!option.options || option.options.length < 2) return '';\n      \n      const activeOpt = option.options.find(opt => opt.data === true);\n      const inactiveOpt = option.options.find(opt => opt.data === false);\n      \n      return isActive ? \n        (activeOpt ? activeOpt.description : '是') : \n        (inactiveOpt ? inactiveOpt.description : '否');\n    },\n    \n    // 保存配置\n    saveConfig() {\n      this.saving = true;\n      \n      // 模拟API保存配置\n      setTimeout(() => {\n        this.saving = false;\n        \n        // 通知父组件配置已更新\n        this.$emit('config-updated', {\n          modId: this.modId,\n          configData: this.configForm\n        });\n        \n        // 关闭对话框\n        this.dialogVisible = false;\n        \n        // 显示成功提示\n        this.$message({\n          type: 'success',\n          message: '配置已保存'\n        });\n      }, 800);\n    },\n    \n    // 关闭对话框\n    handleClose() {\n      // 检查是否有未保存的更改\n      let hasChanges = false;\n      \n      for (const key in this.configForm) {\n        if (this.configForm[key] !== this.originalConfig[key]) {\n          hasChanges = true;\n          break;\n        }\n      }\n      \n      if (hasChanges) {\n        this.$confirm('您有未保存的配置更改，确定要关闭吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.dialogVisible = false;\n        }