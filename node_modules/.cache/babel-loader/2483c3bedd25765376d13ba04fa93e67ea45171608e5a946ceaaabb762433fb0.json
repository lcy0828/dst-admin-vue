{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'BanList',\n  data() {\n    return {\n      loading: false,\n      searchForm: {\n        name: '',\n        banType: '',\n        status: ''\n      },\n      // 模拟封禁列表数据\n      bans: [{\n        id: 1,\n        name: '恶意玩家A',\n        banType: 'accountBan',\n        reason: '使用自动脚本，违反游戏规则',\n        bannedBy: '管理员小明',\n        banTime: '2023-03-15 14:30:22',\n        expireTime: '2023-04-15 14:30:22',\n        status: 'active'\n      }, {\n        id: 2,\n        name: '恶意玩家B',\n        banType: 'ipBan',\n        reason: '多次使用作弊模组',\n        bannedBy: '管理员小红',\n        banTime: '2023-03-10 09:15:40',\n        expireTime: '永久',\n        status: 'active'\n      }, {\n        id: 3,\n        name: '恶意玩家C',\n        banType: 'chatBan',\n        reason: '聊天频道发送不当言论',\n        bannedBy: '管理员小蓝',\n        banTime: '2023-03-18 16:45:12',\n        expireTime: '2023-03-25 16:45:12',\n        status: 'active'\n      }, {\n        id: 4,\n        name: '普通玩家D',\n        banType: 'chatBan',\n        reason: '聊天频道发广告',\n        bannedBy: '管理员小绿',\n        banTime: '2023-02-20 11:30:05',\n        expireTime: '2023-02-23 11:30:05',\n        status: 'expired'\n      }, {\n        id: 5,\n        name: '恶意玩家E',\n        banType: 'accountBan',\n        reason: '恶意破坏其他玩家建筑',\n        bannedBy: '管理员小明',\n        banTime: '2023-03-05 10:20:15',\n        expireTime: '2023-03-12 10:20:15',\n        status: 'expired'\n      }],\n      filteredBans: [],\n      multipleSelection: [],\n      currentPage: 1,\n      pageSize: 10,\n      totalBans: 0,\n      // 对话框相关\n      dialogVisible: false,\n      dialogTitle: '新增封禁',\n      banForm: {\n        id: null,\n        name: '',\n        banType: 'accountBan',\n        reason: '',\n        duration: '7d',\n        customEndDate: null\n      },\n      banRules: {\n        name: [{\n          required: true,\n          message: '请输入玩家名称',\n          trigger: 'blur'\n        }],\n        banType: [{\n          required: true,\n          message: '请选择封禁类型',\n          trigger: 'change'\n        }],\n        reason: [{\n          required: true,\n          message: '请输入封禁原因',\n          trigger: 'blur'\n        }],\n        duration: [{\n          required: true,\n          message: '请选择封禁时长',\n          trigger: 'change'\n        }],\n        customEndDate: [{\n          required: true,\n          message: '请选择截止日期',\n          trigger: 'change'\n        }]\n      },\n      // 模拟玩家列表数据用于自动补全\n      players: [{\n        value: '猪王爱烤肉'\n      }, {\n        value: '沃利大厨'\n      }, {\n        value: '麦斯威尔'\n      }, {\n        value: '温蒂的鬼魂'\n      }, {\n        value: '旺达时光机'\n      }, {\n        value: '韦伯蜘蛛窝'\n      }, {\n        value: '薇格弗德火女'\n      }, {\n        value: '大力士沃尔夫冈'\n      }]\n    };\n  },\n  created() {\n    this.initData();\n  },\n  methods: {\n    initData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.filteredBans = [...this.bans];\n        this.totalBans = this.bans.length;\n        this.loading = false;\n      }, 500);\n    },\n    refreshData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.$message({\n          message: '数据已刷新',\n          type: 'success'\n        });\n        this.loading = false;\n      }, 800);\n    },\n    onSearch() {\n      this.loading = true;\n      setTimeout(() => {\n        this.filteredBans = this.bans.filter(ban => {\n          let matchName = true;\n          let matchType = true;\n          let matchStatus = true;\n          if (this.searchForm.name) {\n            matchName = ban.name.includes(this.searchForm.name);\n          }\n          if (this.searchForm.banType) {\n            matchType = ban.banType === this.searchForm.banType;\n          }\n          if (this.searchForm.status) {\n            matchStatus = ban.status === this.searchForm.status;\n          }\n          return matchName && matchType && matchStatus;\n        });\n        this.totalBans = this.filteredBans.length;\n        this.currentPage = 1;\n        this.loading = false;\n      }, 500);\n    },\n    resetSearch() {\n      this.searchForm = {\n        name: '',\n        banType: '',\n        status: ''\n      };\n      this.initData();\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n    },\n    handleSelectionChange(val) {\n      this.multipleSelection = val;\n    },\n    getBanTypeText(type) {\n      const typeMap = {\n        'accountBan': '账号封禁',\n        'ipBan': 'IP封禁',\n        'chatBan': '聊天封禁'\n      };\n      return typeMap[type] || type;\n    },\n    getBanTypeTag(type) {\n      const typeMap = {\n        'accountBan': 'danger',\n        'ipBan': 'warning',\n        'chatBan': 'info'\n      };\n      return typeMap[type] || '';\n    },\n    handleAddBan() {\n      this.dialogTitle = '新增封禁';\n      this.banForm = {\n        id: null,\n        name: '',\n        banType: 'accountBan',\n        reason: '',\n        duration: '7d',\n        customEndDate: null\n      };\n      this.dialogVisible = true;\n    },\n    handleEdit(row) {\n      this.dialogTitle = '编辑封禁';\n      this.banForm = {\n        id: row.id,\n        name: row.name,\n        banType: row.banType,\n        reason: row.reason,\n        duration: row.expireTime === '永久' ? 'permanent' : 'custom',\n        customEndDate: row.expireTime !== '永久' ? new Date(row.expireTime) : null\n      };\n      this.dialogVisible = true;\n    },\n    handleUnban(row) {\n      this.$confirm(`确定要解除对玩家 \"${row.name}\" 的封禁吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟解除封禁操作\n        const index = this.bans.findIndex(ban => ban.id === row.id);\n        if (index !== -1) {\n          this.bans[index].status = 'expired';\n          this.filteredBans = [...this.bans];\n        }\n        this.$message({\n          type: 'success',\n          message: `已解除对玩家 ${row.name} 的封禁！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleDelete(row) {\n      this.$confirm(`确定要删除对玩家 \"${row.name}\" 的封禁记录吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟删除操作\n        const index = this.bans.findIndex(ban => ban.id === row.id);\n        if (index !== -1) {\n          this.bans.splice(index, 1);\n          this.filteredBans = [...this.bans];\n          this.totalBans = this.bans.length;\n        }\n        this.$message({\n          type: 'success',\n          message: `已删除对玩家 ${row.name} 的封禁记录！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleBatchDelete() {\n      if (this.multipleSelection.length === 0) {\n        this.$message.warning('请选择要删除的封禁记录');\n        return;\n      }\n      this.$confirm(`确定要删除选中的 ${this.multipleSelection.length} 条封禁记录吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟批量删除操作\n        const ids = this.multipleSelection.map(item => item.id);\n        this.bans = this.bans.filter(ban => !ids.includes(ban.id));\n        this.filteredBans = [...this.bans];\n        this.totalBans = this.bans.length;\n        this.$message({\n          type: 'success',\n          message: `成功删除 ${ids.length} 条封禁记录！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    queryPlayers(queryString, cb) {\n      const results = queryString ? this.players.filter(player => player.value.toLowerCase().includes(queryString.toLowerCase())) : this.players;\n      cb(results);\n    },\n    submitBanForm() {\n      this.$refs.banForm.validate(valid => {\n        if (valid) {\n          // 模拟表单提交\n          this.loading = true;\n          setTimeout(() => {\n            if (this.banForm.id) {\n              // 编辑现有记录\n              const index = this.bans.findIndex(ban => ban.id === this.banForm.id);\n              if (index !== -1) {\n                // 计算过期时间\n                let expireTime = '永久';\n                if (this.banForm.duration !== 'permanent') {\n                  if (this.banForm.duration === 'custom' && this.banForm.customEndDate) {\n                    expireTime = this.formatDate(this.banForm.customEndDate);\n                  } else {\n                    const days = parseInt(this.banForm.duration);\n                    const date = new Date();\n                    date.setDate(date.getDate() + days);\n                    expireTime = this.formatDate(date);\n                  }\n                }\n                this.bans[index] = {\n                  ...this.bans[index],\n                  name: this.banForm.name,\n                  banType: this.banForm.banType,\n                  reason: this.banForm.reason,\n                  expireTime: expireTime\n                };\n                this.$message({\n                  message: '封禁记录已更新',\n                  type: 'success'\n                });\n              }\n            } else {\n              // 添加新记录\n              // 计算过期时间\n              let expireTime = '永久';\n              if (this.banForm.duration !== 'permanent') {\n                if (this.banForm.duration === 'custom' && this.banForm.customEndDate) {\n                  expireTime = this.formatDate(this.banForm.customEndDate);\n                } else {\n                  const days = parseInt(this.banForm.duration);\n                  const date = new Date();\n                  date.setDate(date.getDate() + days);\n                  expireTime = this.formatDate(date);\n                }\n              }\n              const newBan = {\n                id: this.bans.length + 1,\n                name: this.banForm.name,\n                banType: this.banForm.banType,\n                reason: this.banForm.reason,\n                bannedBy: '当前管理员',\n                banTime: this.formatDate(new Date()),\n                expireTime: expireTime,\n                status: 'active'\n              };\n              this.bans.unshift(newBan);\n              this.$message({\n                message: '已成功添加封禁记录',\n                type: 'success'\n              });\n            }\n            this.filteredBans = [...this.bans];\n            this.totalBans = this.bans.length;\n            this.dialogVisible = false;\n            this.loading = false;\n          }, 800);\n        } else {\n          return false;\n        }\n      });\n    },\n    formatDate(date) {\n      const d = new Date(date);\n      const year = d.getFullYear();\n      const month = String(d.getMonth() + 1).padStart(2, '0');\n      const day = String(d.getDate()).padStart(2, '0');\n      const hours = String(d.getHours()).padStart(2, '0');\n      const minutes = String(d.getMinutes()).padStart(2, '0');\n      const seconds = String(d.getSeconds()).padStart(2, '0');\n      return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;\n    }\n  }\n};","map":{"version":3,"names":["name","data","loading","searchForm","banType","status","bans","id","reason","bannedBy","banTime","expireTime","filteredBans","multipleSelection","currentPage","pageSize","totalBans","dialogVisible","dialogTitle","banForm","duration","customEndDate","banRules","required","message","trigger","players","value","created","initData","methods","setTimeout","length","refreshData","$message","type","onSearch","filter","ban","matchName","matchType","matchStatus","includes","resetSearch","handleSizeChange","val","handleCurrentChange","handleSelectionChange","getBanTypeText","typeMap","getBanTypeTag","handleAddBan","handleEdit","row","Date","handleUnban","$confirm","confirmButtonText","cancelButtonText","then","index","findIndex","catch","handleDelete","splice","handleBatchDelete","warning","ids","map","item","queryPlayers","queryString","cb","results","player","toLowerCase","submitBanForm","$refs","validate","valid","formatDate","days","parseInt","date","setDate","getDate","newBan","unshift","d","year","getFullYear","month","String","getMonth","padStart","day","hours","getHours","minutes","getMinutes","seconds","getSeconds"],"sources":["src/views/players/BanList.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card class=\"main-card\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>封禁列表</span>\n        <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"refreshData\">刷新</el-button>\n      </div>\n\n      <!-- 搜索栏 -->\n      <div class=\"search-bar\">\n        <el-form :inline=\"true\" :model=\"searchForm\" class=\"form-inline\">\n          <el-form-item label=\"玩家名称\">\n            <el-input v-model=\"searchForm.name\" placeholder=\"输入玩家名称\" clearable></el-input>\n          </el-form-item>\n          <el-form-item label=\"封禁类型\">\n            <el-select v-model=\"searchForm.banType\" placeholder=\"选择封禁类型\" clearable>\n              <el-option label=\"账号封禁\" value=\"accountBan\"></el-option>\n              <el-option label=\"IP封禁\" value=\"ipBan\"></el-option>\n              <el-option label=\"聊天封禁\" value=\"chatBan\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item label=\"状态\">\n            <el-select v-model=\"searchForm.status\" placeholder=\"封禁状态\" clearable>\n              <el-option label=\"活跃\" value=\"active\"></el-option>\n              <el-option label=\"已过期\" value=\"expired\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item>\n            <el-button type=\"primary\" @click=\"onSearch\">查询</el-button>\n            <el-button @click=\"resetSearch\">重置</el-button>\n          </el-form-item>\n        </el-form>\n      </div>\n\n      <!-- 工具栏 -->\n      <div class=\"tool-bar\">\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"handleAddBan\">新增封禁</el-button>\n        <el-button type=\"danger\" icon=\"el-icon-delete\" :disabled=\"!multipleSelection.length\" @click=\"handleBatchDelete\">批量删除</el-button>\n      </div>\n\n      <!-- 封禁表格 -->\n      <el-table\n        :data=\"filteredBans\"\n        v-loading=\"loading\"\n        style=\"width: 100%\"\n        border\n        @selection-change=\"handleSelectionChange\">\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n        <el-table-column prop=\"name\" label=\"玩家名称\" min-width=\"120\"></el-table-column>\n        <el-table-column prop=\"banType\" label=\"封禁类型\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"getBanTypeTag(scope.row.banType)\">{{ getBanTypeText(scope.row.banType) }}</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"reason\" label=\"封禁原因\" min-width=\"180\"></el-table-column>\n        <el-table-column prop=\"bannedBy\" label=\"操作人\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"banTime\" label=\"封禁时间\" width=\"180\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"expireTime\" label=\"到期时间\" width=\"180\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"90\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === 'active' ? 'danger' : 'info'\">\n              {{ scope.row.status === 'active' ? '活跃' : '已过期' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" @click=\"handleEdit(scope.row)\">编辑</el-button>\n            <el-button size=\"mini\" type=\"success\" @click=\"handleUnban(scope.row)\" :disabled=\"scope.row.status !== 'active'\">解封</el-button>\n            <el-button size=\"mini\" type=\"danger\" @click=\"handleDelete(scope.row)\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <!-- 分页器 -->\n      <div class=\"pagination-container\">\n        <el-pagination\n          @size-change=\"handleSizeChange\"\n          @current-change=\"handleCurrentChange\"\n          :current-page=\"currentPage\"\n          :page-sizes=\"[10, 20, 50, 100]\"\n          :page-size=\"pageSize\"\n          layout=\"total, sizes, prev, pager, next, jumper\"\n          :total=\"totalBans\">\n        </el-pagination>\n      </div>\n    </el-card>\n\n    <!-- 新增/编辑封禁对话框 -->\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"600px\">\n      <el-form :model=\"banForm\" :rules=\"banRules\" ref=\"banForm\" label-width=\"100px\">\n        <el-form-item label=\"玩家名称\" prop=\"name\">\n          <el-autocomplete\n            v-model=\"banForm.name\"\n            :fetch-suggestions=\"queryPlayers\"\n            placeholder=\"请输入玩家名称\"\n            style=\"width: 100%\">\n          </el-autocomplete>\n        </el-form-item>\n        <el-form-item label=\"封禁类型\" prop=\"banType\">\n          <el-select v-model=\"banForm.banType\" placeholder=\"请选择封禁类型\" style=\"width: 100%\">\n            <el-option label=\"账号封禁\" value=\"accountBan\"></el-option>\n            <el-option label=\"IP封禁\" value=\"ipBan\"></el-option>\n            <el-option label=\"聊天封禁\" value=\"chatBan\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"封禁原因\" prop=\"reason\">\n          <el-input type=\"textarea\" v-model=\"banForm.reason\" :rows=\"3\" placeholder=\"请输入封禁原因\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"封禁时长\" prop=\"duration\">\n          <el-select v-model=\"banForm.duration\" placeholder=\"请选择封禁时长\" style=\"width: 100%\">\n            <el-option label=\"1天\" value=\"1d\"></el-option>\n            <el-option label=\"3天\" value=\"3d\"></el-option>\n            <el-option label=\"7天\" value=\"7d\"></el-option>\n            <el-option label=\"30天\" value=\"30d\"></el-option>\n            <el-option label=\"永久\" value=\"permanent\"></el-option>\n            <el-option label=\"自定义\" value=\"custom\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"截止日期\" v-if=\"banForm.duration === 'custom'\" prop=\"customEndDate\">\n          <el-date-picker\n            v-model=\"banForm.customEndDate\"\n            type=\"datetime\"\n            placeholder=\"选择封禁结束日期\"\n            style=\"width: 100%\">\n          </el-date-picker>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitBanForm\">确认</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'BanList',\n  data() {\n    return {\n      loading: false,\n      searchForm: {\n        name: '',\n        banType: '',\n        status: ''\n      },\n      // 模拟封禁列表数据\n      bans: [\n        {\n          id: 1,\n          name: '恶意玩家A',\n          banType: 'accountBan',\n          reason: '使用自动脚本，违反游戏规则',\n          bannedBy: '管理员小明',\n          banTime: '2023-03-15 14:30:22',\n          expireTime: '2023-04-15 14:30:22',\n          status: 'active'\n        },\n        {\n          id: 2,\n          name: '恶意玩家B',\n          banType: 'ipBan',\n          reason: '多次使用作弊模组',\n          bannedBy: '管理员小红',\n          banTime: '2023-03-10 09:15:40',\n          expireTime: '永久',\n          status: 'active'\n        },\n        {\n          id: 3,\n          name: '恶意玩家C',\n          banType: 'chatBan',\n          reason: '聊天频道发送不当言论',\n          bannedBy: '管理员小蓝',\n          banTime: '2023-03-18 16:45:12',\n          expireTime: '2023-03-25 16:45:12',\n          status: 'active'\n        },\n        {\n          id: 4,\n          name: '普通玩家D',\n          banType: 'chatBan',\n          reason: '聊天频道发广告',\n          bannedBy: '管理员小绿',\n          banTime: '2023-02-20 11:30:05',\n          expireTime: '2023-02-23 11:30:05',\n          status: 'expired'\n        },\n        {\n          id: 5,\n          name: '恶意玩家E',\n          banType: 'accountBan',\n          reason: '恶意破坏其他玩家建筑',\n          bannedBy: '管理员小明',\n          banTime: '2023-03-05 10:20:15',\n          expireTime: '2023-03-12 10:20:15',\n          status: 'expired'\n        }\n      ],\n      filteredBans: [],\n      multipleSelection: [],\n      currentPage: 1,\n      pageSize: 10,\n      totalBans: 0,\n      \n      // 对话框相关\n      dialogVisible: false,\n      dialogTitle: '新增封禁',\n      banForm: {\n        id: null,\n        name: '',\n        banType: 'accountBan',\n        reason: '',\n        duration: '7d',\n        customEndDate: null\n      },\n      banRules: {\n        name: [\n          { required: true, message: '请输入玩家名称', trigger: 'blur' }\n        ],\n        banType: [\n          { required: true, message: '请选择封禁类型', trigger: 'change' }\n        ],\n        reason: [\n          { required: true, message: '请输入封禁原因', trigger: 'blur' }\n        ],\n        duration: [\n          { required: true, message: '请选择封禁时长', trigger: 'change' }\n        ],\n        customEndDate: [\n          { required: true, message: '请选择截止日期', trigger: 'change' }\n        ]\n      },\n      \n      // 模拟玩家列表数据用于自动补全\n      players: [\n        { value: '猪王爱烤肉' },\n        { value: '沃利大厨' },\n        { value: '麦斯威尔' },\n        { value: '温蒂的鬼魂' },\n        { value: '旺达时光机' },\n        { value: '韦伯蜘蛛窝' },\n        { value: '薇格弗德火女' },