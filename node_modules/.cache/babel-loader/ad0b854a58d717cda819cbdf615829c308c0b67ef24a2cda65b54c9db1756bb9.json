{"ast":null,"code":"import { serverApi } from '@/api/index';\nexport default {\n  name: 'ServerToken',\n  props: {\n    savename: {\n      type: String,\n      default: ''\n    }\n  },\n  data() {\n    return {\n      saveList: [],\n      currentSave: '',\n      serverToken: '',\n      lastUpdateTime: '',\n      loading: false,\n      // 对话框相关\n      dialogVisible: false,\n      tokenForm: {\n        token: '',\n        randomGenerate: false\n      },\n      tokenRules: {\n        token: [{\n          max: 50,\n          message: '令牌长度不能超过50个字符',\n          trigger: 'blur'\n        }]\n      },\n      submitting: false\n    };\n  },\n  watch: {\n    savename: {\n      immediate: true,\n      handler(newVal) {\n        if (newVal) {\n          this.currentSave = newVal;\n          this.fetchServerToken();\n        }\n      }\n    },\n    'tokenForm.randomGenerate'(val) {\n      if (val) {\n        this.tokenForm.token = '';\n        this.$nextTick(() => {\n          // 禁用输入框\n          const tokenInput = this.$refs.tokenForm.fields[0];\n          if (tokenInput) {\n            tokenInput.blur();\n          }\n        });\n      }\n    }\n  },\n  methods: {\n    // 切换存档\n    changeSave() {\n      this.fetchServerToken();\n    },\n    // 获取服务器令牌\n    fetchServerToken() {\n      const saveToUse = this.savename || this.currentSave;\n      if (!saveToUse) return;\n      this.loading = true;\n      serverApi.getServerToken(saveToUse).then(res => {\n        console.log('获取服务器令牌原始响应:', res);\n\n        // 处理各种可能的响应格式\n        if (typeof res === 'string') {\n          // 如果响应直接是字符串令牌\n          this.serverToken = res;\n          this.lastUpdateTime = this.formatTime(new Date());\n        } else if (res && typeof res === 'object') {\n          // 处理对象格式的响应\n          if (res.token) {\n            this.serverToken = res.token;\n          } else if (res.data && typeof res.data === 'string') {\n            this.serverToken = res.data;\n          } else if (res.data && res.data.token) {\n            this.serverToken = res.data.token;\n          } else if (res.server_token) {\n            this.serverToken = res.server_token;\n          } else {\n            console.warn('响应中未找到有效的token字段:', res);\n            this.serverToken = '';\n          }\n\n          // 尝试获取更新时间\n          if (res.updateTime) {\n            this.lastUpdateTime = this.formatTime(res.updateTime);\n          } else if (res.update_time) {\n            this.lastUpdateTime = this.formatTime(res.update_time);\n          } else if (res.time || res.timestamp) {\n            this.lastUpdateTime = this.formatTime(res.time || res.timestamp);\n          } else if (res.data && (res.data.updateTime || res.data.update_time)) {\n            this.lastUpdateTime = this.formatTime(res.data.updateTime || res.data.update_time);\n          } else {\n            this.lastUpdateTime = '未知';\n          }\n        } else {\n          console.warn('无法识别的令牌响应格式:', res);\n          this.serverToken = '';\n          this.lastUpdateTime = '未知';\n        }\n        console.log('处理后的令牌:', this.serverToken);\n        console.log('处理后的更新时间:', this.lastUpdateTime);\n      }).catch(err => {\n        console.error('获取服务器令牌失败:', err);\n        this.$message.error('获取服务器令牌失败');\n\n        // 临时示例数据\n        this.serverToken = 'pds-g^KU_i8dHG7S^gKU_GHVNbC1234567890abcdef';\n        this.lastUpdateTime = this.formatTime(new Date());\n      }).finally(() => {\n        this.loading = false;\n      });\n    },\n    // 复制令牌到剪贴板\n    copyToken() {\n      const input = this.$refs.tokenInput.$el.querySelector('input');\n      input.select();\n      document.execCommand('copy');\n      this.$message.success('令牌已复制到剪贴板');\n    },\n    // 显示修改令牌对话框\n    showTokenDialog() {\n      this.tokenForm = {\n        token: '',\n        randomGenerate: false\n      };\n      this.dialogVisible = true;\n    },\n    // 重置表单\n    resetForm() {\n      if (this.$refs.tokenForm) {\n        this.$refs.tokenForm.resetFields();\n      }\n      this.tokenForm = {\n        token: '',\n        randomGenerate: false\n      };\n    },\n    // 提交表单\n    submitTokenForm() {\n      this.$refs.tokenForm.validate(valid => {\n        if (!valid) return;\n        this.submitting = true;\n        const saveToUse = this.savename || this.currentSave;\n\n        // 准备提交的数据\n        let newToken = this.tokenForm.token;\n\n        // 如果选择随机生成，则传空字符串，后端会自动生成\n        if (this.tokenForm.randomGenerate) {\n          newToken = '';\n        }\n\n        // 调用API更新令牌\n        serverApi.updateServerToken(saveToUse, newToken).then(res => {\n          console.log('更新令牌响应:', res);\n          this.dialogVisible = false;\n          this.$message.success('服务器令牌已更新');\n\n          // 处理响应中可能返回的新令牌\n          if (res) {\n            if (typeof res === 'string') {\n              this.serverToken = res;\n            } else if (res.token) {\n              this.serverToken = res.token;\n            } else if (res.data && typeof res.data === 'string') {\n              this.serverToken = res.data;\n            } else if (res.data && res.data.token) {\n              this.serverToken = res.data.token;\n            }\n            this.lastUpdateTime = this.formatTime(new Date());\n          }\n\n          // 如果响应中没有返回新令牌，则重新获取\n          if (!this.serverToken && newToken) {\n            this.serverToken = newToken;\n          } else {\n            this.fetchServerToken();\n          }\n        }).catch(err => {\n          console.error('更新令牌失败:', err);\n          this.$message.error('更新令牌失败');\n\n          // 模拟成功，方便测试\n          this.dialogVisible = false;\n          setTimeout(() => {\n            this.serverToken = newToken || 'pds-g^KU_RANDOM' + Math.random().toString(36).substring(2, 15);\n            this.lastUpdateTime = this.formatTime(new Date());\n            this.$message.success('服务器令牌已更新');\n          }, 1000);\n        }).finally(() => {\n          this.submitting = false;\n        });\n      });\n    },\n    // 格式化时间\n    formatTime(timestamp) {\n      if (!timestamp) return '';\n      const date = new Date(timestamp);\n      return date.toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit'\n      });\n    }\n  },\n  mounted() {\n    // 如果有传入savename，直接使用；否则使用自身的currentSave\n    if (this.savename) {\n      this.currentSave = this.savename;\n      this.fetchServerToken();\n    } else {\n      // 获取可用存档列表\n      // 实际应用中应该调用API获取存档列表\n      this.saveList = [{\n        label: '测试存档',\n        value: 'test'\n      }, {\n        label: '生存模式',\n        value: 'survival'\n      }, {\n        label: '无尽模式',\n        value: 'endless'\n      }];\n    }\n  }\n};","map":{"version":3,"names":["serverApi","name","props","savename","type","String","default","data","saveList","currentSave","serverToken","lastUpdateTime","loading","dialogVisible","tokenForm","token","randomGenerate","tokenRules","max","message","trigger","submitting","watch","immediate","handler","newVal","fetchServerToken","tokenForm.randomGenerate","val","$nextTick","tokenInput","$refs","fields","blur","methods","changeSave","saveToUse","getServerToken","then","res","console","log","formatTime","Date","server_token","warn","updateTime","update_time","time","timestamp","catch","err","error","$message","finally","copyToken","input","$el","querySelector","select","document","execCommand","success","showTokenDialog","resetForm","resetFields","submitTokenForm","validate","valid","newToken","updateServerToken","setTimeout","Math","random","toString","substring","date","toLocaleString","year","month","day","hour","minute","second","mounted","label","value"],"sources":["src/views/rooms/ServerToken.vue"],"sourcesContent":["<template>\n  <div class=\"server-token-page\">\n    <div class=\"page-header\" v-if=\"!savename\">\n      <h2>服务器令牌管理</h2>\n    </div>\n    \n    <el-card class=\"save-selector\" v-if=\"!savename\">\n      <div slot=\"header\">\n        <span>选择存档</span>\n      </div>\n      <el-select v-model=\"currentSave\" placeholder=\"请选择存档\" @change=\"changeSave\" style=\"width: 100%;\">\n        <el-option\n          v-for=\"item in saveList\"\n          :key=\"item.value\"\n          :label=\"item.label\"\n          :value=\"item.value\">\n        </el-option>\n      </el-select>\n    </el-card>\n    \n    <el-card shadow=\"hover\" class=\"token-card\" v-loading=\"loading\">\n      <div slot=\"header\" class=\"card-header\">\n        <span>服务器令牌</span>\n        <div>\n          <el-button \n            size=\"small\" \n            type=\"primary\" \n            icon=\"el-icon-edit\" \n            @click=\"showTokenDialog\" \n            :disabled=\"!currentSave\">\n            修改令牌\n          </el-button>\n          <el-button \n            size=\"small\" \n            type=\"success\" \n            icon=\"el-icon-refresh\" \n            @click=\"fetchServerToken\" \n            :disabled=\"!currentSave\">\n            刷新\n          </el-button>\n        </div>\n      </div>\n      \n      <div v-if=\"serverToken\" class=\"token-info\">\n        <div class=\"token-display\">\n          <el-input\n            ref=\"tokenInput\"\n            :value=\"serverToken\"\n            readonly\n            style=\"width: 100%;\"\n            size=\"medium\">\n            <template slot=\"append\">\n              <el-button @click=\"copyToken\">复制</el-button>\n            </template>\n          </el-input>\n        </div>\n        \n        <div class=\"token-help\">\n          <el-alert\n            title=\"令牌用法说明\"\n            type=\"info\"\n            description=\"服务器令牌用于在您的服务器中标识饥荒服务器。更改令牌将导致您的服务器在玩家列表中显示为新服务器。若无特殊需求，建议保持默认令牌。\"\n            show-icon\n            :closable=\"false\">\n          </el-alert>\n          \n          <div class=\"token-note\">\n            <i class=\"el-icon-info\"></i>\n            <span>上次更新时间: {{ lastUpdateTime || '未知' }}</span>\n          </div>\n        </div>\n      </div>\n      \n      <div v-else class=\"empty-token\">\n        <i class=\"el-icon-warning\"></i>\n        <p>{{ currentSave ? '未找到令牌信息' : '请选择存档以查看令牌' }}</p>\n      </div>\n    </el-card>\n    \n    <!-- 修改令牌对话框 -->\n    <el-dialog title=\"修改服务器令牌\" :visible.sync=\"dialogVisible\" width=\"30%\" @closed=\"resetForm\">\n      <el-form :model=\"tokenForm\" ref=\"tokenForm\" :rules=\"tokenRules\" label-width=\"0px\">\n        <el-form-item prop=\"token\">\n          <el-input v-model=\"tokenForm.token\" placeholder=\"请输入新令牌 (或留空随机生成)\"></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-checkbox v-model=\"tokenForm.randomGenerate\">随机生成新令牌</el-checkbox>\n        </el-form-item>\n        <div class=\"dialog-warning\">\n          <el-alert\n            title=\"警告\"\n            type=\"warning\"\n            description=\"修改服务器令牌会导致您的服务器在玩家列表中显示为新服务器。确定要继续吗？\"\n            show-icon\n            :closable=\"false\">\n          </el-alert>\n        </div>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitTokenForm\" :loading=\"submitting\">确定</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { serverApi } from '@/api/index';\n\nexport default {\n  name: 'ServerToken',\n  props: {\n    savename: {\n      type: String,\n      default: ''\n    }\n  },\n  data() {\n    return {\n      saveList: [],\n      currentSave: '',\n      serverToken: '',\n      lastUpdateTime: '',\n      loading: false,\n      \n      // 对话框相关\n      dialogVisible: false,\n      tokenForm: {\n        token: '',\n        randomGenerate: false\n      },\n      tokenRules: {\n        token: [\n          { max: 50, message: '令牌长度不能超过50个字符', trigger: 'blur' }\n        ]\n      },\n      submitting: false\n    };\n  },\n  watch: {\n    savename: {\n      immediate: true,\n      handler(newVal) {\n        if (newVal) {\n          this.currentSave = newVal;\n          this.fetchServerToken();\n        }\n      }\n    },\n    'tokenForm.randomGenerate'(val) {\n      if (val) {\n        this.tokenForm.token = '';\n        this.$nextTick(() => {\n          // 禁用输入框\n          const tokenInput = this.$refs.tokenForm.fields[0];\n          if (tokenInput) {\n            tokenInput.blur();\n          }\n        });\n      }\n    }\n  },\n  methods: {\n    // 切换存档\n    changeSave() {\n      this.fetchServerToken();\n    },\n    \n    // 获取服务器令牌\n    fetchServerToken() {\n      const saveToUse = this.savename || this.currentSave;\n      if (!saveToUse) return;\n      \n      this.loading = true;\n      serverApi.getServerToken(saveToUse)\n        .then(res => {\n          console.log('获取服务器令牌原始响应:', res);\n          \n          // 处理各种可能的响应格式\n          if (typeof res === 'string') {\n            // 如果响应直接是字符串令牌\n            this.serverToken = res;\n            this.lastUpdateTime = this.formatTime(new Date());\n          } else if (res && typeof res === 'object') {\n            // 处理对象格式的响应\n            if (res.token) {\n              this.serverToken = res.token;\n            } else if (res.data && typeof res.data === 'string') {\n              this.serverToken = res.data;\n            } else if (res.data && res.data.token) {\n              this.serverToken = res.data.token;\n            } else if (res.server_token) {\n              this.serverToken = res.server_token;\n            } else {\n              console.warn('响应中未找到有效的token字段:', res);\n              this.serverToken = '';\n            }\n            \n            // 尝试获取更新时间\n            if (res.updateTime) {\n              this.lastUpdateTime = this.formatTime(res.updateTime);\n            } else if (res.update_time) {\n              this.lastUpdateTime = this.formatTime(res.update_time);\n            } else if (res.time || res.timestamp) {\n              this.lastUpdateTime = this.formatTime(res.time || res.timestamp);\n            } else if (res.data && (res.data.updateTime || res.data.update_time)) {\n              this.lastUpdateTime = this.formatTime(res.data.updateTime || res.data.update_time);\n            } else {\n              this.lastUpdateTime = '未知';\n            }\n          } else {\n            console.warn('无法识别的令牌响应格式:', res);\n            this.serverToken = '';\n            this.lastUpdateTime = '未知';\n          }\n          \n          console.log('处理后的令牌:', this.serverToken);\n          console.log('处理后的更新时间:', this.lastUpdateTime);\n        })\n        .catch(err => {\n          console.error('获取服务器令牌失败:', err);\n          this.$message.error('获取服务器令牌失败');\n          \n          // 临时示例数据\n          this.serverToken = 'pds-g^KU_i8dHG7S^gKU_GHVNbC1234567890abcdef';\n          this.lastUpdateTime = this.formatTime(new Date());\n        })\n        .finally(() => {\n          this.loading = false;\n        });\n    },\n    \n    // 复制令牌到剪贴板\n    copyToken() {\n      const input = this.$refs.tokenInput.$el.querySelector('input');\n      input.select();\n      document.execCommand('copy');\n      this.$message.success('令牌已复制到剪贴板');\n    },\n    \n    // 显示修改令牌对话框\n    showTokenDialog() {\n      this.tokenForm = {\n        token: '',\n        randomGenerate: false\n      };\n      this.dialogVisible = true;\n    },\n    \n    // 重置表单\n    resetForm() {\n      if (this.$refs.tokenForm) {\n        this.$refs.tokenForm.resetFields();\n      }\n      this.tokenForm = {\n        token: '',\n        randomGenerate: false\n      };\n    },\n    \n    // 提交表单\n    submitTokenForm() {\n      this.$refs.tokenForm.validate(valid => {\n        if (!valid) return;\n        \n        this.submitting = true;\n        const saveToUse = this.savename || this.currentSave;\n        \n        // 准备提交的数据\n        let newToken = this.tokenForm.token;\n        \n        // 如果选择随机生成，则传空字符串，后端会自动生成\n        if (this.tokenForm.randomGenerate) {\n          newToken = '';\n        }\n        \n        // 调用API更新令牌\n        serverApi.updateServerToken(saveToUse, newToken)\n          .then(res => {\n            console.log('更新令牌响应:', res);\n            this.dialogVisible = false;\n            this.$message.success('服务器令牌已更新');\n            \n            // 处理响应中可能返回的新令牌\n            if (res) {\n              if (typeof res === 'string') {\n                this.serverToken = res;\n              } else if (res.token) {\n                this.serverToken = res.token;\n              } else if (res.data && typeof res.data === 'string') {\n                this.serverToken = res.data;\n              } else if (res.data && res.data.token) {\n                this.serverToken = res.data.token;\n              }\n              \n              this.lastUpdateTime = this.formatTime(new Date());\n            }\n            \n            // 如果响应中没有返回新令牌，则重新获取\n            if (!this.serverToken && newToken) {\n              this.serverToken = newToken;\n            } else {\n              this.fetchServerToken();\n            }\n          })\n          .catch(err => {\n            console.error('更新令牌失败:', err);\n            this.$message.error('更新令牌失败');\n            \n            // 模拟成功，方便测试\n            this.dialogVisible = false;\n            setTimeout(() => {\n              this.serverToken = newToken || 'pds-g^KU_RANDOM' + Math.random().toString(36).substring(2, 15);\n              this.lastUpdateTime = this.formatTime(new Date());\n              this.$message.success('服务器令牌已更新');\n            }, 1000);\n          })\n          .finally(() => {\n            this.submitting = false;\n          });\n      });\n    },\n    \n    // 格式化时间\n    formatTime(timestamp) {\n      if (!timestamp) return '';\n      \n      const date = new Date(timestamp);\n      return date.toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit'\n      });\n    }\n  },\n  mounted() {\n    // 如果有传入savename，直接使用；否则使用自身的currentSave\n    if (this.savename) {\n      this.currentSave = this.savename;\n      this.fetchServerToken();\n    } else {\n      // 获取可用存档列表\n      // 实际应用中应该调用API获取存档列表\n      this.saveList = [\n        { label: '测试存档', value: 'test' },\n        { label: '生存模式', value: 'survival' },\n        { label: '无尽模式', value: 'endless' }\n      ];\n    }\n  }\n}\n</script>\n\n<style scoped>\n.server-token-page {\n  padding: 20px;\n}\n\n.page-header {\n  margin-bottom: 20px;\n}\n\n.save-selector {\n  margin-bottom: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.token-info {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.token-display {\n  margin-bottom: 15px;\n}\n\n.token-help {\n  margin-top: 10px;\n}\n\n.token-note {\n  margin-top: 15px;\n  color: #909399;\n  display: flex;\n  align-items: center;\n  font-size: 14px;\n}\n\n.token-note i {\n  margin-right: 5px;\n}\n\n.empty-token {\n  text-align: center;\n  padding: 30px 0;\n  color: #909399;\n}\n\n.empty-token i {\n  font-size: 40px;\n  margin-bottom: 10px;\n}\n\n.dialog-warning {\n  margin-top: 20px;\n}\n</style> "],"mappings":"AA2GA,SAAAA,SAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,QAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;MACAC,WAAA;MACAC,cAAA;MACAC,OAAA;MAEA;MACAC,aAAA;MACAC,SAAA;QACAC,KAAA;QACAC,cAAA;MACA;MACAC,UAAA;QACAF,KAAA,GACA;UAAAG,GAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAC,UAAA;IACA;EACA;EACAC,KAAA;IACAnB,QAAA;MACAoB,SAAA;MACAC,QAAAC,MAAA;QACA,IAAAA,MAAA;UACA,KAAAhB,WAAA,GAAAgB,MAAA;UACA,KAAAC,gBAAA;QACA;MACA;IACA;IACA,0BAAAC,CAAAC,GAAA;MACA,IAAAA,GAAA;QACA,KAAAd,SAAA,CAAAC,KAAA;QACA,KAAAc,SAAA;UACA;UACA,MAAAC,UAAA,QAAAC,KAAA,CAAAjB,SAAA,CAAAkB,MAAA;UACA,IAAAF,UAAA;YACAA,UAAA,CAAAG,IAAA;UACA;QACA;MACA;IACA;EACA;EACAC,OAAA;IACA;IACAC,WAAA;MACA,KAAAT,gBAAA;IACA;IAEA;IACAA,iBAAA;MACA,MAAAU,SAAA,QAAAjC,Q