     surviveDays: 28,\n        deathCount: 15,\n        ipAddress: '192.168.1.104',\n        notes: ''\n      }, {\n        id: 5,\n        avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n        name: '旺达时光机',\n        role: '旺达',\n        lastServer: '模组服务器',\n        playtime: '43小时',\n        status: 'online',\n        lastLogin: '2023-03-21 11:20:33',\n        registerTime: '2023-03-01 09:25:00',\n        surviveDays: 18,\n        deathCount: 5,\n        ipAddress: '192.168.1.105',\n        notes: '新玩家，需要帮助'\n      }, {\n        id: 6,\n        avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n        name: '韦伯蜘蛛窝',\n        role: '韦伯',\n        lastServer: '洞穴服务器',\n        playtime: '178小时',\n        status: 'online',\n        lastLogin: '2023-03-21 08:15:40',\n        registerTime: '2022-11-12 14:50:00',\n        surviveDays: 95,\n        deathCount: 17,\n        ipAddress: '192.168.1.106',\n        notes: ''\n      }, {\n        id: 7,\n        avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n        name: '薇格弗德火女',\n        role: '薇格弗德',\n        lastServer: '主世界服务器',\n        playtime: '152小时',\n        status: 'offline',\n        lastLogin: '2023-03-20 18:40:22',\n        registerTime: '2022-12-30 11:15:00',\n        surviveDays: 84,\n        deathCount: 14,\n        ipAddress: '192.168.1.107',\n        notes: ''\n      }, {\n        id: 8,\n        avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n        name: '大力士沃尔夫冈',\n        role: '沃尔夫冈',\n        lastServer: 'PVP服务器',\n        playtime: '96小时',\n        status: 'offline',\n        lastLogin: '2023-03-20 20:10:05',\n        registerTime: '2023-01-25 16:30:00',\n        surviveDays: 35,\n        deathCount: 22,\n        ipAddress: '192.168.1.108',\n        notes: 'PVP积极玩家'\n      }],\n      filteredPlayers: [],\n      currentPage: 1,\n      pageSize: 10,\n      totalPlayers: 0,\n      detailsVisible: false,\n      currentPlayer: {}\n    };\n  },\n  created() {\n    this.initData();\n  },\n  methods: {\n    initData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.filteredPlayers = [...this.players];\n        this.totalPlayers = this.players.length;\n        this.loading = false;\n      }, 500);\n    },\n    refreshData() {\n      this.loading = true;\n      setTimeout(() => {\n        this.$message({\n          message: '数据已刷新',\n          type: 'success'\n        });\n        this.loading = false;\n      }, 800);\n    },\n    onSearch() {\n      this.loading = true;\n      setTimeout(() => {\n        this.filteredPlayers = this.players.filter(player => {\n          let matchName = true;\n          let matchServer = true;\n          let matchStatus = true;\n          if (this.searchForm.name) {\n            matchName = player.name.includes(this.searchForm.name);\n          }\n          if (this.searchForm.server) {\n            matchServer = player.lastServer === this.searchForm.server;\n          }\n          if (this.searchForm.status) {\n            matchStatus = player.status === this.searchForm.status;\n          }\n          return matchName && matchServer && matchStatus;\n        });\n        this.totalPlayers = this.filteredPlayers.length;\n        this.currentPage = 1;\n        this.loading = false;\n      }, 500);\n    },\n    resetSearch() {\n      this.searchForm = {\n        name: '',\n        server: '',\n        status: ''\n      };\n      this.initData();\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n    },\n    getTagType(role) {\n      const roleMap = {\n        '薇诺娜': 'warning',\n        '沃利': 'success',\n        '麦斯威尔': 'info',\n        '温蒂': 'primary',\n        '旺达': 'warning',\n        '韦伯': 'danger',\n        '薇格弗德': 'danger',\n        '沃尔夫冈': 'primary'\n      };\n      return roleMap[role] || '';\n    },\n    handleViewDetails(row) {\n      this.currentPlayer = {\n        ...row\n      };\n      this.detailsVisible = true;\n    },\n    handleMessage(player) {\n      this.$prompt(`发送消息给玩家 ${player.name}`, '私信', {\n        confirmButtonText: '发送',\n        cancelButtonText: '取消',\n        inputPlaceholder: '请输入消息内容'\n      }).then(({\n        value\n      }) => {\n        this.$message({\n          type: 'success',\n          message: `消息已发送给 ${player.name}！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消发送'\n        });\n      });\n    },\n    handleKick(player) {\n      this.$confirm(`确定要将玩家 \"${player.name}\" 踢出服务器吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.$message({\n          type: 'success',\n          message: `已将玩家 ${player.name} 踢出服务器！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleBan(player) {\n      this.$confirm(`确定要封禁玩家 \"${player.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.$message({\n          type: 'success',\n          message: `已封禁玩家 ${player.name}！`\n        });\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","loading","searchForm","server","status","players","id","avatar","role","lastServer","playtime","lastLogin","registerTime","surviveDays","deathCount","ipAddress","notes","filteredPlayers","currentPage","pageSize","totalPlayers","detailsVisible","currentPlayer","created","initData","methods","setTimeout","length","refreshData","$message","message","type","onSearch","filter","player","matchName","matchServer","matchStatus","includes","resetSearch","handleSizeChange","val","handleCurrentChange","getTagType","roleMap","handleViewDetails","row","handleMessage","$prompt","confirmButtonText","cancelButtonText","inputPlaceholder","then","value","catch","handleKick","$confirm","handleBan"],"sources":["src/views/players/PlayerList.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card class=\"main-card\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>玩家列表</span>\n        <el-button style=\"float: right; padding: 3px 0\" type=\"text\" @click=\"refreshData\">刷新</el-button>\n      </div>\n\n      <!-- 搜索栏 -->\n      <div class=\"search-bar\">\n        <el-form :inline=\"true\" :model=\"searchForm\" class=\"form-inline\">\n          <el-form-item label=\"玩家名称\">\n            <el-input v-model=\"searchForm.name\" placeholder=\"输入玩家名称\" clearable></el-input>\n          </el-form-item>\n          <el-form-item label=\"所在服务器\">\n            <el-select v-model=\"searchForm.server\" placeholder=\"选择服务器\" clearable>\n              <el-option label=\"主世界服务器\" value=\"主世界服务器\"></el-option>\n              <el-option label=\"洞穴服务器\" value=\"洞穴服务器\"></el-option>\n              <el-option label=\"模组服务器\" value=\"模组服务器\"></el-option>\n              <el-option label=\"PVP服务器\" value=\"PVP服务器\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item label=\"状态\">\n            <el-select v-model=\"searchForm.status\" placeholder=\"玩家状态\" clearable>\n              <el-option label=\"在线\" value=\"online\"></el-option>\n              <el-option label=\"离线\" value=\"offline\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item>\n            <el-button type=\"primary\" @click=\"onSearch\">查询</el-button>\n            <el-button @click=\"resetSearch\">重置</el-button>\n          </el-form-item>\n        </el-form>\n      </div>\n\n      <!-- 玩家表格 -->\n      <el-table\n        :data=\"filteredPlayers\"\n        v-loading=\"loading\"\n        style=\"width: 100%\"\n        border>\n        <el-table-column label=\"玩家头像\" width=\"80\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-avatar :src=\"scope.row.avatar\" :size=\"40\"></el-avatar>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"name\" label=\"玩家名称\" min-width=\"120\"></el-table-column>\n        <el-table-column prop=\"role\" label=\"角色\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"getTagType(scope.row.role)\" size=\"medium\">{{ scope.row.role }}</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"lastServer\" label=\"最后在线服务器\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"playtime\" label=\"游戏时长\" width=\"110\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === 'online' ? 'success' : 'info'\" size=\"medium\">\n              {{ scope.row.status === 'online' ? '在线' : '离线' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"lastLogin\" label=\"最后登录时间\" width=\"180\" align=\"center\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"260\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" @click=\"handleViewDetails(scope.row)\">详情</el-button>\n            <el-button size=\"mini\" type=\"success\" @click=\"handleMessage(scope.row)\" :disabled=\"scope.row.status !== 'online'\">私信</el-button>\n            <el-button size=\"mini\" type=\"warning\" @click=\"handleKick(scope.row)\" :disabled=\"scope.row.status !== 'online'\">踢出</el-button>\n            <el-button size=\"mini\" type=\"danger\" @click=\"handleBan(scope.row)\">封禁</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <!-- 分页器 -->\n      <div class=\"pagination-container\">\n        <el-pagination\n          @size-change=\"handleSizeChange\"\n          @current-change=\"handleCurrentChange\"\n          :current-page=\"currentPage\"\n          :page-sizes=\"[10, 20, 50, 100]\"\n          :page-size=\"pageSize\"\n          layout=\"total, sizes, prev, pager, next, jumper\"\n          :total=\"totalPlayers\">\n        </el-pagination>\n      </div>\n    </el-card>\n\n    <!-- 玩家详情对话框 -->\n    <el-dialog title=\"玩家详情\" :visible.sync=\"detailsVisible\" width=\"600px\">\n      <el-descriptions :column=\"2\" border>\n        <el-descriptions-item label=\"玩家名称\">{{ currentPlayer.name }}</el-descriptions-item>\n        <el-descriptions-item label=\"角色\">{{ currentPlayer.role }}</el-descriptions-item>\n        <el-descriptions-item label=\"累计游戏时长\">{{ currentPlayer.playtime }}</el-descriptions-item>\n        <el-descriptions-item label=\"状态\">\n          <el-tag :type=\"currentPlayer.status === 'online' ? 'success' : 'info'\" size=\"medium\">\n            {{ currentPlayer.status === 'online' ? '在线' : '离线' }}\n          </el-tag>\n        </el-descriptions-item>\n        <el-descriptions-item label=\"所在服务器\">{{ currentPlayer.lastServer }}</el-descriptions-item>\n        <el-descriptions-item label=\"最后登录时间\">{{ currentPlayer.lastLogin }}</el-descriptions-item>\n        <el-descriptions-item label=\"注册时间\" :span=\"2\">{{ currentPlayer.registerTime }}</el-descriptions-item>\n        <el-descriptions-item label=\"生存天数\">{{ currentPlayer.surviveDays }}</el-descriptions-item>\n        <el-descriptions-item label=\"死亡次数\">{{ currentPlayer.deathCount }}</el-descriptions-item>\n        <el-descriptions-item label=\"IP地址\" :span=\"2\">{{ currentPlayer.ipAddress }}</el-descriptions-item>\n        <el-descriptions-item label=\"备注\" :span=\"2\">\n          {{ currentPlayer.notes || '暂无备注' }}\n        </el-descriptions-item>\n      </el-descriptions>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button type=\"success\" @click=\"handleMessage(currentPlayer)\" :disabled=\"currentPlayer.status !== 'online'\">私信</el-button>\n        <el-button type=\"warning\" @click=\"handleKick(currentPlayer)\" :disabled=\"currentPlayer.status !== 'online'\">踢出</el-button>\n        <el-button type=\"danger\" @click=\"handleBan(currentPlayer)\">封禁</el-button>\n        <el-button @click=\"detailsVisible = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'PlayerList',\n  data() {\n    return {\n      loading: false,\n      searchForm: {\n        name: '',\n        server: '',\n        status: ''\n      },\n      players: [\n        {\n          id: 1,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '猪王爱烤肉',\n          role: '薇诺娜',\n          lastServer: '主世界服务器',\n          playtime: '126小时',\n          status: 'online',\n          lastLogin: '2023-03-21 08:45:12',\n          registerTime: '2022-12-05 14:30:00',\n          surviveDays: 78,\n          deathCount: 12,\n          ipAddress: '192.168.1.101',\n          notes: '常玩玩家，是服务器的老用户'\n        },\n        {\n          id: 2,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '沃利大厨',\n          role: '沃利',\n          lastServer: '主世界服务器',\n          playtime: '87小时',\n          status: 'online',\n          lastLogin: '2023-03-21 09:15:30',\n          registerTime: '2023-01-15 10:20:00',\n          surviveDays: 42,\n          deathCount: 8,\n          ipAddress: '192.168.1.102',\n          notes: ''\n        },\n        {\n          id: 3,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '麦斯威尔',\n          role: '麦斯威尔',\n          lastServer: '洞穴服务器',\n          playtime: '215小时',\n          status: 'online',\n          lastLogin: '2023-03-21 07:30:45',\n          registerTime: '2022-10-08 16:45:00',\n          surviveDays: 123,\n          deathCount: 20,\n          ipAddress: '192.168.1.103',\n          notes: '经常组队探险'\n        },\n        {\n          id: 4,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '温蒂的鬼魂',\n          role: '温蒂',\n          lastServer: '主世界服务器',\n          playtime: '62小时',\n          status: 'online',\n          lastLogin: '2023-03-21 10:05:18',\n          registerTime: '2023-02-20 12:10:00',\n          surviveDays: 28,\n          deathCount: 15,\n          ipAddress: '192.168.1.104',\n          notes: ''\n        },\n        {\n          id: 5,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '旺达时光机',\n          role: '旺达',\n          lastServer: '模组服务器',\n          playtime: '43小时',\n          status: 'online',\n          lastLogin: '2023-03-21 11:20:33',\n          registerTime: '2023-03-01 09:25:00',\n          surviveDays: 18,\n          deathCount: 5,\n          ipAddress: '192.168.1.105',\n          notes: '新玩家，需要帮助'\n        },\n        {\n          id: 6,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '韦伯蜘蛛窝',\n          role: '韦伯',\n          lastServer: '洞穴服务器',\n          playtime: '178小时',\n          status: 'online',\n          lastLogin: '2023-03-21 08:15:40',\n          registerTime: '2022-11-12 14:50:00',\n          surviveDays: 95,\n          deathCount: 17,\n          ipAddress: '192.168.1.106',\n          notes: ''\n        },\n        {\n          id: 7,\n          avatar: 'https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png',\n          name: '薇格弗德火女',\n          role: '薇格弗德',\n          lastServer: '主世界服务器',\n          playtime: '152小时',\n          status: 'offline',\n          lastLogin: '2023-03-20 18:40:22',\n          registerTime: '2022-12-30