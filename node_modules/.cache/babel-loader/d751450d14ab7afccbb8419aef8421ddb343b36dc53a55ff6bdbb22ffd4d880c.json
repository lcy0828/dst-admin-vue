{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport ModConfigDialog from './ModConfigDialog.vue';\nexport default {\n  name: 'ModSearch',\n  components: {\n    ModConfigDialog\n  },\n  data() {\n    return {\n      // 搜索表单\n      searchForm: {\n        keyword: '',\n        category: '',\n        sortBy: 'popular'\n      },\n      // 加载状态\n      loading: false,\n      // 搜索结果\n      searchResults: [],\n      // 是否已经搜索过\n      hasSearched: false,\n      // 分页\n      currentPage: 1,\n      pageSize: 12,\n      totalResults: 0,\n      // 详情对话框\n      detailsDialogVisible: false,\n      currentMod: null,\n      currentModId: null,\n      // 配置对话框\n      configDialogVisible: false,\n      // Workshop URL导入\n      workshopUrl: '',\n      // 默认图片\n      defaultImage: 'https://placehold.co/400x225/909399/FFFFFF?text=NO+IMAGE'\n    };\n  },\n  created() {\n    // 检查URL参数中是否有搜索关键词\n    const urlParams = new URLSearchParams(window.location.search);\n    const keyword = urlParams.get('keyword');\n    if (keyword) {\n      this.searchForm.keyword = keyword;\n      this.searchMods();\n    }\n  },\n  methods: {\n    // 搜索模组\n    searchMods() {\n      this.loading = true;\n      this.hasSearched = true;\n      this.currentPage = 1;\n\n      // 模拟API搜索\n      setTimeout(() => {\n        // 生成测试数据\n        this.totalResults = 28;\n        this.searchResults = [{\n          id: '2675609101',\n          name: '终极棱镜',\n          author: 'WIGFRID',\n          description: '来自泰拉瑞亚的强大魔法武器。这个模组为游戏添加了一种强力的魔法武器，可以发射彩虹光线攻击敌人。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1834650713180144448/9AEF44B007018B8BD48A8BA29874E31C069295D9/',\n          subscribers: 12589,\n          updatedAt: '2023-10-15',\n          version: '1.0.4',\n          isInstalled: true,\n          tags: ['武器', '魔法', '物品'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          }\n        }, {\n          id: '1392778117',\n          name: 'Legion-棱镜',\n          author: 'ti_Tout',\n          description: '一款强大的武器模组，增加了多种棱镜武器。包括不同级别的棱镜，每种都有不同的效果和攻击方式。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1021698814063197415/5348EF5526A2526D1A59E45AFA3A3C6299ABD826/',\n          subscribers: 34267,\n          updatedAt: '2023-03-02',\n          version: '1.0.2',\n          isInstalled: true,\n          tags: ['武器', '物品', '装备'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          }\n        }, {\n          id: '2274573725',\n          name: '防御塔',\n          author: 'DefenderDev',\n          description: '增加了多种防御塔，可以自动攻击附近的敌人。包括火焰塔、冰霜塔、雷电塔等多种类型。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1778353442633873752/CADE0AABBB7F04012DD3EFA3F8CD180E57597E6A/',\n          subscribers: 54321,\n          updatedAt: '2023-06-28',\n          version: '2.1.5',\n          isInstalled: false,\n          tags: ['防御', '建筑', '战斗'],\n          compatibility: {\n            dst: true,\n            ds: true,\n            rog: true,\n            sw: false,\n            hamlet: false\n          }\n        }, {\n          id: '1185229307',\n          name: '厨师工作站',\n          author: 'MasterChef',\n          description: '添加了一个全新的厨师工作站，解锁更多烹饪配方和食物选择。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/856103174390469849/10B4CB4F8A11F284F73BC7C9DC5B1BB1C9839615/',\n          subscribers: 125476,\n          updatedAt: '2023-09-12',\n          version: '3.0.1',\n          isInstalled: false,\n          tags: ['食物', '烹饪', '工作站'],\n          compatibility: {\n            dst: true,\n            ds: true,\n            rog: true,\n            sw: true,\n            hamlet: true\n          }\n        }, {\n          id: '1505270912',\n          name: '额外物品栏',\n          author: 'InventoryPlus',\n          description: '扩展物品栏空间，添加了专用装备栏、护身符栏和额外的背包空间。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/947330690467435816/5E07575BC70F73A4D43F48E28D6540BC18D30E9B/',\n          subscribers: 298754,\n          updatedAt: '2023-05-19',\n          version: '2.5.0',\n          isInstalled: false,\n          tags: ['物品栏', '界面', '功能增强'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          }\n        }, {\n          id: '1872756407',\n          name: '自动采集',\n          author: 'LazyFarmer',\n          description: '添加自动采集功能，可以自动采集附近的资源和作物。',\n          previewImage: null,\n          subscribers: 67823,\n          updatedAt: '2023-04-05',\n          version: '1.3.7',\n          isInstalled: false,\n          tags: ['自动化', '采集', '工具'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          }\n        }, {\n          id: '1908933602',\n          name: '魔法师',\n          author: 'MageCreator',\n          description: '添加一个全新的角色：魔法师，拥有独特的魔法能力和法术系统。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/775103991156506493/9BF05B649F02BA196EE3B98125F6E4A48E97F810/',\n          subscribers: 142876,\n          updatedAt: '2023-08-17',\n          version: '2.0.0',\n          isInstalled: false,\n          tags: ['角色', '魔法', '技能'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          }\n        }, {\n          id: '2156328660',\n          name: '宠物系统',\n          author: 'PetLover',\n          description: '添加宠物系统，可以捕获和训练野生动物成为你的宠物。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1483325816731663113/FDB7EE08A5A4E7F648FCBB28A221D11AA93C7884/',\n          subscribers: 89542,\n          updatedAt: '2023-07-30',\n          version: '1.4.2',\n          isInstalled: false,\n          tags: ['宠物', '动物', '伙伴'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          }\n        }];\n        this.loading = false;\n      }, 1000);\n    },\n    // 重置搜索条件\n    resetSearch() {\n      this.searchForm = {\n        keyword: '',\n        category: '',\n        sortBy: 'popular'\n      };\n    },\n    // 页面变化处理\n    handlePageChange(page) {\n      this.currentPage = page;\n      this.loading = true;\n\n      // 模拟API分页请求\n      setTimeout(() => {\n        // 这里可以根据当前页码生成不同的测试数据\n\n        this.loading = false;\n      }, 800);\n    },\n    // 查看模组详情\n    viewDetails(mod) {\n      this.currentMod = mod;\n      this.detailsDialogVisible = true;\n    },\n    // 添加模组\n    addMod(mod) {\n      // 防止重复添加\n      if (mod.isInstalled) return;\n      this.currentMod = mod;\n      this.currentModId = mod.id;\n      this.configDialogVisible = true;\n    },\n    // 配置更新回调\n    handleConfigUpdated(data) {\n      // 模拟添加成功\n      setTimeout(() => {\n        // 更新模组状态为已安装\n        const mod = this.searchResults.find(m => m.id === data.modId);\n        if (mod) {\n          mod.isInstalled = true;\n        }\n        this.$message({\n          type: 'success',\n          message: `模组 ${this.currentMod.name} 已成功添加！`\n        });\n      }, 500);\n    },\n    // 从URL导入模组\n    importFromUrl() {\n      if (!this.workshopUrl) {\n        this.$message({\n          type: 'warning',\n          message: '请输入有效的Steam Workshop URL'\n        });\n        return;\n      }\n      this.loading = true;\n\n      // 尝试从URL中提取模组ID\n      let modId = null;\n      try {\n        const url = new URL(this.workshopUrl);\n        // 处理典型的Steam Workshop URL\n        // 例如: https://steamcommunity.com/sharedfiles/filedetails/?id=2675609101\n        const params = new URLSearchParams(url.search);\n        modId = params.get('id');\n\n        // 如果URL中没有ID参数，尝试从路径中提取\n        if (!modId && url.pathname.includes('/filedetails/')) {\n          modId = url.pathname.split('/filedetails/')[1];\n        }\n      } catch (e) {\n        // URL解析失败，尝试使用正则表达式\n        const regexResult = /[?&]id=(\\d+)/.exec(this.workshopUrl);\n        if (regexResult && regexResult[1]) {\n          modId = regexResult[1];\n        }\n      }\n      if (!modId) {\n        this.loading = false;\n        this.$message({\n          type: 'error',\n          message: '无法从URL中提取模组ID，请确保URL格式正确'\n        });\n        return;\n      }\n\n      // 模拟从API获取模组信息\n      setTimeout(() => {\n        // 假设我们找到了模组信息\n        const foundMod = {\n          id: modId,\n          name: '从URL导入的模组',\n          author: 'Workshop创作者',\n          description: '这是一个从Steam Workshop URL导入的模组。包含了各种有趣的功能和内容。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1695028253726448079/9B7A6B4D4F6CFAA12B4754FAC77FC0B6A1395CDF/',\n          subscribers: 45678,\n          updatedAt: '2023-11-25',\n          version: '1.2.3',\n          isInstalled: false,\n          tags: ['导入', '未分类'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          },\n          configuration_options: [{\n            \"hover\": \"语言设置\",\n            \"name\": \"language\",\n            \"label\": \"语言\",\n            \"default\": \"cn\",\n            \"options\": [{\n              \"description\": \"简体中文\",\n              \"data\": \"cn\"\n            }, {\n              \"description\": \"English\",\n              \"data\": \"en\"\n            }]\n          }, {\n            \"default\": 0,\n            \"options\": [{\n              \"description\": \"\",\n              \"data\": 0\n            }],\n            \"name\": \"null\",\n            \"label\": \"基本设置\"\n          }, {\n            \"hover\": \"难度设置\",\n            \"name\": \"difficulty\",\n            \"label\": \"难度\",\n            \"default\": \"normal\",\n            \"options\": [{\n              \"description\": \"简单\",\n              \"data\": \"easy\"\n            }, {\n              \"description\": \"普通\",\n              \"data\": \"normal\"\n            }, {\n              \"description\": \"困难\",\n              \"data\": \"hard\"\n            }, {\n              \"description\": \"噩梦\",\n              \"data\": \"nightmare\"\n            }]\n          }, {\n            \"hover\": \"启用特殊能力\",\n            \"name\": \"special_ability\",\n            \"label\": \"特殊能力\",\n            \"default\": true,\n            \"options\": [{\n              \"description\": \"开启\",\n              \"data\": true\n            }, {\n              \"description\": \"关闭\",\n              \"data\": false\n            }]\n          }, {\n            \"default\": 0,\n            \"options\": [{\n              \"description\": \"\",\n              \"data\": 0\n            }],\n            \"name\": \"null\",\n            \"label\": \"高级设置\"\n          }, {\n            \"hover\": \"资源倍率\",\n            \"name\": \"resource_multiplier\",\n            \"label\": \"资源倍率\",\n            \"default\": 1,\n            \"options\": [{\n              \"description\": \"0.5x\",\n              \"data\": 0.5\n            }, {\n              \"description\": \"1x\",\n              \"data\": 1\n            }, {\n              \"description\": \"1.5x\",\n              \"data\": 1.5\n            }, {\n              \"description\": \"2x\",\n              \"data\": 2\n            }]\n          }, {\n            \"hover\": \"显示调试信息\",\n            \"name\": \"debug_info\",\n            \"label\": \"调试信息\",\n            \"default\": false,\n            \"options\": [{\n              \"description\": \"显示\",\n              \"data\": true\n            }, {\n              \"description\": \"隐藏\",\n              \"data\": false\n            }]\n          }]\n        };\n        this.currentMod = foundMod;\n        this.currentModId = foundMod.id;\n        this.loading = false;\n\n        // 打开配置对话框\n        this.configDialogVisible = true;\n\n        // 清空URL输入\n        this.workshopUrl = '';\n      }, 1500);\n    },\n    // 在Steam中打开模组页面\n    openWorkshopPage(mod) {\n      const url = `https://steamcommunity.com/sharedfiles/filedetails/?id=${mod.id}`;\n      window.open(url, '_blank');\n    },\n    // 格式化数字（如：1.2k 而不是 1200）\n    formatNumber(num) {\n      if (num >= 1000000) {\n        return (num / 1000000).toFixed(1) + 'M';\n      } else if (num >= 1000) {\n        return (num / 1000).toFixed(1) + 'k';\n      }\n      return num;\n    },\n    // 返回模组列表\n    goToModList() {\n      this.$router.push('/mods/list');\n    }\n  }\n};","map":{"version":3,"names":["ModConfigDialog","name","components","data","searchForm","keyword","category","sortBy","loading","searchResults","hasSearched","currentPage","pageSize","totalResults","detailsDialogVisible","currentMod","currentModId","configDialogVisible","workshopUrl","defaultImage","created","urlParams","URLSearchParams","window","location","search","get","searchMods","methods","setTimeout","id","author","description","previewImage","subscribers","updatedAt","version","isInstalled","tags","compatibility","dst","ds","rog","sw","hamlet","resetSearch","handlePageChange","page","viewDetails","mod","addMod","handleConfigUpdated","find","m","modId","$message","type","message","importFromUrl","url","URL","params","pathname","includes","split","e","regexResult","exec","foundMod","configuration_options","openWorkshopPage","open","formatNumber","num","toFixed","goToModList","$router","push"],"sources":["src/views/mods/ModSearch.vue"],"sourcesContent":["<template>\n  <div class=\"page-container\">\n    <el-card class=\"main-card\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>搜索模组</span>\n        <div class=\"header-actions\">\n          <el-button size=\"small\" type=\"primary\" @click=\"goToModList\">返回模组列表</el-button>\n        </div>\n      </div>\n      \n      <!-- 搜索表单 -->\n      <div class=\"search-form-container\">\n        <el-form :inline=\"true\" :model=\"searchForm\" size=\"small\">\n          <el-form-item>\n            <el-input \n              v-model=\"searchForm.keyword\" \n              placeholder=\"输入关键词搜索...\" \n              prefix-icon=\"el-icon-search\" \n              clearable\n              @keyup.enter.native=\"searchMods\">\n            </el-input>\n          </el-form-item>\n          <el-form-item>\n            <el-select v-model=\"searchForm.category\" placeholder=\"分类\">\n              <el-option label=\"全部\" value=\"\"></el-option>\n              <el-option label=\"游戏玩法\" value=\"gameplay\"></el-option>\n              <el-option label=\"界面\" value=\"interface\"></el-option>\n              <el-option label=\"物品\" value=\"items\"></el-option>\n              <el-option label=\"角色\" value=\"character\"></el-option>\n              <el-option label=\"生物\" value=\"creature\"></el-option>\n              <el-option label=\"工具\" value=\"utility\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item>\n            <el-select v-model=\"searchForm.sortBy\" placeholder=\"排序方式\">\n              <el-option label=\"热门程度\" value=\"popular\"></el-option>\n              <el-option label=\"最新发布\" value=\"published\"></el-option>\n              <el-option label=\"最近更新\" value=\"updated\"></el-option>\n              <el-option label=\"订阅量\" value=\"subscribers\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item>\n            <el-button type=\"primary\" @click=\"searchMods\">搜索</el-button>\n            <el-button @click=\"resetSearch\">重置</el-button>\n          </el-form-item>\n        </el-form>\n      </div>\n      \n      <!-- 模组列表 -->\n      <div v-loading=\"loading\" class=\"mod-search-results\">\n        <div v-if=\"searchResults.length > 0\" class=\"mod-grid\">\n          <el-row :gutter=\"20\">\n            <el-col \n              :xs=\"24\" \n              :sm=\"12\" \n              :md=\"8\" \n              :lg=\"6\" \n              v-for=\"mod in searchResults\" \n              :key=\"mod.id\" \n              class=\"mod-card-col\">\n              <el-card class=\"mod-card\" shadow=\"hover\">\n                <div class=\"mod-card-image\">\n                  <el-image \n                    :src=\"mod.previewImage || defaultImage\" \n                    fit=\"cover\"\n                    lazy>\n                    <div slot=\"error\" class=\"image-slot\">\n                      <i class=\"el-icon-picture-outline\"></i>\n                    </div>\n                  </el-image>\n                  <div class=\"mod-card-badge\" v-if=\"mod.isInstalled\">\n                    <el-tag size=\"small\" type=\"success\">已安装</el-tag>\n                  </div>\n                </div>\n                \n                <div class=\"mod-card-content\">\n                  <div class=\"mod-card-title\" :title=\"mod.name\">{{ mod.name }}</div>\n                  <div class=\"mod-card-meta\">\n                    <span class=\"mod-card-author\">\n                      <i class=\"el-icon-user\"></i> {{ mod.author }}\n                    </span>\n                    <span class=\"mod-card-stats\">\n                      <i class=\"el-icon-star-on\"></i> {{ formatNumber(mod.subscribers) }}\n                    </span>\n                  </div>\n                  <div class=\"mod-card-description\" :title=\"mod.description\">\n                    {{ mod.description || '暂无描述' }}\n                  </div>\n                  <div class=\"mod-card-tags\" v-if=\"mod.tags && mod.tags.length\">\n                    <el-tag size=\"mini\" v-for=\"tag in mod.tags\" :key=\"tag\" class=\"mod-tag\">{{ tag }}</el-tag>\n                  </div>\n                </div>\n                \n                <div class=\"mod-card-actions\">\n                  <el-button \n                    size=\"small\" \n                    type=\"primary\" \n                    @click=\"addMod(mod)\"\n                    :disabled=\"mod.isInstalled\">\n                    {{ mod.isInstalled ? '已安装' : '添加' }}\n                  </el-button>\n                  <el-button \n                    size=\"small\" \n                    @click=\"viewDetails(mod)\">\n                    详情\n                  </el-button>\n                </div>\n              </el-card>\n            </el-col>\n          </el-row>\n          \n          <!-- 分页 -->\n          <div class=\"pagination-container\">\n            <el-pagination\n              background\n              layout=\"prev, pager, next\"\n              :total=\"totalResults\"\n              :page-size=\"pageSize\"\n              :current-page.sync=\"currentPage\"\n              @current-change=\"handlePageChange\">\n            </el-pagination>\n          </div>\n        </div>\n        \n        <!-- 无结果提示 -->\n        <div v-else-if=\"!loading && hasSearched\" class=\"empty-results\">\n          <el-empty description=\"没有找到匹配的模组\" :image-size=\"200\">\n            <template #description>\n              <p>没有找到匹配的模组</p>\n              <p>尝试使用不同的关键词或者筛选条件</p>\n            </template>\n          </el-empty>\n        </div>\n        \n        <!-- 初始提示 -->\n        <div v-else-if=\"!loading && !hasSearched\" class=\"initial-prompt\">\n          <div class=\"prompt-content\">\n            <i class=\"el-icon-search prompt-icon\"></i>\n            <h3>搜索Steam Workshop模组</h3>\n            <p>输入关键词开始搜索，或者直接粘贴Steam Workshop模组链接</p>\n            \n            <div class=\"url-import\">\n              <el-input\n                v-model=\"workshopUrl\"\n                placeholder=\"粘贴Steam Workshop模组URL...\"\n                clearable>\n                <el-button slot=\"append\" @click=\"importFromUrl\">导入</el-button>\n              </el-input>\n            </div>\n          </div>\n        </div>\n      </div>\n    </el-card>\n    \n    <!-- 模组详情对话框 -->\n    <el-dialog\n      title=\"模组详情\"\n      :visible.sync=\"detailsDialogVisible\"\n      width=\"800px\"\n      class=\"mod-details-dialog\">\n      <div v-if=\"currentMod\" class=\"mod-details-content\">\n        <!-- 模组头部信息 -->\n        <div class=\"mod-details-header\">\n          <div class=\"mod-details-preview\">\n            <el-image \n              :src=\"currentMod.previewImage || defaultImage\" \n              fit=\"cover\">\n              <div slot=\"error\" class=\"image-slot\">\n                <i class=\"el-icon-picture-outline\"></i>\n              </div>\n            </el-image>\n          </div>\n          \n          <div class=\"mod-details-info\">\n            <h2 class=\"mod-details-name\">{{ currentMod.name }}</h2>\n            \n            <div class=\"mod-details-meta\">\n              <span class=\"mod-details-author\">\n                <i class=\"el-icon-user\"></i> {{ currentMod.author }}\n              </span>\n              <span class=\"mod-details-update\">\n                <i class=\"el-icon-time\"></i> {{ currentMod.updatedAt || '未知' }}\n              </span>\n              <span class=\"mod-details-subscribers\">\n                <i class=\"el-icon-star-on\"></i> {{ formatNumber(currentMod.subscribers) }} 订阅者\n              </span>\n            </div>\n            \n            <div class=\"mod-details-actions\">\n              <el-button \n                type=\"primary\" \n                @click=\"addMod(currentMod)\"\n                :disabled=\"currentMod.isInstalled\">\n                {{ currentMod.isInstalled ? '已安装' : '添加到游戏' }}\n              </el-button>\n              <el-button \n                @click=\"openWorkshopPage(currentMod)\">\n                在Steam中查看\n              </el-button>\n            </div>\n          </div>\n        </div>\n        \n        <!-- 模组描述 -->\n        <div class=\"mod-details-description\">\n          <h3>模组描述</h3>\n          <div class=\"description-content\">\n            {{ currentMod.description || '该模组暂无描述' }}\n          </div>\n        </div>\n        \n        <!-- 兼容性 -->\n        <div class=\"mod-details-compatibility\" v-if=\"currentMod.compatibility\">\n          <h3>兼容性</h3>\n          <div class=\"compatibility-tags\">\n            <el-tag size=\"medium\" type=\"success\" v-if=\"currentMod.compatibility.dst\">\n              饥荒联机版\n            </el-tag>\n            <el-tag size=\"medium\" type=\"info\" v-if=\"currentMod.compatibility.ds\">\n              单机版饥荒\n            </el-tag>\n            <el-tag size=\"medium\" type=\"warning\" v-if=\"currentMod.compatibility.rog\">\n              巨人国\n            </el-tag>\n            <el-tag size=\"medium\" type=\"danger\" v-if=\"currentMod.compatibility.sw\">\n              海难\n            </el-tag>\n            <el-tag size=\"medium\" v-if=\"currentMod.compatibility.hamlet\">\n              哈姆雷特\n            </el-tag>\n          </div>\n        </div>\n        \n        <!-- 模组标签 -->\n        <div class=\"mod-details-tags\" v-if=\"currentMod.tags && currentMod.tags.length\">\n          <h3>标签</h3>\n          <div class=\"tags-container\">\n            <el-tag \n              v-for=\"tag in currentMod.tags\" \n              :key=\"tag\" \n              class=\"mod-tag\">\n              {{ tag }}\n            </el-tag>\n          </div>\n        </div>\n      </div>\n      \n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"detailsDialogVisible = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n    \n    <!-- 模组配置对话框 -->\n    <mod-config-dialog\n      :visible.sync=\"configDialogVisible\"\n      :mod-id=\"currentModId\"\n      :mod-info=\"currentMod\"\n      :is-new-mod=\"true\"\n      @config-updated=\"handleConfigUpdated\">\n    </mod-config-dialog>\n  </div>\n</template>\n\n<script>\nimport ModConfigDialog from './ModConfigDialog.vue';\n\nexport default {\n  name: 'ModSearch',\n  components: {\n    ModConfigDialog\n  },\n  data() {\n    return {\n      // 搜索表单\n      searchForm: {\n        keyword: '',\n        category: '',\n        sortBy: 'popular'\n      },\n      // 加载状态\n      loading: false,\n      // 搜索结果\n      searchResults: [],\n      // 是否已经搜索过\n      hasSearched: false,\n      // 分页\n      currentPage: 1,\n      pageSize: 12,\n      totalResults: 0,\n      // 详情对话框\n      detailsDialogVisible: false,\n      currentMod: null,\n      currentModId: null,\n      // 配置对话框\n      configDialogVisible: false,\n      // Workshop URL导入\n      workshopUrl: '',\n      // 默认图片\n      defaultImage: 'https://placehold.co/400x225/909399/FFFFFF?text=NO+IMAGE'\n    };\n  },\n  created() {\n    // 检查URL参数中是否有搜索关键词\n    const urlParams = new URLSearchParams(window.location.search);\n    const keyword = urlParams.get('keyword');\n    \n    if (keyword) {\n      this.searchForm.keyword = keyword;\n      this.searchMods();\n    }\n  },\n  methods: {\n    // 搜索模组\n    searchMods() {\n      this.loading = true;\n      this.hasSearched = true;\n      this.currentPage = 1;\n      \n      // 模拟API搜索\n      setTimeout(() => {\n        // 生成测试数据\n        this.totalResults = 28;\n        this.searchResults = [\n          {\n            id: '2675609101',\n            name: '终极棱镜',\n            author: 'WIGFRID',\n            description: '来自泰拉瑞亚的强大魔法武器。这个模组为游戏添加了一种强力的魔法武器，可以发射彩虹光线攻击敌人。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1834650713180144448/9AEF44B007018B8BD48A8BA29874E31C069295D9/',\n            subscribers: 12589,\n            updatedAt: '2023-10-15',\n            version: '1.0.4',\n            isInstalled: true,\n            tags: ['武器', '魔法', '物品'],\n            compatibility: {\n              dst: true,\n              ds: false,\n              rog: false,\n              sw: false,\n              hamlet: false\n            }\n          },\n          {\n            id: '1392778117',\n            name: 'Legion-棱镜',\n            author: 'ti_Tout',\n            description: '一款强大的武器模组，增加了多种棱镜武器。包括不同级别的棱镜，每种都有不同的效果和攻击方式。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1021698814063197415/5348EF5526A2526D1A59E45AFA3A3C6299ABD826/',\n            subscribers: 34267,\n            updatedAt: '2023-03-02',\n            version: '1.0.2',\n            isInstalled: true,\n            tags: ['武器', '物品', '装备'],\n            compatibility: {\n              dst: true,\n              ds: false,\n              rog: false,\n              sw: false,\n              hamlet: false\n            }\n          },\n          {\n            id: '2274573725',\n            name: '防御塔',\n            author: 'DefenderDev',\n            description: '增加了多种防御塔，可以自动攻击附近的敌人。包括火焰塔、冰霜塔、雷电塔等多种类型。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1778353442633873752/CADE0AABBB7F04012DD3EFA3F8CD180E57597E6A/',\n            subscribers: 54321,\n            updatedAt: '2023-06-28',\n            version: '2.1.5',\n            isInstalled: false,\n            tags: ['防御', '建筑', '战斗'],\n            compatibility: {\n              dst: true,\n              ds: true,\n              rog: true,\n              sw: false,\n              hamlet: false\n            }\n          },\n          {\n            id: '1185229307',\n            name: '厨师工作站',\n            author: 'MasterChef',\n            description: '添加了一个全新的厨师工作站，解锁更多烹饪配方和食物选择。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/856103174390469849/10B4CB4F8A11F284F73BC7C9DC5B1BB1C9839615/',\n            subscribers: 125476,\n            updatedAt: '2023-09-12',\n            version: '3.0.1',\n            isInstalled: false,\n            tags: ['食物', '烹饪', '工作站'],\n            compatibility: {\n              dst: true,\n              ds: true,\n              rog: true,\n              sw: true,\n              hamlet: true\n            }\n          },\n          {\n            id: '1505270912',\n            name: '额外物品栏',\n            author: 'InventoryPlus',\n            description: '扩展物品栏空间，添加了专用装备栏、护身符栏和额外的背包空间。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/947330690467435816/5E07575BC70F73A4D43F48E28D6540BC18D30E9B/',\n            subscribers: 298754,\n            updatedAt: '2023-05-19',\n            version: '2.5.0',\n            isInstalled: false,\n            tags: ['物品栏', '界面', '功能增强'],\n            compatibility: {\n              dst: true,\n              ds: false,\n              rog: false,\n              sw: false,\n              hamlet: false\n            }\n          },\n          {\n            id: '1872756407',\n            name: '自动采集',\n            author: 'LazyFarmer',\n            description: '添加自动采集功能，可以自动采集附近的资源和作物。',\n            previewImage: null,\n            subscribers: 67823,\n            updatedAt: '2023-04-05',\n            version: '1.3.7',\n            isInstalled: false,\n            tags: ['自动化', '采集', '工具'],\n            compatibility: {\n              dst: true,\n              ds: false,\n              rog: false,\n              sw: false,\n              hamlet: false\n            }\n          },\n          {\n            id: '1908933602',\n            name: '魔法师',\n            author: 'MageCreator',\n            description: '添加一个全新的角色：魔法师，拥有独特的魔法能力和法术系统。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/775103991156506493/9BF05B649F02BA196EE3B98125F6E4A48E97F810/',\n            subscribers: 142876,\n            updatedAt: '2023-08-17',\n            version: '2.0.0',\n            isInstalled: false,\n            tags: ['角色', '魔法', '技能'],\n            compatibility: {\n              dst: true,\n              ds: false,\n              rog: false,\n              sw: false,\n              hamlet: false\n            }\n          },\n          {\n            id: '2156328660',\n            name: '宠物系统',\n            author: 'PetLover',\n            description: '添加宠物系统，可以捕获和训练野生动物成为你的宠物。',\n            previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1483325816731663113/FDB7EE08A5A4E7F648FCBB28A221D11AA93C7884/',\n            subscribers: 89542,\n            updatedAt: '2023-07-30',\n            version: '1.4.2',\n            isInstalled: false,\n            tags: ['宠物', '动物', '伙伴'],\n            compatibility: {\n              dst: true,\n              ds: false,\n              rog: false,\n              sw: false,\n              hamlet: false\n            }\n          }\n        ];\n        \n        this.loading = false;\n      }, 1000);\n    },\n    \n    // 重置搜索条件\n    resetSearch() {\n      this.searchForm = {\n        keyword: '',\n        category: '',\n        sortBy: 'popular'\n      };\n    },\n    \n    // 页面变化处理\n    handlePageChange(page) {\n      this.currentPage = page;\n      this.loading = true;\n      \n      // 模拟API分页请求\n      setTimeout(() => {\n        // 这里可以根据当前页码生成不同的测试数据\n        \n        this.loading = false;\n      }, 800);\n    },\n    \n    // 查看模组详情\n    viewDetails(mod) {\n      this.currentMod = mod;\n      this.detailsDialogVisible = true;\n    },\n    \n    // 添加模组\n    addMod(mod) {\n      // 防止重复添加\n      if (mod.isInstalled) return;\n      \n      this.currentMod = mod;\n      this.currentModId = mod.id;\n      this.configDialogVisible = true;\n    },\n    \n    // 配置更新回调\n    handleConfigUpdated(data) {\n      // 模拟添加成功\n      setTimeout(() => {\n        // 更新模组状态为已安装\n        const mod = this.searchResults.find(m => m.id === data.modId);\n        if (mod) {\n          mod.isInstalled = true;\n        }\n        \n        this.$message({\n          type: 'success',\n          message: `模组 ${this.currentMod.name} 已成功添加！`\n        });\n      }, 500);\n    },\n    \n    // 从URL导入模组\n    importFromUrl() {\n      if (!this.workshopUrl) {\n        this.$message({\n          type: 'warning',\n          message: '请输入有效的Steam Workshop URL'\n        });\n        return;\n      }\n      \n      this.loading = true;\n      \n      // 尝试从URL中提取模组ID\n      let modId = null;\n      \n      try {\n        const url = new URL(this.workshopUrl);\n        // 处理典型的Steam Workshop URL\n        // 例如: https://steamcommunity.com/sharedfiles/filedetails/?id=2675609101\n        const params = new URLSearchParams(url.search);\n        modId = params.get('id');\n        \n        // 如果URL中没有ID参数，尝试从路径中提取\n        if (!modId && url.pathname.includes('/filedetails/')) {\n          modId = url.pathname.split('/filedetails/')[1];\n        }\n      } catch (e) {\n        // URL解析失败，尝试使用正则表达式\n        const regexResult = /[?&]id=(\\d+)/.exec(this.workshopUrl);\n        if (regexResult && regexResult[1]) {\n          modId = regexResult[1];\n        }\n      }\n      \n      if (!modId) {\n        this.loading = false;\n        this.$message({\n          type: 'error',\n          message: '无法从URL中提取模组ID，请确保URL格式正确'\n        });\n        return;\n      }\n      \n      // 模拟从API获取模组信息\n      setTimeout(() => {\n        // 假设我们找到了模组信息\n        const foundMod = {\n          id: modId,\n          name: '从URL导入的模组',\n          author: 'Workshop创作者',\n          description: '这是一个从Steam Workshop URL导入的模组。包含了各种有趣的功能和内容。',\n          previewImage: 'https://steamuserimages-a.akamaihd.net/ugc/1695028253726448079/9B7A6B4D4F6CFAA12B4754FAC77FC0B6A1395CDF/',\n          subscribers: 45678,\n          updatedAt: '2023-11-25',\n          version: '1.2.3',\n          isInstalled: false,\n          tags: ['导入', '未分类'],\n          compatibility: {\n            dst: true,\n            ds: false,\n            rog: false,\n            sw: false,\n            hamlet: false\n          },\n          configuration_options: [\n            {\"hover\":\"语言设置\",\"name\":\"language\",\"label\":\"语言\",\"default\":\"cn\",\"options\":[{\"description\":\"简体中文\",\"data\":\"cn\"},{\"description\":\"English\",\"data\":\"en\"}]},\n            {\"default\":0,\"options\":[{\"description\":\"\",\"data\":0}],\"name\":\"null\",\"label\":\"基本设置\"},\n            {\"hover\":\"难度设置\",\"name\":\"difficulty\",\"label\":\"难度\",\"default\":\"normal\",\"options\":[{\"description\":\"简单\",\"data\":\"easy\"},{\"description\":\"普通\",\"data\":\"normal\"},{\"description\":\"困难\",\"data\":\"hard\"},{\"description\":\"噩梦\",\"data\":\"nightmare\"}]},\n            {\"hover\":\"启用特殊能力\",\"name\":\"special_ability\",\"label\":\"特殊能力\",\"default\":true,\"options\":[{\"description\":\"开启\",\"data\":true},{\"description\":\"关闭\",\"data\":false}]},\n            {\"default\":0,\"options\":[{\"description\":\"\",\"data\":0}],\"name\":\"null\",\"label\":\"高级设置\"},\n            {\"hover\":\"资源倍率\",\"name\":\"resource_multiplier\",\"label\":\"资源倍率\",\"default\":1,\"options\":[{\"description\":\"0.5x\",\"data\":0.5},{\"description\":\"1x\",\"data\":1},{\"description\":\"1.5x\",\"data\":1.5},{\"description\":\"2x\",\"data\":2}]},\n            {\"hover\":\"显示调试信息\",\"name\":\"debug_info\",\"label\":\"调试信息\",\"default\":false,\"options\":[{\"description\":\"显示\",\"data\":true},{\"description\":\"隐藏\",\"data\":false}]}\n          ]\n        };\n        \n        this.currentMod = foundMod;\n        this.currentModId = foundMod.id;\n        this.loading = false;\n        \n        // 打开配置对话框\n        this.configDialogVisible = true;\n        \n        // 清空URL输入\n        this.workshopUrl = '';\n      }, 1500);\n    },\n    \n    // 在Steam中打开模组页面\n    openWorkshopPage(mod) {\n      const url = `https://steamcommunity.com/sharedfiles/filedetails/?id=${mod.id}`;\n      window.open(url, '_blank');\n    },\n    \n    // 格式化数字（如：1.2k 而不是 1200）\n    formatNumber(num) {\n      if (num >= 1000000) {\n        return (num / 1000000).toFixed(1) + 'M';\n      } else if (num >= 1000) {\n        return (num / 1000).toFixed(1) + 'k';\n      }\n      return num;\n    },\n    \n    // 返回模组列表\n    goToModList() {\n      this.$router.push('/mods/list');\n    }\n  }\n};\n</script>\n\n<style scoped>\n.page-container {\n  padding: 20px;\n}\n\n.main-card {\n  margin-bottom: 20px;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  border-radius: 4px;\n}\n\n.header-actions {\n  float: right;\n}\n\n.search-form-container {\n  margin-bottom: 20px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid #EBEEF5;\n}\n\n.mod-search-results {\n  min-height: 400px;\n}\n\n.mod-grid {\n  margin-bottom: 20px;\n}\n\n.mod-card-col {\n  margin-bottom: 20px;\n}\n\n.mod-card {\n  height: 100%;\n  transition: all 0.3s;\n  display: flex;\n  flex-direction: column;\n}\n\n.mod-card:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);\n}\n\n.mod-card-image {\n  position: relative;\n  width: 100%;\n  height: 0;\n  padding-bottom: 56.25%; /* 16:9 比例 */\n  overflow: hidden;\n  border-radius: 4px 4px 0 0;\n}\n\n.mod-card-image .el-image {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.image-slot {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n  height: 100%;\n  background-color: #f5f7fa;\n  color: #909399;\n}\n\n.mod-card-badge {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  z-index: 1;\n}\n\n.mod-card-content {\n  padding: 15px;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.mod-card-title {\n  font-weight: bold;\n  font-size: 16px;\n  margin-bottom: 10px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.mod-card-meta {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  color: #606266;\n  margin-bottom: 10px;\n}\n\n.mod-card-author,\n.mod-card-stats {\n  display: flex;\n  align-items: center;\n}\n\n.mod-card-author i,\n.mod-card-stats i {\n  margin-right: 5px;\n}\n\n.mod-card-descript