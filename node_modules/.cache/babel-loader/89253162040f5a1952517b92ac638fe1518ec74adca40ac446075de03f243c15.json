{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { getRoomList } from '@/api/index';\nexport default {\n  name: 'RoomList',\n  data() {\n    return {\n      loading: false,\n      searchQuery: '',\n      statusFilter: 'all',\n      rooms: [{\n        id: 1,\n        name: '饥荒联机版主世界',\n        players: '12/20',\n        mode: '生存模式',\n        style: 'default',\n        styleName: '默认风格',\n        status: '开放',\n        description: '主世界服务器，欢迎所有玩家加入'\n      }, {\n        id: 2,\n        name: '洞穴探险',\n        players: '8/16',\n        mode: '冒险模式',\n        style: 'cave',\n        styleName: '洞穴风格',\n        status: '开放',\n        description: '黑暗、危险的洞穴探险，挑战极限'\n      }, {\n        id: 3,\n        name: '永冬世界',\n        players: '5/10',\n        mode: '困难模式',\n        style: 'winter',\n        styleName: '冬季风格',\n        status: '开放',\n        description: '永久冬季，高难度生存挑战'\n      }, {\n        id: 4,\n        name: '测试房间',\n        players: '1/8',\n        mode: '创造模式',\n        style: 'desert',\n        styleName: '沙漠风格',\n        status: '关闭',\n        description: '用于测试各种道具和模组的房间'\n      }, {\n        id: 5,\n        name: '森林庇护所',\n        players: '0/12',\n        mode: '休闲模式',\n        style: 'forest',\n        styleName: '森林风格',\n        status: '关闭',\n        description: '资源丰富的休闲模式，适合新手玩家'\n      }]\n    };\n  },\n  computed: {\n    filteredRooms() {\n      let result = this.rooms;\n\n      // 按状态筛选\n      if (this.statusFilter !== 'all') {\n        const status = this.statusFilter === 'open' ? '开放' : '关闭';\n        result = result.filter(room => room.status === status);\n      }\n\n      // 按搜索查询筛选\n      if (this.searchQuery) {\n        const query = this.searchQuery.toLowerCase();\n        result = result.filter(room => room.name.toLowerCase().includes(query) || room.mode.toLowerCase().includes(query) || room.description.toLowerCase().includes(query));\n      }\n      return result;\n    }\n  },\n  methods: {\n    getStyleColor(style) {\n      const colors = {\n        default: '#f9f9f9',\n        dark: '#333333',\n        forest: '#2c7744',\n        desert: '#e8c07d',\n        winter: '#a8d8ff',\n        cave: '#514b4a'\n      };\n      return colors[style] || colors.default;\n    },\n    refreshRooms() {\n      this.loading = true;\n      getRoomList().then(response => {\n        console.log(response);\n      });\n      // 模拟API请求\n      // setTimeout(() => {\n      //   this.$message({\n      //     message: '房间列表已刷新',\n      //     type: 'success'\n      //   });\n      //   this.loading = false;\n      // }, 800);\n    },\n    createRoom() {\n      this.$router.push('/rooms/settings');\n    },\n    editRoom(room) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: {\n          id: room.id\n        }\n      });\n    },\n    shutdownRoom(room) {\n      this.$confirm(`确定要关闭房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms[index].status = '关闭';\n          }\n          this.$message({\n            message: `房间 ${room.name} 已关闭`,\n            type: 'success'\n          });\n        }, 500);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    startRoom(room) {\n      this.$confirm(`确定要开启房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms[index].status = '开放';\n          }\n          this.$message({\n            message: `房间 ${room.name} 已开启`,\n            type: 'success'\n          });\n        }, 500);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleMoreCommands(command, room) {\n      switch (command) {\n        case 'duplicate':\n          this.duplicateRoom(room);\n          break;\n        case 'backup':\n          this.backupRoom(room);\n          break;\n        case 'delete':\n          this.deleteRoom(room);\n          break;\n      }\n    },\n    duplicateRoom(room) {\n      this.$confirm(`确定要复制房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'info'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          const newRoom = {\n            ...room\n          };\n          newRoom.id = this.rooms.length + 1;\n          newRoom.name = `${room.name} (复制)`;\n          newRoom.status = '关闭';\n          this.rooms.push(newRoom);\n          this.$message({\n            message: `房间 ${room.name} 已复制`,\n            type: 'success'\n          });\n        }, 500);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    backupRoom(room) {\n      this.$message({\n        message: `正在备份房间 ${room.name}`,\n        type: 'success'\n      });\n    },\n    deleteRoom(room) {\n      this.$confirm(`确定要删除房间 \"${room.name}\" 吗? 此操作不可恢复!`, '警告', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms.splice(index, 1);\n          }\n          this.$message({\n            message: `房间 ${room.name} 已删除`,\n            type: 'success'\n          });\n        }, 500);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleRowClick(row) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: {\n          id: row.id,\n          view: 'true'\n        }\n      });\n    }\n  },\n  mounted() {\n    this.refreshRooms();\n  }\n};","map":{"version":3,"names":["getRoomList","name","data","loading","searchQuery","statusFilter","rooms","id","players","mode","style","styleName","status","description","computed","filteredRooms","result","filter","room","query","toLowerCase","includes","methods","getStyleColor","colors","default","dark","forest","desert","winter","cave","refreshRooms","then","response","console","log","createRoom","$router","push","editRoom","path","shutdownRoom","$confirm","confirmButtonText","cancelButtonText","type","setTimeout","index","findIndex","r","$message","message","catch","startRoom","handleMoreCommands","command","duplicateRoom","backupRoom","deleteRoom","newRoom","length","splice","handleRowClick","row","view","mounted"],"sources":["src/views/rooms/RoomList.vue"],"sourcesContent":["<template>\n  <div class=\"room-list-page\">\n    <div class=\"page-header\">\n      <h2>房间列表</h2>\n      <div class=\"header-actions\">\n        <el-input\n          placeholder=\"搜索房间\"\n          v-model=\"searchQuery\"\n          class=\"search-input\"\n          prefix-icon=\"el-icon-search\"\n          clearable>\n        </el-input>\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"createRoom\">创建房间</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"room-list-card\">\n      <div slot=\"header\" class=\"card-header\">\n        <span>所有房间</span>\n        <div>\n          <el-radio-group v-model=\"statusFilter\" size=\"small\">\n            <el-radio-button label=\"all\">全部</el-radio-button>\n            <el-radio-button label=\"open\">开放</el-radio-button>\n            <el-radio-button label=\"closed\">关闭</el-radio-button>\n          </el-radio-group>\n          <el-button style=\"margin-left: 10px;\" size=\"small\" icon=\"el-icon-refresh\" @click=\"refreshRooms\">刷新</el-button>\n        </div>\n      </div>\n      \n      <el-table\n        :data=\"filteredRooms\"\n        style=\"width: 100%\"\n        v-loading=\"loading\"\n        @row-click=\"handleRowClick\">\n        <el-table-column prop=\"name\" label=\"房间名称\">\n          <template slot-scope=\"scope\">\n            <div class=\"room-name\">\n              <div class=\"style-dot\" :style=\"{ backgroundColor: getStyleColor(scope.row.style) }\"></div>\n              {{ scope.row.name }}\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"players\" label=\"玩家数\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"mode\" label=\"游戏模式\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"style\" label=\"风格\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <div class=\"style-tag\" :class=\"'style-' + scope.row.style\">{{ scope.row.styleName }}</div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === '开放' ? 'success' : 'info'\" size=\"mini\">{{ scope.row.status }}</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\">\n          <template slot-scope=\"scope\">\n            <el-button \n              v-if=\"scope.row.status === '开放'\"\n              type=\"danger\" \n              size=\"mini\" \n              @click.stop=\"shutdownRoom(scope.row)\">关闭</el-button>\n            <el-button \n              v-else\n              type=\"success\" \n              size=\"mini\" \n              @click.stop=\"startRoom(scope.row)\">开启</el-button>\n            <el-button \n              type=\"primary\" \n              size=\"mini\" \n              @click.stop=\"editRoom(scope.row)\">编辑</el-button>\n            <el-dropdown trigger=\"click\" @command=\"handleMoreCommands($event, scope.row)\" @click.stop>\n              <el-button size=\"mini\">\n                更多<i class=\"el-icon-arrow-down el-icon--right\"></i>\n              </el-button>\n              <el-dropdown-menu slot=\"dropdown\">\n                <el-dropdown-item command=\"duplicate\">复制房间</el-dropdown-item>\n                <el-dropdown-item command=\"backup\">备份房间</el-dropdown-item>\n                <el-dropdown-item command=\"delete\" divided>\n                  <span style=\"color: #F56C6C;\">删除房间</span>\n                </el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { getRoomList } from '@/api/index';\n\nexport default {\n  name: 'RoomList',\n  data() {\n    return {\n      loading: false,\n      searchQuery: '',\n      statusFilter: 'all',\n      rooms: [\n        {\n          id: 1,\n          name: '饥荒联机版主世界',\n          players: '12/20',\n          mode: '生存模式',\n          style: 'default',\n          styleName: '默认风格',\n          status: '开放',\n          description: '主世界服务器，欢迎所有玩家加入'\n        },\n        {\n          id: 2,\n          name: '洞穴探险',\n          players: '8/16',\n          mode: '冒险模式',\n          style: 'cave',\n          styleName: '洞穴风格',\n          status: '开放',\n          description: '黑暗、危险的洞穴探险，挑战极限'\n        },\n        {\n          id: 3,\n          name: '永冬世界',\n          players: '5/10',\n          mode: '困难模式',\n          style: 'winter',\n          styleName: '冬季风格',\n          status: '开放',\n          description: '永久冬季，高难度生存挑战'\n        },\n        {\n          id: 4,\n          name: '测试房间',\n          players: '1/8',\n          mode: '创造模式',\n          style: 'desert',\n          styleName: '沙漠风格',\n          status: '关闭',\n          description: '用于测试各种道具和模组的房间'\n        },\n        {\n          id: 5,\n          name: '森林庇护所',\n          players: '0/12',\n          mode: '休闲模式',\n          style: 'forest',\n          styleName: '森林风格',\n          status: '关闭',\n          description: '资源丰富的休闲模式，适合新手玩家'\n        }\n      ]\n    }\n  },\n  computed: {\n    filteredRooms() {\n      let result = this.rooms;\n      \n      // 按状态筛选\n      if (this.statusFilter !== 'all') {\n        const status = this.statusFilter === 'open' ? '开放' : '关闭';\n        result = result.filter(room => room.status === status);\n      }\n      \n      // 按搜索查询筛选\n      if (this.searchQuery) {\n        const query = this.searchQuery.toLowerCase();\n        result = result.filter(room => \n          room.name.toLowerCase().includes(query) || \n          room.mode.toLowerCase().includes(query) ||\n          room.description.toLowerCase().includes(query)\n        );\n      }\n      \n      return result;\n    }\n  },\n  methods: {\n    getStyleColor(style) {\n      const colors = {\n        default: '#f9f9f9',\n        dark: '#333333',\n        forest: '#2c7744',\n        desert: '#e8c07d',\n        winter: '#a8d8ff',\n        cave: '#514b4a'\n      };\n      return colors[style] || colors.default;\n    },\n    refreshRooms() {\n      this.loading = true;\n      getRoomList().then(response => {\n        console.log(response);\n      });\n      // 模拟API请求\n      // setTimeout(() => {\n      //   this.$message({\n      //     message: '房间列表已刷新',\n      //     type: 'success'\n      //   });\n      //   this.loading = false;\n      // }, 800);\n    },\n    createRoom() {\n      this.$router.push('/rooms/settings');\n    },\n    editRoom(room) {\n      this.$router.push({\n        path: '/rooms/settings',\n        query: { id: room.id }\n      });\n    },\n    shutdownRoom(room) {\n      this.$confirm(`确定要关闭房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms[index].status = '关闭';\n          }\n          \n          this.$message({\n            message: `房间 ${room.name} 已关闭`,\n            type: 'success'\n          });\n        }, 500);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    startRoom(room) {\n      this.$confirm(`确定要开启房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          // 更新本地数据\n          const index = this.rooms.findIndex(r => r.id === room.id);\n          if (index > -1) {\n            this.rooms[index].status = '开放';\n          }\n          \n          this.$message({\n            message: `房间 ${room.name} 已开启`,\n            type: 'success'\n          });\n        }, 500);\n      }).catch(() => {\n        this.$message({\n          type: 'info',\n          message: '已取消操作'\n        });\n      });\n    },\n    handleMoreCommands(command, room) {\n      switch(command) {\n        case 'duplicate':\n          this.duplicateRoom(room);\n          break;\n        case 'backup':\n          this.backupRoom(room);\n          break;\n        case 'delete':\n          this.deleteRoom(room);\n          break;\n      }\n    },\n    duplicateRoom(room) {\n      this.$confirm(`确定要复制房间 \"${room.name}\" 吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'info'\n      }).then(() => {\n        // 模拟API请求\n        setTimeout(() => {\n          const newRoom = {...room};\n      