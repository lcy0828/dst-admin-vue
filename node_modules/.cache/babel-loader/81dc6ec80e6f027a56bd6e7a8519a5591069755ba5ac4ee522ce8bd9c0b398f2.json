{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'ModConfigDialog',\n  props: {\n    visible: {\n      type: Boolean,\n      default: false\n    },\n    modId: {\n      type: String,\n      default: null\n    },\n    modInfo: {\n      type: Object,\n      default: null\n    },\n    isNewMod: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      // 弹窗可见状态\n      dialogVisible: false,\n      // 加载状态\n      loading: false,\n      saving: false,\n      // 配置表单\n      configForm: {},\n      // 原始配置，用于重置\n      originalConfig: {},\n      // 默认配置，用于重置为默认值\n      defaultConfig: {},\n      // 搜索查询\n      searchQuery: '',\n      // 默认图标\n      defaultIcon: 'https://placehold.co/200x200/409EFF/white?text=MOD'\n    };\n  },\n  computed: {\n    // 是否有配置选项\n    hasOptions() {\n      return this.modInfo && this.modInfo.configuration_options && this.modInfo.configuration_options.length > 0;\n    },\n    // 按分类整理的配置选项\n    categorizedOptions() {\n      if (!this.hasOptions) return [];\n      const result = [];\n      let currentCategory = {\n        name: '基本设置',\n        options: []\n      };\n      this.modInfo.configuration_options.forEach(option => {\n        // 跳过空选项\n        if (option.name === \"\" && (!option.options || option.options.length === 0)) {\n          return;\n        }\n\n        // 判断是否是分类标题\n        if (option.name === \"Title\") {\n          // 将之前的分类添加到结果中\n          if (currentCategory.options.length > 0) {\n            result.push({\n              ...currentCategory\n            });\n          }\n          // 创建新分类\n          currentCategory = {\n            name: option.label,\n            options: []\n          };\n        }\n        // 普通配置选项\n        else if (option.name !== \"Title\" && option.name) {\n          currentCategory.options.push(option);\n        }\n      });\n\n      // 添加最后一个分类\n      if (currentCategory.options.length > 0) {\n        result.push(currentCategory);\n      }\n      return result;\n    },\n    // 过滤后的分类\n    filteredCategories() {\n      if (!this.searchQuery) {\n        return this.categorizedOptions;\n      }\n      const query = this.searchQuery.toLowerCase();\n      return this.categorizedOptions.map(category => {\n        const filteredOptions = category.options.filter(option => {\n          return option.label.toLowerCase().includes(query) || option.hover && option.hover.toLowerCase().includes(query);\n        });\n        if (filteredOptions.length > 0) {\n          return {\n            ...category,\n            options: filteredOptions\n          };\n        }\n        return null;\n      }).filter(Boolean);\n    }\n  },\n  watch: {\n    visible(newVal) {\n      this.dialogVisible = newVal;\n      if (newVal) {\n        this.initializeConfig();\n      }\n    },\n    dialogVisible(newVal) {\n      if (!newVal) {\n        this.$emit('update:visible', false);\n      }\n    }\n  },\n  methods: {\n    // 初始化配置\n    initializeConfig() {\n      this.loading = true;\n      this.searchQuery = '';\n\n      // 清空配置表单\n      this.configForm = {};\n      this.originalConfig = {};\n      this.defaultConfig = {};\n      if (this.modInfo && this.modInfo.configuration_options) {\n        // 初始化配置表单\n        this.modInfo.configuration_options.forEach(option => {\n          if (option.name && option.name !== \"Title\") {\n            this.configForm[option.name] = option.default;\n            this.originalConfig[option.name] = option.default;\n            this.defaultConfig[option.name] = option.default;\n          }\n        });\n      }\n\n      // 如果不是新模组，可以从API获取保存的配置\n      if (!this.isNewMod && this.modId) {\n        this.fetchSavedConfig();\n      } else {\n        this.loading = false;\n      }\n    },\n    // 获取保存的配置\n    fetchSavedConfig() {\n      // 模拟API获取保存的配置\n      setTimeout(() => {\n        // 更新配置（这里可以放实际API调用）\n        this.loading = false;\n      }, 600);\n    },\n    // 判断是否是布尔选项（开关类型）\n    isBooleanOption(option) {\n      return option.options && option.options.length === 2 && typeof option.options[0].data === 'boolean' && typeof option.options[1].data === 'boolean';\n    },\n    // 判断是否是单选选项（选项较少时适合）\n    isRadioOption(option) {\n      return option.options && option.options.length > 0 && option.options.length <= 5;\n    },\n    // 获取开关选项的显示文本\n    getOptionLabel(option, isActive) {\n      if (!option.options || option.options.length < 2) return '';\n      const activeOpt = option.options.find(opt => opt.data === true);\n      const inactiveOpt = option.options.find(opt => opt.data === false);\n      return isActive ? activeOpt ? activeOpt.description : '是' : inactiveOpt ? inactiveOpt.description : '否';\n    },\n    // 重置为默认配置\n    resetToDefault() {\n      this.$confirm('确定要重置所有配置为默认值吗？', '确认重置', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.configForm = JSON.parse(JSON.stringify(this.defaultConfig));\n        this.$message({\n          type: 'success',\n          message: '配置已重置为默认值'\n        });\n      }).catch(() => {});\n    },\n    // 保存配置\n    saveConfig() {\n      this.saving = true;\n\n      // 模拟API保存配置\n      setTimeout(() => {\n        this.saving = false;\n\n        // 通知父组件配置已更新\n        this.$emit('config-updated', {\n          modId: this.modId,\n          configData: this.configForm\n        });\n\n        // 关闭对话框\n        this.dialogVisible = false;\n\n        // 显示成功提示\n        this.$message({\n          type: 'success',\n          message: '配置已保存'\n        });\n      }, 800);\n    },\n    // 关闭对话框\n    handleClose() {\n      // 检查是否有未保存的更改\n      let hasChanges = false;\n      for (const key in this.configForm) {\n        if (this.configForm[key] !== this.originalConfig[key]) {\n          hasChanges = true;\n          break;\n        }\n      }\n      if (hasChanges) {\n        this.$confirm('您有未保存的配置更改，确定要关闭吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.dialogVisible = false;\n        }).catch(() => {\n          // 用户取消关闭\n        });\n      } else {\n        this.dialogVisible = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","visible","type","Boolean","default","modId","String","modInfo","Object","isNewMod","data","dialogVisible","loading","saving","configForm","originalConfig","defaultConfig","searchQuery","defaultIcon","computed","hasOptions","configuration_options","length","categorizedOptions","result","currentCategory","options","forEach","option","push","label","filteredCategories","query","toLowerCase","map","category","filteredOptions","filter","includes","hover","watch","newVal","initializeConfig","$emit","methods","fetchSavedConfig","setTimeout","isBooleanOption","isRadioOption","getOptionLabel","isActive","activeOpt","find","opt","inactiveOpt","description","resetToDefault","$confirm","confirmButtonText","cancelButtonText","then","JSON","parse","stringify","$message","message","catch","saveConfig","configData","handleClose","hasChanges","key"],"sources":["src/views/mods/ModConfigDialog.vue"],"sourcesContent":["<template>\n  <el-dialog\n    title=\"模组配置\"\n    :visible.sync=\"dialogVisible\"\n    width=\"900px\"\n    class=\"mod-config-dialog\"\n    :before-close=\"handleClose\">\n    \n    <!-- 加载状态 -->\n    <div v-loading=\"loading\" class=\"config-container\">\n      <!-- 模组基本信息 -->\n      <div v-if=\"modInfo\" class=\"mod-info-section\">\n        <div class=\"mod-info-header\">\n          <el-image \n            :src=\"modInfo.iconUrl || defaultIcon\" \n            fit=\"cover\"\n            class=\"mod-icon\">\n            <div slot=\"error\" class=\"image-slot\">\n              <i class=\"el-icon-picture-outline\"></i>\n            </div>\n          </el-image>\n          \n          <div class=\"mod-info-details\">\n            <h2 class=\"mod-name\">{{ modInfo.name }}</h2>\n            <div class=\"mod-meta\">\n              <span class=\"mod-author\">\n                <i class=\"el-icon-user\"></i> {{ modInfo.author }}\n              </span>\n              <span class=\"mod-version\">\n                <i class=\"el-icon-info\"></i> v{{ modInfo.version }}\n              </span>\n            </div>\n            <div class=\"mod-description\" v-if=\"modInfo.description\">\n              {{ modInfo.description || '暂无描述' }}\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <!-- 配置选项 -->\n      <div v-if=\"!loading && hasOptions\" class=\"config-options-section\">\n        <div class=\"options-header\">\n          <h3 class=\"section-title\">配置选项</h3>\n          <div class=\"section-actions\">\n            <el-button size=\"small\" type=\"text\" @click=\"resetToDefault\">\n              <i class=\"el-icon-refresh-left\"></i> 重置为默认配置\n            </el-button>\n          </div>\n        </div>\n        \n        <!-- 搜索和过滤 -->\n        <div class=\"filter-container\" v-if=\"filteredCategories.length > 3\">\n          <el-input\n            v-model=\"searchQuery\"\n            placeholder=\"搜索配置选项...\"\n            prefix-icon=\"el-icon-search\"\n            clearable\n            size=\"small\">\n          </el-input>\n        </div>\n        \n        <!-- 分类配置选项 -->\n        <div class=\"categories-container\">\n          <el-card \n            v-for=\"(category, categoryIndex) in filteredCategories\" \n            :key=\"categoryIndex\"\n            class=\"category-card\"\n            :class=\"{'empty-category': !category.name}\"\n            shadow=\"hover\">\n            \n            <div v-if=\"category.name\" slot=\"header\" class=\"category-header\">\n              <span class=\"category-title\">{{ category.name }}</span>\n            </div>\n            \n            <div class=\"category-options\">\n              <el-form :model=\"configForm\" label-position=\"top\">\n                <transition-group name=\"fade\">\n                  <el-form-item \n                    v-for=\"option in category.options\" \n                    :key=\"option.name\" \n                    :label=\"option.label\"\n                    class=\"config-form-item\">\n                    \n                    <!-- 配置说明提示 -->\n                    <el-tooltip \n                      v-if=\"option.hover\" \n                      class=\"item\" \n                      effect=\"dark\" \n                      :content=\"option.hover\" \n                      placement=\"top-start\">\n                      <i class=\"el-icon-question option-tooltip\"></i>\n                    </el-tooltip>\n                    \n                    <!-- 开关类型 -->\n                    <template v-if=\"isBooleanOption(option)\">\n                      <el-switch\n                        v-model=\"configForm[option.name]\"\n                        :active-text=\"getOptionLabel(option, true)\"\n                        :inactive-text=\"getOptionLabel(option, false)\"\n                        class=\"switch-option\">\n                      </el-switch>\n                    </template>\n                    \n                    <!-- 单选类型 -->\n                    <template v-else-if=\"isRadioOption(option)\">\n                      <el-radio-group v-model=\"configForm[option.name]\" class=\"radio-options\">\n                        <el-radio \n                          v-for=\"(opt, idx) in option.options\" \n                          :key=\"idx\" \n                          :label=\"opt.data\"\n                          border>\n                          {{ opt.description }}\n                        </el-radio>\n                      </el-radio-group>\n                    </template>\n                    \n                    <!-- 下拉选择类型 -->\n                    <template v-else>\n                      <el-select v-model=\"configForm[option.name]\" style=\"width: 100%\">\n                        <el-option\n                          v-for=\"(opt, idx) in option.options\"\n                          :key=\"idx\"\n                          :label=\"opt.description\"\n                          :value=\"opt.data\">\n                        </el-option>\n                      </el-select>\n                    </template>\n                  </el-form-item>\n                </transition-group>\n              </el-form>\n            </div>\n          </el-card>\n        </div>\n        \n        <!-- 无配置选项提示 -->\n        <div v-if=\"!hasOptions\" class=\"no-options\">\n          <el-empty description=\"该模组没有配置选项\" :image-size=\"150\"></el-empty>\n        </div>\n      </div>\n    </div>\n    \n    <span slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"handleClose\">取消</el-button>\n      <el-button type=\"primary\" @click=\"saveConfig\" :loading=\"saving\">保存配置</el-button>\n    </span>\n  </el-dialog>\n</template>\n\n<script>\nexport default {\n  name: 'ModConfigDialog',\n  props: {\n    visible: {\n      type: Boolean,\n      default: false\n    },\n    modId: {\n      type: String,\n      default: null\n    },\n    modInfo: {\n      type: Object,\n      default: null\n    },\n    isNewMod: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      // 弹窗可见状态\n      dialogVisible: false,\n      // 加载状态\n      loading: false,\n      saving: false,\n      // 配置表单\n      configForm: {},\n      // 原始配置，用于重置\n      originalConfig: {},\n      // 默认配置，用于重置为默认值\n      defaultConfig: {},\n      // 搜索查询\n      searchQuery: '',\n      // 默认图标\n      defaultIcon: 'https://placehold.co/200x200/409EFF/white?text=MOD'\n    };\n  },\n  computed: {\n    // 是否有配置选项\n    hasOptions() {\n      return this.modInfo && \n        this.modInfo.configuration_options && \n        this.modInfo.configuration_options.length > 0;\n    },\n    \n    // 按分类整理的配置选项\n    categorizedOptions() {\n      if (!this.hasOptions) return [];\n      \n      const result = [];\n      let currentCategory = { name: '基本设置', options: [] };\n      \n      this.modInfo.configuration_options.forEach(option => {\n        // 跳过空选项\n        if (option.name === \"\" && (!option.options || option.options.length === 0)) {\n          return;\n        }\n        \n        // 判断是否是分类标题\n        if (option.name === \"Title\") {\n          // 将之前的分类添加到结果中\n          if (currentCategory.options.length > 0) {\n            result.push({...currentCategory});\n          }\n          // 创建新分类\n          currentCategory = {\n            name: option.label,\n            options: []\n          };\n        } \n        // 普通配置选项\n        else if (option.name !== \"Title\" && option.name) {\n          currentCategory.options.push(option);\n        }\n      });\n      \n      // 添加最后一个分类\n      if (currentCategory.options.length > 0) {\n        result.push(currentCategory);\n      }\n      \n      return result;\n    },\n    \n    // 过滤后的分类\n    filteredCategories() {\n      if (!this.searchQuery) {\n        return this.categorizedOptions;\n      }\n      \n      const query = this.searchQuery.toLowerCase();\n      return this.categorizedOptions.map(category => {\n        const filteredOptions = category.options.filter(option => {\n          return option.label.toLowerCase().includes(query) || \n                 (option.hover && option.hover.toLowerCase().includes(query));\n        });\n        \n        if (filteredOptions.length > 0) {\n          return { \n            ...category, \n            options: filteredOptions \n          };\n        }\n        \n        return null;\n      }).filter(Boolean);\n    }\n  },\n  watch: {\n    visible(newVal) {\n      this.dialogVisible = newVal;\n      if (newVal) {\n        this.initializeConfig();\n      }\n    },\n    dialogVisible(newVal) {\n      if (!newVal) {\n        this.$emit('update:visible', false);\n      }\n    }\n  },\n  methods: {\n    // 初始化配置\n    initializeConfig() {\n      this.loading = true;\n      this.searchQuery = '';\n      \n      // 清空配置表单\n      this.configForm = {};\n      this.originalConfig = {};\n      this.defaultConfig = {};\n      \n      if (this.modInfo && this.modInfo.configuration_options) {\n        // 初始化配置表单\n        this.modInfo.configuration_options.forEach(option => {\n          if (option.name && option.name !== \"Title\") {\n            this.configForm[option.name] = option.default;\n            this.originalConfig[option.name] = option.default;\n            this.defaultConfig[option.name] = option.default;\n          }\n        });\n      }\n      \n      // 如果不是新模组，可以从API获取保存的配置\n      if (!this.isNewMod && this.modId) {\n        this.fetchSavedConfig();\n      } else {\n        this.loading = false;\n      }\n    },\n    \n    // 获取保存的配置\n    fetchSavedConfig() {\n      // 模拟API获取保存的配置\n      setTimeout(() => {\n        // 更新配置（这里可以放实际API调用）\n        this.loading = false;\n      }, 600);\n    },\n    \n    // 判断是否是布尔选项（开关类型）\n    isBooleanOption(option) {\n      return option.options && \n        option.options.length === 2 && \n        typeof option.options[0].data === 'boolean' && \n        typeof option.options[1].data === 'boolean';\n    },\n    \n    // 判断是否是单选选项（选项较少时适合）\n    isRadioOption(option) {\n      return option.options && \n        option.options.length > 0 && \n        option.options.length <= 5;\n    },\n    \n    // 获取开关选项的显示文本\n    getOptionLabel(option, isActive) {\n      if (!option.options || option.options.length < 2) return '';\n      \n      const activeOpt = option.options.find(opt => opt.data === true);\n      const inactiveOpt = option.options.find(opt => opt.data === false);\n      \n      return isActive ? \n        (activeOpt ? activeOpt.description : '是') : \n        (inactiveOpt ? inactiveOpt.description : '否');\n    },\n    \n    // 重置为默认配置\n    resetToDefault() {\n      this.$confirm('确定要重置所有配置为默认值吗？', '确认重置', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.configForm = JSON.parse(JSON.stringify(this.defaultConfig));\n        this.$message({\n          type: 'success',\n          message: '配置已重置为默认值'\n        });\n      }).catch(() => {});\n    },\n    \n    // 保存配置\n    saveConfig() {\n      this.saving = true;\n      \n      // 模拟API保存配置\n      setTimeout(() => {\n        this.saving = false;\n        \n        // 通知父组件配置已更新\n        this.$emit('config-updated', {\n          modId: this.modId,\n          configData: this.configForm\n        });\n        \n        // 关闭对话框\n        this.dialogVisible = false;\n        \n        // 显示成功提示\n        this.$message({\n          type: 'success',\n          message: '配置已保存'\n        });\n      }, 800);\n    },\n    \n    // 关闭对话框\n    handleClose() {\n      // 检查是否有未保存的更改\n      let hasChanges = false;\n      \n      for (const key in this.configForm) {\n        if (this.configForm[key] !== this.originalConfig[key]) {\n          hasChanges = true;\n          break;\n        }\n      }\n      \n      if (hasChanges) {\n        this.$confirm('您有未保存的配置更改，确定要关闭吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.dialogVisible = false;\n        }).catch(() => {\n          // 用户取消关闭\n        });\n      } else {\n        this.dialogVisible = false;\n      }\n    }\n  }\n};\n</script>\n\n<style>\n.mod-config-dialog {\n  max-width: 95%;\n}\n\n.mod-config-dialog .el-dialog__body {\n  padding: 20px 25px;\n}\n\n.config-container {\n  min-height: 200px;\n}\n\n.mod-info-section {\n  margin-bottom: 25px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid #EBEEF5;\n}\n\n.mod-info-header {\n  display: flex;\n  align-items: flex-start;\n}\n\n.mod-icon {\n  width: 90px;\n  height: 90px;\n  margin-right: 20px;\n  flex-shrink: 0;\n  border-radius: 8px;\n  overflow: hidden;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n}\n\n.image-slot {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n  height: 100%;\n  background-color: #f5f7fa;\n  color: #909399;\n}\n\n.mod-info-details {\n  flex: 1;\n}\n\n.mod-name {\n  margin: 0 0 10px 0;\n  font-size: 22px;\n  color: #303133;\n  font-weight: 600;\n}\n\n.mod-meta {\n  display: flex;\n  flex-wrap: wrap;\n  margin-bottom: 12px;\n  font-size: 14px;\n  color: #606266;\n}\n\n.mod-author, .mod-version {\n  margin-right: 20px;\n  display: flex;\n  align-items: center;\n  background: #f8f9fb;\n  padding: 2px 10px;\n  border-radius: 12px;\n}\n\n.mod-author i, .mod-version i {\n  margin-right: 5px;\n}\n\n.mod-description {\n  font-size: 14px;\n  color: #606266;\n  line-height: 1.6;\n  max-height: 100px;\n  overflow-y: auto;\n  padding-right: 5px;\n}\n\n.options-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 15px;\n}\n\n.section-title {\n  margin: 0;\n  font-size: 18px;\n  color: #303133;\n  font-weight: 600;\n}\n\n.filter-container {\n  margin-bottom: 15px;\n}\n\n.categories-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));\n  gap: 20px;\n}\n\n.category-card {\n  margin-bottom: 0;\n  transition: all 0.3s;\n}\n\n.category-card.empty-category .el-card__body {\n  padding-top: 15px;\n}\n\n.category-card:hover {\n  transform: translateY(-5px);\n}\n\n.category-header {\n  display: flex;\n  align-items: center;\n  padding: 0;\n}\n\n.category-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #303133;\n}\n\n.category-options {\n  padding: 5px 0;\n}\n\n.config-form-item {\n  margin-bottom: 20px;\n  position: relative;\n}\n\n.el-form-item__label {\n  line-height: 1.4;\n  padding-bottom: 5p