{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.set.difference.v2.js\";\nimport \"core-js/modules/es.set.intersection.v2.js\";\nimport \"core-js/modules/es.set.is-disjoint-from.v2.js\";\nimport \"core-js/modules/es.set.is-subset-of.v2.js\";\nimport \"core-js/modules/es.set.is-superset-of.v2.js\";\nimport \"core-js/modules/es.set.symmetric-difference.v2.js\";\nimport \"core-js/modules/es.set.union.v2.js\";\nimport apiConfig from '@/api/config';\nexport default {\n  name: 'Backups',\n  data() {\n    return {\n      loading: false,\n      createLoading: false,\n      createDialogVisible: false,\n      selectedArchive: '',\n      selectedFilter: '',\n      backupsList: [],\n      archivesList: []\n    };\n  },\n  computed: {\n    archiveOptions() {\n      // 从备份列表中提取所有唯一的存档名称\n      const archives = this.backupsList.map(backup => backup.archive_name);\n      return [...new Set(archives)];\n    },\n    filteredBackups() {\n      if (!this.selectedFilter) {\n        return this.backupsList;\n      }\n      return this.backupsList.filter(backup => backup.archive_name === this.selectedFilter);\n    }\n  },\n  methods: {\n    refreshBackups() {\n      this.loading = true;\n      this.$api.backupApi.getBackupList().then(res => {\n        if (res.status === 200) {\n          // 处理返回的数据结构\n          let allBackups = [];\n          // 将各个存档的备份整合到一个列表中\n          for (const archive in res.data) {\n            if (Object.hasOwnProperty.call(res.data, archive)) {\n              if (!this.archivesList.includes(archive)) {\n                this.archivesList.push(archive);\n              }\n              const backups = res.data[archive];\n              allBackups = [...allBackups, ...backups];\n            }\n          }\n          this.backupsList = allBackups;\n        } else {\n          this.$message.error('获取备份列表失败：' + res.msg);\n        }\n      }).catch(err => {\n        this.$message.error('获取备份列表失败：' + err.message);\n      }).finally(() => {\n        this.loading = false;\n      });\n    },\n    showCreateBackupDialog() {\n      this.createDialogVisible = true;\n\n      // 使用房间管理接口获取存档列表\n      this.$api.roomApi.getRoomList().then(res => {\n        if (Array.isArray(res)) {\n          // 提取房间名称作为存档列表\n          this.archivesList = res.map(room => room.savename || room.name);\n        } else if (res.data && Array.isArray(res.data)) {\n          this.archivesList = res.data.map(room => room.savename || room.name);\n        }\n        if (this.archivesList.length === 0) {\n          this.$message.warning('没有可用的存档');\n        }\n      }).catch(err => {\n        this.$message.error('获取存档列表失败：' + (err.message || '未知错误'));\n      });\n    },\n    createBackup() {\n      if (!this.selectedArchive) {\n        this.$message.warning('请选择要备份的存档');\n        return;\n      }\n      this.createLoading = true;\n      this.$api.backupApi.createBackup(this.selectedArchive).then(res => {\n        if (res.status === 200) {\n          this.$message({\n            type: 'success',\n            message: res.msg || '创建备份成功'\n          });\n          this.createDialogVisible = false;\n          this.refreshBackups();\n        } else {\n          this.$message.error('创建备份失败：' + res.msg);\n        }\n      }).catch(err => {\n        this.$message.error('创建备份失败：' + err.message);\n      }).finally(() => {\n        this.createLoading = false;\n      });\n    },\n    downloadBackup(backup) {\n      const {\n        archive_name,\n        name\n      } = backup;\n\n      // 创建一个临时的a标签用于下载\n      const link = document.createElement('a');\n\n      // 获取API基础地址\n      const baseUrl = apiConfig.BASE_URL;\n      // 确保链接正确构建\n      link.href = `${baseUrl}/backup/download?archive=${archive_name}&backup=${name}`;\n      link.setAttribute('download', name);\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      this.$message({\n        message: `正在下载备份：${name}`,\n        type: 'success'\n      });\n    }\n  },\n  mounted() {\n    this.refreshBackups();\n  }\n};","map":{"version":3,"names":["apiConfig","name","data","loading","createLoading","createDialogVisible","selectedArchive","selectedFilter","backupsList","archivesList","computed","archiveOptions","archives","map","backup","archive_name","Set","filteredBackups","filter","methods","refreshBackups","$api","backupApi","getBackupList","then","res","status","allBackups","archive","Object","hasOwnProperty","call","includes","push","backups","$message","error","msg","catch","err","message","finally","showCreateBackupDialog","roomApi","getRoomList","Array","isArray","room","savename","length","warning","createBackup","type","downloadBackup","link","document","createElement","baseUrl","BASE_URL","href","setAttribute","body","appendChild","click","removeChild","mounted"],"sources":["src/views/Backups.vue"],"sourcesContent":["<template>\n  <div class=\"backups-page\">\n    <div class=\"page-header\">\n      <h2>备份管理</h2>\n      <div class=\"header-actions\">\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"showCreateBackupDialog\">创建备份</el-button>\n        <el-button icon=\"el-icon-refresh\" @click=\"refreshBackups\">刷新</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"backups-card\">\n      <div slot=\"header\" class=\"card-header\">\n        <span>备份列表</span>\n        <el-select v-model=\"selectedFilter\" placeholder=\"选择存档\" clearable style=\"width: 180px\">\n          <el-option label=\"全部\" value=\"\"></el-option>\n          <el-option \n            v-for=\"archive in archiveOptions\" \n            :key=\"archive\" \n            :label=\"archive\" \n            :value=\"archive\">\n          </el-option>\n        </el-select>\n      </div>\n      \n      <el-table\n        :data=\"filteredBackups\"\n        style=\"width: 100%\"\n        v-loading=\"loading\">\n        <el-table-column prop=\"name\" label=\"备份名称\">\n          <template slot-scope=\"scope\">\n            <div class=\"backup-name\">\n              <i class=\"el-icon-document\"></i>\n              {{ scope.row.name }}\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"archive_name\" label=\"存档名称\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"size_formatted\" label=\"大小\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"创建时间\" width=\"180\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"200\">\n          <template slot-scope=\"scope\">\n            <el-button \n              type=\"success\" \n              size=\"mini\" \n              @click=\"downloadBackup(scope.row)\">下载</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n\n    <!-- 创建备份对话框 -->\n    <el-dialog\n      title=\"创建存档备份\"\n      :visible.sync=\"createDialogVisible\"\n      width=\"30%\">\n      <span>选择要备份的存档：</span>\n      <el-select v-model=\"selectedArchive\" placeholder=\"请选择存档\" style=\"width: 100%; margin-top: 15px;\">\n        <el-option\n          v-for=\"archive in archivesList\"\n          :key=\"archive\"\n          :label=\"archive\"\n          :value=\"archive\">\n        </el-option>\n      </el-select>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"createDialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"createBackup\" :loading=\"createLoading\">创建</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport apiConfig from '@/api/config';\n\nexport default {\n  name: 'Backups',\n  data() {\n    return {\n      loading: false,\n      createLoading: false,\n      createDialogVisible: false,\n      selectedArchive: '',\n      selectedFilter: '',\n      backupsList: [],\n      archivesList: []\n    }\n  },\n  computed: {\n    archiveOptions() {\n      // 从备份列表中提取所有唯一的存档名称\n      const archives = this.backupsList.map(backup => backup.archive_name);\n      return [...new Set(archives)];\n    },\n    filteredBackups() {\n      if (!this.selectedFilter) {\n        return this.backupsList;\n      }\n      return this.backupsList.filter(backup => backup.archive_name === this.selectedFilter);\n    }\n  },\n  methods: {\n    refreshBackups() {\n      this.loading = true;\n      this.$api.backupApi.getBackupList()\n        .then(res => {\n          if (res.status === 200) {\n            // 处理返回的数据结构\n            let allBackups = [];\n            // 将各个存档的备份整合到一个列表中\n            for (const archive in res.data) {\n              if (Object.hasOwnProperty.call(res.data, archive)) {\n                if (!this.archivesList.includes(archive)) {\n                  this.archivesList.push(archive);\n                }\n                \n                const backups = res.data[archive];\n                allBackups = [...allBackups, ...backups];\n              }\n            }\n            this.backupsList = allBackups;\n          } else {\n            this.$message.error('获取备份列表失败：' + res.msg);\n          }\n        })\n        .catch(err => {\n          this.$message.error('获取备份列表失败：' + err.message);\n        })\n        .finally(() => {\n          this.loading = false;\n        });\n    },\n    showCreateBackupDialog() {\n      this.createDialogVisible = true;\n      \n      // 使用房间管理接口获取存档列表\n      this.$api.roomApi.getRoomList()\n        .then(res => {\n          if (Array.isArray(res)) {\n            // 提取房间名称作为存档列表\n            this.archivesList = res.map(room => room.savename || room.name);\n          } else if (res.data && Array.isArray(res.data)) {\n            this.archivesList = res.data.map(room => room.savename || room.name);\n          }\n          \n          if (this.archivesList.length === 0) {\n            this.$message.warning('没有可用的存档');\n          }\n        })\n        .catch(err => {\n          this.$message.error('获取存档列表失败：' + (err.message || '未知错误'));\n        });\n    },\n    createBackup() {\n      if (!this.selectedArchive) {\n        this.$message.warning('请选择要备份的存档');\n        return;\n      }\n      \n      this.createLoading = true;\n      this.$api.backupApi.createBackup(this.selectedArchive)\n        .then(res => {\n          if (res.status === 200) {\n            this.$message({\n              type: 'success',\n              message: res.msg || '创建备份成功'\n            });\n            this.createDialogVisible = false;\n            this.refreshBackups();\n          } else {\n            this.$message.error('创建备份失败：' + res.msg);\n          }\n        })\n        .catch(err => {\n          this.$message.error('创建备份失败：' + err.message);\n        })\n        .finally(() => {\n          this.createLoading = false;\n        });\n    },\n    downloadBackup(backup) {\n      const { archive_name, name } = backup;\n      \n      // 创建一个临时的a标签用于下载\n      const link = document.createElement('a');\n      \n      // 获取API基础地址\n      const baseUrl = apiConfig.BASE_URL;\n      // 确保链接正确构建\n      link.href = `${baseUrl}/backup/download?archive=${archive_name}&backup=${name}`;\n      \n      link.setAttribute('download', name);\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      \n      this.$message({\n        message: `正在下载备份：${name}`,\n        type: 'success'\n      });\n    }\n  },\n  mounted() {\n    this.refreshBackups();\n  }\n}\n</script>\n\n<style scoped>\n.backups-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.backups-card {\n  margin-bottom: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.backup-name {\n  display: flex;\n  align-items: center;\n}\n\n.backup-name i {\n  margin-right: 10px;\n  font-size: 18px;\n  color: #409EFF;\n}\n\n.el-table >>> .el-table__row {\n  cursor: pointer;\n}\n</style> "],"mappings":";;;;;;;;;;;AAyEA,OAAAA,SAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,aAAA;MACAC,mBAAA;MACAC,eAAA;MACAC,cAAA;MACAC,WAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACAC,eAAA;MACA;MACA,MAAAC,QAAA,QAAAJ,WAAA,CAAAK,GAAA,CAAAC,MAAA,IAAAA,MAAA,CAAAC,YAAA;MACA,eAAAC,GAAA,CAAAJ,QAAA;IACA;IACAK,gBAAA;MACA,UAAAV,cAAA;QACA,YAAAC,WAAA;MACA;MACA,YAAAA,WAAA,CAAAU,MAAA,CAAAJ,MAAA,IAAAA,MAAA,CAAAC,YAAA,UAAAR,cAAA;IACA;EACA;EACAY,OAAA;IACAC,eAAA;MACA,KAAAjB,OAAA;MACA,KAAAkB,IAAA,CAAAC,SAAA,CAAAC,aAAA,GACAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,MAAA;UACA;UACA,IAAAC,UAAA;UACA;UACA,WAAAC,OAAA,IAAAH,GAAA,CAAAvB,IAAA;YACA,IAAA2B,MAAA,CAAAC,cAAA,CAAAC,IAAA,CAAAN,GAAA,CAAAvB,IAAA,EAAA0B,OAAA;cACA,UAAAnB,YAAA,CAAAuB,QAAA,CAAAJ,OAAA;gBACA,KAAAnB,YAAA,CAAAwB,IAAA,CAAAL,OAAA;cACA;cAEA,MAAAM,OAAA,GAAAT,GAAA,CAAAvB,IAAA,CAAA0B,OAAA;cACAD,UAAA,OAAAA,UAAA,KAAAO,OAAA;YACA;UACA;UACA,KAAA1B,WAAA,GAAAmB,UAAA;QACA;UACA,KAAAQ,QAAA,CAAAC,KAAA,eAAAX,GAAA,CAAAY,GAAA;QACA;MACA,GACAC,KAAA,CAAAC,GAAA;QACA,KAAAJ,QAAA,CAAAC,KAAA,eAAAG,GAAA,CAAAC,OAAA;MACA,GACAC,OAAA;QACA,KAAAtC,OAAA;MACA;IACA;IACAuC,uBAAA;MACA,KAAArC,mBAAA;;MAEA;MACA,KAAAgB,IAAA,CAAAsB,OAAA,CAAAC,WAAA,GACApB,IAAA,CAAAC,GAAA;QACA,IAAAoB,KAAA,CAAAC,OAAA,CAAArB,GAAA;UACA;UACA,KAAAhB,YAAA,GAAAgB,GAAA,CAAAZ,GAAA,CAAAkC,IAAA,IAAAA,IAAA,CAAAC,QAAA,IAAAD,IAAA,CAAA9C,IAAA;QACA,WAAAwB,GAAA,CAAAvB,IAAA,IAAA2C,KAAA,CAAAC,OAAA,CAAArB,GAAA,CAAAvB,IAAA;UACA,KAAAO,YAAA,GAAAgB,GAAA,CAAAvB,IAAA,CAAAW,GAAA,CAAAkC,IAAA,IAAAA,IAAA,CAAAC,QAAA,IAAAD,IAAA,CAAA9C,IAAA;QACA;QAEA,SAAAQ,YAAA,CAAAwC,MAAA;UACA,KAAAd,QAAA,CAAAe,OAAA;QACA;MACA,GACAZ,KAAA,CAAAC,GAAA;QACA,KAAAJ,QAAA,CAAAC,KAAA,gBAAAG,GAAA,CAAAC,OAAA;MACA;IACA;IACAW,aAAA;MACA,UAAA7C,eAAA;QACA,KAAA6B,QAAA,CAAAe,OAAA;QACA;MACA;MAEA,KAAA9C,aAAA;MACA,KAAAiB,IAAA,CAAAC,SAAA,CAAA6B,YAAA,M