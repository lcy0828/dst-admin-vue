{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: {\n        username: '',\n        password: '',\n        remember: false\n      },\n      loginRules: {\n        username: [{\n          required: true,\n          message: '请输入用户名',\n          trigger: 'blur'\n        }],\n        password: [{\n          required: true,\n          message: '请输入密码',\n          trigger: 'blur'\n        }, {\n          min: 6,\n          message: '密码长度不少于6位',\n          trigger: 'blur'\n        }]\n      },\n      loading: false\n    };\n  },\n  methods: {\n    handleLogin() {\n      this.$refs.loginForm.validate(valid => {\n        if (valid) {\n          this.loading = true;\n\n          // 模拟登录请求\n          setTimeout(() => {\n            this.loading = false;\n\n            // 保存登录状态\n            localStorage.setItem('isLoggedIn', 'true');\n\n            // 登录成功，跳转到首页\n            this.$router.push('/');\n            this.$message({\n              type: 'success',\n              message: '登录成功'\n            });\n          }, 1500);\n        } else {\n          return false;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","loginForm","username","password","remember","loginRules","required","message","trigger","min","loading","methods","handleLogin","$refs","validate","valid","setTimeout","localStorage","setItem","$router","push","$message","type"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-container\">\n    <div class=\"login-form-wrapper\">\n      <div class=\"login-header\">\n        <h1>饥荒服务器管理系统</h1>\n        <p>Don't Starve Together 管理后台</p>\n      </div>\n      \n      <el-form ref=\"loginForm\" :model=\"loginForm\" :rules=\"loginRules\" class=\"login-form\">\n        <el-form-item prop=\"username\">\n          <el-input \n            v-model=\"loginForm.username\" \n            prefix-icon=\"el-icon-user\" \n            placeholder=\"用户名\">\n          </el-input>\n        </el-form-item>\n        \n        <el-form-item prop=\"password\">\n          <el-input \n            v-model=\"loginForm.password\" \n            prefix-icon=\"el-icon-lock\" \n            type=\"password\" \n            placeholder=\"密码\"\n            @keyup.enter.native=\"handleLogin\">\n          </el-input>\n        </el-form-item>\n        \n        <el-form-item>\n          <el-checkbox v-model=\"loginForm.remember\">记住我</el-checkbox>\n          <el-link type=\"primary\" class=\"forgot-password\" :underline=\"false\">忘记密码?</el-link>\n        </el-form-item>\n        \n        <el-form-item>\n          <el-button \n            type=\"primary\" \n            class=\"login-button\" \n            :loading=\"loading\" \n            @click=\"handleLogin\">\n            登录\n          </el-button>\n        </el-form-item>\n      </el-form>\n      \n      <div class=\"login-footer\">\n        <p>© 2023 饥荒管理系统 - Don't Starve Together Admin</p>\n      </div>\n    </div>\n    \n    <div class=\"login-background\">\n      <div class=\"login-illustration\"></div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: {\n        username: '',\n        password: '',\n        remember: false\n      },\n      loginRules: {\n        username: [\n          { required: true, message: '请输入用户名', trigger: 'blur' }\n        ],\n        password: [\n          { required: true, message: '请输入密码', trigger: 'blur' },\n          { min: 6, message: '密码长度不少于6位', trigger: 'blur' }\n        ]\n      },\n      loading: false\n    }\n  },\n  methods: {\n    handleLogin() {\n      this.$refs.loginForm.validate(valid => {\n        if (valid) {\n          this.loading = true\n          \n          // 模拟登录请求\n          setTimeout(() => {\n            this.loading = false\n            \n            // 保存登录状态\n            localStorage.setItem('isLoggedIn', 'true')\n            \n            // 登录成功，跳转到首页\n            this.$router.push('/')\n            \n            this.$message({\n              type: 'success',\n              message: '登录成功'\n            })\n          }, 1500)\n        } else {\n          return false\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  height: 100vh;\n  width: 100%;\n  background-color: #f0f2f5;\n}\n\n.login-form-wrapper {\n  width: 400px;\n  padding: 60px 40px;\n  background-color: #fff;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n\n.login-header {\n  text-align: center;\n  margin-bottom: 40px;\n}\n\n.login-header h1 {\n  font-size: 24px;\n  color: #333;\n  margin-bottom: 10px;\n}\n\n.login-header p {\n  font-size: 14px;\n  color: #999;\n}\n\n.login-form {\n  margin-bottom: 40px;\n}\n\n.login-button {\n  width: 100%;\n  border-radius: 4px;\n}\n\n.forgot-password {\n  float: right;\n}\n\n.login-footer {\n  text-align: center;\n  color: #999;\n  font-size: 12px;\n  margin-top: auto;\n}\n\n.login-background {\n  flex: 1;\n  background-color: #304156;\n  position: relative;\n  overflow: hidden;\n}\n\n.login-illustration {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-image: url('https://cdn2.steamgriddb.com/file/sgdb-cdn/grid/76a4d2de4b17729ad86b2d4580a33059.png');\n  background-size: cover;\n  background-position: center;\n  opacity: 0.6;\n}\n\n@media (max-width: 768px) {\n  .login-container {\n    flex-direction: column-reverse;\n  }\n  \n  .login-form-wrapper {\n    width: 100%;\n    padding: 40px 20px;\n  }\n  \n  .login-background {\n    height: 180px;\n  }\n}\n</style> "],"mappings":";AAuDA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;QACAC,QAAA;QACAC,QAAA;QACAC,QAAA;MACA;MACAC,UAAA;QACAH,QAAA,GACA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAL,QAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAC,GAAA;UAAAF,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAE,OAAA;IACA;EACA;EACAC,O