{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\n// 导入世界设置JSON数据\nimport worldSettingsData from '../../../dist/misc/dst_world_setting.json';\nexport default {\n  name: 'WorldSettings',\n  data() {\n    return {\n      loading: false,\n      isEdit: false,\n      saveId: null,\n      // 存档基本信息\n      saveForm: {\n        name: '',\n        description: ''\n      },\n      // 验证规则\n      saveRules: {\n        name: [{\n          required: true,\n          message: '请输入存档名称',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 30,\n          message: '长度在 2 到 30 个字符',\n          trigger: 'blur'\n        }]\n      },\n      // 世界列表\n      worlds: [],\n      // 世界设置数据\n      worldSettingsData: worldSettingsData\n    };\n  },\n  computed: {\n    // 是否已有森林世界\n    hasForestWorld() {\n      return this.worlds.some(world => world.type === 'master');\n    },\n    // 是否已有洞穴世界\n    hasCaveWorld() {\n      return this.worlds.some(world => world.type === 'cave');\n    }\n  },\n  methods: {\n    // 返回列表页\n    goBack() {\n      this.$router.push('/worlds/list');\n    },\n    // 保存设置\n    saveSettings() {\n      this.$refs.saveForm.validate(valid => {\n        if (valid) {\n          if (this.worlds.length === 0) {\n            this.$message.error('请至少添加一个世界');\n            return;\n          }\n          this.loading = true;\n\n          // 准备保存的数据\n          const saveData = {\n            ...this.saveForm,\n            worlds: this.worlds.map(world => {\n              // 仅保存必要的数据，不包括UI状态等\n              return {\n                name: world.name,\n                type: world.type,\n                worldgen: world.worldgen,\n                worldsettings: world.worldsettings,\n                mods: world.mods,\n                others: world.others\n              };\n            })\n          };\n          console.log('保存的数据:', saveData);\n\n          // 模拟API调用\n          setTimeout(() => {\n            this.loading = false;\n            this.$message({\n              message: this.isEdit ? '存档设置已更新' : '存档创建成功',\n              type: 'success'\n            });\n            this.goBack();\n          }, 1000);\n        } else {\n          this.$message.error('请正确填写表单信息');\n          return false;\n        }\n      });\n    },\n    // 添加世界\n    addWorld(type) {\n      // 创建新世界的初始数据结构\n      const newWorld = {\n        name: type === 'master' ? '森林世界' : '洞穴世界',\n        type: type,\n        activeTab: 'basic',\n        worldgen: this.initWorldCategorySettings(type, 'WORLDGEN_GROUP'),\n        worldsettings: this.initWorldCategorySettings(type, 'WORLDSETTINGS_GROUP'),\n        mods: {},\n        others: {}\n      };\n      this.worlds.push(newWorld);\n    },\n    // 删除世界\n    removeWorld(index) {\n      this.$confirm('确定要删除此世界吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.worlds.splice(index, 1);\n        this.$message({\n          type: 'success',\n          message: '删除成功!'\n        });\n      }).catch(() => {});\n    },\n    // 初始化世界分类设置\n    initWorldCategorySettings(worldType, groupType) {\n      const result = {};\n      const worldData = this.worldSettingsData[worldType];\n      if (!worldData || !worldData[groupType]) {\n        return result;\n      }\n\n      // 遍历分类\n      Object.keys(worldData[groupType]).forEach(categoryKey => {\n        const category = worldData[groupType][categoryKey];\n        result[categoryKey] = {};\n\n        // 遍历项目\n        if (category.items) {\n          Object.keys(category.items).forEach(itemKey => {\n            const item = category.items[itemKey];\n            result[categoryKey][itemKey] = item.value || 'default';\n          });\n        }\n      });\n      return result;\n    },\n    // 获取世界生成分类\n    getWorldgenCategories(worldType) {\n      if (!this.worldSettingsData[worldType] || !this.worldSettingsData[worldType]['WORLDGEN_GROUP']) {\n        return {};\n      }\n      return this.worldSettingsData[worldType]['WORLDGEN_GROUP'];\n    },\n    // 获取世界设置分类\n    getWorldsettingsCategories(worldType) {\n      if (!this.worldSettingsData[worldType] || !this.worldSettingsData[worldType]['WORLDSETTINGS_GROUP']) {\n        return {};\n      }\n      return this.worldSettingsData[worldType]['WORLDSETTINGS_GROUP'];\n    },\n    // 加载存档数据\n    loadSaveData() {\n      if (!this.saveId) return;\n      this.loading = true;\n\n      // 模拟API调用\n      setTimeout(() => {\n        // 模拟从API获取的数据\n        const saveData = {\n          id: 1,\n          name: '测试存档',\n          description: '这是一个测试存档',\n          worlds: [{\n            name: '森林世界',\n            type: 'master'\n            // 其他数据...\n          }, {\n            name: '洞穴世界',\n            type: 'cave'\n            // 其他数据...\n          }]\n        };\n\n        // 设置表单数据\n        this.saveForm.name = saveData.name;\n        this.saveForm.description = saveData.description;\n\n        // 设置世界数据\n        this.worlds = saveData.worlds.map(world => {\n          return {\n            ...world,\n            activeTab: 'basic',\n            worldgen: world.worldgen || this.initWorldCategorySettings(world.type, 'WORLDGEN_GROUP'),\n            worldsettings: world.worldsettings || this.initWorldCategorySettings(world.type, 'WORLDSETTINGS_GROUP'),\n            mods: world.mods || {},\n            others: world.others || {}\n          };\n        });\n        this.loading = false;\n      }, 1000);\n    }\n  },\n  created() {\n    // 判断是否为编辑模式\n    const {\n      id\n    } = this.$route.query;\n    if (id) {\n      this.isEdit = true;\n      this.saveId = parseInt(id);\n      this.loadSaveData();\n    } else {\n      // 默认添加一个森林世界\n      this.addWorld('master');\n    }\n  }\n};","map":{"version":3,"names":["worldSettingsData","name","data","loading","isEdit","saveId","saveForm","description","saveRules","required","message","trigger","min","max","worlds","computed","hasForestWorld","some","world","type","hasCaveWorld","methods","goBack","$router","push","saveSettings","$refs","validate","valid","length","$message","error","saveData","map","worldgen","worldsettings","mods","others","console","log","setTimeout","addWorld","newWorld","activeTab","initWorldCategorySettings","removeWorld","index","$confirm","confirmButtonText","cancelButtonText","then","splice","catch","worldType","groupType","result","worldData","Object","keys","forEach","categoryKey","category","items","itemKey","item","value","getWorldgenCategories","getWorldsettingsCategories","loadSaveData","id","created","$route","query","parseInt"],"sources":["src/views/worlds/WorldSettings.vue"],"sourcesContent":["<template>\n  <div class=\"world-settings-page\">\n    <div class=\"page-header\">\n      <h2>{{ isEdit ? '编辑存档' : '创建存档' }}</h2>\n      <div class=\"header-actions\">\n        <el-button @click=\"goBack\">返回列表</el-button>\n        <el-button type=\"primary\" @click=\"saveSettings\" :loading=\"loading\">保存设置</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"settings-card\">\n      <el-form ref=\"saveForm\" :model=\"saveForm\" :rules=\"saveRules\" label-width=\"120px\">\n        <el-form-item label=\"存档名称\" prop=\"name\">\n          <el-input v-model=\"saveForm.name\" placeholder=\"请输入存档名称\"></el-input>\n        </el-form-item>\n        \n        <el-form-item label=\"存档描述\">\n          <el-input type=\"textarea\" v-model=\"saveForm.description\" rows=\"3\" placeholder=\"请输入存档描述\"></el-input>\n        </el-form-item>\n      </el-form>\n    </el-card>\n    \n    <!-- 世界列表 -->\n    <div class=\"worlds-container\">\n      <h3 class=\"section-title\">世界列表</h3>\n      \n      <div class=\"worlds-list\">\n        <el-card \n          v-for=\"(world, index) in worlds\" \n          :key=\"index\" \n          shadow=\"hover\" \n          class=\"world-card\"\n        >\n          <div class=\"world-card-header\">\n            <div class=\"world-info\">\n              <h4>{{ world.name }} ({{ world.type === 'master' ? '森林' : '洞穴' }})</h4>\n            </div>\n            <div class=\"world-actions\">\n              <el-button size=\"small\" type=\"danger\" @click=\"removeWorld(index)\">删除</el-button>\n            </div>\n          </div>\n          \n          <el-tabs v-model=\"world.activeTab\">\n            <el-tab-pane label=\"基本设置\" name=\"basic\">\n              <el-form :model=\"world\" label-width=\"120px\">\n                <el-form-item label=\"世界名称\" prop=\"name\">\n                  <el-input v-model=\"world.name\" placeholder=\"请输入世界名称\"></el-input>\n                </el-form-item>\n                \n                <el-form-item label=\"世界类型\" prop=\"type\">\n                  <el-radio-group v-model=\"world.type\" disabled>\n                    <el-radio label=\"master\">森林</el-radio>\n                    <el-radio label=\"cave\">洞穴</el-radio>\n                  </el-radio-group>\n                </el-form-item>\n              </el-form>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"世界生成\" name=\"generation\">\n              <div class=\"world-config-container\">\n                <!-- 世界生成配置 -->\n                <div \n                  v-for=\"(category, categoryKey) in getWorldgenCategories(world.type)\" \n                  :key=\"categoryKey\" \n                  class=\"config-category\"\n                >\n                  <div class=\"category-header\">\n                    <h3>{{ category.text }}</h3>\n                    <span v-if=\"category.desc\" class=\"category-desc\">{{ category.desc }}</span>\n                  </div>\n                  \n                  <div class=\"category-items\">\n                    <div \n                      v-for=\"(item, itemKey) in category.items\" \n                      :key=\"itemKey\" \n                      class=\"config-item\"\n                    >\n                      <div class=\"item-header\">\n                        <div class=\"item-icon\" v-if=\"item.image\">\n                          <div \n                            class=\"item-image\" \n                            :style=\"{\n                              backgroundImage: `url(/dist/misc/worldgen_customization.webp)`,\n                              backgroundPosition: `${item.image.x * -128}px ${item.image.y * -128}px`\n                            }\"\n                          ></div>\n                        </div>\n                        <div class=\"item-info\">\n                          <span class=\"item-title\">{{ item.text }}</span>\n                        </div>\n                      </div>\n\n                      <div class=\"item-control\">\n                        <el-select \n                          v-model=\"world.worldgen[categoryKey][itemKey]\" \n                          placeholder=\"请选择\">\n                          <el-option \n                            v-for=\"(label, value) in item.desc\" \n                            :key=\"value\" \n                            :label=\"label\" \n                            :value=\"value\">\n                          </el-option>\n                        </el-select>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"世界设置\" name=\"settings\">\n              <div class=\"world-config-container\">\n                <!-- 世界设置配置 -->\n                <div \n                  v-for=\"(category, categoryKey) in getWorldsettingsCategories(world.type)\" \n                  :key=\"categoryKey\" \n                  class=\"config-category\"\n                >\n                  <div class=\"category-header\">\n                    <h3>{{ category.text }}</h3>\n                    <span v-if=\"category.desc\" class=\"category-desc\">{{ category.desc }}</span>\n                  </div>\n                  \n                  <div class=\"category-items\">\n                    <div \n                      v-for=\"(item, itemKey) in category.items\" \n                      :key=\"itemKey\" \n                      class=\"config-item\"\n                    >\n                      <div class=\"item-header\">\n                        <div class=\"item-icon\" v-if=\"item.image\">\n                          <div \n                            class=\"item-image\" \n                            :style=\"{\n                              backgroundImage: `url(/dist/misc/worldsettings_customization.webp)`,\n                              backgroundPosition: `${item.image.x * -128}px ${item.image.y * -128}px`\n                            }\"\n                          ></div>\n                        </div>\n                        <div class=\"item-info\">\n                          <span class=\"item-title\">{{ item.text }}</span>\n                        </div>\n                      </div>\n\n                      <div class=\"item-control\">\n                        <el-select \n                          v-model=\"world.worldsettings[categoryKey][itemKey]\" \n                          placeholder=\"请选择\">\n                          <el-option \n                            v-for=\"(label, value) in item.desc\" \n                            :key=\"value\" \n                            :label=\"label\" \n                            :value=\"value\">\n                          </el-option>\n                        </el-select>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"模组配置\" name=\"mods\">\n              <p>模组配置功能待开发</p>\n            </el-tab-pane>\n            \n            <el-tab-pane label=\"其他配置\" name=\"others\">\n              <p>其他配置功能待开发</p>\n            </el-tab-pane>\n          </el-tabs>\n        </el-card>\n      </div>\n      \n      <div class=\"add-world-actions\">\n        <el-button type=\"primary\" @click=\"addWorld('master')\" :disabled=\"hasForestWorld\">添加森林世界</el-button>\n        <el-button type=\"primary\" @click=\"addWorld('cave')\" :disabled=\"hasCaveWorld\">添加洞穴世界</el-button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\n// 导入世界设置JSON数据\nimport worldSettingsData from '../../../dist/misc/dst_world_setting.json'\n\nexport default {\n  name: 'WorldSettings',\n  data() {\n    return {\n      loading: false,\n      isEdit: false,\n      saveId: null,\n      \n      // 存档基本信息\n      saveForm: {\n        name: '',\n        description: ''\n      },\n      \n      // 验证规则\n      saveRules: {\n        name: [\n          { required: true, message: '请输入存档名称', trigger: 'blur' },\n          { min: 2, max: 30, message: '长度在 2 到 30 个字符', trigger: 'blur' }\n        ]\n      },\n      \n      // 世界列表\n      worlds: [],\n      \n      // 世界设置数据\n      worldSettingsData: worldSettingsData\n    }\n  },\n  computed: {\n    // 是否已有森林世界\n    hasForestWorld() {\n      return this.worlds.some(world => world.type === 'master');\n    },\n    \n    // 是否已有洞穴世界\n    hasCaveWorld() {\n      return this.worlds.some(world => world.type === 'cave');\n    }\n  },\n  methods: {\n    // 返回列表页\n    goBack() {\n      this.$router.push('/worlds/list');\n    },\n    \n    // 保存设置\n    saveSettings() {\n      this.$refs.saveForm.validate(valid => {\n        if (valid) {\n          if (this.worlds.length === 0) {\n            this.$message.error('请至少添加一个世界');\n            return;\n          }\n          \n          this.loading = true;\n          \n          // 准备保存的数据\n          const saveData = {\n            ...this.saveForm,\n            worlds: this.worlds.map(world => {\n              // 仅保存必要的数据，不包括UI状态等\n              return {\n                name: world.name,\n                type: world.type,\n                worldgen: world.worldgen,\n                worldsettings: world.worldsettings,\n                mods: world.mods,\n                others: world.others\n              };\n            })\n          };\n          \n          console.log('保存的数据:', saveData);\n          \n          // 模拟API调用\n          setTimeout(() => {\n            this.loading = false;\n            this.$message({\n              message: this.isEdit ? '存档设置已更新' : '存档创建成功',\n              type: 'success'\n            });\n            this.goBack();\n          }, 1000);\n        } else {\n          this.$message.error('请正确填写表单信息');\n          return false;\n        }\n      });\n    },\n    \n    // 添加世界\n    addWorld(type) {\n      // 创建新世界的初始数据结构\n      const newWorld = {\n        name: type === 'master' ? '森林世界' : '洞穴世界',\n        type: type,\n        activeTab: 'basic',\n        worldgen: this.initWorldCategorySettings(type, 'WORLDGEN_GROUP'),\n        worldsettings: this.initWorldCategorySettings(type, 'WORLDSETTINGS_GROUP'),\n        mods: {},\n        others: {}\n      };\n      \n      this.worlds.push(newWorld);\n    },\n    \n    // 删除世界\n    removeWorld(index) {\n      this.$confirm('确定要删除此世界吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.worlds.splice(index, 1);\n        this.$message({\n          type: 'success',\n          message: '删除成功!'\n        });\n      }).catch(() => {});\n    },\n    \n    // 初始化世界分类设置\n    initWorldCategorySettings(worldType, groupType) {\n      const result = {};\n      const worldData = this.worldSettingsData[worldType];\n      \n      if (!worldData || !worldData[groupType]) {\n        return result;\n      }\n      \n      // 遍历分类\n      Object.keys(worldData[groupType]).forEach(categoryKey => {\n        const category = worldData[groupType][categoryKey];\n        result[categoryKey] = {};\n        \n        // 遍历项目\n        if (category.items) {\n          Object.keys(category.items).forEach(itemKey => {\n            const item = category.items[itemKey];\n            result[categoryKey][itemKey] = item.value || 'default';\n          });\n        }\n      });\n      \n      return result;\n    },\n    \n    // 获取世界生成分类\n    getWorldgenCategories(worldType) {\n      if (!this.worldSettingsData[worldType] || !this.worldSettingsData[worldType]['WORLDGEN_GROUP']) {\n        return {};\n      }\n      \n      return this.worldSettingsData[worldType]['WORLDGEN_GROUP'];\n    },\n    \n    // 获取世界设置分类\n    getWorldsettingsCategories(worldType) {\n      if (!this.worldSettingsData[worldType] || !this.worldSettingsData[worldType]['WORLDSETTINGS_GROUP']) {\n        return {};\n      }\n      \n      return this.worldSettingsData[worldType]['WORLDSETTINGS_GROUP'];\n    },\n    \n    // 加载存档数据\n    loadSaveData() {\n      if (!this.saveId) return;\n      \n      this.loading = true;\n      \n      // 模拟API调用\n      setTimeout(() => {\n        // 模拟从API获取的数据\n        const saveData = {\n          id: 1,\n          name: '测试存档',\n          description: '这是一个测试存档',\n          worlds: [\n            {\n              name: '森林世界',\n              type: 'master',\n              // 其他数据...\n            },\n            {\n              name: '洞穴世界',\n              type: 'cave',\n              // 其他数据...\n            }\n          ]\n        };\n        \n        // 设置表单数据\n        this.saveForm.name = saveData.name;\n        this.saveForm.description = saveData.description;\n        \n        // 设置世界数据\n        this.worlds = saveData.worlds.map(world => {\n          return {\n            ...world,\n            activeTab: 'basic',\n            worldgen: world.worldgen || this.initWorldCategorySettings(world.type, 'WORLDGEN_GROUP'),\n            worldsettings: world.worldsettings || this.initWorldCategorySettings(world.type