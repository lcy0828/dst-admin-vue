{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport apiConfig from '@/api/config';\nexport default {\n  name: 'Backups',\n  data() {\n    return {\n      loading: false,\n      createLoading: false,\n      createDialogVisible: false,\n      selectedArchive: '',\n      backupsList: [],\n      archivesList: []\n    };\n  },\n  methods: {\n    refreshBackups() {\n      this.loading = true;\n      this.$api.backupApi.getBackupList().then(res => {\n        if (res.status === 200) {\n          // 处理返回的数据结构\n          let allBackups = [];\n          // 将各个存档的备份整合到一个列表中\n          for (const archive in res.data) {\n            if (Object.hasOwnProperty.call(res.data, archive)) {\n              if (!this.archivesList.includes(archive)) {\n                this.archivesList.push(archive);\n              }\n              const backups = res.data[archive];\n              allBackups = [...allBackups, ...backups];\n            }\n          }\n          this.backupsList = allBackups;\n        } else {\n          this.$message.error('获取备份列表失败：' + res.msg);\n        }\n      }).catch(err => {\n        this.$message.error('获取备份列表失败：' + err.message);\n      }).finally(() => {\n        this.loading = false;\n      });\n    },\n    showCreateBackupDialog() {\n      this.createDialogVisible = true;\n\n      // 使用房间管理接口获取存档列表\n      this.$api.roomApi.getRoomList().then(res => {\n        if (Array.isArray(res)) {\n          // 提取房间名称作为存档列表\n          this.archivesList = res.map(room => room.savename || room.name);\n        } else if (res.data && Array.isArray(res.data)) {\n          this.archivesList = res.data.map(room => room.savename || room.name);\n        }\n        if (this.archivesList.length === 0) {\n          this.$message.warning('没有可用的存档');\n        }\n      }).catch(err => {\n        this.$message.error('获取存档列表失败：' + (err.message || '未知错误'));\n      });\n    },\n    createBackup() {\n      if (!this.selectedArchive) {\n        this.$message.warning('请选择要备份的存档');\n        return;\n      }\n      this.createLoading = true;\n      this.$api.backupApi.createBackup(this.selectedArchive).then(res => {\n        if (res.status === 200) {\n          this.$message({\n            type: 'success',\n            message: res.msg || '创建备份成功'\n          });\n          this.createDialogVisible = false;\n          this.refreshBackups();\n        } else {\n          this.$message.error('创建备份失败：' + res.msg);\n        }\n      }).catch(err => {\n        this.$message.error('创建备份失败：' + err.message);\n      }).finally(() => {\n        this.createLoading = false;\n      });\n    },\n    downloadBackup(backup) {\n      const {\n        archive_name,\n        name\n      } = backup;\n\n      // 创建一个临时的a标签用于下载\n      const link = document.createElement('a');\n\n      // 获取API基础地址\n      const baseUrl = apiConfig.BASE_URL;\n      // 确保链接正确构建\n      link.href = `${baseUrl}/backup/download?archive=${archive_name}&backup=${name}`;\n      link.setAttribute('download', name);\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      this.$message({\n        message: `正在下载备份：${name}`,\n        type: 'success'\n      });\n    }\n  },\n  mounted() {\n    this.refreshBackups();\n  }\n};","map":{"version":3,"names":["apiConfig","name","data","loading","createLoading","createDialogVisible","selectedArchive","backupsList","archivesList","methods","refreshBackups","$api","backupApi","getBackupList","then","res","status","allBackups","archive","Object","hasOwnProperty","call","includes","push","backups","$message","error","msg","catch","err","message","finally","showCreateBackupDialog","roomApi","getRoomList","Array","isArray","map","room","savename","length","warning","createBackup","type","downloadBackup","backup","archive_name","link","document","createElement","baseUrl","BASE_URL","href","setAttribute","body","appendChild","click","removeChild","mounted"],"sources":["src/views/Backups.vue"],"sourcesContent":["<template>\n  <div class=\"backups-page\">\n    <div class=\"page-header\">\n      <h2>备份管理</h2>\n      <div class=\"header-actions\">\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"showCreateBackupDialog\">创建备份</el-button>\n        <el-button icon=\"el-icon-refresh\" @click=\"refreshBackups\">刷新</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"backups-card\">\n      <div slot=\"header\" class=\"card-header\">\n        <span>备份列表</span>\n      </div>\n      \n      <el-table\n        :data=\"backupsList\"\n        style=\"width: 100%\"\n        v-loading=\"loading\">\n        <el-table-column prop=\"name\" label=\"备份名称\">\n          <template slot-scope=\"scope\">\n            <div class=\"backup-name\">\n              <i class=\"el-icon-document\"></i>\n              {{ scope.row.name }}\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"archive_name\" label=\"存档名称\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"size_formatted\" label=\"大小\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"创建时间\" width=\"180\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"200\">\n          <template slot-scope=\"scope\">\n            <el-button \n              type=\"success\" \n              size=\"mini\" \n              @click=\"downloadBackup(scope.row)\">下载</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n\n    <!-- 创建备份对话框 -->\n    <el-dialog\n      title=\"创建存档备份\"\n      :visible.sync=\"createDialogVisible\"\n      width=\"30%\">\n      <span>选择要备份的存档：</span>\n      <el-select v-model=\"selectedArchive\" placeholder=\"请选择存档\" style=\"width: 100%; margin-top: 15px;\">\n        <el-option\n          v-for=\"archive in archivesList\"\n          :key=\"archive\"\n          :label=\"archive\"\n          :value=\"archive\">\n        </el-option>\n      </el-select>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"createDialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"createBackup\" :loading=\"createLoading\">创建</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport apiConfig from '@/api/config';\n\nexport default {\n  name: 'Backups',\n  data() {\n    return {\n      loading: false,\n      createLoading: false,\n      createDialogVisible: false,\n      selectedArchive: '',\n      backupsList: [],\n      archivesList: []\n    }\n  },\n  methods: {\n    refreshBackups() {\n      this.loading = true;\n      this.$api.backupApi.getBackupList()\n        .then(res => {\n          if (res.status === 200) {\n            // 处理返回的数据结构\n            let allBackups = [];\n            // 将各个存档的备份整合到一个列表中\n            for (const archive in res.data) {\n              if (Object.hasOwnProperty.call(res.data, archive)) {\n                if (!this.archivesList.includes(archive)) {\n                  this.archivesList.push(archive);\n                }\n                \n                const backups = res.data[archive];\n                allBackups = [...allBackups, ...backups];\n              }\n            }\n            this.backupsList = allBackups;\n          } else {\n            this.$message.error('获取备份列表失败：' + res.msg);\n          }\n        })\n        .catch(err => {\n          this.$message.error('获取备份列表失败：' + err.message);\n        })\n        .finally(() => {\n          this.loading = false;\n        });\n    },\n    showCreateBackupDialog() {\n      this.createDialogVisible = true;\n      \n      // 使用房间管理接口获取存档列表\n      this.$api.roomApi.getRoomList()\n        .then(res => {\n          if (Array.isArray(res)) {\n            // 提取房间名称作为存档列表\n            this.archivesList = res.map(room => room.savename || room.name);\n          } else if (res.data && Array.isArray(res.data)) {\n            this.archivesList = res.data.map(room => room.savename || room.name);\n          }\n          \n          if (this.archivesList.length === 0) {\n            this.$message.warning('没有可用的存档');\n          }\n        })\n        .catch(err => {\n          this.$message.error('获取存档列表失败：' + (err.message || '未知错误'));\n        });\n    },\n    createBackup() {\n      if (!this.selectedArchive) {\n        this.$message.warning('请选择要备份的存档');\n        return;\n      }\n      \n      this.createLoading = true;\n      this.$api.backupApi.createBackup(this.selectedArchive)\n        .then(res => {\n          if (res.status === 200) {\n            this.$message({\n              type: 'success',\n              message: res.msg || '创建备份成功'\n            });\n            this.createDialogVisible = false;\n            this.refreshBackups();\n          } else {\n            this.$message.error('创建备份失败：' + res.msg);\n          }\n        })\n        .catch(err => {\n          this.$message.error('创建备份失败：' + err.message);\n        })\n        .finally(() => {\n          this.createLoading = false;\n        });\n    },\n    downloadBackup(backup) {\n      const { archive_name, name } = backup;\n      \n      // 创建一个临时的a标签用于下载\n      const link = document.createElement('a');\n      \n      // 获取API基础地址\n      const baseUrl = apiConfig.BASE_URL;\n      // 确保链接正确构建\n      link.href = `${baseUrl}/backup/download?archive=${archive_name}&backup=${name}`;\n      \n      link.setAttribute('download', name);\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      \n      this.$message({\n        message: `正在下载备份：${name}`,\n        type: 'success'\n      });\n    }\n  },\n  mounted() {\n    this.refreshBackups();\n  }\n}\n</script>\n\n<style scoped>\n.backups-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.backups-card {\n  margin-bottom: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.backup-name {\n  display: flex;\n  align-items: center;\n}\n\n.backup-name i {\n  margin-right: 10px;\n  font-size: 18px;\n  color: #409EFF;\n}\n\n.el-table >>> .el-table__row {\n  cursor: pointer;\n}\n</style> "],"mappings":";;;AAgEA,OAAAA,SAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,aAAA;MACAC,mBAAA;MACAC,eAAA;MACAC,WAAA;MACAC,YAAA;IACA;EACA;EACAC,OAAA;IACAC,eAAA;MACA,KAAAP,OAAA;MACA,KAAAQ,IAAA,CAAAC,SAAA,CAAAC,aAAA,GACAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,MAAA;UACA;UACA,IAAAC,UAAA;UACA;UACA,WAAAC,OAAA,IAAAH,GAAA,CAAAb,IAAA;YACA,IAAAiB,MAAA,CAAAC,cAAA,CAAAC,IAAA,CAAAN,GAAA,CAAAb,IAAA,EAAAgB,OAAA;cACA,UAAAV,YAAA,CAAAc,QAAA,CAAAJ,OAAA;gBACA,KAAAV,YAAA,CAAAe,IAAA,CAAAL,OAAA;cACA;cAEA,MAAAM,OAAA,GAAAT,GAAA,CAAAb,IAAA,CAAAgB,OAAA;cACAD,UAAA,OAAAA,UAAA,KAAAO,OAAA;YACA;UACA;UACA,KAAAjB,WAAA,GAAAU,UAAA;QACA;UACA,KAAAQ,QAAA,CAAAC,KAAA,eAAAX,GAAA,CAAAY,GAAA;QACA;MACA,GACAC,KAAA,CAAAC,GAAA;QACA,KAAAJ,QAAA,CAAAC,KAAA,eAAAG,GAAA,CAAAC,OAAA;MACA,GACAC,OAAA;QACA,KAAA5B,OAAA;MACA;IACA;IACA6B,uBAAA;MACA,KAAA3B,mBAAA;;MAEA;MACA,KAAAM,IAAA,CAAAsB,OAAA,CAAAC,WAAA,GACApB,IAAA,CAAAC,GAAA;QACA,IAAAoB,KAAA,CAAAC,OAAA,CAAArB,GAAA;UACA;UACA,KAAAP,YAAA,GAAAO,GAAA,CAAAsB,GAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,QAAA,IAAAD,IAAA,CAAArC,IAAA;QACA,WAAAc,GAAA,CAAAb,IAAA,IAAAiC,KAAA,CAAAC,OAAA,CAAArB,GAAA,CAAAb,IAAA;UACA,KAAAM,YAAA,GAAAO,GAAA,CAAAb,IAAA,CAAAmC,GAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,QAAA,IAAAD,IAAA,CAAArC,IAAA;QACA;QAEA,SAAAO,YAAA,CAAAgC,MAAA;UACA,KAAAf,QAAA,CAAAgB,OAAA;QACA;MACA,GACAb,KAAA,CAAAC,GAAA;QACA,KAAAJ,QAAA,CAAAC,KAAA,gBAAAG,GAAA,CAAAC,OAAA;MACA;IACA;IACAY,aAAA;MACA,UAAApC,eAAA;QACA,KAAAmB,QAAA,CAAAgB,OAAA;QACA;MACA;MAEA,KAAArC,aAAA;MACA,KAAAO,IAAA,CAAAC,SAAA,CAAA8B,YAAA,MAAApC,eAAA,EACAQ,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,MAAA;U