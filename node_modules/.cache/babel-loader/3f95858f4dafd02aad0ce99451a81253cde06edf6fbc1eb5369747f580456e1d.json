{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nexport default {\n  name: 'WorldSettings',\n  data() {\n    return {\n      loading: false,\n      activeTab: 'basic',\n      activeWorldType: 'forest',\n      // 当前活动的世界类型\n      isEdit: false,\n      worldId: null,\n      worldForm: {\n        name: '',\n        type: 'master',\n        gameMode: 'survival',\n        description: '',\n        generation: {\n          size: 'default',\n          branches: 5,\n          loop: false,\n          resources: 'default',\n          specialResources: []\n        },\n        advanced: {\n          startSeason: 'autumn',\n          seasonLength: 20,\n          dayLength: 'default',\n          creatureAggression: 'default',\n          monsterCount: 'default'\n        }\n      },\n      // 世界类型定义\n      worldTypes: [{\n        id: 'forest',\n        text: '森林',\n        order: 0,\n        atlas: {\n          name: 'worldgen_customization',\n          width: 2048,\n          height: 1024,\n          item_size: 128\n        },\n        items: {\n          'resources': {\n            order: 0,\n            text: '资源设置',\n            desc: '调整世界资源生成',\n            items: {\n              'season_start': {\n                image: {\n                  x: 0.625,\n                  y: 0.375\n                },\n                text: '起始季节',\n                desc: {\n                  'default': '秋',\n                  'winter': '冬',\n                  'spring': '春',\n                  'summer': '夏',\n                  'autumn|spring': '春或秋',\n                  'winter|summer': '冬季或夏季',\n                  'autumn|winter|spring|summer': '随机'\n                },\n                order: 1,\n                value: 'default'\n              }\n            }\n          }\n        }\n      }, {\n        id: 'cave',\n        text: '洞穴',\n        order: 1,\n        atlas: {\n          name: 'worldgen_customization',\n          width: 2048,\n          height: 1024,\n          item_size: 128\n        },\n        items: {\n          'resources': {\n            order: 0,\n            text: '资源设置',\n            desc: '调整洞穴资源生成',\n            items: {\n              'cave_depth': {\n                image: {\n                  x: 0.5,\n                  y: 0.25\n                },\n                text: '洞穴深度',\n                desc: {\n                  'default': '默认',\n                  'shallow': '浅',\n                  'deep': '深',\n                  'very_deep': '非常深'\n                },\n                order: 1,\n                value: 'default'\n              }\n            }\n          }\n        }\n      }, {\n        id: 'global',\n        text: '全局',\n        order: 2,\n        atlas: {\n          name: 'worldgen_customization',\n          width: 2048,\n          height: 1024,\n          item_size: 128\n        },\n        items: {\n          'global': {\n            order: 1,\n            text: '全局设置',\n            desc: null,\n            items: {\n              'season_start': {\n                image: {\n                  x: 0.625,\n                  y: 0.375\n                },\n                text: '起始季节',\n                desc: {\n                  'default': '秋',\n                  'winter': '冬',\n                  'spring': '春',\n                  'summer': '夏',\n                  'autumn|spring': '春或秋',\n                  'winter|summer': '冬季或夏季',\n                  'autumn|winter|spring|summer': '随机'\n                },\n                order: 1,\n                value: 'default'\n              }\n            }\n          }\n        }\n      }],\n      // 所有世界类型的配置\n      worldConfiguration: {\n        forest: {},\n        cave: {},\n        global: {}\n      },\n      rules: {\n        name: [{\n          required: true,\n          message: '请输入世界名称',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 20,\n          message: '长度在 2 到 20 个字符',\n          trigger: 'blur'\n        }],\n        type: [{\n          required: true,\n          message: '请选择世界类型',\n          trigger: 'change'\n        }],\n        gameMode: [{\n          required: true,\n          message: '请选择游戏模式',\n          trigger: 'change'\n        }]\n      }\n    };\n  },\n  methods: {\n    goBack() {\n      this.$router.push('/worlds/list');\n    },\n    saveSettings() {\n      this.$refs.basicForm.validate(valid => {\n        if (valid) {\n          this.loading = true;\n\n          // 准备保存的数据，包括世界类型配置\n          const saveData = {\n            ...this.worldForm,\n            worldConfiguration: this.worldConfiguration\n          };\n          console.log('保存的数据:', saveData);\n\n          // 模拟API调用\n          setTimeout(() => {\n            this.loading = false;\n            this.$message({\n              message: this.isEdit ? '世界设置已更新' : '世界创建成功',\n              type: 'success'\n            });\n            this.goBack();\n          }, 1000);\n        } else {\n          this.$message.error('请正确填写表单信息');\n          return false;\n        }\n      });\n    },\n    loadWorldData() {\n      if (!this.worldId) return;\n      this.loading = true;\n\n      // 模拟API调用，获取世界详情\n      setTimeout(() => {\n        // 假设这是从API获取的数据\n        const worldData = this.worlds.find(w => w.id === this.worldId);\n        if (worldData) {\n          this.worldForm = {\n            name: worldData.name,\n            type: worldData.type,\n            gameMode: 'survival',\n            description: worldData.description,\n            generation: {\n              size: 'default',\n              branches: 5,\n              loop: false,\n              resources: 'default',\n              specialResources: []\n            },\n            advanced: {\n              startSeason: worldData.season === '秋季' ? 'autumn' : 'spring',\n              seasonLength: 20,\n              dayLength: 'default',\n              creatureAggression: 'default',\n              monsterCount: 'default'\n            }\n          };\n\n          // 加载世界配置\n          if (worldData.worldConfiguration) {\n            this.worldConfiguration = worldData.worldConfiguration;\n          } else {\n            this.initializeWorldConfiguration();\n          }\n        } else {\n          this.$message.error('未找到世界信息');\n          this.goBack();\n        }\n        this.loading = false;\n      }, 1000);\n    },\n    // 初始化世界配置\n    initializeWorldConfiguration() {\n      // 为每个世界类型创建默认配置结构\n      this.worldTypes.forEach(worldType => {\n        if (!this.worldConfiguration[worldType.id]) {\n          this.worldConfiguration[worldType.id] = {};\n        }\n\n        // 为每个分类创建默认配置\n        Object.keys(worldType.items).forEach(categoryKey => {\n          const category = worldType.items[categoryKey];\n          if (!this.worldConfiguration[worldType.id][categoryKey]) {\n            this.worldConfiguration[worldType.id][categoryKey] = {};\n          }\n\n          // 为每个项目设置默认值\n          Object.keys(category.items).forEach(itemKey => {\n            const item = category.items[itemKey];\n            if (!this.worldConfiguration[worldType.id][categoryKey][itemKey]) {\n              this.worldConfiguration[worldType.id][categoryKey][itemKey] = item.value || 'default';\n            }\n          });\n        });\n      });\n      console.log('初始化世界配置完成:', this.worldConfiguration);\n    },\n    // 获取配置项的图片URL\n    getItemImageUrl(worldType, item) {\n      if (!item.image) return '';\n      const atlas = worldType.atlas || {\n        name: 'worldgen_customization',\n        width: 2048,\n        height: 1024,\n        item_size: 128\n      };\n      return `/images/worldgen/${atlas.name}.png`;\n    },\n    // 获取配置项的图片位置\n    getItemImagePosition(item) {\n      if (!item.image) return '';\n      return `${item.image.x * -128}px ${item.image.y * -128}px`;\n    },\n    // 获取配置项的描述文本\n    getItemDescText(item, value) {\n      if (!item.desc) return '';\n      return item.desc[value] || '';\n    }\n  },\n  created() {\n    // 模拟世界数据库\n    this.worlds = [{\n      id: 1,\n      name: '生存世界',\n      type: 'master',\n      season: '秋季',\n      day: 21,\n      status: 'running',\n      description: '基础生存世界'\n    }, {\n      id: 2,\n      name: '生存洞穴',\n      type: 'cave',\n      season: '秋季',\n      day: 21,\n      status: 'running',\n      description: '与生存世界关联的洞穴'\n    }, {\n      id: 3,\n      name: '无尽模式',\n      type: 'master',\n      season: '春季',\n      day: 12,\n      status: 'stopped',\n      description: '无尽模式世界'\n    }];\n\n    // 判断是否为编辑模式\n    const {\n      id\n    } = this.$route.query;\n    if (id) {\n      this.isEdit = true;\n      this.worldId = parseInt(id);\n      this.loadWorldData();\n    } else {\n      // 初始化默认配置\n      this.initializeWorldConfiguration();\n    }\n  }\n};","map":{"version":3,"names":["name","data","loading","activeTab","activeWorldType","isEdit","worldId","worldForm","type","gameMode","description","generation","size","branches","loop","resources","specialResources","advanced","startSeason","seasonLength","dayLength","creatureAggression","monsterCount","worldTypes","id","text","order","atlas","width","height","item_size","items","desc","image","x","y","value","worldConfiguration","forest","cave","global","rules","required","message","trigger","min","max","methods","goBack","$router","push","saveSettings","$refs","basicForm","validate","valid","saveData","console","log","setTimeout","$message","error","loadWorldData","worldData","worlds","find","w","season","initializeWorldConfiguration","forEach","worldType","Object","keys","categoryKey","category","itemKey","item","getItemImageUrl","getItemImagePosition","getItemDescText","created","day","status","$route","query","parseInt"],"sources":["src/views/worlds/WorldSettings.vue"],"sourcesContent":["<template>\n  <div class=\"world-settings-page\">\n    <div class=\"page-header\">\n      <h2>{{ isEdit ? '编辑世界' : '创建世界' }}</h2>\n      <div class=\"header-actions\">\n        <el-button @click=\"goBack\">返回列表</el-button>\n        <el-button type=\"primary\" @click=\"saveSettings\" :loading=\"loading\">保存设置</el-button>\n      </div>\n    </div>\n    \n    <el-card shadow=\"hover\" class=\"settings-card\">\n      <el-tabs v-model=\"activeTab\">\n        <el-tab-pane label=\"基本设置\" name=\"basic\">\n          <el-form ref=\"basicForm\" :model=\"worldForm\" :rules=\"rules\" label-width=\"120px\">\n            <el-form-item label=\"世界名称\" prop=\"name\">\n              <el-input v-model=\"worldForm.name\" placeholder=\"请输入世界名称\"></el-input>\n            </el-form-item>\n            \n            <el-form-item label=\"世界类型\" prop=\"type\">\n              <el-radio-group v-model=\"worldForm.type\">\n                <el-radio label=\"master\">主世界</el-radio>\n                <el-radio label=\"cave\">洞穴</el-radio>\n              </el-radio-group>\n            </el-form-item>\n            \n            <el-form-item label=\"游戏模式\" prop=\"gameMode\">\n              <el-select v-model=\"worldForm.gameMode\" placeholder=\"请选择游戏模式\">\n                <el-option label=\"生存模式\" value=\"survival\"></el-option>\n                <el-option label=\"荒野模式\" value=\"wilderness\"></el-option>\n                <el-option label=\"无尽模式\" value=\"endless\"></el-option>\n                <el-option label=\"自定义模式\" value=\"custom\"></el-option>\n              </el-select>\n            </el-form-item>\n            \n            <el-form-item label=\"描述\">\n              <el-input type=\"textarea\" v-model=\"worldForm.description\" rows=\"3\" placeholder=\"请输入世界描述\"></el-input>\n            </el-form-item>\n          </el-form>\n        </el-tab-pane>\n        \n        <el-tab-pane label=\"世界生成\" name=\"generation\">\n          <el-tabs v-model=\"activeWorldType\" type=\"card\" class=\"world-type-tabs\">\n            <el-tab-pane \n              v-for=\"worldType in worldTypes\" \n              :key=\"worldType.id\" \n              :label=\"worldType.text\" \n              :name=\"worldType.id\"\n            >\n              <!-- 世界类型配置区域 -->\n              <div class=\"world-config-container\">\n                <div v-for=\"(category, categoryKey) in worldType.items\" :key=\"categoryKey\" class=\"config-category\">\n                  <div class=\"category-header\">\n                    <h3>{{ category.text }}</h3>\n                    <span v-if=\"category.desc\" class=\"category-desc\">{{ category.desc }}</span>\n                  </div>\n                  \n                  <div class=\"category-items\">\n                    <div v-for=\"(item, itemKey) in category.items\" :key=\"itemKey\" class=\"config-item\">\n                      <div class=\"item-header\">\n                        <div class=\"item-icon\" v-if=\"item.image\">\n                          <div \n                            class=\"item-image\" \n                            :style=\"{\n                              backgroundImage: `url(/images/worldgen/${worldType.atlas?.name || 'worldgen_customization'}.png)`,\n                              backgroundPosition: `${item.image.x * -128}px ${item.image.y * -128}px`\n                            }\"\n                          ></div>\n                        </div>\n                        <div class=\"item-info\">\n                          <span class=\"item-title\">{{ item.text }}</span>\n                        </div>\n                      </div>\n\n                      <div class=\"item-control\">\n                        <el-select \n                          v-model=\"worldConfiguration[worldType.id][categoryKey][itemKey]\" \n                          placeholder=\"请选择\">\n                          <el-option \n                            v-for=\"(label, value) in item.desc\" \n                            :key=\"value\" \n                            :label=\"label\" \n                            :value=\"value\">\n                          </el-option>\n                        </el-select>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-tab-pane>\n          </el-tabs>\n        </el-tab-pane>\n        \n        <el-tab-pane label=\"高级设置\" name=\"advanced\">\n          <el-form ref=\"advancedForm\" :model=\"worldForm.advanced\" label-width=\"150px\">\n            <el-form-item label=\"季节长度\">\n              <el-input-number v-model=\"worldForm.advanced.seasonLength\" :min=\"1\" :max=\"100\"></el-input-number>\n              <span class=\"input-help\">天</span>\n            </el-form-item>\n            \n            <el-form-item label=\"昼夜长度\">\n              <el-select v-model=\"worldForm.advanced.dayLength\" placeholder=\"请选择昼夜长度\">\n                <el-option label=\"短\" value=\"short\"></el-option>\n                <el-option label=\"默认\" value=\"default\"></el-option>\n                <el-option label=\"长\" value=\"long\"></el-option>\n                <el-option label=\"永昼\" value=\"always_day\"></el-option>\n                <el-option label=\"永夜\" value=\"always_night\"></el-option>\n              </el-select>\n            </el-form-item>\n            \n            <el-divider>难度设置</el-divider>\n            \n            <el-form-item label=\"生物攻击性\">\n              <el-select v-model=\"worldForm.advanced.creatureAggression\" placeholder=\"请选择生物攻击性\">\n                <el-option label=\"无\" value=\"none\"></el-option>\n                <el-option label=\"默认\" value=\"default\"></el-option>\n                <el-option label=\"高\" value=\"high\"></el-option>\n                <el-option label=\"疯狂\" value=\"insane\"></el-option>\n              </el-select>\n            </el-form-item>\n            \n            <el-form-item label=\"怪物数量\">\n              <el-select v-model=\"worldForm.advanced.monsterCount\" placeholder=\"请选择怪物数量\">\n                <el-option label=\"无\" value=\"none\"></el-option>\n                <el-option label=\"少\" value=\"less\"></el-option>\n                <el-option label=\"默认\" value=\"default\"></el-option>\n                <el-option label=\"多\" value=\"more\"></el-option>\n                <el-option label=\"大量\" value=\"lots\"></el-option>\n              </el-select>\n            </el-form-item>\n          </el-form>\n        </el-tab-pane>\n      </el-tabs>\n    </el-card>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'WorldSettings',\n  data() {\n    return {\n      loading: false,\n      activeTab: 'basic',\n      activeWorldType: 'forest', // 当前活动的世界类型\n      isEdit: false,\n      worldId: null,\n      worldForm: {\n        name: '',\n        type: 'master',\n        gameMode: 'survival',\n        description: '',\n        generation: {\n          size: 'default',\n          branches: 5,\n          loop: false,\n          resources: 'default',\n          specialResources: []\n        },\n        advanced: {\n          startSeason: 'autumn',\n          seasonLength: 20,\n          dayLength: 'default',\n          creatureAggression: 'default',\n          monsterCount: 'default'\n        }\n      },\n      // 世界类型定义\n      worldTypes: [\n        {\n          id: 'forest',\n          text: '森林',\n          order: 0,\n          atlas: {\n            name: 'worldgen_customization',\n            width: 2048,\n            height: 1024,\n            item_size: 128\n          },\n          items: {\n            'resources': {\n              order: 0,\n              text: '资源设置',\n              desc: '调整世界资源生成',\n              items: {\n                'season_start': {\n                  image: {\n                    x: 0.625,\n                    y: 0.375\n                  },\n                  text: '起始季节',\n                  desc: {\n                    'default': '秋',\n                    'winter': '冬',\n                    'spring': '春',\n                    'summer': '夏',\n                    'autumn|spring': '春或秋',\n                    'winter|summer': '冬季或夏季',\n                    'autumn|winter|spring|summer': '随机'\n                  },\n                  order: 1,\n                  value: 'default'\n                }\n              }\n            }\n          }\n        },\n        {\n          id: 'cave',\n          text: '洞穴',\n          order: 1,\n          atlas: {\n            name: 'worldgen_customization',\n            width: 2048,\n            height: 1024,\n            item_size: 128\n          },\n          items: {\n            'resources': {\n              order: 0,\n              text: '资源设置',\n              desc: '调整洞穴资源生成',\n              items: {\n                'cave_depth': {\n                  image: {\n                    x: 0.5,\n                    y: 0.25\n                  },\n                  text: '洞穴深度',\n                  desc: {\n                    'default': '默认',\n                    'shallow': '浅',\n                    'deep': '深',\n                    'very_deep': '非常深'\n                  },\n                  order: 1,\n                  value: 'default'\n                }\n              }\n            }\n          }\n        },\n        {\n          id: 'global',\n          text: '全局',\n          order: 2,\n          atlas: {\n            name: 'worldgen_customization',\n            width: 2048,\n            height: 1024,\n            item_size: 128\n          },\n          items: {\n            'global': {\n              order: 1,\n              text: '全局设置',\n              desc: null,\n              items: {\n                'season_start': {\n                  image: {\n                    x: 0.625,\n                    y: 0.375\n                  },\n                  text: '起始季节',\n                  desc: {\n                    'default': '秋',\n                    'winter': '冬',\n                    'spring': '春',\n                    'summer': '夏',\n                    'autumn|spring': '春或秋',\n                    'winter|summer': '冬季或夏季',\n                    'autumn|winter|spring|summer': '随机'\n                  },\n                  order: 1,\n                  value: 'default'\n                }\n              }\n            }\n          }\n        }\n      ],\n      // 所有世界类型的配置\n      worldConfiguration: {\n        forest: {},\n        cave: {},\n        global: {}\n      },\n      rules: {\n        name: [\n          { required: true, message: '请输入世界名称', trigger: 'blur' },\n          { min: 2, max: 20, message: '长度在 2 到 20 个字符', trigger: 'blur' }\n        ],\n        type: [\n          { required: true, message: '请选择世界类型', trigger: 'change' }\n        ],\n        gameMode: [\n          { required: true, message: '请选择游戏模式', trigger: 'change' }\n        ]\n      }\n    }\n  },\n  methods: {\n    goBack() {\n      this.$router.push('/worlds/list');\n    },\n    saveSettings() {\n      this.$refs.basicForm.validate(valid => {\n        if (valid) {\n          this.loading = true;\n          \n          // 准备保存的数据，包括世界类型配置\n          const saveData = {\n            ...this.worldForm,\n            worldConfiguration: this.worldConfiguration\n          };\n          \n          console.log('保存的数据:', saveData);\n          \n          // 模拟API调用\n          setTimeout(() => {\n            this.loading = false;\n            this.$message({\n              message: this.isEdit ? '世界设置已更新' : '世界创建成功',\n              type: 'success'\n            });\n            this.goBack();\n          }, 1000);\n        } else {\n          this.$message.error('请正确填写表单信息');\n          return false;\n        }\n      });\n    },\n    loadWorldData() {\n      if (!this.worldId) return;\n      \n      this.loading = true;\n      \n      // 模拟API调用，获取世界详情\n      setTimeout(() => {\n        // 假设这是从API获取的数据\n        const worldData = this.worlds.find(w => w.id === this.worldId);\n        \n        if (worldData) {\n          this.worldForm = {\n            name: worldData.name,\n            type: worldData.type,\n            gameMode: 'survival',\n            description: worldData.description,\n            generation: {\n              size: 'default',\n              branches: 5,\n              loop: false,\n              resources: 'default',\n              specialResources: []\n            },\n            advanced: {\n              startSeason: worldData.season === '秋季' ? 'autumn' : 'spring',\n              seasonLength: 20,\n              dayLength: 'default',\n              creatureAggression: 'default',\n              monsterCount: 'default'\n            }\n          };\n          \n          // 加载世界配置\n          if (worldData.worldConfiguration) {\n            this.worldConfiguration = worldData.worldConfiguration;\n          } else {\n            this.initializeWorldConfiguration();\n          }\n        } else {\n          this.$message.error('未找到世界信息');\n          this.goBack();\n        }\n        \n        this.loading = false;\n      }, 1000);\n    },\n    \n    // 初始化世界配置\n    initializeWorldConfiguration() {\n      // 为每个世界类型创建默认配置结构\n      this.worldTypes.forEach(worldType => {\n        if (!this.worldConfiguration[worldType.id]) {\n          this.worldConfiguration[worldType.id] = {};\n        }\n        \n        // 为每个分类创建默认配置\n        Object.keys(worldType.items).forEach(categoryKey => {\n          const category = worldType.items[categoryKey];\n          \n          if (!this.worldConfiguration[worldType.id][categoryKey]) {\n            this.worldConfiguration[worldType.id][categoryKey] = {};\n          }\n          \n          // 为每个项目设置默认值\n          Object.keys(category.items).forEach(itemKey => {\n            const item = category.items[itemKey];\n            if (!this.worldConfiguration[worldType.id][categoryKey][itemKey]) {\n              this.worldConfiguration[worldType.id][categoryKey][itemKey] = item.value || 'default';\n            }\n          });\n        });\n      });\n      \n      console.log('初始化世界配置完成:', this.worldConfiguration);\n    },\n    \n    // 获取配置项的图片URL\n    getItemImageUrl(worldType, item) {\n      if (!item.image) return '';\n      \n      const atlas = worldType.atlas || {\n        name: 'worldgen_customization',\n        width: 2048,\n        height: 1024,\n        item_size: 128\n      };\n      \n      return `/images/worldgen/${atlas.name}.png`;\n    },\n    \n    // 获取配置项的图片位置\n    getItemImagePosition(item) {\n      if (!item.image) return '';\n      \n      return `${item.image.x * -128}px ${item.image.y * -128}px`;\n    },\n    \n    // 获取配置项的描述文本\n    getItemDescText(item, value) {\n      if (!item.desc) return '';\n      \n      return item.desc[value] || '';\n    }\n  },\n  created() {\n    // 模拟世界数据库\n    this.worlds = [\n      {\n        id: 1,\n        name: '生存世界',\n        type: 'master',\n        season: '秋季',\n        day: 21,\n        status: 'running',\n        description: '基础生存世界'\n      },\n      {\n        id: 2,\n        name: '生存洞穴',\n        type: 'cave',\n        season: '秋季',\n        day: 21,\n        status: 'running',\n        description: '与生存世界关联的洞穴'\n      },\n      {\n        id: 3,\n        name: '无尽模式',\n        type: 'master',\n        season: '春季',\n        day: 12,\n        status: 'stopped',\n        description: '无尽模式世界'\n      }\n    ];\n    \n    // 判断是否为编辑模式\n    const { id } = this.$route.query;\n    if (id) {\n      this.isEdit = true;\n      this.worldId = parseInt(id);\n      this.loadWorldData();\n    } else {\n      // 初始化默认配置\n      this.initializeWorldConfiguration();\n    }\n  }\n}\n</script>\n\n<style scoped>\n.world-settings-page {\n  padding: 20px;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.settings-card {\n  margin-bottom: 20px;\n}\n\n.input-help {\n  margin-left: 10px;\n  color: #909399;\n}\n\n.el-divider {\n  margin: 20px 0;\n}\n\n.el-